# Admin sign-in for local development (copy to .dev.vars, which is gitignored).
# Password form + signed session cookie. Use a long random ADMIN_SESSION_SECRET (32+ chars).
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Production uses Cloudflare Access as the primary sign-in; the password above stays as the
# break-glass backup when both are set:
# CF_ACCESS_TEAM_DOMAIN=
# CF_ACCESS_AUD=
# Optional: bearer token for scripts calling /api/v1/admin (32+ random characters).
# ADMIN_API_TOKEN=

# Public API: salt for hashing client IPs (rate limiting). Any long random string locally.
IP_HASH_SALT=
# Optional: serve captured media from an absolute origin instead of /media/<key>.
# MEDIA_BASE_URL=

# Optional: recipient of admin notifications (new removal requests). Without a mail transport
# nothing is sent; one line without personal data is logged instead.
# ADMIN_NOTIFY_EMAIL=

# Accounts + Pro via Whop (docs/ACCOUNTS.md). All optional: without them sign-in says "not open
# yet", the Pro buttons explain that, and /api/whop/webhook answers 503.
# Signs the OAuth state cookie (32+ random characters). Needed for any sign-in.
# USER_SESSION_SECRET=
# Local only: '1' adds a dev sign-in form on 127.0.0.1/localhost (never works elsewhere).
# DEV_SIGN_IN=1
# Whop OAuth app (Developer dashboard → OAuth). Public client + PKCE; the secret is optional.
# WHOP_CLIENT_ID=
# WHOP_CLIENT_SECRET=
# 'sandbox' to use sandbox-api.whop.com (no real money) while testing.
# WHOP_ENVIRONMENT=sandbox
# Webhook secret Whop shows for the endpoint <origin>/api/whop/webhook (starts with ws_).
# WHOP_WEBHOOK_SECRET=
# Product ids that grant Pro and Team (prod_…).
# WHOP_PRO_PRODUCT_ID=
# WHOP_TEAM_PRODUCT_ID=
# Checkout links (https) for each plan and billing period.
# WHOP_CHECKOUT_PRO_MONTHLY=
# WHOP_CHECKOUT_PRO_YEARLY=
# WHOP_CHECKOUT_TEAM_MONTHLY=
# WHOP_CHECKOUT_TEAM_YEARLY=
