# --- Admin (names only; set values as Wrangler secrets or in .dev.vars locally) ---
# Cloudflare Access protects /admin in production. Team domain like <team>.cloudflareaccess.com
# and the Access application's Audience (AUD) tag.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# Password sign-in for local/dev when Access is not configured.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# --- Public API / media (names only) ---
# Salt for hashing client IPs (removal-request rate limiting; raw IPs are never stored).
# Required in production (Wrangler secret); local dev falls back to a fixed dev-only salt.
IP_HASH_SALT=
# Optional absolute origin for captured media, e.g. an R2 custom domain. Unset = /media/<key>.
MEDIA_BASE_URL=

# --- Notifications (names only) ---
# Who is told about new removal requests. Placeholder for now: no mail transport is configured,
# so requests are only logged (without personal data). See src/server/notify.ts.
ADMIN_NOTIFY_EMAIL=
