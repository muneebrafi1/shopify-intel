---
/**
 * /sections/<type> — one section type: what it does on a Shopify store, how many there are and
 * where they appear, the Desktop/Mobile switch, then the same browse bar + crop grid as the
 * library scoped to the type, who renders it (apps and themes), and the other types in its
 * group.
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/ui/Breadcrumbs.astro';
import Chip from '~/components/ui/Chip.astro';
import PageHeader from '~/components/ui/PageHeader.astro';
import SectionHeader from '~/components/ui/SectionHeader.astro';
import Segmented from '~/components/ui/Segmented.astro';
import LibraryBrowse from '~/components/sections/LibraryBrowse.astro';
import RenderedBy from '~/components/sections/RenderedBy.astro';
import TypeCard from '~/components/sections/TypeCard.astro';
import {
  PAGE_SIZE,
  activeFilterCount,
  apiSort,
  buildFilterGroups,
  buildSort,
  cropSource,
  deviceItems,
  filterQuery,
  fmt,
  isSectionType,
  libraryHref,
  pageLabel,
  readFilters,
  resolveSearch,
} from '~/components/sections/library';
import { SECTION_TYPES, type PageType } from '~/lib/taxonomy';
import { api, isApiError } from '~/server/api';

const slug = Astro.params.type;
if (!isSectionType(slug)) return Astro.rewrite('/404');
const type = slug;

const url = Astro.url;
const filters = readFilters(url);
const cursor = url.searchParams.get('cursor') || undefined;
const q = (url.searchParams.get('q') ?? '').trim().slice(0, 100);
if (q) {
  const target = await resolveSearch(q, type, filters);
  if (target) return Astro.redirect(target, 302);
}
const filtered = activeFilterCount(filters);
// The header and "who renders it" describe the whole type; the grid follows the filters.
const narrowed = filtered > 0 || !!cursor;

let list;
let whole;
let types;
try {
  [list, whole, types] = await Promise.all([
    api.listSections({
      type,
      page_type: filters.page,
      device: filters.device,
      theme: filters.theme,
      app: filters.app,
      store: filters.store,
      sort: apiSort(filters),
      cursor,
      limit: PAGE_SIZE,
    }),
    narrowed ? api.listSections({ type, sort: 'mixed', limit: 60 }) : Promise.resolve(null),
    api.listSectionTypes({}),
  ]);
} catch (err) {
  if (isApiError(err) && err.status === 400) return Astro.redirect(libraryHref(type, filters), 302);
  throw err;
}
whole ??= list;

Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=600');

const { data, meta } = list;
const info = whole.data.section_type ?? data.section_type;
if (!info) return Astro.rewrite('/404');
// A type with nothing captured (cart-only types) has no page.
if ((whole.meta.pagination?.total ?? whole.data.items.length) === 0) return Astro.rewrite('/404');

const taxonomy = SECTION_TYPES.find((t) => t.slug === type)!;
const total = meta.pagination?.total ?? data.items.length;
const page = cursor ? Math.max(2, Number.parseInt(url.searchParams.get('p') ?? '', 10) || 2) : 1;
const nextCursor = meta.pagination?.next_cursor;
const nextHref = nextCursor
  ? `/sections/${type}${filterQuery(filters, { cursor: nextCursor, p: String(page + 1) })}`
  : null;
const groups = buildFilterGroups(data.facets, type, filters);
const source = cropSource(whole.meta, whole.data.items);

// Where it usually appears: page types it was seen on (most first), then the taxonomy's others.
const pageFacets = [...whole.data.facets.page_types].sort((a, b) => b.count - a.count);
const usualPages = [
  ...pageFacets.map((p) => ({ slug: p.value as PageType, count: p.count })),
  ...taxonomy.pages
    .filter((p) => !pageFacets.some((f) => f.value === p))
    .map((p) => ({ slug: p as PageType, count: 0 })),
];

// Who renders it, with icons from the cards we already have.
const icons = new Map<string, string | null>();
for (const s of [...whole.data.items, ...data.items])
  if (s.app) icons.set(s.app.slug, s.app.icon_url);
const appFacets = whole.data.facets.apps;
const apps = appFacets.slice(0, 7).map((a) => ({
  slug: a.value,
  name: a.label,
  count: a.count,
  icon: icons.get(a.value) ?? null,
  href: libraryHref(type, { app: a.value }),
  page: `/apps/${a.value}`,
}));
const attributed = appFacets.reduce((n, a) => n + a.count, 0);
const themeOwn = Math.max(0, info.count - attributed);
const themes = whole.data.facets.themes.slice(0, 8).map((t) => ({
  slug: t.value,
  name: t.label,
  count: t.count,
  href: libraryHref(type, { theme: t.value }),
  page: `/themes/${t.value}`,
}));

// The other types in this group, with a real crop each.
const siblings = types.data.items.filter(
  (t) => t.group.slug === info.group.slug && t.slug !== type && t.count > 0,
);

const lower = info.name.toLowerCase();
const title = `${info.name} sections on real Shopify stores`;
const description = `${fmt(info.count)} ${lower} sections from ${info.stores} Shopify stores on ${info.themes} themes. ${info.description} Desktop and mobile, filterable by page type, theme and app.`;
const canonical = `/sections/${type}`;
const site = Astro.site ?? url;
const jsonLd = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Sections', item: new URL('/sections', site).href },
      { '@type': 'ListItem', position: 2, name: info.name, item: new URL(canonical, site).href },
    ],
  },
  {
    '@type': 'CollectionPage',
    name: `${info.name} sections`,
    description,
    url: new URL(canonical, site).href,
  },
];
---

<BaseLayout
  title={page > 1 ? `${info.name} sections — page ${page}` : title}
  description={description}
  canonical={canonical}
  noindex={!!cursor || filtered > 1 || !!filters.store || !!filters.sort}
  jsonLd={jsonLd}
  wide
>
  <div class="container--wide tx">
    <PageHeader
      eyebrow={info.group.name}
      title={info.name}
      count={info.count}
      description={info.description}
    >
      <Breadcrumbs
        slot="top"
        items={[{ label: 'Sections', href: '/sections' }, { label: info.name }]}
      />
      <div slot="meta" class="tx__meta">
        <p class="tx__stats">
          <span>
            <span class="num">{fmt(info.stores)}</span> stores
          </span>
          <span aria-hidden="true">·</span>
          <span>
            <span class="num">{fmt(info.themes)}</span> themes
          </span>
          <span aria-hidden="true">·</span>
          <span>
            {appFacets.length > 0 ? (
              <>
                <span class="num">{fmt(appFacets.length)}</span>{' '}
                {appFacets.length === 1 ? 'app' : 'apps'}
              </>
            ) : (
              'no app detected'
            )}
          </span>
        </p>
        <div class="tx__pages" role="group" aria-label="Usually appears on">
          <span class="tx__pages-label">Usually on</span>
          {usualPages.map((p) =>
            p.count > 0 ? (
              <Chip
                size="sm"
                href={libraryHref(type, { ...filters, page: p.slug })}
                selected={filters.page === p.slug}
                count={p.count}
              >
                {pageLabel(p.slug)}
              </Chip>
            ) : (
              <span class="tx__page-off" title="Not seen on this page type yet">
                {pageLabel(p.slug)}
              </span>
            ),
          )}
        </div>
      </div>
      <Segmented
        slot="actions"
        label="Device"
        items={deviceItems(data.facets.devices, type, filters)}
      />
    </PageHeader>

    <LibraryBrowse
      groups={groups}
      sort={buildSort(type, filters)}
      items={data.items}
      total={total}
      tag="page"
      page={page}
      pageSize={PAGE_SIZE}
      nextHref={nextHref}
      firstHref={libraryHref(type, filters)}
      clearHref={libraryHref(type, { view: filters.view })}
      device={filters.device}
      view={{
        current: filters.view ?? 'grid',
        gridHref: libraryHref(type, { ...filters, view: undefined }),
        indexHref: libraryHref(type, { ...filters, view: 'index' }),
      }}
      search={{
        value: q,
        hidden: {
          page: filters.page,
          device: filters.device,
          theme: filters.theme,
          app: filters.app,
          store: filters.store,
          sort: filters.sort,
          view: filters.view,
        },
      }}
      unmatched={q || null}
    />

    <section class="tx__block" aria-labelledby="rendered-by">
      <SectionHeader
        id="rendered-by"
        title={`Who renders ${lower} sections`}
        description={`Across all ${fmt(info.count)} in the library. Pick a name to filter the grid to it.`}
      />
      <RenderedBy
        typeName={info.name}
        total={info.count}
        apps={apps}
        themeOwn={themeOwn}
        themes={themes}
        appTotal={appFacets.length}
        themeTotal={info.themes}
        source={source}
      />
    </section>

    {siblings.length > 0 && (
      <section class="tx__block" aria-labelledby="related-types">
        <SectionHeader
          id="related-types"
          title={`More ${info.group.name.toLowerCase()} sections`}
          href="/sections"
          linkLabel="All types"
        />
        <ul class="tx__types" role="list">
          {siblings.map((t) => (
            <li>
              <TypeCard name={t.name} href={t.href} count={t.count} preview={t.preview} />
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .tx {
    padding-bottom: var(--section-y-app);
  }
  .tx__meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }
  .tx__stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    color: var(--ink-3);
    font-size: var(--text-sm);
  }
  .tx__stats .num {
    color: var(--ink);
    font-weight: var(--weight-medium);
  }
  .tx__pages {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }
  .tx__pages-label {
    margin-right: var(--space-1);
    color: var(--ink-3);
    font-size: var(--text-sm);
  }
  .tx__page-off {
    display: inline-flex;
    align-items: center;
    height: 28px;
    padding: 0 10px;
    border-radius: var(--radius-pill);
    box-shadow: inset 0 0 0 1px var(--line);
    color: var(--ink-3);
    font-size: var(--text-sm);
  }
  .tx__block {
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--line);
  }
  .tx__types {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
  }
  @media (min-width: 640px) {
    .tx__types {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .tx__types {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: var(--space-4);
    }
    .tx__block {
      margin-top: var(--space-16);
      padding-top: var(--space-10);
    }
  }
</style>
