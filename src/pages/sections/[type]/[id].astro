---
/**
 * /sections/<type>/<id> — one section in focus: identity row with prev/next in the type (← →),
 * the crop large in a product window beside a facts card, then the section in the context of
 * its full page (pinned tags, this one outlined) with the page's other sections, and similar
 * sections on other stores. Unknown ids 404; an id under another type 301s to its real URL.
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/ui/Breadcrumbs.astro';
import SectionHeader from '~/components/ui/SectionHeader.astro';
import CropCard from '~/components/sections/CropCard.astro';
import PageContext from '~/components/sections/PageContext.astro';
import SectionFocus from '~/components/sections/SectionFocus.astro';
import { cropSource, fmt, pageLabel, pagePhrase } from '~/components/sections/library';
import { api, orNotFound } from '~/server/api';
import { isPlaceholderSrc } from '~/lib/media';

const { type, id } = Astro.params;
if (!id || !/^[1-9]\d{0,9}$/.test(id)) return Astro.rewrite('/404');

const res = await orNotFound(api.getSection({ id: Number(id) }));
if (!res) return Astro.rewrite('/404');
const { data: detail, meta } = res;
const s = detail.section;
if (s.type.slug !== type) return Astro.redirect(s.href, 301);

// The store's list entry carries the theme version, storefront URL and scan dates.
const stores = await api
  .listStores({ q: s.store.domain, scope: 'all', limit: 5 })
  .catch(() => null);
const store = stores?.data.items.find((x) => x.domain === s.store.domain) ?? null;

Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=600');

const shot = detail.screenshot;
const ordered = [...shot.sections].sort((a, b) => a.order_index - b.order_index);
const index = ordered.findIndex((x) => x.id === s.id);
const source = cropSource(meta, [s]);
const phrase = pagePhrase(s.page_type, s.device);
const fullPageHref = `${s.store.href}?page=${s.page_type}&device=${s.device}#section-${s.id}`;
// Whole rows on the 4-column grid.
const more =
  detail.more_like_this.length >= 4
    ? detail.more_like_this.slice(
        0,
        detail.more_like_this.length - (detail.more_like_this.length % 4),
      )
    : detail.more_like_this;

const title = `${s.type.name} section on ${s.store.display_name} (${phrase})`;
const description = `The ${s.type.name.toLowerCase()} section on ${s.store.display_name}'s ${phrase}${
  s.theme ? `, ${s.theme.name} theme` : ''
}${s.app ? `, rendered by ${s.app.short_name}` : ''}. Section ${index + 1} of ${ordered.length} on the page.`;
const ogImage =
  !detail.screenshot.is_placeholder &&
  !s.crop.is_placeholder &&
  !isPlaceholderSrc(s.crop.src) &&
  /\.(webp|png|jpe?g)$/i.test(s.crop.src.split('?')[0] ?? s.crop.src)
    ? s.crop.src
    : undefined;
const site = Astro.site ?? Astro.url;
const jsonLd = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Sections', item: new URL('/sections', site).href },
      {
        '@type': 'ListItem',
        position: 2,
        name: s.type.name,
        item: new URL(s.type.href, site).href,
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: s.store.display_name,
        item: new URL(s.href, site).href,
      },
    ],
  },
  {
    '@type': 'ImageObject',
    name: title,
    description,
    contentUrl: new URL(s.crop.src, site).href,
    width: s.crop.width,
    height: s.crop.height,
    isPartOf: { '@type': 'WebPage', url: new URL(s.store.href, site).href },
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={s.href}
  ogImage={ogImage}
  ogImageAlt={ogImage ? title : undefined}
  jsonLd={jsonLd}
  wide
>
  <div class="container--wide dx">
    <Breadcrumbs
      class="dx__crumbs"
      items={[
        { label: 'Sections', href: '/sections' },
        { label: s.type.name, href: s.type.href },
        { label: s.store.display_name },
      ]}
    />
    <SectionFocus detail={detail} source={source} store={store} />

    <section class="dx__block" aria-labelledby="on-the-page">
      <SectionHeader
        id="on-the-page"
        title="On the page"
        href={fullPageHref}
        linkLabel="Open in the store viewer"
      />
      <PageContext
        shot={shot}
        currentId={s.id}
        storeLabel={s.store.display_name}
        fullPageHref={fullPageHref}
      />
    </section>

    {more.length > 0 && (
      <section class="dx__block" aria-labelledby="more-like-this">
        <SectionHeader
          id="more-like-this"
          title={`Similar ${s.type.name.toLowerCase()} sections`}
          href={s.type.href}
          linkLabel={`All ${fmt(detail.in_type.total)}`}
        />
        <div class="dx__more">
          {more.map((m) => (
            <CropCard section={m} tag="page" />
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>

<script>
  // ← → step through the sections of this type (the prev/next links in the identity row).
  document.addEventListener('keydown', (event) => {
    if (event.defaultPrevented || event.metaKey || event.ctrlKey || event.altKey || event.shiftKey)
      return;
    const target = event.target as HTMLElement;
    if (target.closest('input, textarea, select, [contenteditable], dialog[open]')) return;
    if (document.querySelector('dialog[open]')) return;
    const link =
      event.key === 'ArrowLeft'
        ? document.querySelector<HTMLAnchorElement>('[data-sf-prev]')
        : event.key === 'ArrowRight'
          ? document.querySelector<HTMLAnchorElement>('[data-sf-next]')
          : null;
    if (!link) return;
    event.preventDefault();
    window.location.href = link.href;
  });
</script>

<style>
  .dx {
    padding-top: var(--space-6);
    padding-bottom: var(--section-y-app);
  }
  .dx :global(.dx__crumbs) {
    margin-bottom: var(--space-5);
  }
  .dx__block {
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--line);
  }
  .dx__more {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
  }
  @media (min-width: 560px) {
    .dx__more {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .dx {
      padding-top: var(--space-8);
    }
    .dx :global(.dx__crumbs) {
      margin-bottom: var(--space-6);
    }
    .dx__block {
      margin-top: var(--space-16);
      padding-top: var(--space-10);
    }
    .dx__more {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-5);
    }
  }
</style>
