---
/**
 * /sections — the sections library ("Mobbin for Shopify"): every captured page sliced into
 * typed sections. Page header with the Desktop/Mobile switch, the browse bar (search, type
 * pills, page/theme/app filters, sort, grid/list), a "browse by type" overview on the plain
 * first page, then the crop grid with cursor pagination and a lightbox.
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/ui/PageHeader.astro';
import Segmented from '~/components/ui/Segmented.astro';
import LibraryBrowse from '~/components/sections/LibraryBrowse.astro';
import TypeOverview from '~/components/sections/TypeOverview.astro';
import {
  PAGE_SIZE,
  activeFilterCount,
  apiSort,
  buildFilterGroups,
  buildSort,
  deviceItems,
  filterQuery,
  fmt,
  libraryHref,
  readFilters,
  resolveSearch,
} from '~/components/sections/library';
import { SECTION_GROUPS, SECTION_TYPES } from '~/lib/taxonomy';
import { api, isApiError } from '~/server/api';

const url = Astro.url;
const filters = readFilters(url);
const cursor = url.searchParams.get('cursor') || undefined;
const q = (url.searchParams.get('q') ?? '').trim().slice(0, 100);

// The search box resolves to a filter (type, theme, app or store) and redirects there.
if (q) {
  const target = await resolveSearch(q, null, filters);
  if (target) return Astro.redirect(target, 302);
}

const filtered = activeFilterCount(filters);
const showOverview = !cursor && filtered === 0 && !q;

let list;
let types;
try {
  [list, types] = await Promise.all([
    api.listSections({
      page_type: filters.page,
      device: filters.device,
      theme: filters.theme,
      app: filters.app,
      store: filters.store,
      sort: apiSort(filters),
      cursor,
      limit: PAGE_SIZE,
    }),
    showOverview ? api.listSectionTypes({}) : Promise.resolve(null),
  ]);
} catch (err) {
  // A stale or hand-edited cursor: start the same filters from the top.
  if (isApiError(err) && err.status === 400) return Astro.redirect(libraryHref(null, filters), 302);
  throw err;
}
const { data: metaData } = await api.getMeta({});
const { data, meta } = list;

Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=600');

const counts = metaData.counts;
const total = meta.pagination?.total ?? data.items.length;
const page = cursor ? Math.max(2, Number.parseInt(url.searchParams.get('p') ?? '', 10) || 2) : 1;
const nextCursor = meta.pagination?.next_cursor;
const nextHref = nextCursor
  ? `/sections${filterQuery(filters, { cursor: nextCursor, p: String(page + 1) })}`
  : null;
const groups = buildFilterGroups(data.facets, null, filters);
const deviceAll = (data.facets.devices.find((d) => d.value === 'desktop')?.count ?? 0)
  + (data.facets.devices.find((d) => d.value === 'mobile')?.count ?? 0);
const libraryCount = deviceAll || counts.sections;

const description = `${fmt(counts.sections)} page sections (headers, heroes, buy boxes, reviews, footers and more) sliced from ${counts.stores_with_capture_plan} Shopify stores on desktop and mobile. Filter by type, page, device, theme and app.`;

const jsonLd = {
  '@type': 'CollectionPage',
  name: 'Sections',
  description,
  url: new URL('/sections', Astro.site ?? url).href,
  hasPart: {
    '@type': 'ItemList',
    numberOfItems: SECTION_TYPES.length,
    itemListElement: SECTION_TYPES.map((t, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: t.name,
      url: new URL(`/sections/${t.slug}`, Astro.site ?? url).href,
    })),
  },
};
---

<BaseLayout
  title={page > 1 ? `Sections — page ${page}` : 'Sections library: every Shopify page, sliced'}
  description={description}
  canonical="/sections"
  noindex={!!cursor || filtered > 1 || !!q || !!filters.store || !!filters.sort}
  jsonLd={jsonLd}
  wide
>
  <div class="container--wide sx">
    <PageHeader
      class="sx__header"
      title="Sections"
      count={libraryCount}
    >
      <Segmented
        slot="actions"
        label="Device"
        items={deviceItems(data.facets.devices, null, filters)}
      />
    </PageHeader>

    <LibraryBrowse
      class="sx__browse"
      groups={groups}
      sort={buildSort(null, filters)}
      items={data.items}
      total={total}
      tag="type"
      page={page}
      pageSize={PAGE_SIZE}
      nextHref={nextHref}
      firstHref={libraryHref(null, filters)}
      clearHref={libraryHref(null, { view: filters.view })}
      device={filters.device}
      view={{
        current: filters.view ?? 'grid',
        gridHref: libraryHref(null, { ...filters, view: undefined }),
        indexHref: libraryHref(null, { ...filters, view: 'index' }),
      }}
      search={{
        value: q,
        hidden: {
          page: filters.page,
          device: filters.device,
          theme: filters.theme,
          app: filters.app,
          store: filters.store,
          sort: filters.sort,
          view: filters.view,
        },
      }}
      unmatched={q || null}
    >
      {showOverview && types && (
        <Fragment slot="lead">
          <TypeOverview types={types.data.items} groupCount={SECTION_GROUPS.length} />
          <h2 id="all-sections" class="sx__feed">
            All sections
          </h2>
        </Fragment>
      )}
    </LibraryBrowse>
  </div>
</BaseLayout>

<style>
  .sx {
    padding-bottom: var(--section-y-app);
  }
  .sx__feed {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-4);
    margin: var(--space-10) 0 var(--space-4);
    padding-top: var(--space-6);
    border-top: 1px solid var(--line);
    font-size: var(--text-h3);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.015em;
    scroll-margin-top: calc(var(--header-h) + 72px);
  }
  .sx :global(.sx__browse) {
    margin-top: 0;
  }
  @media (min-width: 1024px) {
    .sx :global(.sx__browse) {
      margin-top: var(--space-4);
    }
  }
</style>
