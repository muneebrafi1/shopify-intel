---
/**
 * /compare — the curated popular pairs (top apps per category, top and same-vendor themes) as
 * cards grouped by category, under one "find a comparison" control. Only curated pairs have a
 * page (owner decision: no thin long-tail pages). The picker submits GET /compare?a=&b=:
 * curated pairs redirect to their canonical page; any other pair gets a plain answer here
 * ("no comparison page for these two") with links to both items.
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/ui/PageHeader.astro';
import BrowseBar, { type FilterGroup } from '~/components/ui/BrowseBar.astro';
import SourceNote from '~/components/ui/SourceNote.astro';
import EmptyState from '~/components/ui/EmptyState.astro';
import Button from '~/components/ui/Button.astro';
import Icon from '~/components/ui/Icon.astro';
import AppIcon from '~/components/ui/AppIcon.astro';
import Shot from '~/components/media/Shot.astro';
import PairCard from '~/components/compare/PairCard.astro';
import ComparePicker, { type PickerGroup } from '~/components/compare/ComparePicker.astro';
import { api, isApiError } from '~/server/api';
import type { AppListItem, ComparisonLink, ThemeListItem } from '~/server/api/v1/types';
import { formatCount, formatDate } from '~/lib/format';
import { appPairLine, themePairLine } from '~/components/compare/compare';
import { shareOgSrc } from '~/lib/share-og';

const params = Astro.url.searchParams;

// ---- "Find a comparison" (GET handler) --------------------------------------------------------
const qa = params.get('a')?.trim().toLowerCase() ?? '';
const qb = params.get('b')?.trim().toLowerCase() ?? '';
let pickError: string | null = null;
let notCurated = false;
if (params.has('a') || params.has('b')) {
  const valid = (s: string) => /^[a-z0-9][a-z0-9.-]*$/.test(s);
  if (!qa || !qb) pickError = 'Choose two apps or two themes to compare.';
  else if (qa === qb) pickError = 'Pick two different ones.';
  else if (!valid(qa) || !valid(qb))
    pickError = 'We couldn’t find one of those. Pick from the lists.';
  else {
    try {
      const { data } = await api.getComparison({ pair: `${qa}-vs-${qb}` });
      return Astro.redirect(data.href, 302);
    } catch (err) {
      if (!isApiError(err)) throw err;
      if (err.code === 'not_found' && err.details?.some((d) => d.message === 'not_curated'))
        notCurated = true;
      else
        pickError =
          err.code === 'not_found'
            ? 'We couldn’t find one of those. Pick from the lists.'
            : err.code === 'bad_request' && /different/.test(err.message)
              ? 'Those are the same app. Pick two different ones.'
              : 'Compare two apps or two themes, not one of each.';
    }
  }
  // A pair without a page is "not found"; a malformed pick is a bad request.
  Astro.response.status = notCurated ? 404 : 400;
}

// ---- Data -----------------------------------------------------------------------------------
const kindParam = params.get('kind');
const kind = kindParam === 'app' || kindParam === 'theme' ? kindParam : null;
const groupParam = params.get('group');

const [{ data: list, meta }, appsPage1, { data: themes }] = await Promise.all([
  api.listComparisons({ limit: 200 }),
  api.listApps({ limit: 100, sort: 'usage' }),
  api.listThemes({ limit: 100, sort: 'usage' }),
]);
const apps: AppListItem[] = [...appsPage1.data.items];
let cursor = appsPage1.meta.pagination?.next_cursor ?? null;
while (cursor && apps.length < 1000) {
  const next = await api.listApps({ limit: 100, sort: 'usage', cursor });
  apps.push(...next.data.items);
  cursor = next.meta.pagination?.next_cursor ?? null;
}
const appBySlug = new Map(apps.map((a) => [a.slug, a]));
const themeBySlug = new Map(themes.items.map((t) => [t.slug, t]));

const all = list.items;

// Curated partners per slug (for the picker and the "no page" answer).
const pairs: Record<string, string[]> = {};
for (const c of all) {
  (pairs[c.a.slug] ??= []).push(c.b.slug);
  (pairs[c.b.slug] ??= []).push(c.a.slug);
}

// ---- Groups: app pairs by category (busiest first), theme pairs by reason ---------------------
interface PairGroup {
  key: string;
  kind: 'app' | 'theme';
  label: string;
  note: string;
  href?: string;
  linkLabel?: string;
  weight: number;
  links: ComparisonLink[];
}
const storesOf = (c: ComparisonLink, side: 'a' | 'b') =>
  c.kind === 'app'
    ? appBySlug.get(c[side].slug)?.usage.stores
    : themeBySlug.get(c[side].slug)?.usage.stores;
const groupMap = new Map<string, PairGroup>();
for (const c of all) {
  let key: string;
  let make: () => PairGroup;
  if (c.kind === 'app') {
    const cat = appBySlug.get(c.a.slug)?.category ?? appBySlug.get(c.b.slug)?.category ?? null;
    key = `apps-${cat?.slug ?? 'other'}`;
    make = () => ({
      key,
      kind: 'app',
      label: cat?.name ?? 'Other apps',
      note: 'Most used in the category',
      href: cat?.href,
      linkLabel: cat ? `All ${cat.name} apps` : undefined,
      weight: 0,
      links: [],
    });
  } else {
    const vendor = themeBySlug.get(c.a.slug)?.vendor_info ?? null;
    const same = c.reason === 'same-vendor' && vendor;
    key = same ? `themes-${vendor.slug}` : 'themes-most-used';
    make = () =>
      same
        ? {
            key,
            kind: 'theme',
            label: `${vendor.name} themes`,
            note: 'Same vendor',
            href: vendor.href,
            linkLabel: `More from ${vendor.name}`,
            weight: 0,
            links: [],
          }
        : {
            key,
            kind: 'theme',
            label: 'Most used themes',
            note: 'Top themes by usage',
            href: '/themes',
            linkLabel: 'All themes',
            weight: 0,
            links: [],
          };
  }
  const g = groupMap.get(key) ?? make();
  g.weight = Math.max(g.weight, storesOf(c, 'a') ?? 0, storesOf(c, 'b') ?? 0);
  g.links.push(c);
  groupMap.set(key, g);
}
// Groups with a single pair share one "more" group (each card names its category or vendor),
// so the page doesn't fill with near-empty rows.
const eyebrowOf = new Map<string, string>();
const merge = (groups: PairGroup[], into: Omit<PairGroup, 'links' | 'weight'>): PairGroup[] => {
  const singles = groups.filter((g) => g.links.length === 1);
  if (singles.length < 2) return groups;
  for (const g of singles)
    for (const c of g.links) eyebrowOf.set(c.slug, g.label.replace(/ themes$/, ''));
  return [
    ...groups.filter((g) => g.links.length > 1),
    {
      ...into,
      weight: Math.max(...singles.map((g) => g.weight)),
      links: singles.flatMap((g) => g.links),
    },
  ];
};
const appGroupsAll = merge(
  [...groupMap.values()].filter((g) => g.kind === 'app').sort((x, y) => y.weight - x.weight),
  {
    key: 'apps-more',
    kind: 'app',
    label: 'More categories',
    note: 'One popular pair each',
    href: '/apps/categories',
    linkLabel: 'All app categories',
  },
);
const themeGroupsAll = merge(
  [...groupMap.values()].filter((g) => g.kind === 'theme'),
  {
    key: 'themes-same-vendor',
    kind: 'theme',
    label: 'Same vendor',
    note: 'Two themes from one maker',
    href: '/themes',
    linkLabel: 'All themes',
  },
);
for (const g of [...appGroupsAll, ...themeGroupsAll]) groupMap.set(g.key, g);
const groupSel = groupParam && groupMap.has(groupParam) ? groupParam : null;
const inKind = (g: PairGroup) => !kind || g.kind === kind;
const inGroup = (g: PairGroup) => !groupSel || g.key === groupSel;
const appGroups = appGroupsAll.filter((g) => inKind(g) && inGroup(g));
const themeGroups = themeGroupsAll.filter((g) => inKind(g) && inGroup(g));
const shownCount = [...appGroups, ...themeGroups].reduce((n, g) => n + g.links.length, 0);
const counts = {
  all: all.length,
  app: all.filter((c) => c.kind === 'app').length,
  theme: all.filter((c) => c.kind === 'theme').length,
};

const cardFor = (c: ComparisonLink) => {
  if (c.kind === 'app') {
    const a = appBySlug.get(c.a.slug);
    const b = appBySlug.get(c.b.slug);
    return {
      a: {
        name: a?.short_name ?? c.a.name,
        iconUrl: c.a.icon_url,
        kind: 'app',
        slug: c.a.slug,
        stores: a?.usage.stores,
      },
      b: {
        name: b?.short_name ?? c.b.name,
        iconUrl: c.b.icon_url,
        kind: 'app',
        slug: c.b.slug,
        stores: b?.usage.stores,
      },
      line: a && b ? appPairLine(a, b) : c.title,
      preview: null,
    };
  }
  const a = themeBySlug.get(c.a.slug);
  const b = themeBySlug.get(c.b.slug);
  const shot = (t?: ThemeListItem) => t?.previews[0] ?? null;
  return {
    a: { name: a?.name ?? c.a.name, kind: 'theme', slug: c.a.slug, stores: a?.usage.stores },
    b: { name: b?.name ?? c.b.name, kind: 'theme', slug: c.b.slug, stores: b?.usage.stores },
    line: a && b ? themePairLine(a, b) : c.title,
    preview: { a: shot(a), b: shot(b) },
  };
};

// ---- URLs (all state is in the URL) ---------------------------------------------------------
const hrefWith = (next: { kind?: string | null; group?: string | null }) => {
  const u = new URLSearchParams();
  const k = next.kind === undefined ? kind : next.kind;
  const g = next.group === undefined ? groupSel : next.group;
  if (k) u.set('kind', k);
  if (g) u.set('group', g);
  const s = u.toString();
  return s ? `/compare?${s}` : '/compare';
};
const groupsForBar: FilterGroup[] = [
  {
    key: 'kind',
    label: 'Kind',
    options: [
      { label: 'All', href: hrefWith({ kind: null }), selected: !kind, count: counts.all },
      {
        label: 'Apps',
        href: hrefWith({
          kind: 'app',
          group: groupSel?.startsWith('themes-') ? null : undefined,
        }),
        selected: kind === 'app',
        count: counts.app,
      },
      {
        label: 'Themes',
        href: hrefWith({ kind: 'theme', group: groupSel?.startsWith('apps-') ? null : undefined }),
        selected: kind === 'theme',
        count: counts.theme,
      },
    ],
  },
  {
    key: 'group',
    label: 'Category',
    options: [
      { label: 'All categories', href: hrefWith({ group: null }), selected: !groupSel },
      ...[...appGroupsAll, ...themeGroupsAll].filter(inKind).map((g) => ({
        label: g.label,
        href: hrefWith({ group: g.key }),
        selected: g.key === groupSel,
        count: g.links.length,
      })),
    ],
  },
];

// ---- Picker options: themes first (short list), then apps by category ------------------------
const pickerGroups: PickerGroup[] = [
  {
    label: 'Themes',
    options: themes.items.map((t) => ({
      value: t.slug,
      label: t.name,
      kind: 'theme' as const,
      meta: t.vendor ? `Theme · ${t.vendor}` : 'Theme',
    })),
  },
];
const byCat = new Map<string, AppListItem[]>();
for (const a of apps) {
  const k = a.category?.name ?? 'Other apps';
  byCat.set(k, [...(byCat.get(k) ?? []), a]);
}
for (const [label, items] of [...byCat.entries()].sort((x, y) => x[0].localeCompare(y[0]))) {
  pickerGroups.push({
    label: `Apps · ${label}`,
    options: items
      .slice()
      .sort((x, y) => x.short_name.localeCompare(y.short_name))
      .map((a) => ({
        value: a.slug,
        label: a.short_name,
        kind: 'app' as const,
        icon: a.icon_url,
        meta: a.category?.name ?? 'App',
      })),
  });
}

// ---- "No comparison page" answer ---------------------------------------------------------------
interface Picked {
  slug: string;
  name: string;
  href: string;
  kind: 'app' | 'theme';
  icon: string | null;
  meta: string;
}
const picked = (slug: string): Picked | null => {
  const a = appBySlug.get(slug);
  if (a)
    return {
      slug,
      name: a.short_name,
      href: a.href,
      kind: 'app',
      icon: a.icon_url,
      meta: a.category?.name ?? 'App',
    };
  const t = themeBySlug.get(slug);
  if (t)
    return {
      slug,
      name: t.name,
      href: t.href,
      kind: 'theme',
      icon: null,
      meta: t.vendor ? `Theme by ${t.vendor}` : 'Theme',
    };
  return null;
};
const answer = notCurated
  ? (() => {
      const pa = picked(qa);
      const pb = picked(qb);
      const related = all
        .filter((c) => [qa, qb].includes(c.a.slug) || [qa, qb].includes(c.b.slug))
        .slice(0, 4);
      return { pa, pb, related };
    })()
  : null;

const asOf = formatDate(meta.data_as_of);
const denominator = apps[0]?.usage.denominator ?? themes.items[0]?.usage.denominator ?? 0;
const scan = Object.entries(meta.sources).find(([k]) => k.startsWith('storepeek-scan'))?.[1];
const jsonLd = [
  {
    '@type': 'CollectionPage',
    name: 'Compare Shopify apps and themes',
    description: 'Popular side-by-side comparisons of Shopify apps and themes on real stores.',
  },
  {
    '@type': 'ItemList',
    name: 'Popular comparisons',
    numberOfItems: all.length,
    itemListElement: all.slice(0, 50).map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.title,
      url: new URL(c.href, Astro.site ?? Astro.url).href,
    })),
  },
];

if (!pickError && !notCurated)
  Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=600');
else Astro.response.headers.set('Cache-Control', 'no-store');
const groupId = (g: PairGroup) => `g-${g.key}`;
---

<BaseLayout
  title="Compare Shopify apps and themes"
  description={`Popular pairs of Shopify apps and themes, side by side on real stores: where each renders, App Store facts and how many of ${formatCount(denominator)} scanned stores run them. No winners, just evidence.`}
  canonical="/compare"
  noindex={!!kind || !!groupSel || !!pickError || notCurated}
  jsonLd={jsonLd}
  ogImage={shareOgSrc('compare')}
  ogImageAlt="Compare apps and themes on real stores"
>
  <div class="container cmpi">
    <PageHeader title="Comparisons" count={counts.all}>
      <div class="cmpi__find">
        <ComparePicker
          groups={pickerGroups}
          pairs={pairs}
          a={qa || null}
          b={qb || null}
          error={pickError}
        />
        {answer && (
          <section class="cmpi__answer" aria-labelledby="no-page" role="status">
            <div class="cmpi__answer-head">
              <Icon name="info" size={20} />
              <div>
                <h2 id="no-page" class="cmpi__answer-title">
                  {answer.pa && answer.pb
                    ? `There’s no comparison page for ${answer.pa.name} and ${answer.pb.name}.`
                    : 'There’s no comparison page for that pair.'}
                </h2>
                <p class="cmpi__answer-body">
                  We only publish comparisons for popular pairs, so every page has enough real data
                  behind it. Each one still has its own page:
                </p>
              </div>
            </div>
            {answer.pa && answer.pb && (
              <ul class="cmpi__answer-items">
                {[answer.pa, answer.pb].map((p) => (
                  <li>
                    <a href={p.href} class="cmpi__item">
                      <AppIcon src={p.icon} name={p.name} size={36} />
                      <span class="cmpi__item-text">
                        <span class="cmpi__item-name">{p.name}</span>
                        <span class="cmpi__item-meta">{p.meta}</span>
                      </span>
                      <span class="cmpi__item-go">
                        {p.kind === 'app' ? 'App page' : 'Theme page'}
                        <Icon name="arrow-right" size={14} />
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            )}
            {answer.related.length > 0 && (
              <div class="cmpi__answer-rel">
                <p class="eyebrow">Comparisons that exist</p>
                <ul>
                  {answer.related.map((c) => (
                    <li>
                      <a href={c.href}>{c.title}</a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </section>
        )}
      </div>
    </PageHeader>

    <BrowseBar
      groups={groupsForBar}
      pills="kind"
      total={shownCount}
      noun={shownCount === 1 ? 'pair' : 'pairs'}
      clearHref="/compare"
    />

    {shownCount === 0 ? (
      <div class="page-block">
        <EmptyState
          title="No popular pairs in this view"
          body="This filter has no curated comparisons. Clear it to see every pair."
          align="start"
        >
          <Button href="/compare" variant="secondary">
            All comparisons
          </Button>
        </EmptyState>
      </div>
    ) : (
      [
        { id: 'cmpi-apps', label: 'Apps', groups: appGroups, n: counts.app },
        { id: 'cmpi-themes', label: 'Themes', groups: themeGroups, n: counts.theme },
      ]
        .filter((k) => k.groups.length > 0)
        .map((k) => (
          <section class="cmpi__kind" aria-labelledby={k.id}>
            <div class="cmpi__kind-head">
              <h2 id={k.id} class="h2">
                {k.label === 'Apps' ? 'App pairs' : 'Theme pairs'}
                <span class="cmpi__kind-n num">{k.n}</span>
              </h2>
            </div>
            {k.groups.map((g) => (
              <section class="cmpi__group" aria-labelledby={groupId(g)}>
                <div class="cmpi__ghead">
                  <h3 id={groupId(g)} class="cmpi__gtitle">
                    {g.label}
                  </h3>
                  <p class="cmpi__gnote">
                    {`${g.links.length} ${g.links.length === 1 ? 'pair' : 'pairs'} · ${g.note}`}
                  </p>
                  {g.href && (
                    <a class="cmpi__glink" href={g.href}>
                      {g.linkLabel}
                      <Icon name="arrow-right" size={14} />
                    </a>
                  )}
                </div>
                <ul class:list={['cmpi__grid', { 'cmpi__grid--one': g.links.length === 1 }]}>
                  {g.links.map((c) => {
                    const card = cardFor(c);
                    return (
                      <li>
                        <PairCard
                          href={c.href}
                          a={card.a}
                          b={card.b}
                          line={card.line}
                          shared={c.shared_stores ?? null}
                          sharedVerb={c.kind === 'app' ? 'run' : 'ran'}
                          eyebrow={eyebrowOf.get(c.slug)}
                          marks={!card.preview}
                          level={4}
                        >
                          {card.preview && (card.preview.a || card.preview.b) && (
                            <div slot="media" class="cmpi__shots">
                              {(['a', 'b'] as const).map((side) => {
                                const p = card.preview![side];
                                return p ? (
                                  <Shot
                                    src={p.image.src}
                                    width={p.image.width}
                                    height={p.image.height}
                                    device="desktop"
                                    ratio="5 / 4"
                                    flush
                                    alt={`${card[side].name} on a curated store, home page`}
                                  />
                                ) : (
                                  <div class="cmpi__shot-none">No capture yet</div>
                                );
                              })}
                              <span class="cmpi__shots-vs" aria-hidden="true">
                                vs
                              </span>
                            </div>
                          )}
                        </PairCard>
                      </li>
                    );
                  })}
                </ul>
              </section>
            ))}
          </section>
        ))
    )}

    <footer class="cmpi__foot">
      <SourceNote
        source={`${scan?.label ?? 'Our scan of public storefronts'}. Pairs are ordered by usage, not quality; data as of ${asOf}`}
      />
      <a class="cmpi__alts" href="/alternatives">
        Looking for a replacement instead? Browse alternatives
        <Icon name="arrow-right" size={14} />
      </a>
    </footer>
  </div>
</BaseLayout>

<style>
  .cmpi {
    padding-bottom: var(--section-y-app);
  }
  .cmpi__find {
    max-width: 920px;
    margin-top: var(--space-8);
  }

  /* "No comparison page" answer */
  .cmpi__answer {
    margin-top: var(--space-4);
    padding: var(--space-5);
    border-radius: var(--radius-card);
    background: var(--bg-subtle);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .cmpi__answer-head {
    display: grid;
    grid-template-columns: 20px minmax(0, 1fr);
    gap: var(--space-3);
    color: var(--ink-2);
  }
  .cmpi__answer-head > :global(.icon) {
    margin-top: 2px;
    color: var(--ink);
  }
  .cmpi__answer-title {
    color: var(--ink);
    font-size: var(--text-h4);
    font-weight: var(--weight-strong);
    line-height: 1.4;
  }
  .cmpi__answer-body {
    margin-top: 4px;
    color: var(--ink-2);
    font-size: var(--text-ui);
    line-height: 1.5;
  }
  .cmpi__answer-items {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }
  .cmpi__item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 56px;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-control);
    background: var(--surface);
    box-shadow:
      inset 0 0 0 1px var(--line),
      var(--shadow-xs);
    transition: box-shadow var(--dur-base) var(--ease-out);
  }
  .cmpi__item:hover {
    box-shadow:
      inset 0 0 0 1px var(--line-strong),
      var(--shadow-sm);
  }
  .cmpi__item-text {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
  }
  .cmpi__item-name {
    font-weight: var(--weight-medium);
  }
  .cmpi__item-meta {
    color: var(--ink-3);
    font-size: var(--text-xs);
  }
  .cmpi__item-go {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 6px;
    color: var(--ink-2);
    font-size: var(--text-sm);
  }
  .cmpi__item:hover .cmpi__item-go :global(.icon) {
    transform: translateX(2px);
  }
  .cmpi__item-go :global(.icon) {
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .cmpi__answer-rel {
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }
  .cmpi__answer-rel ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }
  .cmpi__answer-rel a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 0 12px;
    border-radius: var(--radius-pill);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line-strong);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }
  .cmpi__answer-rel a:hover {
    background: var(--surface-2);
  }

  /* Groups */
  .cmpi__kind {
    margin-top: var(--space-10);
  }
  .cmpi__kind + .cmpi__kind {
    margin-top: var(--space-16);
  }
  .cmpi__kind-head {
