---
/**
 * /compare/<a>-vs-<b> — two apps or two themes side by side. Only curated popular pairs have a
 * page (the API 404s any other pair with details[0].message = "not_curated"); a reversed
 * curated pair 301s to the canonical slug; unknown, identical or mixed (app + theme) pairs are
 * 404s too.
 *
 * Composition: both products facing each other → "Seen on" captures with pinned tags → the
 * fact matrix → overlap (stores using both) → plans or price → a verdict-free summary of the
 * facts → more comparisons and alternatives.
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/ui/Breadcrumbs.astro';
import SectionHeader from '~/components/ui/SectionHeader.astro';
import SourceNote from '~/components/ui/SourceNote.astro';
import Icon from '~/components/ui/Icon.astro';
import AppIcon from '~/components/ui/AppIcon.astro';
import CompareHead from '~/components/compare/CompareHead.astro';
import Stage from '~/components/compare/Stage.astro';
import FactMatrix, { type ExtraRow } from '~/components/compare/FactMatrix.astro';
import Diptych from '~/components/compare/Diptych.astro';
import PlanList from '~/components/compare/PlanList.astro';
import ThemeSpec from '~/components/compare/ThemeSpec.astro';
import Overlap, { type SharedStoreRow } from '~/components/compare/Overlap.astro';
import PairCard from '~/components/compare/PairCard.astro';
import { api, isApiError } from '~/server/api';
import type {
  AppListItem,
  ComparisonDetail,
  ResponseMeta,
  StoreListItem,
  ThemeListItem,
} from '~/server/api/v1/types';
import { formatCount, formatDate } from '~/lib/format';
import {
  appPairLine,
  appStage,
  factSentences,
  pluralStores,
  sides,
  themePairLine,
  themeStage,
} from '~/components/compare/compare';

const pair = Astro.params.pair ?? '';
let cmp: ComparisonDetail;
let meta: ResponseMeta;
try {
  ({ data: cmp, meta } = await api.getComparison({ pair }));
} catch (err) {
  // Two real items without a curated page: answer like the picker does ("there's no comparison
  // page for these two", links to both), still with a 404 status.
  if (
    isApiError(err) &&
    err.code === 'not_found' &&
    err.details?.some((d) => d.message === 'not_curated')
  ) {
    const [pa = '', pb = ''] = pair.split('-vs-');
    return Astro.rewrite(`/compare?a=${encodeURIComponent(pa)}&b=${encodeURIComponent(pb)}`);
  }
  // Unknown slugs (404), mixed kinds or the same item twice (400) and malformed pairs are all
  // "no such page" for a visitor.
  if (isApiError(err) && err.status < 500) return Astro.rewrite('/404');
  throw err;
}
if (!cmp.is_canonical) return Astro.redirect(`${cmp.href}${Astro.url.search}`, 301);

Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=600');

const [a, b] = sides(cmp);
const isApp = cmp.kind === 'app';
const scanKey =
  Object.keys(meta.sources).find((k) => k.startsWith('storepeek-scan')) ?? 'storepeek-scan';
const scan = meta.sources[scanKey];

// ---- Seen on ----------------------------------------------------------------------------------
const stage = cmp.apps
  ? appStage(cmp.apps.a, cmp.apps.b)
  : themeStage(cmp.themes!.a, cmp.themes!.b);
const qPage = Astro.url.searchParams.get('page');
const qDevice = Astro.url.searchParams.get('device');

// ---- Extra fact rows (from our scan, same source as the matrix's usage rows) ------------------
const extra: ExtraRow[] = [];
if (cmp.apps) {
  const other = { a: b.slug, b: a.slug };
  const top = (side: 'a' | 'b') => {
    const c = cmp.apps![side].co_installed.find((x) => x.app.slug !== other[side]);
    return c ? `${c.app.short_name} (${formatCount(c.stores)})` : undefined;
  };
  const theme = (side: 'a' | 'b') => {
    const t = cmp.apps![side].themes[0];
    return t ? `${t.theme.name} (${formatCount(t.stores)})` : undefined;
  };
  extra.push(
    {
      source: scanKey,
      label: 'Run both',
      help: 'Scanned stores running both right now',
      both: pluralStores(cmp.shared_stores.total),
    },
    {
      source: scanKey,
      label: 'Most often installed with',
      help: 'The app most often found next to it',
      a: top('a'),
      b: top('b'),
    },
    {
      source: scanKey,
      label: 'Most common theme',
      help: 'The theme its stores run most',
      a: theme('a'),
      b: theme('b'),
    },
  );
} else {
  const latest = (side: 'a' | 'b') =>
    cmp
      .themes![side].versions.map((v) => v.version)
      .filter((v): v is string => !!v)
      .sort((x, y) => y.localeCompare(x, 'en', { numeric: true }))[0];
  const topApp = (side: 'a' | 'b') => {
    const t = cmp.themes![side];
    const x = t.top_apps[0];
    return x
      ? `${x.app.short_name} (${formatCount(x.stores)} of ${formatCount(t.theme.usage.stores)})`
      : undefined;
  };
  extra.push(
    {
      source: scanKey,
      label: 'Ran both',
      help: 'Stores seen on both themes at some point',
      both: pluralStores(cmp.shared_stores.total),
    },
    {
      source: scanKey,
      label: 'Latest version seen',
      help: 'Highest version detected on a live store',
      a: latest('a'),
      b: latest('b'),
    },
    {
      source: scanKey,
      label: 'Most used app on its stores',
      help: 'The app its stores run most',
      a: topApp('a'),
      b: topApp('b'),
    },
  );
}
const appStoreChecked = cmp.apps ? (cmp.apps.a.app.checked_on ?? cmp.apps.b.app.checked_on) : null;
const notes: Record<string, string> = {};
for (const key of Object.keys(meta.sources)) {
  if (key.startsWith('shopify-app-store') && appStoreChecked)
    notes[key] = `Shopify App Store listings, checked ${formatDate(appStoreChecked)}`;
}

// ---- Shared stores, enriched with list data (theme, market, apps) where we have it -----------
// One lookup of exactly the stores shown; listStores defaults to the curated stores, overlap is
// about every detected store (scope all).
const sharedDomains = cmp.shared_stores.items.map((s) => s.domain);
const lookups =
  sharedDomains.length > 0
    ? await api
        .listStores({
          domains: sharedDomains,
          scope: 'all',
          limit: sharedDomains.length,
          facets: false,
        })
        .then((r) => r.data.items)
        .catch(() => [] as StoreListItem[])
    : [];
const storeInfo = new Map(lookups.map((s) => [s.domain, s]));
const sharedRows: SharedStoreRow[] = cmp.shared_stores.items.map((s) => {
  const info = storeInfo.get(s.domain);
  return {
    domain: s.domain,
    name: s.display_name,
    href: s.href,
    theme: info?.theme.label ?? null,
    market: info ? [info.country, info.currency].filter(Boolean).join(' · ') || null : null,
    apps: info?.app_count ?? null,
  };
});

// ---- Related (curated pairs only) -------------------------------------------------------------
// One list call gives usage and listing facts for exactly the apps/themes in the related pairs,
// so the cards read like the ones on the compare index.
const relatedApps = new Map<string, AppListItem>();
const relatedThemes = new Map<string, ThemeListItem>();
const relatedSlugs = [...new Set(cmp.related.flatMap((r) => [r.a.slug, r.b.slug]))];
if (relatedSlugs.length > 0) {
  const lookup = { slugs: relatedSlugs, limit: 100, facets: false };
  if (cmp.apps) {
    const r = await api.listApps(lookup).catch(() => null);
    for (const x of r?.data.items ?? []) relatedApps.set(x.slug, x);
  } else {
    const r = await api.listThemes(lookup).catch(() => null);
    for (const x of r?.data.items ?? []) relatedThemes.set(x.slug, x);
  }
}
// Titles are "<short A> vs <short B>"; entity refs carry full listing names.
const related = cmp.related.map((r) => {
  const [na, nb] = r.title.split(' vs ');
  const appA = relatedApps.get(r.a.slug);
  const appB = relatedApps.get(r.b.slug);
  const thA = relatedThemes.get(r.a.slug);
  const thB = relatedThemes.get(r.b.slug);
  const line =
    appA && appB
      ? appPairLine(appA, appB)
      : thA && thB
        ? themePairLine(thA, thB)
        : r.shared_stores
          ? `${pluralStores(r.shared_stores)} ${isApp ? 'run' : 'ran'} both`
          : 'Side by side on real stores';
  return {
    href: r.href,
    a: {
      name: na ?? r.a.name,
      iconUrl: r.a.icon_url,
      stores: appA?.usage.stores ?? thA?.usage.stores ?? null,
    },
    b: {
      name: nb ?? r.b.name,
      iconUrl: r.b.icon_url,
      stores: appB?.usage.stores ?? thB?.usage.stores ?? null,
    },
    shared: r.shared_stores ?? null,
    line,
  };
});

// ---- JSON-LD ----------------------------------------------------------------------------------
const abs = (path: string) => new URL(path, Astro.site ?? Astro.url).href;
const jsonLd = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: 'Compare', item: abs('/compare') },
      { '@type': 'ListItem', position: 3, name: cmp.title, item: abs(cmp.href) },
    ],
  },
  {
    '@type': 'ItemList',
    name: cmp.title,
    numberOfItems: 2,
    itemListElement: [a, b].map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': isApp ? 'SoftwareApplication' : 'CreativeWork',
        name: s.fullName,
        url: abs(s.href),
        ...(isApp
          ? { applicationCategory: 'BusinessApplication', operatingSystem: 'Shopify' }
          : {}),
        ...(s.maker ? { author: { '@type': 'Organization', name: s.maker } } : {}),
      },
    })),
  },
];
const description = `${cmp.title}: ${isApp ? 'where each app renders on real Shopify stores' : 'the same pages on real stores using each theme'}, ${isApp ? 'ratings, plans' : 'prices, versions'} and how many of ${formatCount(a.denominator)} scanned stores run them. Facts only, no winner.`;
const sections: Array<[string, string]> = [
  ['stage', 'Seen on'],
  ['facts', 'Facts'],
  ['overlap', 'Overlap'],
  ...(cmp.themes && cmp.shared_apps.length > 0 ? [['stacks', 'Apps'] as [string, string]] : []),
  ['pricing', isApp ? 'Plans' : 'Price'],
  ['summary', 'In short'],
];
---

<BaseLayout
  title={`${cmp.title}: side by side on real stores`}
  description={description}
  canonical={cmp.href}
  jsonLd={jsonLd}
>
  <div class="container">
    <Breadcrumbs
      class="cmp__crumbs"
      items={[
        { label: 'Home', href: '/' },
        { label: 'Compare', href: '/compare' },
        { label: cmp.title },
      ]}
    />
    <CompareHead cmp={cmp} meta={meta} sections={sections} />
  </div>

  <div class="cmp__stage">
    <Stage model={stage} a={a} b={b} page={qPage} device={qDevice} />
  </div>

  <div class="container cmp">
    <section class="cmp__block" id="facts" aria-labelledby="facts-title">
      <SectionHeader
        id="facts-title"
        title="The listing and our scan, row by row"
        description="Check marks are facts, not points. Nothing here is scored or added up."
      />
      <FactMatrix rows={cmp.matrix} meta={meta} a={a} b={b} extra={extra} notes={notes} />
    </section>

    <section class="cmp__block" id="overlap" aria-labelledby="overlap-title">
      <SectionHeader
        id="overlap-title"
        title={isApp ? 'Stores running both' : 'Stores that ran both'}
        count={cmp.shared_stores.total}
        description={
          isApp
            ? `Of ${formatCount(a.denominator)} scanned stores, how many run one, the other, or both at the same time.`
            : 'Stores we have seen on both themes, and how many run each one now.'
        }
      />
      <Overlap
        a={a}
        b={b}
        total={cmp.shared_stores.total}
        rows={sharedRows}
        source={scan?.label ?? 'Our scan'}
      />
    </section>

    {cmp.themes && cmp.shared_apps.length > 0 && (
      <section class="cmp__block" id="stacks" aria-labelledby="stacks-title">
        <SectionHeader
          id="stacks-title"
          title="Apps used on both themes"
          count={cmp.shared_apps.length}
          description={`What stores add on top of ${a.name} or ${b.name}, by number of stores on each.`}
        />
        <table class="table cmp__apps">
          <caption class="visually-hidden">{`Apps used on both ${a.name} and ${b.name}`}</caption>
          <thead>
            <tr>
              <th scope="col">App</th>
              <th scope="col" class="cmp__opt">
                Category
              </th>
              <th scope="col" class="is-num">
                {`On ${a.name}`}
              </th>
              <th scope="col" class="is-num">
                {`On ${b.name}`}
              </th>
            </tr>
          </thead>
          <tbody>
            {cmp.shared_apps.map((s) => (
              <tr>
                <td>
                  <a href={s.app.href} class="cmp__app">
                    <AppIcon src={s.app.icon_url} name={s.app.short_name} size={24} />
                    <span>{s.app.short_name}</span>
                  </a>
                </td>
                <td class="cmp__opt cmp__muted">{s.app.category?.name ?? '—'}</td>
                <td class="is-num num">{formatCount(s.a_stores)}</td>
                <td class="is-num num">{formatCount(s.b_stores)}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <SourceNote source={scan?.label ?? 'Our scan'} class="cmp__note" />
      </section>
    )}

    <section class="cmp__block" id="pricing" aria-labelledby="pricing-title">
      <SectionHeader
        id="pricing-title"
        title={isApp ? 'Plans side by side' : 'Price and versions'}
        description={
          isApp
            ? `As listed on the Shopify App Store${appStoreChecked ? `, checked ${formatDate(appStoreChecked)}` : ''}. Prices in USD.`
            : 'List price from the vendor, and the versions we detect on live stores.'
        }
      />
      <Diptych labels={[a.name, b.name]} name="cmp-plans">
        {(['a', 'b'] as const).map((side) => (
          <div slot={side}>
            {cmp.apps ? (
              <PlanList app={cmp.apps[side].app} />
            ) : (
              <ThemeSpec detail={cmp.themes![side]} />
            )}
          </div>
        ))}
      </Diptych>
    </section>

    <section class="cmp__block cmp__summary" id="summary" aria-labelledby="summary-title">
      <div class="cmp__summary-main">
        <SectionHeader
          id="summary-title"
          title="What the data says"
          description="The facts above in plain sentences. Which one fits depends on your store; we don’t pick."
        />
        <ul class="cmp__facts">
          {factSentences(cmp).map((f) => (
            <li>
              <span class="cmp__dot" aria-hidden="true" />
              <span>{f}</span>
            </li>
          ))}
        </ul>
        <SourceNote
          class="cmp__note"
          source={
            isApp
              ? `${scan?.label ?? 'our scan'}; ratings, plans and prices from each Shopify App Store listing${appStoreChecked ? `, checked ${formatDate(appStoreChecked)}` : ''}`
              : `${scan?.label ?? 'our scan'}; prices and vendors are editorial, from each theme’s listing`
          }
        />
      </div>
      <nav class="cmp__alts" aria-label="Alternatives">
        <p class="eyebrow">Looking for a replacement?</p>
        {[a, b].map((s) => (
          <a href={s.alternativesHref} class="cmp__alt">
            <AppIcon src={s.iconUrl} name={s.name} size={32} />
            <span class="cmp__alt-text">
              <span class="cmp__alt-k">Alternatives to</span>
              <span class="cmp__alt-name">{s.name}</span>
            </span>
            <Icon name="arrow-right" size={16} />
          </a>
        ))}
      </nav>
    </section>

    <section class="cmp__block" aria-labelledby="next-title">
      <SectionHeader
        id="next-title"
        title={related.length > 0 ? 'Related comparisons' : 'More comparisons'}
        href="/compare"
        linkLabel="All comparisons"
      />
      {related.length > 0 ? (
        <ul class="cmp__related">
          {related.map((r) => (
            <li>
              <PairCard
                href={r.href}
                a={r.a}
                b={r.b}
                line={r.line}
                shared={r.shared}
                sharedVerb={isApp ? 'run' : 'ran'}
                level={3}
              />
            </li>
          ))}
        </ul>
      ) : (
        <p class="cmp__muted">
          No other popular comparisons with these two yet. Every curated pair is on the compare
          index.
        </p>
      )}
    </section>
  </div>
</BaseLayout>

<style>
  .cmp__crumbs {
    padding-top: var(--space-6);
  }
  .cmp__stage {
    margin-top: var(--space-10);
  }
  .cmp {
    padding-bottom: var(--section-y-app);
  }
  .cmp__block {
    padding-top: var(--space-12);
    scroll-margin-top: calc(var(--header-h) + 48px);
  }
  .cmp__block + .cmp__block {
    margin-top: var(--space-4);
  }
  .cmp :global(.cmp__note) {
    margin-top: var(--space-5);
  }
  .cmp__muted {
    color: var(--ink-3);
    font-size: var(--text-ui);
  }
  .cmp__opt {
    display: none;
  }
  .cmp__apps {
    table-layout: fixed;
  }
  .cmp__apps th:nth-child(3),
  .cmp__apps th:nth-child(4) {
    width: 26%;
  }
  .cmp__app {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-width: 0;
    font-weight: var(--weight-medium);
  }
  .cmp__app span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .cmp__app:hover span {
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
  }
  .cmp__muted,
  td.cmp__muted {
    color: var(--ink-2);
  }

  /* In short */
  .cmp__summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-8);
  }
  .cmp__facts {
    display: grid;
    gap: var(--space-3);
    max-width: 720px;
  }
  .cmp__facts li {
    display: grid;
    grid-template-columns: 14px minmax(0, 1fr);
    gap: var(--space-3);
    color: var(--ink-2);
    font-size: var(--text-body);
    line-height: 1.6;
  }
  .cmp__dot {
    width: 6px;
    height: 6px;
    margin-top: 0.62em;
    border-radius: 50%;
    background: var(--ink-3);
  }
  .cmp__alts {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .cmp__alts .eyebrow {
    margin-bottom: var(--space-1);
  }
  .cmp__alt {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 64px;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-card);
    background: var(--surface);
    box-shadow:
      inset 0 0 0 1px var(--line),
      var(--shadow-xs),
      var(--highlight);
    color: var(--ink-3);
    transition:
      box-shadow var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }
  .cmp__alt:hover {
    box-shadow:
      inset 0 0 0 1px var(--line-strong),
      var(--shadow-md),
      var(--highlight);
    transform: translateY(-2px);
  }
  .cmp__alt :global(.icon) {
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .cmp__alt:hover :global(.icon) {
    color: var(--ink);
    transform: translateX(2px);
  }
  .cmp__alt-text {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
  }
  .cmp__alt-k {
    color: var(--ink-3);
    font-size: var(--text-xs);
  }
  .cmp__alt-name {
    overflow: hidden;
    color: var(--ink);
    font-weight: var(--weight-semibold);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .cmp__related {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
  }

  @media (min-width: 640px) {
    .cmp__opt {
      display: table-cell;
    }
    .cmp__related {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-4);
    }
  }
  @media (min-width: 1024px) {
    .cmp__stage {
      margin-top: var(--space-12);
    }
    .cmp__block {
      padding-top: var(--space-16);
    }
    .cmp__summary {
      grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
      gap: var(--space-12);
      align-items: start;
    }
    .cmp__alts {
      padding-top: var(--space-2);
    }
    .cmp__related {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
