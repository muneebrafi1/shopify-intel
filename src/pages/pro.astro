---
/**
 * Pro pricing (direction.md "Pricing"): centred two-tone header → Monthly / Yearly switch →
 * three plan cards (Pro recommended) → "Compare all features" with a sticky plan header row
 * (one plan column at a time below 640px) → FAQ → lifetime-deal band.
 *
 * Checkout runs on Whop: with WHOP_CHECKOUT_* links set, paid plan buttons open Whop's checkout
 * for the selected billing period (members then sign in with the same Whop account). Without
 * them the buttons go to /sign-in?next=/pro, which explains that accounts open with Pro. Both switches are URL state and work without JS
 * (?billing=yearly, ?compare=free|pro|team); with JS they switch in place and keep the URL
 * shareable. Plans and prices live in src/components/static/content.ts (OWNER: draft).
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import Badge from '~/components/ui/Badge.astro';
import Button from '~/components/ui/Button.astro';
import Card from '~/components/ui/Card.astro';
import Counter from '~/components/ui/Counter.astro';
import Icon from '~/components/ui/Icon.astro';
import Segmented from '~/components/ui/Segmented.astro';
import { CONTACT, SITE_NAME } from '~/config/site';
import { formatDate } from '~/lib/format';
import { loadMeta } from '~/components/static/meta';
import { whopConfig } from '~/server/account/env';
import {
  LIFETIME,
  MONTHLY_PRICE,
  PLAN_MATRIX,
  PLANS,
  YEARLY_FREE_MONTHS,
  YEARLY_LABEL,
  type Billing,
  type Cell,
  type Plan,
  type Price,
} from '~/components/static/content';

type PlanId = Plan['id'];
const params = Astro.url.searchParams;
const billing: Billing = params.get('billing') === 'yearly' ? 'yearly' : 'monthly';
const compareParam = params.get('compare');
const compare: PlanId =
  compareParam === 'free' || compareParam === 'team' || compareParam === 'pro'
    ? compareParam
    : 'pro';
Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=600');

const meta = await loadMeta();
const checkout = whopConfig().checkout;
const checkoutFor = (id: PlanId, b: Billing): string | null =>
  id === 'pro' || id === 'team' ? checkout[`${id}-${b}`] : null;
const checkoutOpen = !!(checkout['pro-monthly'] || checkout['pro-yearly']);
/** Plan button target and per-billing alternatives for the in-place switch. */
const ctaAttrs = (plan: Plan) => {
  const m = checkoutFor(plan.id, 'monthly');
  const y = checkoutFor(plan.id, 'yearly');
  if (!m && !y) return { href: plan.cta.href };
  return {
    href: (billing === 'yearly' ? y : m) ?? plan.cta.href,
    'data-href-monthly': m ?? plan.cta.href,
    'data-href-yearly': y ?? plan.cta.href,
  };
};

/** URL for a given state; defaults are left out so the canonical stays /pro. */
const stateHref = (b: Billing, c: PlanId, hash = '') => {
  const q = new URLSearchParams();
  if (b === 'yearly') q.set('billing', b);
  if (c !== 'pro') q.set('compare', c);
  const s = q.toString();
  return `/pro${s ? `?${s}` : ''}${hash}`;
};

const perLabel = (p: Price) => (p.per ? `/${p.per}` : '');
const shortPer = (p: Price) => (p.per === 'month' ? '/mo' : p.per === 'year' ? '/yr' : '');
const money = (n: number) => `$${Number.isInteger(n) ? n : n.toFixed(2)}`;
const priceText = (p: Price) => money(p.amount);

const yearlyOf = (monthly: number) => monthly * (12 - YEARLY_FREE_MONTHS);
const FAQ = [
  {
    q: 'When can I buy Pro?',
    a: checkoutOpen
      ? 'Now. Checkout runs on Whop; after paying, sign in here with the same Whop account and Pro is on. Cancel any time on Whop.'
      : 'Pro opens together with accounts. Checkout isn’t live yet, so nothing on this page can charge you. The prices here are the planned launch prices.',
  },
  {
    q: 'What stays free?',
    a: 'Home page screenshots of every store we capture, and the basic theme and app data: which theme a store runs and which apps we detected on it. No account needed.',
  },
  {
    q: 'How does yearly billing work?',
    a: `You pay for ten months and get twelve. Pro is ${money(yearlyOf(MONTHLY_PRICE.pro))} a year instead of ${money(MONTHLY_PRICE.pro * 12)}, and Team is ${money(yearlyOf(MONTHLY_PRICE.team))} instead of ${money(MONTHLY_PRICE.team * 12)}.`,
  },
  {
    q: 'How many people can use Team?',
    a: 'Three. Each person signs in with their own email, and boards are shared across the plan.',
  },
  {
    q: 'How will payment work?',
    a: 'Checkout, billing and memberships run on Whop. You will be able to cancel at any time before your next renewal, and we will publish the refund policy with the prices.',
  },
  {
    q: 'Does Pro change the data I see?',
    a: 'No. Detections, counts and rankings are the same for everyone. Pro adds depth: every page type, full-page and section screenshots, the full theme and app record, and exports.',
  },
  {
    q: 'Is the API part of Pro?',
    a: 'The public JSON API stays free within fair use, on every plan. A plan for heavy API and MCP use may come later.',
  },
  {
    q: 'Will you add revenue or traffic estimates?',
    a: 'No, on any plan. They can’t be measured honestly from outside a store, so we don’t publish them.',
  },
];

const cellText = (c: Cell) => (c === true ? 'Included' : c === false ? 'Not included' : c);

const site = Astro.site ?? Astro.url;
const abs = (path: string) => new URL(path, site).href;
const jsonLd = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: 'Pro', item: abs('/pro') },
    ],
  },
  {
    '@type': 'SoftwareApplication',
    name: SITE_NAME,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    url: abs('/pro'),
    offers: [
      { '@type': 'Offer', name: 'Free', price: '0', priceCurrency: 'USD' },
      {
        '@type': 'Offer',
        name: 'Pro monthly',
        price: String(MONTHLY_PRICE.pro),
        priceCurrency: 'USD',
      },
      {
        '@type': 'Offer',
        name: 'Pro yearly',
        price: String(yearlyOf(MONTHLY_PRICE.pro)),
        priceCurrency: 'USD',
      },
      {
        '@type': 'Offer',
        name: 'Team monthly',
        price: String(MONTHLY_PRICE.team),
        priceCurrency: 'USD',
      },
      {
        '@type': 'Offer',
        name: 'Team yearly',
        price: String(yearlyOf(MONTHLY_PRICE.team)),
        priceCurrency: 'USD',
      },
    ],
  },
  {
    '@type': 'FAQPage',
    mainEntity: FAQ.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
];
---

<BaseLayout
  title="Pro"
  description={`${SITE_NAME} pricing. Free: home page screenshots and basic theme and app data. Pro: every page type, full-page and section screenshots, CSV exports. Team: three seats. Planned launch prices.`}
  canonical="/pro"
  jsonLd={jsonLd}
>
  <div class="pro" data-billing={billing} data-compare={compare} data-pro>
    <div class="container guides pro__frame">
      <!-- ============================== Header ============================== -->
      <header class="pro-head bg-spotlight">
        {meta && (
          <Counter
            class="pro-head__counter"
            items={[
              { value: meta.counts.stores_scanned, label: 'stores' },
              { value: meta.counts.sections, label: 'sections tagged' },
            ]}
            asOf={formatDate(meta.data_as_of)}
          />
        )}
        <h1 class="display-lg pro-head__title">
          Free to browse.{' '}
          <span class="tone-muted">Pro for people who build stores for a living.</span>
        </h1>
        <p class="lead pro-head__lead">
          Pro opens every page type, full-page and section-by-section screenshots, and CSV exports.
          Team puts three seats on one plan.
        </p>
        <div class="billing" data-billing-toggle>
          <Segmented
            label="Billing period"
            items={[
              {
                label: 'Monthly',
                value: 'monthly',
                href: stateHref('monthly', compare),
                selected: billing === 'monthly',
              },
              {
                label: 'Yearly',
                value: 'yearly',
                href: stateHref('yearly', compare),
                selected: billing === 'yearly',
              },
            ]}
          />
          <Badge tone="accent" class="billing__badge">
            {YEARLY_LABEL}
          </Badge>
        </div>
      </header>

      <!-- ============================== Plans ============================== -->
      <section class="plans" aria-labelledby="plans-title">
        <h2 class="visually-hidden" id="plans-title">
          Plans
        </h2>
        <div class="plans__grid">
          {PLANS.map((plan, i) => {
            const now = plan.price[billing];
            return (
              <Card
                as="article"
                padding="lg"
                accent={!!plan.recommended}
                class:list={['plan reveal', { 'plan--rec': plan.recommended }]}
                style={`--reveal-delay: ${i * 70}ms`}
                data-plan={plan.id}
              >
                <div class="plan__head">
                  <h3 class="plan__name">{plan.name}</h3>
                  {plan.recommended && (
                    <Badge tone="accent" size="sm">
                      Recommended
                    </Badge>
                  )}
                </div>
                <p class="plan__for">{plan.forWho}</p>
                <p class="plan__price">
                  <span
                    class="plan__amount num"
                    data-price
                    data-monthly={priceText(plan.price.monthly)}
                    data-yearly={priceText(plan.price.yearly)}
                  >
                    {priceText(now)}
                  </span>
                  <span
                    class="plan__per"
                    data-per
                    data-monthly={perLabel(plan.price.monthly)}
                    data-yearly={perLabel(plan.price.yearly)}
                  >
                    {perLabel(now)}
                  </span>
                </p>
                <p
                  class="plan__note"
                  data-note
                  data-monthly={plan.price.monthly.note}
                  data-yearly={plan.price.yearly.note}
                >
                  {now.note}
                </p>
                <Button
                  {...ctaAttrs(plan)}
                  variant={plan.recommended ? 'accent' : 'secondary'}
                  size="lg"
                  full
                  rel={plan.id === 'free' ? undefined : 'nofollow'}
                  class="plan__cta"
                >
                  {plan.cta.label}
                </Button>
                <ul class="plan__features" aria-label={`${plan.name} includes`}>
                  {plan.features.map((f) => (
                    <li>
                      <Icon name="check-bold" size={14} class="plan__check" />
                      <span>{f}</span>
                    </li>
                  ))}
                </ul>
              </Card>
            );
          })}
        </div>
        <p class="plans__fine">
          Planned launch prices in USD. Checkout runs on Whop and isn’t open yet, so nothing here
          charges you.
        </p>
      </section>

      <!-- ============================== Compare ============================== -->
      <section class="cmp" id="compare" aria-labelledby="compare-title">
        <header class="cmp__head reveal">
          <h2 class="h2" id="compare-title">
            Compare all features
          </h2>
          <p class="cmp__sub">Everything in each plan, with what it means.</p>
        </header>

        <div class="cmp__bar" data-compare-bar>
          <div class="cmp__corner">
            <div class="cmp__switch" data-compare-toggle>
              <Segmented
                label="Plan to compare"
                full
                items={PLANS.map((p) => ({
                  label: p.name,
                  value: p.id,
                  href: stateHref(billing, p.id, '#compare'),
                  selected: compare === p.id,
                }))}
              />
            </div>
            <p class="cmp__corner-note">
              Prices{' '}
              <span data-monthly="billed monthly" data-yearly={`billed yearly, ${YEARLY_LABEL}`}>
                {billing === 'yearly' ? `billed yearly, ${YEARLY_LABEL}` : 'billed monthly'}
              </span>
            </p>
          </div>
          {PLANS.map((p) => (
            <div class:list={['cmp__plan', { 'cmp__plan--rec': p.recommended }]} data-col={p.id}>
              <p class="cmp__plan-name">
                {p.name}
                {p.recommended && <span class="cmp__dot" aria-hidden="true" />}
              </p>
              <p class="cmp__plan-price num">
                <span
                  data-monthly={priceText(p.price.monthly)}
                  data-yearly={priceText(p.price.yearly)}
                >
                  {priceText(p.price[billing])}
                </span>
                <span
                  class="cmp__plan-per"
                  data-monthly={shortPer(p.price.monthly)}
                  data-yearly={shortPer(p.price.yearly)}
                >
                  {shortPer(p.price[billing])}
                </span>
              </p>
              <Button
                {...ctaAttrs(p)}
                variant={p.recommended ? 'accent' : 'secondary'}
                size="sm"
                rel={p.id === 'free' ? undefined : 'nofollow'}
                class="cmp__plan-cta"
              >
                {p.cta.label}
              </Button>
            </div>
          ))}
        </div>

        <table class="cmp__table">
          <caption class="visually-hidden">What each plan includes</caption>
          <colgroup>
            <col class="cmp__col-label" />
            {PLANS.map((p) => (
              <col class="cmp__col-plan" data-col={p.id} />
            ))}
          </colgroup>
          <thead class="visually-hidden">
            <tr>
              <th scope="col">Feature</th>
              {PLANS.map((p) => (
                <th scope="col" data-col={p.id}>
                  {p.name}
                </th>
              ))}
            </tr>
          </thead>
          {PLAN_MATRIX.map((group) => (
            <tbody>
              <tr class="cmp__group">
                <th scope="colgroup" colspan={4}>
                  <span class="eyebrow">{group.group}</span>
                </th>
              </tr>
              {group.rows.map((row) => (
                <tr class="cmp__row">
                  <th scope="row">
                    <span class="cmp__label">{row.label}</span>
                    {row.note && <span class="cmp__note">{row.note}</span>}
                  </th>
                  {PLANS.map((p) => {
                    const c = row[p.id];
                    return (
                      <td data-col={p.id}>
                        {c === true ? (
                          <Icon name="check-bold" size={16} label="Included" class="cmp__yes" />
                        ) : c === false ? (
                          <span class="cmp__no">
                            <Icon name="minus" size={16} />
                            <span class="visually-hidden">Not included</span>
                          </span>
                        ) : (
                          <span
                            class:list={['cmp__val', { 'cmp__val--never': c === 'Never' }]}
                            title={cellText(c)}
                          >
                            {c}
                          </span>
                        )}
                      </td>
                    );
                  })}
                </tr>
              ))}
            </tbody>
          ))}
        </table>
      </section>

      <!-- ============================== FAQ ============================== -->
      <section class="faq" aria-labelledby="faq-title">
        <div class="faq__intro reveal">
          <h2 class="h2" id="faq-title">
            Questions
          </h2>
          <p class="faq__sub">
            Something else? Write to <a href={`mailto:${CONTACT.hello}`}>{CONTACT.hello}</a>.
          </p>
        </div>
        <div class="faq__list reveal" style="--reveal-delay: 80ms">
          {FAQ.map((item) => (
            <details class="disclosure faq__item">
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </section>

      <!-- ============================== Lifetime ============================== -->
      <section class="lifetime band reveal" data-theme="dark" aria-labelledby="lifetime-title">
        <div class="lifetime__text">
          <p class="lifetime__eyebrow">
            <span class="eyebrow">Launch offer</span>
            <Badge tone="outline" size="sm">
              Draft terms
            </Badge>
          </p>
          <h2 class="lifetime__title" id="lifetime-title">
            <span class="lifetime__price num">${LIFETIME.price}</span>
            <span>once, for Pro for life.</span>
          </h2>
          <p class="lifetime__body">
            For the first {LIFETIME.cap} accounts when checkout opens. One payment, no renewals, and
            everything we add to Pro later. The terms may change before launch.
          </p>
        </div>
        <div class="lifetime__cta">
          <Button href="/sign-in?next=/pro" variant="accent" size="lg" rel="nofollow" arrow>
            Get lifetime
          </Button>
          <p class="lifetime__fine">Opens with accounts. Nothing is charged today.</p>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  // Billing and compare switches: change in place (the links still work without JS), keep the
  // URL shareable, and keep every switch link pointing at the full current state.
  type PlanId = 'free' | 'pro' | 'team';
  const root = document.querySelector<HTMLElement>('[data-pro]');

  function hrefFor(billing: string, compare: string, hash = '') {
    const q = new URLSearchParams();
    if (billing === 'yearly') q.set('billing', billing);
    if (compare !== 'pro') q.set('compare', compare);
    const s = q.toString();
    return `/pro${s ? `?${s}` : ''}${hash}`;
  }

  function sync(root: HTMLElement) {
    const billing = root.dataset.billing === 'yearly' ? 'yearly' : 'monthly';
    const compare = (root.dataset.compare ?? 'pro') as PlanId;
    root.querySelectorAll<HTMLAnchorElement>('[data-billing-toggle] a[data-value]').forEach((a) => {
      const on = a.dataset.value === billing;
      if (on) a.setAttribute('aria-current', 'true');
      else a.removeAttribute('aria-current');
      a.href = hrefFor(a.dataset.value ?? 'monthly', compare);
    });
    root.querySelectorAll<HTMLAnchorElement>('[data-compare-toggle] a[data-value]').forEach((a) => {
      const on = a.dataset.value === compare;
      if (on) a.setAttribute('aria-current', 'true');
      else a.removeAttribute('aria-current');
      a.href = hrefFor(billing, a.dataset.value ?? 'pro', '#compare');
    });
    root
      .querySelectorAll<HTMLAnchorElement>('a[data-href-monthly][data-href-yearly]')
      .forEach((a) => {
        const next = billing === 'yearly' ? a.dataset.hrefYearly : a.dataset.hrefMonthly;
        if (next) a.href = next;
      });
    root.querySelectorAll<HTMLElement>('[data-monthly][data-yearly]').forEach((el) => {
      const next = el.dataset[billing];
      if (next !== undefined && el.textContent !== next) el.textContent = next;
    });
  }

  root?.addEventListener('click', (event) => {
    if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    const link = (event.target as Element | null)?.closest<HTMLAnchorElement>(
      '[data-billing-toggle] a[data-value], [data-compare-toggle] a[data-value]',
    );
    if (!link) return;
    event.preventDefault();
    const value = link.dataset.value ?? '';
    if (link.closest('[data-billing-toggle]')) root.dataset.billing = value;
    else root.dataset.compare = value;
    sync(root);
    const url = hrefFor(root.dataset.billing ?? 'monthly', root.dataset.compare ?? 'pro');
    history.replaceState(null, '', url + location.hash);
  });
</script>

<style>
  .pro__frame {
    padding-bottom: 0;
  }

  /* ---------------------------------------------------------------- Header (centred) */
  .pro-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: var(--space-12);
    text-align: center;
  }
  .pro-head :global(.pro-head__counter) {
    justify-content: center;
    margin-bottom: var(--space-6);
  }
  .pro-head__title {
    max-width: 780px;
  }
  @media (max-width: 639px) {
    /* Keep the counter on one line at 390: the data date is in the footer too. */
    .pro-head :global(.pro-head__counter .counter__item:nth-child(n + 4)) {
      display: none;
    }
  }
  .pro-head__lead {
    max-width: 560px;
    margin-top: var(--space-5);
  }
  .billing {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  /* ---------------------------------------------------------------- Plan cards */
  .plans {
    position: relative;
    margin-top: var(--space-10);
  }
  /* A faint grid behind the plan cards, fading out (direction.md: light, not decoration). */
  .plans::before {
    content: '';
    position: absolute;
    inset: calc(var(--space-12) * -1) 0 30%;
    z-index: -1;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 48px 48px;
    background-position: center top;
    mask-image: radial-gradient(ellipse 65% 60% at 50% 35%, #000 25%, transparent 75%);
    pointer-events: none;
  }
  .plans__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
  }
  .plan__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 24px;
  }
  .plan__name {
    font-size: var(--text-h3);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.015em;
  }
  .plan__for {
    margin-top: var(--space-1);
    color: var(--ink-3);
    font-size: var(--text-sm);
  }
  .plan__price {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin-top: var(--space-6);
  }
  .plan__amount {
    color: var(--ink);
    font-size: 48px;
    font-weight: var(--weight-semibold);
    line-height: 1;
    letter-spacing: -0.035em;
  }
  .plan__per {
    color: var(--ink-3);
    font-size: var(--text-ui);
  }
  .plan__note {
    min-height: 1.45em;
    margin-top: var(--space-2);
    color: var(--ink-3);
    font-size: var(--text-sm);
  }
  .plan :global(.plan__cta) {
    margin-top: var(--space-6);
  }
  .plan__features {
    display: grid;
    gap: var(--space-2-5, 10px);
    margin-top: var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid var(--line);
    color: var(--ink-2);
    font-size: var(--text-ui);
    line-height: 1.45;
  }
  .plan__features li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2-5, 10px);
  }
  .plan__features :global(.plan__check) {
    margin-top: 3px;
    color: var(--ink);
  }
  .plan--rec .plan__features :global(.plan__check) {
    color: var(--accent);
  }
  .plans__fine {
    margin-top: var(--space-5);
    color: var(--ink-3);
    font-size: var(--text-sm);
    text-align: center;
  }

  /* ---------------------------------------------------------------- Compare */
  .cmp {
    margin-top: var(--section-y);
    scroll-margin-top: var(--header-h);
  }
  .cmp__head {
    margin-bottom: var(--space-6);
  }
  .cmp__sub {
    margin-top: var(--space-2);
    color: var(--ink-2);
    font-size: var(--text-body);
  }

  /* Sticky plan header row. Below 640: the plan switcher + the selected plan's CTA. */
  .cmp__bar {
    position: sticky;
    top: var(--header-h);
    z-index: var(--z-sticky);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    margin-inline: calc(var(--page-gutter) * -1);
    padding: var(--space-2) var(--page-gutter);
    background: var(--bg);
    box-shadow: 0 1px 0 var(--line);
  }
  .cmp__corner-note {
    display: none;
