---
/** About: what this is, why, who it's for, how it makes money, independence. Editorial. */
import BaseLayout from '~/layouts/BaseLayout.astro';
import MonoLabel from '~/components/ui/MonoLabel.astro';
import Stat from '~/components/ui/Stat.astro';
import StatList from '~/components/ui/StatList.astro';
import { CONTACT, SITE_NAME, SITE_URL } from '~/config/site';
import { formatCount, formatDate } from '~/lib/format';
import { loadMeta } from '~/components/static/meta';

const meta = await loadMeta();
Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=600');
const asOf = meta ? formatDate(meta.data_as_of) : null;

const AUDIENCES = [
  {
    who: 'Merchants',
    what: 'choosing a theme or an app. See it on stores like yours before you pay, with honest comparisons.',
    href: '/themes',
    link: 'Browse themes',
  },
  {
    who: 'Designers and agencies',
    what: 'looking for references. Real pages by theme, page type and section, and boards for client pitches.',
    href: '/sections',
    link: 'Open the sections library',
  },
  {
    who: 'App and theme developers',
    what: 'who want to know where their work is used, and what it runs next to.',
    href: '/apps',
    link: 'Browse apps',
  },
  {
    who: 'AI builders',
    what: 'who want real store references inside Claude or ChatGPT, through our API and an MCP server.',
    href: '/developers',
    link: 'API & MCP',
  },
];
---

<BaseLayout
  title="About"
  description={`${SITE_NAME} is an independent library of real Shopify storefronts: themes, apps and every page type, on desktop and mobile. Why it exists and how it makes money.`}
  jsonLd={{
    '@type': 'AboutPage',
    name: `About ${SITE_NAME}`,
    url: `${SITE_URL}/about`,
    publisher: { '@type': 'Organization', name: SITE_NAME, url: SITE_URL },
  }}
>
  <div class="about container">
    <header class="about__hero cols-12">
      <div class="about__statement">
        <MonoLabel as="p" class="about__eyebrow">
          About {SITE_NAME}
        </MonoLabel>
        <h1 class="about__title display">
          See a theme or an app on real stores before you buy it.
        </h1>
      </div>
      <div class="about__intro">
        <p>
          {SITE_NAME} is an independent library of public Shopify storefronts. For each store we
          record the theme and apps it runs, and capture its pages on desktop and mobile, section by
          section.
        </p>
        <MonoLabel as="p" class="about__spec">
          Independent · Not affiliated with Shopify{asOf ? ` · Data as of ${asOf}` : ''}
        </MonoLabel>
      </div>
    </header>

    <section class="about__row cols-12" aria-labelledby="why">
      <MonoLabel as="h2" tone="ink" class="about__label" id="why">
        01 Why
      </MonoLabel>
      <div class="about__body prose">
        <p class="about__lead">
          Theme demos show a theme at its best: stock photos, perfect copy, nothing real. App
          listings show the screenshots the developer chose.
        </p>
        <p>
          Neither tells you how it looks on a store like yours. Detection tools tell you a store
          runs Prestige and stop there. We go further down: the home page, a collection, a product
          and the cart, on both devices, sliced into the sections you would actually build. Then we
          link it all up, so a theme leads to the stores using it, a store to its apps, and a
          section to the app that renders it.
        </p>
        <p>
          <strong>Depth over count.</strong> We would rather show a few hundred stores properly than
          twenty thousand home pages cut off at the fold.
        </p>
        <p>
          <strong>Honest numbers.</strong> We never estimate revenue or traffic, the top complaint
          about spy tools. Every number on the site shows its source and the date it was true. The{' '}
          <a href="/methodology">methodology</a> explains each one.
        </p>
      </div>
    </section>

    <section class="about__row cols-12" aria-labelledby="who">
      <MonoLabel as="h2" tone="ink" class="about__label" id="who">
        02 Who it’s for
      </MonoLabel>
      <ol class="about__who">
        {AUDIENCES.map((a, i) => (
          <li class="about__who-row">
            <span class="about__who-n">{String(i + 1).padStart(2, '0')}</span>
            <p class="about__who-text">
              <strong>{a.who}</strong> {a.what}
            </p>
            <a class="about__who-link" href={a.href}>
              {a.link}
              <span aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>
    </section>

    {meta && (
      <section class="about__row cols-12" aria-labelledby="numbers">
        <MonoLabel as="h2" tone="ink" class="about__label" id="numbers">
          03 So far
        </MonoLabel>
        <div class="about__numbers">
          <div class="about__strip marks">
            <StatList columns={4}>
              <Stat
                value={formatCount(meta.counts.stores_scanned)}
                label="Stores scanned"
                size="lg"
                display
              />
              <Stat
                value={formatCount(meta.counts.stores_curated)}
                label="Curated stores"
                size="lg"
                display
              />
              <Stat value={formatCount(meta.counts.themes)} label="Themes" size="lg" display />
              <Stat value={formatCount(meta.counts.apps_full)} label="App profiles" size="lg" display />
            </StatList>
          </div>
          <MonoLabel as="p" class="about__source">
            Source: {meta.source.label} · <a href="/methodology">How we detect</a>
          </MonoLabel>
        </div>
      </section>
    )}

    <section class="about__row cols-12" aria-labelledby="money">
      <MonoLabel as="h2" tone="ink" class="about__label" id="money">
        {meta ? '04' : '03'} How we make money
      </MonoLabel>
      <div class="about__body prose">
        <p>
          <strong>Affiliate links first.</strong> Some links to apps and themes earn us a commission
          when you buy. Each one is labelled right where it appears, and none of them changes what
          we detect or how we rank. Apps that pay us nothing, like Klaviyo and Judge.me, are shown
          exactly the same way. <a href="/affiliate-disclosure">Affiliate disclosure</a>
        </p>
        <p>
          <strong>Pro later.</strong> A paid plan for designers and agencies: every page type,
          filters by section, theme and app, boards and exports. <a href="/pro">See the plans</a>
        </p>
        <p>We don’t sell data and we don’t sell placements.</p>
      </div>
    </section>

    <section class="about__row cols-12" aria-labelledby="independence">
      <MonoLabel as="h2" tone="ink" class="about__label" id="independence">
        {meta ? '05' : '04'} Independence
      </MonoLabel>
      <div class="about__body prose">
        <p>
          {SITE_NAME} is independent. We are not affiliated with or endorsed by Shopify Inc., and
          theme and app names belong to their owners. Our data comes from our own crawler, reading
          public pages only. We may look at other tools to learn which stores are notable, but we
          never copy their databases or their estimates.
        </p>
        <p>
          Own a store we list? You can <a href="/opt-out">remove it</a> at any time. Anything else:{' '}
          <a href={`mailto:${CONTACT.hello}`}>{CONTACT.hello}</a>.
        </p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .about {
    padding-top: var(--space-12);
  }

  /* ---------- Hero: statement left (8 cols), intro right (cols 9–12) ---------- */
  .about__hero {
    align-items: end;
    padding-bottom: var(--space-16);
  }
  .about__hero :global(.about__eyebrow) {
    display: flex;
    margin-bottom: var(--space-6);
  }
  .about__title {
    font-size: clamp(2.5rem, 1.4rem + 4.6vw, 5rem);
    line-height: 1.02;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .about__intro {
    color: var(--ink-2);
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
  }
  .about__intro :global(.about__spec) {
    display: flex;
    flex-wrap: wrap;
    margin-top: var(--space-4);
  }

  /* ---------- Rows: mono label left, text right, hairline above ---------- */
  .about__row {
    padding-block: var(--space-8) var(--space-12);
    border-top: 1px solid var(--line);
  }
  .about__row :global(.about__label) {
    display: flex;
    align-self: start;
    padding-top: 6px;
  }
  .about__body {
    min-width: 0;
  }
  .about__lead {
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .about__who {
    min-width: 0;
  }
  .about__who-row {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    gap: var(--space-1) var(--space-4);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--line);
  }
  .about__who-row:first-child {
    padding-top: 0;
  }
  .about__who-n {
    padding-top: 3px;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  .about__who-text {
    color: var(--ink-2);
    font-size: var(--text-md);
    line-height: var(--leading-normal);
  }
  .about__who-text strong {
    color: var(--ink);
    font-weight: var(--weight-semibold);
  }
  .about__who-link {
    grid-column: 2;
    display: inline-flex;
    gap: 4px;
    justify-self: start;
    color: var(--ink-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .about__who-link:hover {
    color: var(--ink);
  }
  .about__who-link span {
    text-decoration: none;
  }

  .about__numbers {
    min-width: 0;
  }
  .about__strip {
    padding: var(--space-6) var(--space-5);
  }
  .about__numbers :global(.about__source) {
    display: flex;
    flex-wrap: wrap;
    margin-top: var(--space-5);
  }
  .about__numbers :global(.about__source a) {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 639px) {
    .about {
      padding-top: var(--space-8);
    }
    .about__hero {
      padding-bottom: var(--space-12);
    }
    .about__lead {
      font-size: var(--text-xl);
    }
  }

  @media (min-width: 1024px) {
    .about {
      padding-top: var(--space-16);
    }
    .about__statement {
      grid-column: 1 / span 8;
    }
    .about__intro {
      grid-column: 9 / -1;
      padding-bottom: var(--space-2);
    }
    .about__row :global(.about__label) {
      grid-column: 1 / span 3;
    }
    .about__body,
    .about__who,
    .about__numbers {
      grid-column: 5 / span 7;
    }
    .about__who-row {
      grid-template-columns: 2.25rem minmax(0, 1fr) auto;
      align-items: baseline;
      column-gap: var(--space-6);
    }
    .about__who-link {
      grid-column: 3;
      white-space: nowrap;
    }
  }
</style>
