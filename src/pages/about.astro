---
/**
 * About: what this is, why, who it's for, how it makes money, independence. A marketing page
 * (guides, left-aligned): two-tone title → a real capture in a product window with its section
 * tags → a stats strip with live numbers → editorial rows.
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import Card from '~/components/ui/Card.astro';
import Icon from '~/components/ui/Icon.astro';
import SourceNote from '~/components/ui/SourceNote.astro';
import Stat from '~/components/ui/Stat.astro';
import StatList from '~/components/ui/StatList.astro';
import Window from '~/components/ui/Window.astro';
import FullPage, { type FullPageSection } from '~/components/media/FullPage.astro';
import type { IconName } from '~/components/ui/icons';
import { api } from '~/server/api';
import type { ScreenshotDetail } from '~/server/api/v1/types';
import { CONTACT, LEGAL_ENTITY, SITE_NAME, SITE_URL } from '~/config/site';
import { formatCount } from '~/lib/format';
import { loadMeta } from '~/components/static/meta';

const meta = await loadMeta();
Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=600');

// The top curated store's home page, with its sections, as the page's visual. Two queries;
// the page renders without it if either fails.
let shot: ScreenshotDetail | null = null;
try {
  const { data: list } = await api.listStores({ limit: 1 });
  const id = list.items[0]?.preview?.id;
  if (id) shot = (await api.getScreenshot({ id })).data;
} catch (err) {
  console.error('about: capture failed', err);
}
const sections: FullPageSection[] = shot
  ? [...shot.sections]
      .sort((a, b) => a.order_index - b.order_index)
      .map((s) => ({
        id: s.id,
        type: s.type.slug,
        name: s.type.name,
        y: s.rect.y,
        height: s.rect.h,
        x: s.rect.x,
        w: s.rect.w,
        app: s.app ? { name: s.app.short_name, slug: s.app.slug, iconUrl: s.app.icon_url } : null,
        href: s.href,
      }))
  : [];

const AUDIENCES: { who: string; what: string; href: string; link: string; icon: IconName }[] = [
  {
    who: 'Merchants',
    what: 'Choosing a theme or an app. See it on stores like yours before you pay, with honest comparisons.',
    href: '/themes',
    link: 'Browse themes',
    icon: 'storefront',
  },
  {
    who: 'Designers and agencies',
    what: 'Looking for references. Real pages by theme, page type and section, and boards for client pitches.',
    href: '/sections',
    link: 'Open the sections library',
    icon: 'paint-brush',
  },
  {
    who: 'App and theme developers',
    what: 'Want to know where their work is used, and what it runs next to.',
    href: '/apps',
    link: 'Browse apps',
    icon: 'puzzle-piece',
  },
  {
    who: 'AI builders',
    what: 'Want real store references inside Claude or ChatGPT, through our API and an MCP server.',
    href: '/developers',
    link: 'API & MCP',
    icon: 'browser',
  },
];
---

<BaseLayout
  title="About"
  description={`${SITE_NAME} is an independent library of real Shopify storefronts: themes, apps and every page type, on desktop and mobile. Why it exists and how it makes money.`}
  jsonLd={{
    '@type': 'AboutPage',
    name: `About ${SITE_NAME}`,
    url: `${SITE_URL}/about`,
    publisher: { '@type': 'Organization', name: SITE_NAME, url: SITE_URL },
  }}
  canonical="/about"
>
  <div class="about container guides">
    <!-- ============================== Hero ============================== -->
    <header class="about__hero">
      <p class="eyebrow">About {SITE_NAME}</p>
      <h1 class="display-lg about__title">
        See a theme or an app on real stores <span class="tone-muted">before you pay for it.</span>
      </h1>
      <p class="lead about__lead">
        {SITE_NAME} is an independent library of public Shopify storefronts. For each store we
        record the theme and apps it runs, and capture its pages on desktop and mobile, section by
        section.
      </p>
    </header>

    {shot && (
      <figure class="about__window">
        <Window url={`${shot.store.domain}`} fade height="var(--about-window-h)">
          <div class="about__fp">
            <FullPage
              src={shot.image.src}
              width={shot.width}
              height={shot.height}
              device={shot.device}
              alt={`${shot.store.display_name} home page, desktop, with each section tagged`}
              sections={sections}
              bare
              eager
            />
          </div>
        </Window>
        <figcaption class="about__caption">
          {shot.store.display_name}’s home page, sliced into {sections.length} sections.{' '}
          <a href={`/stores/${shot.store.domain}`}>Open the store</a>
        </figcaption>
      </figure>
    )}

    {meta && (
      <section class="about__numbers" aria-labelledby="numbers-title">
        <h2 class="visually-hidden" id="numbers-title">
          The library so far
        </h2>
        <StatList columns={4} boxed>
          <Stat value={formatCount(meta.counts.stores_scanned)} label="Stores scanned" size="lg" />
          <Stat value={formatCount(meta.counts.stores_curated)} label="Curated stores" size="lg" />
          <Stat value={formatCount(meta.counts.sections)} label="Sections tagged" size="lg" />
          <Stat value={formatCount(meta.counts.apps_full)} label="App profiles" size="lg" />
        </StatList>
        <SourceNote source={meta.source.label} />
      </section>
    )}

    <!-- ============================== Rows ============================== -->
    <section class="row" aria-labelledby="why">
      <h2 class="h2 row__title" id="why">
        Why we built it
      </h2>
      <div class="row__body prose">
        <p class="row__lead">
          Theme demos show a theme at its best: stock photos, perfect copy, nothing real. App
          listings show the screenshots the developer chose.
        </p>
        <p>
          Neither tells you how it looks on a store like yours. Detection tools tell you a store
          runs Prestige and stop there. We go further down: the home page, a collection, a product
          and the cart, on both devices, sliced into the sections you would actually build. Then we
          link it all up, so a theme leads to the stores using it, a store to its apps, and a
          section to the app that renders it.
        </p>
        <p>
          <strong>Depth over count.</strong> We would rather show a few hundred stores properly than
          twenty thousand home pages cut off at the fold.
        </p>
        <p>
          <strong>Honest numbers.</strong> We never estimate revenue or traffic, the top complaint
          about spy tools. Every number on the site shows its source and the date it was true. The{' '}
          <a href="/methodology">methodology</a> explains each one.
        </p>
      </div>
    </section>

    <section class="row" aria-labelledby="who">
      <h2 class="h2 row__title" id="who">
        Who it’s for
      </h2>
      <ul class="who">
        {AUDIENCES.map((a) => (
          <li>
            <Card interactive padding="md" class="who__card">
              <Icon name={a.icon} size={20} class="who__icon" />
              <h3 class="who__name">
                <a class="stretched-link" href={a.href}>
                  {a.who}
                </a>
              </h3>
              <p class="who__what">{a.what}</p>
              <p class="who__link" aria-hidden="true">
                {a.link}
                <Icon name="arrow-right" size={14} class="who__arrow" />
              </p>
            </Card>
          </li>
        ))}
      </ul>
    </section>

    <section class="row" aria-labelledby="money">
      <h2 class="h2 row__title" id="money">
        How we make money
      </h2>
      <div class="row__body prose">
        <p>
          <strong>Affiliate links first.</strong> Some links to apps and themes earn us a commission
          when you buy. Each one is labelled right where it appears, and none of them changes what
          we detect or how we rank. Apps that pay us nothing, like Klaviyo and Judge.me, are shown
          exactly the same way. <a href="/affiliate-disclosure">Affiliate disclosure</a>
        </p>
        <p>
          <strong>Pro later.</strong> A paid plan for designers and agencies: every page type,
          full-page and section screenshots, and CSV exports. <a href="/pro">See the plans</a>
        </p>
        <p>We don’t sell data and we don’t sell placements.</p>
      </div>
    </section>

    <section class="row" aria-labelledby="independence">
      <h2 class="h2 row__title" id="independence">
        Independence
      </h2>
      <div class="row__body prose">
        <p>
          {SITE_NAME} is independent and run by {LEGAL_ENTITY}. We are not affiliated with or
          endorsed by Shopify Inc., and theme and app names belong to their owners. Our data comes
          from our own crawler, reading public pages only. We may look at other tools to learn which
          stores are notable, but we never copy their databases or their estimates.
        </p>
        <p>
          Own a store we list? You can <a href="/opt-out">remove it</a> at any time. Anything else:{' '}
          <a href={`mailto:${CONTACT.hello}`}>{CONTACT.hello}</a>.
        </p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .about {
    --about-window-h: 420px;
    padding-bottom: var(--space-8);
  }

  /* ---------- Hero ---------- */
  .about__hero {
    padding-top: var(--space-12);
  }
  .about__title {
    max-width: 820px;
    margin-top: var(--space-4);
  }
  .about__lead {
    max-width: 620px;
    margin-top: var(--space-5);
  }

  /* ---------- Product window ---------- */
  .about__window {
    margin-top: var(--space-12);
  }
  .about__window :global(.window) {
    background: var(--surface);
  }
  .about__fp {
    max-width: 960px;
    margin-inline: auto;
  }
  .about__caption {
    margin-top: var(--space-3);
    color: var(--ink-3);
    font-size: var(--text-sm);
  }
  .about__caption a {
    color: var(--ink-2);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
  }
  .about__caption a:hover {
    color: var(--ink);
  }

  /* ---------- Numbers ---------- */
  .about__numbers {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-12);
  }

  /* ---------- Editorial rows: heading left, body right ---------- */
  .row {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-16);
    padding-top: var(--space-8);
    border-top: 1px solid var(--line);
  }
  .row__title {
    scroll-margin-top: calc(var(--header-h) + var(--space-6));
  }
  .row__body {
    min-width: 0;
  }
  .row__lead {
    color: var(--ink);
    font-size: var(--text-h3);
    font-weight: var(--weight-medium);
    line-height: 1.4;
    letter-spacing: -0.015em;
  }

  .who {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
    min-width: 0;
  }
  .who :global(.who__card) {
    height: 100%;
  }
  .who :global(.who__icon) {
    color: var(--ink-2);
  }
  .who__name {
    margin-top: var(--space-4);
    font-size: var(--text-h4);
    font-weight: var(--weight-strong);
  }
  .who__name a {
    color: var(--ink);
  }
  .who__name a:focus-visible {
    outline: none;
  }
  .who :global(.who__card:has(.stretched-link:focus-visible)) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .who__what {
    margin-top: var(--space-1);
    color: var(--ink-2);
    font-size: var(--text-ui);
    line-height: 1.5;
  }
  .who__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: auto;
    padding-top: var(--space-4);
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }
  .who :global(.who__arrow) {
    transition: transform var(--dur-base) var(--ease-out);
  }
  .who :global(.who__card:hover .who__arrow) {
    transform: translateX(2px);
  }

  @media (min-width: 640px) {
    .about {
      --about-window-h: 520px;
    }
    .who {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .about {
      --about-window-h: 600px;
    }
    .about__hero {
      padding-top: var(--space-20);
    }
    .about__window {
      margin-top: var(--space-16);
    }
    .about__fp {
      padding: var(--space-6) var(--space-6) 0;
    }
    .row {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      gap: var(--space-10);
    }
    .row__body,
    .who {
      max-width: 720px;
    }
  }
</style>
