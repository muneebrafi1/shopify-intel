---
/**
 * /apps/categories/<slug> — one kind of app: header with what it is and its reach, a metrics
 * strip, the apps ranked by use within the category (the API's `category_rank`, competition
 * ranking), where these apps show up on real store pages (their own sections, pinned on the
 * page), curated head-to-head comparisons, and the other categories.
 *
 * URL state: ?device=mobile for the "where they show up" captures.
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/ui/PageHeader.astro';
import Breadcrumbs from '~/components/ui/Breadcrumbs.astro';
import Button from '~/components/ui/Button.astro';
import EmptyState from '~/components/ui/EmptyState.astro';
import Icon from '~/components/ui/Icon.astro';
import SectionHeader from '~/components/ui/SectionHeader.astro';
import Segmented from '~/components/ui/Segmented.astro';
import SourceNote from '~/components/ui/SourceNote.astro';
import Stat from '~/components/ui/Stat.astro';
import StatList from '~/components/ui/StatList.astro';
import RankTable from '~/components/apps/RankTable.astro';
import CaptureCard from '~/components/apps/CaptureCard.astro';
import PairList, { type Pair } from '~/components/apps/PairList.astro';
import { api } from '~/server/api';
import type { SectionCard as SectionCardData } from '~/server/api/v1/types';
import type { Device } from '~/lib/taxonomy';
import { formatDate } from '~/lib/format';
import {
  appStoreSource,
  breadcrumbLd,
  pageName,
  rankLabel,
  sectionViewerHref,
  sharePct,
  urlWith,
} from '~/components/apps/helpers';

const slug = Astro.params.slug ?? '';
const { data: catData, meta: catMeta } = await api.listAppCategories({});
const ordered = [...catData.items].sort(
  (a, b) => b.store_count - a.store_count || a.name.localeCompare(b.name),
);
const cat = ordered.find((c) => c.slug === slug);
if (!cat) return Astro.rewrite('/404');

const url = Astro.url;
const device: Device = url.searchParams.get('device') === 'mobile' ? 'mobile' : 'desktop';

const [{ data: list, meta: listMeta }, comparisons] = await Promise.all([
  api.listApps({ category: cat.slug, sort: 'usage', limit: 100 }),
  api.listComparisons({ kind: 'app', limit: 200 }),
]);
const apps = list.items;
const denominator = apps[0]?.usage.denominator ?? Math.round(cat.store_count / (cat.share || 1));
const inCategory = new Set(apps.map((a) => a.slug));
const shortName = new Map(apps.map((a) => [a.slug, a.short_name]));
const leader = apps[0];

// Where these apps render: each leader's own attributed sections, interleaved so one app does
// not fill the grid alone. Only categories that render a section are asked (one call, one
// query, for all eight leaders).
const leaders = apps.slice(0, 8);
const byApp =
  cat.surfaces.length && leaders.length
    ? new Map(
        (
          await api.listSectionsByApps({ apps: leaders.map((a) => a.slug), device, per_app: 4 })
        ).data.items.map((i) => [i.app_slug, i]),
      )
    : null;
const perApp = byApp
  ? leaders.map((a) => ({
      app: a,
      total: byApp.get(a.slug)?.total ?? 0,
      items: byApp.get(a.slug)?.sections ?? [],
    }))
  : [];
const sections: SectionCardData[] = [];
for (let round = 0; round < 4 && sections.length < 8; round++) {
  for (const p of perApp) {
    const s = p.items[round];
    if (s && sections.length < 8) sections.push(s);
  }
}
const renderingApps = perApp.filter((p) => p.total > 0);
const sectionTotal = renderingApps.reduce((n, p) => n + p.total, 0);
const otherDevice: Device = device === 'desktop' ? 'mobile' : 'desktop';
const surfaceNames = cat.surfaces.map((s) => s.name);

// Curated head-to-head pages between apps of this category (the API only lists curated pairs).
const pairs: Pair[] = comparisons.data.items
  .filter((c) => inCategory.has(c.a.slug) && inCategory.has(c.b.slug))
  .slice(0, 6)
  .map((c) => ({
    href: c.href,
    a: { name: shortName.get(c.a.slug) ?? c.a.name, iconUrl: c.a.icon_url },
    b: { name: shortName.get(c.b.slug) ?? c.b.name, iconUrl: c.b.icon_url },
    note:
      typeof c.shared_stores === 'number'
        ? `${c.shared_stores} ${c.shared_stores === 1 ? 'store runs' : 'stores run'} both`
        : null,
  }));

const scan = catMeta.sources[cat.source];
const appStore = listMeta.sources['shopify-app-store'];
const crumbs = [
  { label: 'Apps', href: '/apps' },
  { label: 'Categories', href: '/apps/categories' },
  { label: cat.name, href: cat.href },
];
const base = Astro.site ?? url;
const jsonLd = [
  {
    '@type': 'ItemList',
    name: `${cat.name} apps for Shopify, by usage`,
    numberOfItems: apps.length,
    itemListElement: apps.map((a, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: new URL(a.href, base).href,
      name: a.short_name,
    })),
  },
  breadcrumbLd(base, crumbs),
];
const others = ordered.filter((c) => c.slug !== cat.slug);
const description = `${cat.store_count.toLocaleString('en-US')} of ${denominator.toLocaleString('en-US')} scanned stores run at least one of these ${cat.app_count === 1 ? 'app' : `${cat.app_count} apps`}. ${
  surfaceNames.length
    ? `On the page they render as ${surfaceNames.join(' and ').toLowerCase()}.`
    : 'They work behind the scenes, not as a section on the page.'
}`;

Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=600');
---

<BaseLayout
  title={`${cat.name} apps for Shopify`}
  description={`${cat.app_count} ${cat.name.toLowerCase()} apps ranked by use: ${cat.store_count} of ${denominator} scanned Shopify stores run one. See where they render on real store pages and compare the leaders.`}
  canonical={cat.href}
  noindex={[...url.searchParams.keys()].length > 0}
  jsonLd={jsonLd}
>
  <div class="container cat">
    <PageHeader
      eyebrow="App category"
      title={cat.name}
      count={cat.app_count}
      description={description}
    >
      <Breadcrumbs slot="top" items={crumbs} />
      <Fragment slot="actions">
        {pairs.length > 0 && (
          <Button href="#compare" icon="scales">
            Compare the leaders
          </Button>
        )}
        <Button
          href={`/apps?category=${encodeURIComponent(cat.slug)}`}
          variant="ghost"
          iconRight="arrow-right"
        >
          Filter all apps
        </Button>
      </Fragment>
    </PageHeader>

    <StatList boxed columns={4} class="cat__stats">
      <Stat
        value={sharePct(cat.share)}
        label="Reach"
        source={`${cat.store_count.toLocaleString('en-US')} of ${denominator.toLocaleString('en-US')} stores`}
        asOf={formatDate(cat.as_of)}
      />
      <Stat value={cat.app_count} label="Apps tracked" source="With at least one detection" />
      <Stat
        value={leader ? leader.short_name : '—'}
        label="Most used"
        source={
          leader
            ? `${leader.usage.stores.toLocaleString('en-US')} stores · ${rankLabel(leader.usage.rank)} overall`
            : undefined
        }
      />
      <Stat
        value={surfaceNames.length ? surfaceNames.join(', ') : 'No section'}
        label="Renders as"
        source={surfaceNames.length ? 'Section type on the page' : 'Scripts, widgets, back office'}
      />
    </StatList>

    <section class="cat__block" id="ranking" aria-labelledby="ranked-title">
      <SectionHeader
        title={`${cat.name} apps, ranked`}
        id="ranked-title"
        count={apps.length}
        description="By stores running each. Apps with equal usage share a rank."
      />
      <RankTable
        items={apps.map((a) => ({
          app: a,
          rank: a.category_rank,
          sub: [a.developer, a.usage.rank ? `${rankLabel(a.usage.rank)} overall` : null]
            .filter(Boolean)
            .join(' · '),
        }))}
        max={leader?.usage.stores ?? 0}
        showCategory={false}
        label={`${cat.name} apps ranked by stores running them`}
        rankTitle={`Rank in ${cat.name}`}
        ratingSource={appStoreSource(appStore?.as_of)}
      />
    </section>

    <section class="cat__block" id="where" aria-labelledby="where-title">
      <SectionHeader
        title="Where these apps show up"
        id="where-title"
        description={
          sections.length > 0
            ? `${sectionTotal} ${sectionTotal === 1 ? 'section' : 'sections'} credited to ${renderingApps.length} ${renderingApps.length === 1 ? 'app' : 'apps'} on curated stores, each pinned on its page.`
            : undefined
        }
      >
        {cat.surfaces.length > 0 && (
          <Segmented
            label="Device"
            size="sm"
            items={[
              {
                label: 'Desktop',
                value: 'desktop',
                icon: 'desktop',
                href: `${urlWith(url, { device: null })}#where`,
                selected: device === 'desktop',
              },
              {
                label: 'Mobile',
                value: 'mobile',
                icon: 'device-mobile',
                href: `${urlWith(url, { device: 'mobile' })}#where`,
                selected: device === 'mobile',
              },
            ]}
          />
        )}
      </SectionHeader>
      {sections.length > 0 ? (
        <>
          <ul class="cat__captures">
            {sections.map((s, i) => (
              <li>
                <CaptureCard
                  section={s}
                  href={sectionViewerHref(s)}
                  label={s.type.name}
                  labelMuted={s.app?.short_name}
                  alt={`${s.app?.short_name ?? cat.name}: ${s.type.name.toLowerCase()} section on ${s.store.display_name}, ${pageName(s.page_type).toLowerCase()} page (${s.device}, layout preview)`}
                  title={s.app?.short_name ?? s.type.name}
                  meta={`${s.store.display_name} · ${pageName(s.page_type)}`}
                  icon={
                    s.app
                      ? { kind: 'app', src: s.app.icon_url, name: s.app.short_name }
                      : { kind: 'store', domain: s.store.domain, name: s.store.name }
                  }
                  eager={i < 2}
                />
              </li>
            ))}
          </ul>
          <div class="cat__foot">
            <p>Layout previews drawn from each page’s detected sections until captures land.</p>
            {cat.surfaces[0] && (
              <a href={cat.surfaces[0].href} class="cat__more">
                All {cat.surfaces[0].name.toLowerCase()} sections
                <Icon name="arrow-right" size={14} />
              </a>
            )}
          </div>
        </>
      ) : cat.surfaces.length > 0 ? (
        <EmptyState
          level={3}
          icon="device-mobile"
          title={`No ${surfaceNames.join(' or ').toLowerCase()} sections on ${device} yet`}
          body={`These apps render as ${surfaceNames.join(' and ').toLowerCase()}, but none of our curated stores runs one on ${device}.`}
        >
          <Button
            href={`${urlWith(url, { device: otherDevice === 'desktop' ? null : otherDevice })}#where`}
            size="sm"
          >
            Try {otherDevice}
          </Button>
        </EmptyState>
      ) : (
        <EmptyState
          level={3}
          icon="gear"
          title="Nothing to pin on the page"
          body={`${cat.name} apps run as scripts, widgets or in the back office, so they add no section we slice. Each app’s page lists the stores running it.`}
        >
          {leader && (
            <Button href={leader.href} size="sm" iconRight="arrow-right">
              Stores running {leader.short_name}
            </Button>
          )}
        </EmptyState>
      )}
    </section>

    {pairs.length > 0 && (
      <section class="cat__block" id="compare" aria-labelledby="compare-title">
        <SectionHeader
          title="Compare the leaders"
          id="compare-title"
          description={`Curated side-by-side pages for the most used ${cat.name.toLowerCase()} apps.`}
        />
        <PairList items={pairs} label={`${cat.name} comparisons`} />
      </section>
    )}

    <section class="cat__block cat__others" aria-labelledby="others-title">
      <SectionHeader
        title="Other categories"
        id="others-title"
        count={others.length}
        href="/apps/categories"
        linkLabel="All categories"
      />
      <ul class="others">
        {others.map((c) => (
          <li>
            <a href={c.href} class="others__link">
              <span class="others__name">{c.name}</span>
              <span class="others__meta num">
                {c.app_count} {c.app_count === 1 ? 'app' : 'apps'} · {sharePct(c.share)}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <footer class="cat__sources">
      <SourceNote source={`${scan?.label ?? 'Our scan'}: stores, reach and ranks`} />
      <SourceNote
        source="Shopify App Store listing: ratings and prices"
        asOf={`checked ${formatDate(appStore?.as_of)}`}
        href=""
      />
    </footer>
  </div>
</BaseLayout>

<style>
  .cat {
    padding-bottom: var(--space-16);
  }
  :global(.cat__stats) {
    margin-top: var(--space-2);
  }
  .cat__block {
    margin-top: var(--section-y-app);
    scroll-margin-top: calc(var(--header-h) + var(--space-4));
  }

  .cat__captures {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
  }
  @media (min-width: 1024px) {
    .cat__captures {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-5);
    }
  }
  .cat__captures > li {
    display: flex;
    min-width: 0;
  }
  .cat__captures > li > :global(.capcard) {
    flex: 1;
  }
  .cat__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-6);
    margin-top: var(--space-4);
    color: var(--ink-3);
    font-size: var(--text-xs);
  }
  .cat__more {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }
  .cat__more :global(svg) {
    transition: transform var(--dur-base) var(--ease-out);
  }
  .cat__more:hover :global(svg) {
    transform: translateX(2px);
  }

  .others {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    column-gap: var(--space-8);
    border-top: 1px solid var(--line);
  }
  @media (min-width: 640px) {
    .others {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .others {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .others li {
    min-width: 0;
    border-bottom: 1px solid var(--line);
  }
  .others__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 44px;
    padding: var(--space-2);
    margin-inline: calc(var(--space-2) * -1);
    border-radius: var(--radius-control);
    transition: background-color var(--dur-fast) var(--ease-out);
  }
  .others__link:hover {
    background: var(--surface-2);
  }
  .others__name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-weight: var(--weight-medium);
  }
  .others__meta {
    flex: none;
    color: var(--ink-3);
    font-size: var(--text-xs);
  }
  .cat__sources {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-12);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }
</style>
