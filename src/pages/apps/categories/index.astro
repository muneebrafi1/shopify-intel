---
/**
 * /apps/categories — the app categories as cards, ordered by reach (share of scanned stores
 * running at least one app in the category). Split by where they live: categories whose apps
 * render a section on the storefront, and those that work behind the scenes. Each card shows
 * its reach and its most used apps (real icons, store counts).
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/ui/PageHeader.astro';
import Breadcrumbs from '~/components/ui/Breadcrumbs.astro';
import Button from '~/components/ui/Button.astro';
import SectionHeader from '~/components/ui/SectionHeader.astro';
import SourceNote from '~/components/ui/SourceNote.astro';
import CategoryCard from '~/components/apps/CategoryCard.astro';
import { api } from '~/server/api';
import { formatDate } from '~/lib/format';
import { breadcrumbLd } from '~/components/apps/helpers';
import { allApps } from '~/components/apps/data';

const [{ data, meta }, { data: siteMeta }, usage] = await Promise.all([
  api.listAppCategories({}),
  api.getMeta({}),
  allApps(),
]);
const categories = [...data.items].sort(
  (a, b) => b.store_count - a.store_count || a.name.localeCompare(b.name),
);
const denominator = siteMeta.counts.stores_scanned;
const appCount = siteMeta.counts.apps;
const source = meta.sources[categories[0]?.source ?? ''] ?? siteMeta.source;
const onPage = categories.filter((c) => c.surfaces.length > 0);
const behind = categories.filter((c) => c.surfaces.length === 0);
const maxShare = Math.max(...categories.map((c) => c.share), 0);

// Most used apps per category, with store counts (top_apps are already ordered by use).
const topApps = (c: (typeof categories)[number]) =>
  c.top_apps.slice(0, 3).map((a) => ({
    name: a.short_name,
    href: a.href,
    iconUrl: a.icon_url,
    stores: usage.get(a.slug)?.usage.stores ?? null,
  }));

const WORDS = [
  'Zero',
  'One',
  'Two',
  'Three',
  'Four',
  'Five',
  'Six',
  'Seven',
  'Eight',
  'Nine',
  'Ten',
  'Eleven',
  'Twelve',
  'Thirteen',
  'Fourteen',
  'Fifteen',
  'Sixteen',
  'Seventeen',
  'Eighteen',
  'Nineteen',
  'Twenty',
  'Twenty-one',
  'Twenty-two',
  'Twenty-three',
  'Twenty-four',
  'Twenty-five',
];
const countWord = WORDS[categories.length] ?? String(categories.length);

const crumbs = [
  { label: 'Apps', href: '/apps' },
  { label: 'Categories', href: '/apps/categories' },
];
const base = Astro.site ?? Astro.url;
const jsonLd = [
  {
    '@type': 'ItemList',
    name: 'Shopify app categories by reach',
    numberOfItems: categories.length,
    itemListElement: categories.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: new URL(c.href, base).href,
      name: c.name,
    })),
  },
  breadcrumbLd(base, crumbs),
];

Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=600');
---

<BaseLayout
  title="Shopify app categories"
  description={`${categories.length} kinds of Shopify app, ordered by how many of ${denominator} scanned stores run one, with where each kind shows up on the page and the most used apps.`}
  jsonLd={jsonLd}
  canonical="/apps/categories"
>
  <div class="container cats">
    <PageHeader
      title="App categories"
      count={categories.length}
      description={`${countWord} kinds of app, ordered by how many of ${denominator.toLocaleString('en-US')} scanned stores run at least one. ${onPage.length} of them put a section on the page.`}
    >
      <Breadcrumbs slot="top" items={crumbs} />
      <Fragment slot="actions">
        <Button href="/apps" iconRight="arrow-right">
          All apps, ranked
        </Button>
        <Button href="/sections" variant="ghost" icon="stack">
          Sections library
        </Button>
      </Fragment>
    </PageHeader>

    <section class="cats__group" aria-labelledby="on-page-title">
      <SectionHeader
        title="On the storefront"
        id="on-page-title"
        count={onPage.length}
        description="Apps in these categories render a section shoppers see: reviews, signup forms, upsell blocks. Open one to see them pinned on real store pages."
      />
      <ul class="cats__grid">
        {onPage.map((c) => (
          <li>
            <CategoryCard
              category={c}
              denominator={denominator}
              maxShare={maxShare}
              apps={topApps(c)}
            />
          </li>
        ))}
      </ul>
    </section>

    {behind.length > 0 && (
      <section class="cats__group" aria-labelledby="behind-title">
        <SectionHeader
          title="Behind the scenes"
          id="behind-title"
          count={behind.length}
          description="These apps work as scripts, widgets or in the back office. They add no section to the page, so we show where they are installed instead."
        />
        <ul class="cats__grid">
          {behind.map((c) => (
            <li>
              <CategoryCard
                category={c}
                denominator={denominator}
                maxShare={maxShare}
                apps={topApps(c)}
              />
            </li>
          ))}
        </ul>
      </section>
    )}

    <div class="cats__sources">
      <SourceNote
        source={`${source?.label ?? 'Our scan'}: reach is the share of scanned stores running at least one app in the category`}
      />
    </div>
  </div>
</BaseLayout>

<style>
  .cats {
    padding-bottom: var(--space-16);
  }
  .cats__asof {
    display: flex;
    margin-top: var(--space-3);
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  .cats__group {
    margin-top: var(--section-y-app);
  }
  .cats__group + .cats__group {
    padding-top: var(--section-y-app);
    border-top: 1px solid var(--line);
  }
  .cats__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
  }
  @media (min-width: 640px) {
    .cats__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-4);
    }
  }
  @media (min-width: 1024px) {
    .cats__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-5);
    }
  }
  .cats__grid > li {
    display: flex;
    min-width: 0;
  }
  .cats__grid > li > :global(.ccard) {
    flex: 1;
  }
  .cats__sources {
    margin-top: var(--space-12);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }
</style>
