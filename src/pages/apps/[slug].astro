---
/**
 * /apps/<slug> — an app as an app view: breadcrumb, identity row (icon, name, developer,
 * rating, category, rank; actions: install/affiliate CTA, Save, Compare), section tabs, then a
 * main column with the "Seen on" stage (its sections pinned on real store pages), plans, the
 * listing, the stores running it, co-installs and themes, alternatives and curated comparisons,
 * beside a sticky facts card. Alias slugs 301 to the canonical slug; unknown slugs are 404s.
 *
 * URL state: ?device=mobile (Seen on), ?seen=<section id> (Seen on rail), ?p=<n> (stores).
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import { ogCaptureSrc } from '~/lib/media';
import Breadcrumbs from '~/components/ui/Breadcrumbs.astro';
import AppIcon from '~/components/ui/AppIcon.astro';
import Badge from '~/components/ui/Badge.astro';
import Button from '~/components/ui/Button.astro';
import Card from '~/components/ui/Card.astro';
import FactsCard from '~/components/ui/FactsCard.astro';
import type { Fact } from '~/components/ui/Facts.astro';
import Icon from '~/components/ui/Icon.astro';
import Notice from '~/components/ui/Notice.astro';
import Pagination from '~/components/ui/Pagination.astro';
import Rating from '~/components/ui/Rating.astro';
import SectionHeader from '~/components/ui/SectionHeader.astro';
import SourceNote from '~/components/ui/SourceNote.astro';
import StoreMark from '~/components/ui/StoreMark.astro';
import Tabs from '~/components/ui/Tabs.astro';
import AffiliateCta from '~/components/domain/AffiliateCta.astro';
import SaveButton from '~/components/domain/SaveButton.astro';
import SeenOn from '~/components/apps/SeenOn.astro';
import PlanCards from '~/components/apps/PlanCards.astro';
import ShareList from '~/components/apps/ShareList.astro';
import AltCard from '~/components/apps/AltCard.astro';
import PairList, { type Pair } from '~/components/apps/PairList.astro';
import { api, orNotFound } from '~/server/api';
import type { AppListItem, AppStoreRow, StoreListItem } from '~/server/api/v1/types';
import StoreShotGrid from '~/components/domain/StoreShotGrid.astro';
import type { Device } from '~/lib/taxonomy';
import { formatDate } from '~/lib/format';
import {
  appStoreSource,
  breadcrumbLd,
  intParam,
  priceRange,
  rankLabel,
  sharePct,
  sliceFromCursorList,
  urlWith,
} from '~/components/apps/helpers';

const STORES_PAGE = 24;
const slug = Astro.params.slug ?? '';
if (!/^[a-z0-9][a-z0-9._-]*$/i.test(slug)) return Astro.rewrite('/404');

const res = await orNotFound(api.getApp({ slug, stores_limit: STORES_PAGE }));
if (!res) return Astro.rewrite('/404');
const { data: detail, meta } = res;
const app = detail.app;
if (app.slug !== slug) {
  const qs = Astro.url.search;
  return Astro.redirect(`${meta.canonical ?? app.href}${qs}`, 301);
}

const url = Astro.url;
const device: Device = url.searchParams.get('device') === 'mobile' ? 'mobile' : 'desktop';
const seenParam = Number.parseInt(url.searchParams.get('seen') ?? '', 10);
const storesPage = intParam(url.searchParams.get('p'));
const storesTotal = detail.stores.total;
const storesPages = Math.max(1, Math.ceil(storesTotal / STORES_PAGE));
if (storesPage > storesPages) return Astro.redirect(urlWith(url, { p: null }) + '#stores', 302);

let storeRows: AppStoreRow[] = detail.stores.items;
if (storesPage > 1) {
  storeRows = (
    await sliceFromCursorList(
      async (limit, cursor) => {
        const r = await api.listAppStores({ slug: app.slug, limit, cursor });
        return {
          items: r.data.items,
          next: r.meta.pagination?.next_cursor ?? null,
          total: r.meta.pagination?.total ?? null,
        };
      },
      (storesPage - 1) * STORES_PAGE,
      STORES_PAGE,
    )
  ).items;
}

// Real captures of the stores running it (first page only; the table below lists them all).
const shotStores: StoreListItem[] =
  storesPage === 1
    ? await api
        .listStores({ app: app.slug, captured: true, limit: 6, facets: false })
        .then((r) => r.data.items.filter((s) => s.preview))
        .catch(() => [])
    : [];

const ogShot = shotStores.find((s) => s.preview?.device === 'desktop')?.preview;
const ogImage = ogCaptureSrc(ogShot);

const alternatives = await api.getAlternatives({ slug: app.slug, kind: 'app' }).catch(() => null);

// ---- Facts ----
const name = app.short_name;
const full = app.name !== app.short_name ? app.name : null;
const isBasic = app.profile === 'basic';
const listingRead = Boolean(app.checked_on);
const src = meta.sources;
const scan = src[app.usage.source];
const listingSource = appStoreSource(app.checked_on);
const appStoreAsOf = src['shopify-app-store']?.as_of;
const hasRating = typeof app.rating === 'number' && app.rating > 0;
const missing = listingRead ? 'Not listed' : 'Not checked yet';
const yesNo = (v: boolean | null | undefined) =>
  v === true ? 'Yes' : v === false ? 'No' : missing;
const languages = app.languages;
const denominator = app.usage.denominator;
const facts: Fact[] = [
  {
    label: 'Rating',
    value: hasRating
      ? `${app.rating!.toFixed(1)} of 5${typeof app.reviews === 'number' ? ` · ${app.reviews.toLocaleString('en-US')} reviews` : ''}`
      : listingRead
        ? 'No rating yet'
        : 'Not checked yet',
    title: listingSource,
  },
  { label: 'Price', value: priceRange(app.pricing, app.plans) ?? missing },
  ...(app.pricing.trial_days
    ? [{ label: 'Free trial', value: `${app.pricing.trial_days} days` }]
    : []),
  {
    label: 'Stores',
    value: `${app.usage.stores.toLocaleString('en-US')} · ${sharePct(app.usage.share)}`,
    title: `${app.usage.stores} of ${denominator} scanned stores`,
  },
  {
    label: 'Rank',
    value: app.usage.rank ? `${rankLabel(app.usage.rank)} overall` : 'Not ranked',
    title: 'By stores running it, among every app we track; equal usage shares a rank',
  },
  ...(app.category
    ? [
        { label: 'Category', value: app.category.name, href: app.category.href },
        ...(app.category_rank
          ? [
              {
                label: 'Category rank',
                value: rankLabel(app.category_rank),
                title: `Rank among ${app.category.name} apps by stores running them`,
              },
            ]
          : []),
      ]
    : []),
  { label: 'Developer', value: app.developer ?? missing },
  {
    label: 'Launched',
    value: app.launched_on ? formatDate(app.launched_on) : missing,
    mono: !!app.launched_on,
  },
  { label: 'Built for Shopify', value: yesNo(app.built_for_shopify) },
  {
    label: 'Languages',
    value: languages.length
      ? languages.length <= 2
        ? languages.join(', ')
        : `${languages[0]} + ${languages.length - 1} more`
      : missing,
    title: languages.join(', ') || undefined,
  },
];
const knownListing = [
  hasRating,
  app.plans.length > 0,
  !!app.launched_on,
  languages.length > 0,
].filter(Boolean).length;

// ---- Call to action: App Store listings read "Install on Shopify"; affiliate links are
// labelled by AffiliateCta right under the button; other links keep the API's label.
const ctaLabel = app.cta
  ? app.cta.is_affiliate
    ? `Get ${name}`
    : /^https:\/\/apps\.shopify\.com\//.test(app.cta.href)
      ? 'Install on Shopify'
      : app.cta.label
  : null;

// ---- Relationships ----
const coInstalled = detail.co_installed.slice(0, 8).map((c) => ({
  href: c.app.href,
  name: c.app.short_name,
  sub: c.app.category?.name ?? null,
  iconUrl: c.app.icon_url,
  stores: c.stores,
  share: c.share,
}));
const themes = detail.themes.slice(0, 8).map((t) => ({
  href: t.theme.href,
  name: t.theme.name,
  sub: t.theme.vendor,
  stores: t.stores,
  share: t.share,
}));

interface Alt {
  app: AppListItem;
  compareHref: string | null;
  sharedStores: number | null;
}
const altItems = alternatives?.data.items ?? [];
const alts: Alt[] = altItems.length
  ? altItems
      .filter((i) => i.app)
      .map((i) => ({
        app: i.app!,
        // Only curated pairs have a compare page; every other pair would 404.
        compareHref: i.compare_available ? i.compare_href : null,
        sharedStores: i.shared_stores,
      }))
  : detail.alternatives.map((a) => ({ app: a, compareHref: null, sharedStores: null }));
const altHref = `/alternatives/${app.slug}`;

// Curated comparisons (the API only returns pairs that have a page).
const pairs: Pair[] = [];
const seenPairs = new Set<string>();
for (const c of detail.comparisons) {
  if (seenPairs.has(c.href)) continue;
  seenPairs.add(c.href);
  const other = c.a.slug === app.slug ? c.b : c.a;
  const otherItem = altItems.find((i) => i.app?.slug === other.slug);
  const shared = c.shared_stores ?? otherItem?.shared_stores;
  pairs.push({
    href: c.href,
    a: { name, iconUrl: app.icon_url },
    b: { name: otherItem?.app?.short_name ?? other.name, iconUrl: other.icon_url },
    note:
      typeof shared === 'number'
        ? `${shared} ${shared === 1 ? 'store runs' : 'stores run'} both`
        : c.reason || null,
  });
}

// ---- Section tabs (in-page; a small script moves the indicator while scrolling) ----
const tabs = [
  { label: 'Seen on', href: '#where', count: detail.seen_on.section_total || null },
  ...(app.plans.length ? [{ label: 'Pricing', href: '#plans', count: app.plans.length }] : []),
  { label: 'Stores', href: '#stores', count: storesTotal },
  ...(coInstalled.length || themes.length
    ? [{ label: 'Related', href: '#related', count: null }]
    : []),
  ...(alts.length || pairs.length
    ? [{ label: 'Alternatives', href: '#alternatives', count: alts.length || null }]
    : []),
].map((t, i) => ({ ...t, selected: i === 0 }));

// ---- Page meta ----
const crumbs = [
  { label: 'Apps', href: '/apps' },
  ...(app.category ? [{ label: app.category.name, href: app.category.href }] : []),
  { label: name, href: app.href },
];
const longTitle = `${name} for Shopify: stores using it, pricing, alternatives`;
const title = longTitle.length <= 62 ? longTitle : `${name}: Shopify app on real stores`;
const pricedPlans = app.plans.filter((p) => typeof p.price_cents === 'number');
const paidPlans = pricedPlans.filter((p) => (p.price_cents ?? 0) > 0);
const hasFreePlan = pricedPlans.some((p) => p.price_cents === 0);
const cheapest = paidPlans.length
  ? Math.min(...paidPlans.map((p) => p.price_cents ?? 0)) / 100
  : null;
const priceBit =
  cheapest !== null
    ? `${hasFreePlan ? 'Free plan, paid from ' : 'Plans from '}$${Number.isInteger(cheapest) ? cheapest : cheapest.toFixed(2)}${paidPlans.find((p) => (p.price_cents ?? 0) / 100 === cheapest)?.period === 'month' ? '/mo' : ''}`
    : hasFreePlan
      ? 'Free plan'
      : null;
const description = [
  `${name} is ${app.category ? `${/^[aeiou]/i.test(app.category.name) ? 'an' : 'a'} ${app.category.name} app` : 'an app'} for Shopify${app.developer && app.developer !== name ? ` by ${app.developer}` : ''}, found on ${app.usage.stores.toLocaleString('en-US')} of ${denominator.toLocaleString('en-US')} scanned stores${
    hasRating ? ` and rated ${app.rating!.toFixed(1)} on the App Store` : ''
  }.`,
  priceBit ? `${priceBit}.` : null,
  detail.seen_on.section_total
    ? 'See where it renders on real store pages, with alternatives.'
    : 'See the stores running it and its alternatives.',
]
  .filter(Boolean)
  .join(' ');

const base = Astro.site ?? url;
const offers = app.plans
  .filter((p) => typeof p.price_cents === 'number')
  .map((p) => ({
    '@type': 'Offer',
    name: p.name,
    price: ((p.price_cents ?? 0) / 100).toFixed(2),
    priceCurrency: 'USD',
    ...(p.period ? { description: `per ${p.period}` } : {}),
  }));
const softwareLd: Record<string, unknown> = {
  '@type': 'SoftwareApplication',
  name: app.name,
  alternateName: full ? name : undefined,
  url: new URL(app.href, base).href,
  applicationCategory: 'BusinessApplication',
  applicationSubCategory: app.category?.name,
  operatingSystem: 'Shopify',
  description: app.tagline ?? undefined,
  image: app.icon_url ?? undefined,
  datePublished: app.launched_on ?? undefined,
  author: app.developer ? { '@type': 'Organization', name: app.developer } : undefined,
  sameAs: app.app_store_url ?? undefined,
  ...(offers.length ? { offers } : {}),
};
if (hasRating && typeof app.reviews === 'number' && app.reviews > 0) {
  // Only the App Store's own rating and count, cited by the listing URL and the date we read it.
  softwareLd.aggregateRating = {
    '@type': 'AggregateRating',
    ratingValue: app.rating,
    reviewCount: app.reviews,
    bestRating: 5,
    worstRating: 1,
  };
  softwareLd.isBasedOn = app.app_store_url ?? undefined;
  softwareLd.dateModified = app.checked_on ?? undefined;
}
const jsonLd = [softwareLd, breadcrumbLd(base, crumbs)];

const params = [...url.searchParams.keys()];
Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=600');
---

<BaseLayout
  title={title}
  description={description}
  canonical={app.href}
  noindex={params.length > 0}
  {ogImage}
  ogImageAlt={ogImage ? `${name} on a real store` : undefined}
  jsonLd={jsonLd}
>
  <div class="container app">
    <Breadcrumbs items={crumbs} class="app__crumbs" />

    <header class="head">
      <div class="head__id">
        <AppIcon src={app.icon_url} name={name} size={64} class="head__icon" />
        <div class="head__names">
          <h1 class="display-md head__name">{name}</h1>
          {full && <p class="head__full">{full}</p>}
          <p class="head__line">
            {app.developer && <span>by {app.developer}</span>}
            {app.built_for_shopify && (
              <Badge tone="outline" size="sm" title="Built for Shopify badge on the App Store">
                Built for Shopify
              </Badge>
            )}
          </p>
        </div>
      </div>
      {app.tagline && <p class="lead head__tagline">{app.tagline}</p>}
      <ul class="head__meta" aria-label="Key facts">
        <li>
          <Rating rating={app.rating} reviews={app.reviews} source={listingSource} />
        </li>
        {app.category && (
          <li>
            <a href={app.category.href} class="head__chip">
              {app.category.name}
            </a>
          </li>
        )}
        {app.usage.rank && (
          <li class="num" title={`Rank by stores running it, of every app we track`}>
            {rankLabel(app.usage.rank)} overall
          </li>
        )}
        <li class="num" title={`${app.usage.stores} of ${denominator} scanned stores`}>
          {app.usage.stores.toLocaleString('en-US')} stores
        </li>
      </ul>
      <div class="head__actions">
        <SaveButton itemType="app" itemId={app.slug} size="md" class="head__save" />
        {pairs.length > 0 && (
          <Button href="#compare" size="md" icon="scales" class="head__compare">
            Compare
          </Button>
        )}
        {app.cta && ctaLabel ? (
          <AffiliateCta
            href={app.cta.href}
            label={ctaLabel}
            isAffiliate={app.cta.is_affiliate}
            size="md"
            class="head__cta"
          />
        ) : (
          <p class="head__nocta">No listing yet.</p>
        )}
      </div>
    </header>
  </div>

  <div class="tabbar">
    <div class="container">
      <Tabs items={tabs} label={`${name} sections`} size="sm" class="tabbar__tabs" />
    </div>
  </div>

  <div class="container">
    <div class="layout">
      <div class="layout__item layout__seen">
        <SeenOn
          detail={detail}
          device={device}
          selected={Number.isFinite(seenParam) ? seenParam : null}
          storesTotal={storesTotal}
          deviceHref={(d) =>
            `${urlWith(url, { device: d === 'desktop' ? null : d, seen: null }, true)}#where`
          }
          seenHref={(id) => `${urlWith(url, { seen: String(id) }, true)}#where`}
        />
      </div>

      <aside class="layout__aside" aria-label={`${name} facts`}>
        <FactsCard title={`${name} at a glance`} items={facts} sticky class="facts">
        </FactsCard>
      </aside>

      {app.plans.length > 0 && (
        <section class="layout__item block" id="plans" aria-labelledby="plans-title">
          <SectionHeader
            title="Pricing"
            id="plans-title"
            description={`${app.plans.length} ${app.plans.length === 1 ? 'plan' : 'plans'} as listed on the Shopify App Store, checked ${formatDate(app.checked_on)}. Prices in USD.`}
          />
          <PlanCards plans={app.plans} />
        </section>
      )}

      {(app.features.length > 0 || app.works_with.length > 0 || languages.length > 0) && (
        <section class="layout__item block" id="listing" aria-labelledby="listing-title">
          <SectionHeader
            title="From the listing"
            id="listing-title"
            description={`What ${name}’s App Store listing says it does, checked ${formatDate(app.checked_on)}.`}
          />
          <Card padding="none" class="listing">
            {app.features.length > 0 && (
              <ul class="listing__features">
                {app.features.map((f) => (
                  <li>
                    <Icon name="check-bold" size={14} class="listing__check" />
                    <span>{f}</span>
                  </li>
                ))}
              </ul>
            )}
            {(app.works_with.length > 0 || languages.length > 0) && (
              <dl class="listing__more">
                {app.works_with.length > 0 && (
                  <div>
                    <dt>Works with</dt>
                    <dd class="listing__chips">
                      {app.works_with.map((w) => (
                        <Badge size="sm">{w}</Badge>
                      ))}
                    </dd>
                  </div>
                )}
                {languages.length > 0 && (
                  <div>
                    <dt>Languages</dt>
                    <dd>{languages.join(', ')}</dd>
                  </div>
                )}
              </dl>
            )}
          </Card>
        </section>
      )}

      <section class="layout__item block" id="stores" aria-labelledby="stores-title">
        <SectionHeader
          title={`Stores running ${name}`}
          id="stores-title"
          count={storesTotal}
          description={`Found on ${storesTotal.toLocaleString('en-US')} of ${denominator.toLocaleString('en-US')} scanned stores (${sharePct(app.usage.share)}). Curated stores are mapped page by page.`}
        />
        <StoreShotGrid stores={shotStores} />
        <div class="table-wrap stores-wrap">
          <table class="table stores">
            <caption class="visually-hidden">Stores running{name}</caption>
            <thead>
              <tr>
                <th scope="col">Store</th>
                <th scope="col" class="stores__theme">
                  Theme
                </th>
                <th scope="col" class="is-num stores__apps">
                  Apps
                </th>
                <th scope="col" class="is-num">
                  Pages
                </th>
              </tr>
            </thead>
            <tbody>
              {storeRows.map((row) => (
                <tr>
                  <td>
                    <a href={row.store.href} class="stores__store">
                      <StoreMark domain={row.store.domain} name={row.store.name} size={28} />
                      <span class="stores__names">
                        <span class="stores__name">{row.store.display_name}</span>
                        <span class="stores__sub">
                          {row.store.name ? <span class="mono">{row.store.domain}</span> : null}
                          <span class="stores__sub-theme">{row.theme.label}</span>
                        </span>
                      </span>
                    </a>
                  </td>
                  <td
                    class:list={[
                      'stores__theme',
                      { stores__muted: row.theme.is_custom || !row.theme.theme },
                    ]}
                  >
                    {row.theme.theme ? (
                      <a href={row.theme.theme.href}>{row.theme.label}</a>
                    ) : (
                      row.theme.label
                    )}
                  </td>
                  <td class="is-num stores__apps">{row.app_count}</td>
                  <td class="is-num">
                    {row.is_captured ? (
                      <Badge size="sm" tone="positive" dot>
                        Captured
                      </Badge>
                    ) : row.store.is_curated ? (
                      <Badge size="sm" tone="neutral">
                        Layout preview
                      </Badge>
                    ) : (
                      <span class="stores__muted">Scan only</span>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <Pagination
          class="stores-pager"
          page={storesPage}
          pageSize={STORES_PAGE}
          total={storesTotal}
          noun="stores"
          hrefFor={(n) => `${urlWith(url, { p: n > 1 ? String(n) : null }, true)}#stores`}
        />
      </section>

      {(coInstalled.length > 0 || themes.length > 0) && (
        <section class="layout__item block" id="related" aria-labelledby="related-title">
          <SectionHeader
            title="Runs alongside"
            id="related-title"
            description={`Apps and themes on the ${storesTotal.toLocaleString('en-US')} stores running ${name}, by share of those stores.`}
          />
          <div class="related">
            {coInstalled.length > 0 && (
              <Card padding="sm" class="related__card">
                <h3 class="related__title">Installed alongside</h3>
                <ShareList
                  items={coInstalled}
                  kind="app"
                  shareOf={`of ${name} stores`}
                  label={`Apps installed alongside ${name}`}
                />
              </Card>
            )}
            {themes.length > 0 && (
              <Card padding="sm" class="related__card">
                <h3 class="related__title">Themes on these stores</h3>
                <ShareList
                  items={themes}
                  kind="theme"
                  shareOf={`of ${name} stores`}
                  label={`Themes on stores running ${name}`}
                />
                <p class="related__note">Tracked themes only; custom themes are left out.</p>
              </Card>
            )}
          </div>
        </section>
      )}

      {(alts.length > 0 || pairs.length > 0) && (
        <section class="layout__item block" id="alternatives" aria-labelledby="alts-title">
          <SectionHeader
            title={`Alternatives to ${name}`}
            id="alts-title"
            count={alts.length || undefined}
            description={
              app.category
                ? `Other ${app.category.name.toLowerCase()} apps, by stores running them.`
                : 'Apps that do the same job, by stores running them.'
            }
            href={alts.length ? altHref : undefined}
            linkLabel="All alternatives"
          />
          {alts.length > 0 && (
            <ul class="alts">
              {alts.slice(0, 4).map((a) => (
                <li>
                  <AltCard
                    app={a.app}
                    compareHref={a.compareHref}
                    versus={name}
                    sharedStores={a.sharedStores}
                    ratingSource={a.app.rating ? appStoreSource(appStoreAsOf) : undefined}
                  />
                </li>
              ))}
            </ul>
          )}
          {pairs.length > 0 && (
            <div class="compare" id="compare">
              <h3 class="compare__title">Head to head</h3>
              <PairList items={pairs.slice(0, 6)} label={`Comparisons with ${name}`} />
            </div>
          )}
        </section>
      )}

      <footer class="layout__item block sources">
        <SourceNote
          source={`${scan?.label ?? 'Our scan'}: stores, share, rank, co-installs, themes`}
        />
        <SourceNote
          source={
            listingRead
              ? 'Shopify App Store listing: rating, reviews, plans, features, languages'
              : 'Shopify App Store listing: not read yet for this app'
          }
          asOf={listingRead ? `checked ${formatDate(app.checked_on)}` : undefined}
          href=""
        />
      </footer>
    </div>
  </div>
</BaseLayout>

<script>
  // In-page tabs: the section under the sticky bars is the current tab (the shared indicator
  // slides to it). Scroll-driven so it is right at any position, including back at the top.
  const tabs = Array.from(document.querySelectorAll<HTMLAnchorElement>('.tabbar .tabs__item'));
  const targets = tabs.map((tab) => document.querySelector<HTMLElement>(tab.hash));
  const bar = document.querySelector<HTMLElement>('.tabbar');
  let frame = 0;
  const mark = () => {
    frame = 0;
    const line = (bar?.getBoundingClientRect().bottom ?? 0) + 96;
    let current = 0;
    targets.forEach((t, i) => {
      if (t && t.getBoundingClientRect().top <= line) current = i;
    });
    tabs.forEach((tab, i) => {
      if (i === current) tab.setAttribute('aria-current', 'page');
      else tab.removeAttribute('aria-current');
    });
  };
  if (tabs.length > 1) {
    addEventListener('scroll', () => (frame ||= requestAnimationFrame(mark)), { passive: true });
    mark();
  }
</script>

