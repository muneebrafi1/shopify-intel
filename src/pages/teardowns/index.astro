---
/**
 * /teardowns — the editorial index. The newest teardown leads as a big card (capture in a
 * product window, title, dek, facts); the rest follow as cards; then how a teardown is written
 * (detected data only).
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/ui/PageHeader.astro';
import Icon from '~/components/ui/Icon.astro';
import EmptyState from '~/components/ui/EmptyState.astro';
import Button from '~/components/ui/Button.astro';
import SourceNote from '~/components/ui/SourceNote.astro';
import TeardownCard from '~/components/domain/TeardownCard.astro';
import LeadTeardown from '~/components/teardowns/LeadTeardown.astro';
import { api } from '~/server/api';
import { formatDate } from '~/lib/format';

const [{ data }, { data: meta }] = await Promise.all([api.listTeardowns({}), api.getMeta({})]);
const items = [...data.items].sort(
  (a, b) =>
    (b.published_at ?? '').localeCompare(a.published_at ?? '') || b.note_count - a.note_count,
);
const [lead, ...rest] = items;
const asOf = formatDate(meta.data_as_of);

const site = Astro.site ?? Astro.url;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Shopify store teardowns',
  numberOfItems: items.length,
  itemListElement: items.map((t, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: t.title,
    url: new URL(t.href, site).href,
  })),
};
Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=600');
---

<BaseLayout
  title="Shopify store teardowns"
  description="Long reads on single Shopify stores: the theme, every detected app and where it shows up on the page. Written from detection data only, never estimates."
  jsonLd={jsonLd}
  canonical="/teardowns"
>
  <div class="container tds">
    <PageHeader
      title="Teardowns"
      count={items.length}
    >
    </PageHeader>

    {lead ? (
      <section class="tds__front" aria-label="Latest teardown">
        <LeadTeardown item={lead} />
      </section>
    ) : (
      <EmptyState
        title="No teardowns yet"
        body="The first ones are being written. Browse the stores in the meantime."
      >
        <Button href="/stores" size="sm">
          Browse stores
        </Button>
      </EmptyState>
    )}

    <div class:list={['tds__below', { 'tds__below--solo': rest.length === 0 }]}>
      {rest.length > 0 && (
        <section class="tds__rest" aria-labelledby="rest-title">
          <h2 id="rest-title" class="tds__h2">
            More teardowns <span class="tds__n num">{rest.length}</span>
          </h2>
          <div class="tds__grid">
            {rest.map((t) => (
              <TeardownCard
                slug={t.slug}
                title={t.title}
                dek={t.dek}
                storeLabel={t.store.domain}
                publishedAt={t.published_at}
                shot={t.cover ? t.cover.image : null}
                isSample={t.is_sample}
              />
            ))}
          </div>
        </section>
      )}

    </div>

    <SourceNote class="tds__source" source={meta.source.label} asOf={asOf} />
  </div>
</BaseLayout>

<style>
  .tds {
    padding-bottom: var(--space-16);
  }
  .tds__below {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-12);
    margin-top: var(--space-12);
  }
  @media (min-width: 1024px) {
    .tds__below {
      grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
      gap: var(--space-12);
      margin-top: var(--space-16);
    }
    .tds__below--solo {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .tds__h2 {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    font-size: var(--text-h4);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.01em;
  }
  .tds__n {
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 400;
  }
  .tds__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    margin-top: var(--space-5);
  }
  @media (min-width: 640px) {
    .tds__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .tds__steps {
    display: grid;
  }
  .tds__steps li {
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr);
    gap: var(--space-2);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--line);
  }
  .tds__step-n {
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 22px;
  }
  .tds__steps h3 {
    color: var(--ink);
    font-size: var(--text-ui);
    font-weight: var(--weight-semibold);
    line-height: 22px;
  }
  .tds__steps p {
    margin-top: var(--space-1);
    color: var(--ink-2);
    font-size: var(--text-sm);
    line-height: 1.55;
  }
  .tds__method {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 40px;
    margin-top: var(--space-2);
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }
  .tds__method :global(.icon) {
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .tds__method:hover :global(.icon) {
    transform: translateX(2px);
  }
  .tds :global(.tds__source) {
    margin-top: var(--space-12);
  }
</style>
