---
/**
 * /teardowns/<slug> — a long read on one store (reading pattern).
 * 680px column: kicker, display-lg title, dek, byline "Editorial team · date", the store's home
 * capture, the article. Beside it (≥1024, sticky): the store's facts card and, ≥1200, the table
 * of contents. Then the notes pinned to sections on the captures (numbers match the store
 * page's sections rail), the stack and more teardowns.
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/ui/Breadcrumbs.astro';
import SectionHeader from '~/components/ui/SectionHeader.astro';
import SourceNote from '~/components/ui/SourceNote.astro';
import FactsCard from '~/components/ui/FactsCard.astro';
import type { Fact } from '~/components/ui/Facts.astro';
import Button from '~/components/ui/Button.astro';
import Badge from '~/components/ui/Badge.astro';
import Window from '~/components/ui/Window.astro';
import Shot from '~/components/media/Shot.astro';
import TeardownCard from '~/components/domain/TeardownCard.astro';
import StackSheet from '~/components/stores/StackSheet.astro';
import AnnotatedPlates from '~/components/teardowns/AnnotatedPlates.astro';
import { renderMarkdown } from '~/components/teardowns/markdown';
import { api, orNotFound } from '~/server/api';
import { SITE_NAME } from '~/config/site';
import { formatCount, formatDate } from '~/lib/format';

const slug = Astro.params.slug ?? '';
const res = slug ? await orNotFound(api.getTeardown({ slug })) : null;
if (!res) return Astro.rewrite('/404');

const { data, meta } = res;
const { teardown, store: detail, notes } = data;
const store = detail.store;
const { data: list } = await api.listTeardowns({});
const ordered = [...list.items].sort(
  (a, b) =>
    (b.published_at ?? '').localeCompare(a.published_at ?? '') || b.note_count - a.note_count,
);
const others = ordered.filter((t) => t.slug !== teardown.slug).slice(0, 3);

const body = renderMarkdown(teardown.body_md);
const words =
  teardown.body_md.split(/\s+/).length + notes.reduce((n, x) => n + x.body.split(/\s+/).length, 0);
const minutes = Math.max(1, Math.round(words / 220));
const captures = new Set(notes.map((n) => `${n.page_type}-${n.device}`)).size;
const source = meta.sources[detail.detection.source];
const asOf = formatDate(source?.as_of ?? detail.detection.last_seen);
const isPreview = detail.pages.some((p) => p.is_placeholder);
const title = store.name ?? store.domain;
const cover = teardown.cover;

const facts: Fact[] = [
  { label: 'Store', value: store.domain, href: store.href, mono: true },
  {
    label: 'Theme',
    value: store.theme.label,
    ...(store.theme.theme ? { href: store.theme.theme.href } : {}),
  },
  { label: 'Apps', value: `${store.app_count} detected`, href: '#stack' },
  {
    label: 'Pixels',
    value: detail.pixels.length ? detail.pixels.map((p) => p.name).join(', ') : 'None detected',
  },
  { label: 'Currency', value: store.currency ?? '—', mono: !!store.currency },
  {
    label: 'Tranco rank',
    value: store.tranco_rank ? formatCount(store.tranco_rank) : 'Not ranked',
    mono: !!store.tranco_rank,
  },
  { label: 'Detected', value: formatDate(detail.detection.last_seen), mono: true },
];
const toc = [
  ...body.headings.filter((h) => h.level === 2).map((h) => ({ href: `#${h.id}`, text: h.text })),
  ...(notes.length ? [{ href: '#notes', text: 'Notes on the captures' }] : []),
  { href: '#stack', text: 'The stack' },
];

const plateParam = Astro.url.searchParams.get('plate');
const site = Astro.site ?? Astro.url;
const pageUrl = new URL(teardown.href, site).href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Teardowns',
        item: new URL('/teardowns', site).href,
      },
      { '@type': 'ListItem', position: 2, name: teardown.title, item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: teardown.title,
    ...(teardown.dek ? { description: teardown.dek } : {}),
    ...(teardown.published_at
      ? { datePublished: teardown.published_at, dateModified: teardown.published_at }
      : {}),
    author: { '@type': 'Organization', name: SITE_NAME, url: new URL('/about', site).href },
    publisher: { '@type': 'Organization', name: SITE_NAME },
    mainEntityOfPage: pageUrl,
    wordCount: words,
    about: { '@type': 'OnlineStore', name: title, url: store.url },
  },
];

Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=600');
---

<BaseLayout
  title={teardown.title}
  description={
    teardown.dek ??
    `A teardown of ${store.domain}: theme, apps and where each one shows up on the page.`
  }
  canonical={teardown.href}
  jsonLd={jsonLd}
>
  <article class="td">
    <div class="container">
      <Breadcrumbs items={[{ label: 'Teardowns', href: '/teardowns' }, { label: title }]} />

      <div class="td__layout">
        <div class="td__main">
          <header class="td__head">
            <p class="td__kicker">
              <span>Teardown</span>
              {teardown.is_sample && (
                <Badge tone="caution" size="sm">
                  Sample · detected data only
                </Badge>
              )}
            </p>
            <h1 class="td__title display-lg">{teardown.title}</h1>
            {teardown.dek && <p class="td__dek lead">{teardown.dek}</p>}
            <p class="td__byline">
              <span class="td__author">Editorial team</span>
              {teardown.published_at && (
                <time datetime={teardown.published_at}>{formatDate(teardown.published_at)}</time>
              )}
              <span>{minutes} min read</span>
            </p>
          </header>

          {cover && (
            <figure class="td__cover">
              <Window url={store.domain}>
                <Shot
                  src={cover.image.src}
                  width={cover.image.width}
                  height={cover.image.height}
                  device="desktop"
                  alt={`${title} home page${cover.is_placeholder ? ' (layout preview, not a screenshot)' : ''}`}
                  ratio="16 / 9"
                  eager
                  flush
                />
              </Window>
              <figcaption>
                {title} home page, desktop
                {cover.is_placeholder
                  ? ' · layout preview drawn from the sections we expect, not a screenshot'
                  : cover.captured_at
                    ? ` · captured ${formatDate(cover.captured_at)}`
                    : ''}
              </figcaption>
            </figure>
          )}

          <div class="prose td-prose" set:html={body.html} />
        </div>

        <aside class="td__aside" aria-label="The store and contents">
          <FactsCard title="The store" items={facts} source={source?.label} class="td__sheet">
            <Button
              slot="actions"
              href={store.href}
              variant="secondary"
              size="sm"
              arrow
              full
              class="td__open"
            >
              Open the store page
            </Button>
          </FactsCard>
          <nav class="td__toc" aria-label="On this page" data-toc>
            <p class="eyebrow">On this page</p>
            <ol>
              {toc.map((t) => (
                <li>
                  <a href={t.href}>{t.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        </aside>
      </div>
    </div>

    {notes.length > 0 && (
      <section id="notes" class="container td__notes" aria-labelledby="notes-title">
        <SectionHeader
          id="notes-title"
          title="Notes on the captures"
          count={notes.length}
          description={
            isPreview
              ? `Each note points at one section, pinned on ${captures === 1 ? 'the capture' : `${captures} captures`}. The pages are layout previews, drawn from the sections we expect, until the store is captured.`
              : `Each note points at one section, pinned on ${captures === 1 ? 'the capture' : `${captures} captures`}.`
          }
          rule
        />
        <AnnotatedPlates notes={notes} store={detail} basePath={store.href} plate={plateParam} />
      </section>
    )}

    <section id="stack" class="container td__stack" aria-labelledby="stack-title">
      <SectionHeader
        id="stack-title"
        title="The stack"
        count={store.app_count}
        description={`Everything the ${asOf} scan detected on ${store.domain}. Placements link to the section on the store page.`}
        rule
      />
      <StackSheet detail={detail} basePath={store.href} class="td__stacksheet" />
    </section>

    {others.length > 0 && (
      <section class="container td__more" aria-labelledby="more-title">
        <SectionHeader
          id="more-title"
          title="More teardowns"
          href="/teardowns"
          linkLabel="All teardowns"
          rule
        />
        <div class="td__more-grid" style={`--cols:${Math.min(others.length, 3)}`}>
          {others.map((t) => (
            <TeardownCard
              slug={t.slug}
              title={t.title}
              dek={t.dek}
              storeLabel={t.store.domain}
              publishedAt={t.published_at}
              shot={t.cover ? t.cover.image : null}
              isSample={t.is_sample}
            />
          ))}
        </div>
      </section>
    )}

    <div class="container">
      <SourceNote
        class="td__source"
        source={`${source?.label ?? detail.detection.source}${teardown.is_sample ? '. Sample teardown: written from detected data only' : ''}`}
        asOf={asOf}
      />
    </div>
  </article>
</BaseLayout>

<script>
  // Mark the table-of-contents entry for the section being read.
  document.querySelectorAll<HTMLElement>('[data-toc]').forEach((toc) => {
    const links = new Map<Element, HTMLAnchorElement>();
    toc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((a) => {
      const target = document.getElementById(decodeURIComponent(a.hash.slice(1)));
      if (target) links.set(target, a);
    });
    if (!links.size) return;
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          links.forEach((a, el) => a.toggleAttribute('aria-current', el === entry.target));
        }
      },
      { rootMargin: '-15% 0px -75% 0px' },
    );
    links.forEach((_, el) => observer.observe(el));
  });
</script>

<style>
  .td :global(nav[aria-label='Breadcrumb']) {
    padding-top: var(--space-6);
  }
  @media (min-width: 1024px) {
    .td :global(nav[aria-label='Breadcrumb']) {
      padding-top: var(--space-8);
    }
  }

  /* Reading column + sticky aside */
  .td__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-12);
  }
  @media (min-width: 1024px) {
    .td__layout {
      grid-template-columns: minmax(0, var(--reading-max)) 300px;
      justify-content: space-between;
      gap: var(--space-12);
    }
  }
  @media (min-width: 1200px) {
    .td__layout {
      grid-template-columns: minmax(0, var(--reading-max)) 320px;
    }
  }
  .td__main {
    min-width: 0;
    max-width: var(--reading-max);
  }
  .td__head {
    padding-block: var(--space-8) var(--space-8);
  }
  @media (min-width: 1024px) {
    .td__head {
      padding-block: var(--space-10);
    }
  }
  .td__kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    color: var(--accent-text);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
  }
  .td__kicker :global(.badge) {
    text-transform: none;
    letter-spacing: 0;
    font-family: var(--font-sans);
  }
  .td__title {
    margin-top: var(--space-4);
    text-wrap: balance;
  }
  .td__dek {
    margin-top: var(--space-4);
  }
  .td__byline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) 0;
    margin-top: var(--space-6);
    color: var(--ink-3);
    font-size: var(--text-sm);
  }
  .td__byline > * + *::before {
    content: '·';
    margin-inline: var(--space-2);
    color: var(--ink-4);
  }
  .td__author {
    color: var(--ink);
    font-weight: var(--weight-medium);
  }

  .td__cover {
    margin-bottom: var(--space-10);
  }
  .td__cover figcaption {
    margin-top: var(--space-3);
    color: var(--ink-3);
    font-size: var(--text-xs);
    line-height: 1.5;
  }

  /* Article typography (on top of .prose) */
  .td-prose {
    font-size: 1.0625rem;
    line-height: 1.7;
  }
  .td-prose :global(> * + *) {
    margin-top: var(--space-5);
  }
  .td-prose :global(h2) {
    margin-top: var(--space-12);
    font-size: var(--text-h3);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.015em;
    line-height: 1.3;
    scroll-margin-top: calc(var(--header-h) + var(--space-6));
  }
  .td-prose :global(h3) {
    scroll-margin-top: calc(var(--header-h) + var(--space-6));
  }
  .td-prose :global(h2 + *),
  .td-prose :global(h3 + *) {
    margin-top: var(--space-3);
  }
  /* Editor's note: a quiet callout. */
  .td-prose :global(.md-note) {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-well);
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--line);
    font-size: var(--text-ui);
    line-height: 1.6;
  }
  .td-prose :global(.md-note__label) {
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
  }
  .td-prose :global(.md-note p + p) {
    margin-top: var(--space-2);
  }
  /* Numbered takeaways on hairlines (the text sits in its own cell next to the number). */
  .td-prose :global(ol.md-ol) {
    padding-left: 0;
    list-style: none;
    counter-reset: learn;
    border-top: 1px solid var(--line);
  }
  .td-prose :global(ol.md-ol li) {
    counter-increment: learn;
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    gap: var(--space-2);
    margin-top: 0;
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--line);
    color: var(--ink);
  }
  .td-prose :global(ol.md-ol li::before) {
    content: counter(learn, decimal-leading-zero);
    padding-top: 0.3em;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  /* Aside: the store's facts, then the table of contents (≥1200). Sticky from 1024. */
  .td__aside {
    display: grid;
    gap: var(--space-8);
    align-content: start;
    min-width: 0;
  }
  @media (min-width: 1024px) {
    .td__aside {
      position: sticky;
      top: calc(var(--header-h) + var(--space-6));
      align-self: start;
      margin-top: var(--space-10);
    }
  }
  .td__toc {
    display: none;
  }
  @media (min-width: 1200px) {
    .td__toc {
      display: block;
    }
    .td__toc ol {
      margin-top: var(--space-3);
      border-left: 1px solid var(--line);
    }
    .td__toc a {
      display: block;
      margin-left: -1px;
      padding: 5px 0 5px var(--space-4);
      border-left: 1px solid transparent;
      color: var(--ink-3);
      font-size: var(--text-sm);
      line-height: 1.4;
      transition:
        color var(--dur-fast) var(--ease-out),
        border-color var(--dur-fast) var(--ease-out);
    }
    .td__toc a:hover {
      color: var(--ink);
      border-left-color: var(--ink-3);
    }
    .td__toc a[aria-current] {
      color: var(--ink);
      border-left-color: var(--accent);
    }
  }

  .td__notes {
    margin-top: var(--space-16);
    scroll-margin-top: var(--header-h);
  }
  @media (min-width: 1024px) {
    .td__notes {
      margin-top: var(--space-20);
    }
  }
  .td__notes :global(.tdplates) {
    margin-top: var(--space-6);
  }
  .td__stack,
  .td__more {
    margin-top: var(--space-16);
    scroll-margin-top: var(--header-h);
  }
  .td__stack :global(.td__stacksheet) {
    margin-top: var(--space-6);
  }
  .td__more-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    margin-top: var(--space-6);
  }
  @media (min-width: 640px) {
    .td__more-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .td__more-grid {
      grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr));
    }
  }
  .container :global(.td__source) {
    margin-block: var(--space-12) var(--space-16);
  }
</style>
