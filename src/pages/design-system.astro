/* ---------- Fixtures: drawn placeholder captures (same renderer as the site) ---------- */
type Layout = [string, number][];
function stack(layout: Layout): PlaceholderSection[] {
  let y = 0;
  return layout.map(([type, height]) => {
    const s = { type, y, height };
    y += height;
    return s;
  });
}
const HOME_D: Layout = [
  ['announcement-bar', 40],
  ['header', 84],
  ['hero', 680],
  ['featured-collection', 640],
  ['image-with-text', 600],
  ['logo-list', 200],
  ['testimonials', 380],
  ['newsletter', 340],
  ['footer', 440],
];
