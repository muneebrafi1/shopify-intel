const dataUri = (svg: string) => `data:image/svg+xml;charset=utf-8,${encodeURIComponent(svg)}`;
function shot(
  seed: string,
  label: string,
  device: 'desktop' | 'mobile',
  sections: PlaceholderSection[],
  pageType = 'home',
) {
  const width = device === 'desktop' ? 1440 : 390;
  const height = sections.reduce((m, s) => Math.max(m, s.y + s.height), 0);
  const src = dataUri(
    renderPlaceholderSvg({ seed, label, device, pageType, width, height, sections }),
  );
  return { src, width, height, device, sections };
}
function crop(
  seed: string,
  label: string,
  device: 'desktop' | 'mobile',
  sections: PlaceholderSection[],
  type: string,
) {
  const width = device === 'desktop' ? 1440 : 390;
  const height = sections.reduce((m, s) => Math.max(m, s.y + s.height), 0);
  const s = sections.find((x) => x.type === type)!;
  const svg = renderPlaceholderSvg(
    { seed, label, device, width, height, sections },
    { crop: { y: s.y, height: s.height } },
  );
  return { src: dataUri(svg), width, height: s.height };
}
