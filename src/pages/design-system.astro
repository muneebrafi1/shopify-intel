    gap: var(--space-4);
    min-width: 0;
  }
  .ds-canvas.ds-stack {
    gap: var(--space-6);
  }
  .ds-hide-sm {
    display: none;
  }
  @media (min-width: 640px) {
    .ds-hide-sm {
      display: revert;
    }
