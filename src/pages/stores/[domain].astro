---
/**
 * /stores/<domain> — a store as an app view (the product's centrepiece).
 * Breadcrumb → identity row (mark, name, domain, theme and app chips; Visit, Save, Compare) →
 * the viewer (page tabs, Desktop/Mobile, full-page capture with pinned section tags and the
 * sections rail; ?page=&device=) or, for stores we only detected, an honest "not captured"
 * state → a sticky facts card (≥1024) with the teardown link → detected apps → similar
 * stores. Unknown and opted-out domains 404 (the API only serves active stores).
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/ui/Breadcrumbs.astro';
import SectionHeader from '~/components/ui/SectionHeader.astro';
import FactsCard from '~/components/ui/FactsCard.astro';
import type { Fact } from '~/components/ui/Facts.astro';
import Button from '~/components/ui/Button.astro';
import Badge from '~/components/ui/Badge.astro';
import Icon from '~/components/ui/Icon.astro';
import StoreMark from '~/components/ui/StoreMark.astro';
import SaveButton from '~/components/domain/SaveButton.astro';
import StoreViewer from '~/components/stores/StoreViewer.astro';
import NotCaptured from '~/components/stores/NotCaptured.astro';
import StackSheet from '~/components/stores/StackSheet.astro';
import SimilarStores from '~/components/stores/SimilarStores.astro';
import StoreTeardown from '~/components/stores/StoreTeardown.astro';
import { api, orNotFound } from '~/server/api';
import { formatCount, formatDate } from '~/lib/format';
import { parsePlate } from '~/components/stores/plates';
import { themeName } from '~/components/stores/query';
import { ogCaptureSrc } from '~/lib/media';

const param = (Astro.params.domain ?? '').trim();
const res = param ? await orNotFound(api.getStore({ domain: param })) : null;
if (!res) return Astro.rewrite('/404');

const { data: detail, meta } = res;
const store = detail.store;
// Canonical domain (case, www., trailing dots): one URL per store.
if (store.domain !== param) {
  return Astro.redirect(`${store.href}${Astro.url.search}`, 301);
}

const teardownRes = detail.teardown
  ? await orNotFound(api.getTeardown({ slug: detail.teardown.slug }))
  : null;
const basePath = store.href;
const hasPlates = detail.pages.length > 0;
const ogShot =
  detail.pages.find((p) => p.page_type.slug === 'home')?.screenshots.desktop ??
  detail.pages[0]?.screenshots.desktop ??
  detail.pages[0]?.screenshots.mobile;
const ogImage = ogCaptureSrc(ogShot);
const { page, device } = parsePlate(
  Astro.url,
  detail.pages.map((p) => p.page_type.slug),
);
const title = store.name ?? store.domain;
const source = meta.sources[detail.detection.source];
const sourceLabel = source?.label ?? detail.detection.source;
const asOf = formatDate(source?.as_of ?? detail.detection.last_seen);
const firstSeen = formatDate(detail.detection.first_seen);
const lastSeen = formatDate(detail.detection.last_seen);

let regionName: string | null = null;
if (store.country) {
  try {
    regionName =
      new Intl.DisplayNames(['en'], { type: 'region' }).of(store.country) ?? store.country;
  } catch {
    regionName = store.country;
  }
}

const facts: Fact[] = [
  {
    label: 'Theme',
    value: store.theme.label,
    ...(store.theme.theme ? { href: store.theme.theme.href } : {}),
  },
  {
    label: 'Apps',
    value: `${store.app_count} detected`,
    href: '#apps',
  },
  {
    label: 'Category',
    value: store.category?.name ?? '—',
    ...(store.category ? { href: store.category.href } : {}),
  },
  { label: 'Country', value: regionName ?? '—' },
  { label: 'Currency', value: store.currency ?? '—', mono: !!store.currency },
  {
    label: 'Tranco rank',
    value: store.tranco_rank ? formatCount(store.tranco_rank) : 'Not ranked',
    mono: !!store.tranco_rank,
    title: 'Position in the Tranco top-sites list',
  },
  {
    label: 'Pixels',
    value: detail.pixels.length ? detail.pixels.map((p) => p.name).join(', ') : 'None detected',
  },
  {
    label: 'Detected',
    value: firstSeen === lastSeen ? firstSeen : `${firstSeen} – ${lastSeen}`,
    mono: true,
  },
];
const hasSimilar = detail.similar.length > 0;

// ---- SEO ----------------------------------------------------------------------------------
const site = Astro.site ?? Astro.url;
const pageUrl = new URL(basePath, site).href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Stores', item: new URL('/stores', site).href },
      { '@type': 'ListItem', position: 2, name: title, item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: `${title} — Shopify theme, apps and pages`,
    url: pageUrl,
    dateModified: detail.detection.last_seen.slice(0, 10),
    about: {
      '@type': 'OnlineStore',
      name: title,
      url: store.url,
      ...(store.country
        ? { address: { '@type': 'PostalAddress', addressCountry: store.country } }
        : {}),
      ...(store.currency ? { currenciesAccepted: store.currency } : {}),
    },
  },
];
const description = hasPlates
  ? `${title} runs ${store.theme.label} with ${store.app_count} detected apps. See its home, collection, product and cart pages on desktop and mobile, section by section, and where each app renders.`
  : `${store.domain} runs ${store.theme.label} with ${store.app_count} detected Shopify apps (scan of ${asOf}). Screenshots are not captured yet.`;

Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=600');
---

<BaseLayout
  title={
    hasPlates
      ? `${title}: Shopify theme, apps and pages`
      : `${store.domain}: Shopify theme and apps`
  }
  description={description}
  canonical={basePath}
  noindex={!hasPlates}
  ogImage={ogImage}
  ogImageAlt={ogImage ? `${title} home page capture` : undefined}
  jsonLd={jsonLd}
  wide
>
  <div class="container--wide store">
    <header class="sid">
      <Breadcrumbs items={[{ label: 'Stores', href: '/stores' }, { label: title }]} />
      <div class="sid__row">
        <div class="sid__main">
          <StoreMark domain={store.domain} name={store.name} size={52} class="sid__mark" />
          <div class="sid__text">
            <h1 class="sid__name display-md">{title}</h1>
            <p class="sid__meta">
              {store.name && <span class="sid__domain mono">{store.domain}</span>}
              {store.theme.theme ? (
                <a class="sid__chip" href={store.theme.theme.href}>
                  <Icon name="paint-brush" size={14} />
                  {themeName(store.theme)}
                  {store.theme.version && (
                    <span class="sid__chip-mono mono">{store.theme.version}</span>
                  )}
                </a>
              ) : (
                <span class="sid__chip sid__chip--static">
                  <Icon name="paint-brush" size={14} />
                  {store.theme.label}
                </span>
              )}
              <a class="sid__chip" href="#apps">
                <Icon name="puzzle-piece" size={14} />
                <span class="num">{store.app_count}</span>
                {store.app_count === 1 ? 'app' : 'apps'}
              </a>
              {store.is_curated ? (
                <Badge tone="accent" title="Mapped page by page, section by section">
                  Curated
                </Badge>
              ) : (
                <Badge tone="neutral">Detected only</Badge>
              )}
            </p>
          </div>
        </div>
        <div class="sid__actions">
          <Button
            href={store.url}
            variant="primary"
            iconRight="arrow-up-right"
            external
            class="sid__visit"
          >
            Visit store
          </Button>
          <SaveButton itemType="store" itemId={store.domain} size="md" />
          {hasSimilar && (
            <Button
              href="#similar"
              variant="secondary"
              icon="arrows-down-up"
              title="Compare with similar stores"
            >
              Compare
            </Button>
          )}
        </div>
      </div>
    </header>

    <div class:list={['store__layout', { 'store__layout--empty': !hasPlates }]}>
      <div class="store__main">
        {hasPlates ? (
          <StoreViewer
            basePath={basePath}
            domain={store.domain}
            storeLabel={title}
            pages={detail.pages}
            page={page}
            device={device}
          />
        ) : (
          <NotCaptured
            domain={store.domain}
            detectedOn={detail.detection.first_seen}
            appCount={store.app_count}
            themeLabel={store.theme.label}
            pixelCount={detail.pixels.length}
          />
        )}
      </div>

      <aside class="store__aside" aria-label="Store facts">
        <FactsCard title="Store facts" items={facts} source={sourceLabel}>
          <p slot="footer" class="store__optout">
            Your store?{' '}
            <a href={`/opt-out?domain=${encodeURIComponent(store.domain)}`}>Request removal</a> or a
            correction.
          </p>
        </FactsCard>
        {detail.teardown && (
          <StoreTeardown
            href={detail.teardown.href}
            title={detail.teardown.title}
            dek={teardownRes?.data.teardown.dek ?? null}
            isSample={teardownRes?.data.teardown.is_sample ?? false}
            noteCount={teardownRes?.data.notes.length ?? 0}
            publishedAt={teardownRes?.data.teardown.published_at ?? null}
          />
        )}
      </aside>

      <section id="apps" class="store__apps" aria-labelledby="apps-title">
        <SectionHeader
          id="apps-title"
          title="Detected apps"
          count={store.app_count}
          description={
            hasPlates
              ? `The theme and apps detected on ${lastSeen}, by category, with the section each app is attributed to on the pages above.`
              : `The theme and apps detected on ${lastSeen}, by category, with where apps of each kind usually render.`
          }
        />
        <StackSheet detail={detail} basePath={basePath} class="store__stack" />
      </section>
    </div>

    {hasSimilar && (
      <section id="similar" class="store__similar" aria-labelledby="similar-title">
        <SectionHeader
          id="similar-title"
          title="Similar stores"
          count={detail.similar.length}
          description="Compare with stores that share apps or the theme. Ranked by apps in common, with extra weight for the same theme; from the same scan."
          href={store.theme.theme ? `/stores?theme=${store.theme.theme.slug}&scope=all` : undefined}
          linkLabel={store.theme.theme ? `All stores on ${store.theme.theme.name}` : undefined}
          rule
        />
        <SimilarStores items={detail.similar} />
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .store {
    padding-bottom: var(--space-20);
  }

  /* Identity row */
  .sid {
    padding-block: var(--space-6) var(--space-6);
  }
  @media (min-width: 1024px) {
    .sid {
      padding-block: var(--space-8);
    }
  }
  .sid__row {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    margin-top: var(--space-5);
  }
  @media (min-width: 1024px) {
    .sid__row {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-10);
      margin-top: var(--space-6);
    }
  }
  .sid__main {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-width: 0;
  }
  .sid__main :global(.sid__mark) {
    align-self: flex-start;
    margin-top: 2px;
  }
  .sid__text {
    min-width: 0;
  }
  .sid__name {
    overflow-wrap: anywhere;
  }
  .sid__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }
  .sid__domain {
    margin-right: var(--space-1);
    color: var(--ink-2);
    font-size: var(--text-sm);
  }
  .sid__chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 26px;
    padding: 0 10px;
    border-radius: var(--radius-pill);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line-strong);
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    white-space: nowrap;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out);
  }
  .sid__chip :global(.icon) {
    color: var(--ink-3);
  }
  a.sid__chip:hover {
    background: var(--surface-2);
  }
  .sid__chip--static {
    color: var(--ink-2);
  }
  .sid__chip-mono {
    color: var(--ink-3);
    font-size: var(--text-xs);
    font-weight: 400;
  }
  .sid__actions {
    display: flex;
    flex: none;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  /* Main column + sticky facts (≥1024). Below that: viewer, facts, apps. */
  .store__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'main' 'aside' 'apps';
    gap: var(--space-8);
  }
  @media (min-width: 1024px) {
    .store__layout {
      grid-template-columns: minmax(0, 1fr) 300px;
      grid-template-areas:
        'main aside'
        'apps aside';
      grid-template-rows: auto 1fr;
      column-gap: var(--space-8);
      row-gap: var(--space-12);
    }
  }
  @media (min-width: 1280px) {
    .store__layout {
      grid-template-columns: minmax(0, 1fr) 320px;
      column-gap: var(--space-10);
    }
  }
  .store__main {
    grid-area: main;
    min-width: 0;
  }
  .store__aside {
    grid-area: aside;
    display: grid;
    gap: var(--space-4);
    align-content: start;
    min-width: 0;
  }
  @media (min-width: 1024px) {
    .store__aside {
      position: sticky;
      top: calc(var(--header-h) + var(--space-4));
      align-self: start;
    }
  }
  .store__apps {
    grid-area: apps;
    min-width: 0;
    scroll-margin-top: calc(var(--header-h) + var(--space-4));
  }
  .store__apps :global(.store__stack) {
    margin-top: var(--space-5);
  }
  .store__optout {
    margin-top: 6px;
  }
  .store__optout a {
    color: var(--ink-2);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
  }
  .store__similar {
    margin-top: var(--space-16);
    scroll-margin-top: calc(var(--header-h) + var(--space-4));
  }
  .store__similar :global(.similar) {
    margin-top: var(--space-6);
  }
</style>
