---
/**
 * Account overview — designed placeholder until accounts open with Pro (Whop). Shows the slots
 * the real page will fill (plan, boards, settings) with honest empty values. noindex.
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import Button from '~/components/ui/Button.astro';
import MonoLabel from '~/components/ui/MonoLabel.astro';
import AccountShell from '~/components/static/AccountShell.astro';

Astro.response.headers.set('Cache-Control', 'no-store');

const SETTINGS = [
  {
    title: 'Email address',
    body: 'Where sign-in links and receipts go.',
    action: 'Change',
  },
  {
    title: 'Theme-switch alerts',
    body: 'An email when a store you follow changes theme. Pro.',
    action: 'Turn on',
  },
  {
    title: 'Billing',
    body: 'Plan, invoices and cancellation are managed on Whop.',
    action: 'Open Whop',
  },
  {
    title: 'Delete account',
    body: 'Removes your account and every board. This can’t be undone.',
    action: 'Delete',
  },
];
---

<BaseLayout title="Account" description="Your plan, boards and settings." noindex>
  <AccountShell current="overview">
    <header class="ov__head">
      <h1 class="ov__title">Account</h1>
    </header>

    <dl class="ov__spec">
      <div class="ov__row">
        <dt>
          <MonoLabel>Plan</MonoLabel>
        </dt>
        <dd>
          <span class="ov__value">Free</span>
          <a class="ov__link" href="/pro">
            Compare plans <span aria-hidden="true">→</span>
          </a>
        </dd>
      </div>
      <div class="ov__row">
        <dt>
          <MonoLabel>Boards</MonoLabel>
        </dt>
        <dd>
          <span class="ov__value num">0</span>
          <a class="ov__link" href="/account/boards">
            Open boards <span aria-hidden="true">→</span>
          </a>
        </dd>
      </div>
      <div class="ov__row">
        <dt>
          <MonoLabel>Email</MonoLabel>
        </dt>
        <dd>
          <span class="ov__value ov__value--muted">Not signed in</span>
        </dd>
      </div>
      <div class="ov__row">
        <dt>
          <MonoLabel>Member since</MonoLabel>
        </dt>
        <dd>
          <span class="ov__value ov__value--muted">—</span>
        </dd>
      </div>
    </dl>

    <section class="ov__settings" aria-labelledby="settings-title">
      <h2 class="ov__h2" id="settings-title">
        Settings
      </h2>
      <p class="ov__sub">Available once you’re signed in.</p>
      <ul class="ov__list">
        {SETTINGS.map((s) => (
          <li class="ov__setting">
            <div>
              <h3 class="ov__setting-title">{s.title}</h3>
              <p class="ov__setting-body">{s.body}</p>
            </div>
            <Button variant="secondary" size="sm" disabled>
              {s.action}
            </Button>
          </li>
        ))}
      </ul>
    </section>
  </AccountShell>
</BaseLayout>

<style>
  .ov__head {
    padding-block: var(--space-8) var(--space-6);
  }
  .ov__title {
    font-size: var(--text-3xl);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
  }
  .ov__spec {
    max-width: 720px;
    border-top: 1px solid var(--ink);
  }
  .ov__row {
    display: grid;
    grid-template-columns: minmax(0, 9rem) minmax(0, 1fr);
    gap: var(--space-4);
    align-items: center;
    min-height: 52px;
    border-bottom: 1px solid var(--line);
  }
  .ov__row dd {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-1) var(--space-4);
  }
  .ov__value {
    color: var(--ink);
    font-size: var(--text-md);
    font-weight: var(--weight-medium);
  }
  .ov__value--muted {
    color: var(--ink-3);
    font-weight: var(--weight-regular);
  }
  .ov__link {
    color: var(--ink-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .ov__link:hover {
    color: var(--ink);
  }
  .ov__settings {
    max-width: 720px;
    margin-top: var(--space-16);
  }
  .ov__h2 {
    font-size: var(--text-xl);
    letter-spacing: var(--tracking-snug);
  }
  .ov__sub {
    margin-top: var(--space-1);
    color: var(--ink-3);
  }
  .ov__list {
    margin-top: var(--space-5);
    border-top: 1px solid var(--line);
  }
  .ov__setting {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--line);
  }
  .ov__setting-title {
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
  }
  .ov__setting-body {
    margin-top: 2px;
    color: var(--ink-3);
    font-size: var(--text-sm);
  }
  @media (min-width: 1024px) {
    .ov__head {
      padding-top: var(--space-10);
    }
  }
</style>
