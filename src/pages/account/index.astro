---
/**
 * Account overview — designed placeholder until accounts open with Pro (Whop). Shows the slots
 * the real page will fill (plan, boards, profile, settings) with honest empty values. noindex.
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import Badge from '~/components/ui/Badge.astro';
import Button from '~/components/ui/Button.astro';
import Card from '~/components/ui/Card.astro';
import AccountShell from '~/components/static/AccountShell.astro';
import { MONTHLY_PRICE } from '~/components/static/content';

Astro.response.headers.set('Cache-Control', 'no-store');

const SETTINGS = [
  {
    title: 'Email address',
    body: 'Where sign-in links and receipts go.',
    action: 'Change',
  },
  {
    title: 'Theme-switch alerts',
    body: 'An email when a store you follow changes theme. Pro.',
    action: 'Turn on',
  },
  {
    title: 'Billing',
    body: 'Plan, invoices and cancellation are managed on Whop.',
    action: 'Open Whop',
  },
  {
    title: 'Delete account',
    body: 'Removes your account and every board. This can’t be undone.',
    action: 'Delete',
  },
];
---

<BaseLayout title="Account" description="Your plan, boards and settings." noindex>
  <AccountShell current="overview">
    <header class="ov__head">
      <h1 class="h2">Account</h1>
      <p class="ov__sub">Your plan, boards and settings.</p>
    </header>

    <div class="ov__grid">
      <Card padding="md" class="ov__card">
        <p class="ov__label">Plan</p>
        <p class="ov__value">
          Free{' '}
          <Badge tone="neutral" size="sm">
            Current
          </Badge>
        </p>
        <p class="ov__note">
          Home page screenshots and basic theme and app data. Pro adds every page type, full-page
          and section screenshots and exports, from ${MONTHLY_PRICE.pro} a month.
        </p>
        <div class="ov__actions">
          <Button href="/pro" variant="accent" size="sm" arrow>
            Compare plans
          </Button>
        </div>
      </Card>
      <Card padding="md" class="ov__card">
        <p class="ov__label">Boards</p>
        <p class="ov__value num">0</p>
        <p class="ov__note">Save stores, pages and sections to compare them or share them.</p>
        <div class="ov__actions">
          <Button href="/account/boards" variant="secondary" size="sm" arrow>
            Open boards
          </Button>
        </div>
      </Card>
      <Card padding="md" class="ov__card">
        <p class="ov__label">Profile</p>
        <dl class="ov__facts">
          <div>
            <dt>Email</dt>
            <dd class="ov__muted">Not signed in</dd>
          </div>
          <div>
            <dt>Member since</dt>
            <dd class="ov__muted">—</dd>
          </div>
          <div>
            <dt>Seats</dt>
            <dd class="num">1</dd>
          </div>
        </dl>
      </Card>
    </div>

    <section class="ov__settings" aria-labelledby="settings-title">
      <div class="ov__settings-head">
        <h2 class="h3" id="settings-title">
          Settings
        </h2>
        <p class="ov__sub">Available once you’re signed in.</p>
      </div>
      <Card padding="none">
        <ul class="ov__list">
          {SETTINGS.map((s) => (
            <li class="ov__setting">
              <div>
                <h3 class="ov__setting-title">{s.title}</h3>
                <p class="ov__setting-body">{s.body}</p>
              </div>
              <Button variant="secondary" size="sm" disabled>
                {s.action}
              </Button>
            </li>
          ))}
        </ul>
      </Card>
    </section>
  </AccountShell>
</BaseLayout>

<style>
  .ov__head {
    padding-block: var(--space-8) var(--space-6);
  }
  .ov__sub {
    margin-top: var(--space-1);
    color: var(--ink-3);
    font-size: var(--text-ui);
  }
  .ov__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
  }
  .ov__label {
    color: var(--ink-3);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }
  .ov__value {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-2);
    color: var(--ink);
    font-size: var(--text-h2);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.025em;
    line-height: 1.15;
  }
  .ov__note {
    margin-top: var(--space-2);
    color: var(--ink-2);
    font-size: var(--text-sm);
    line-height: 1.5;
  }
  .ov__actions {
    margin-top: auto;
    padding-top: var(--space-4);
  }
  .ov__facts {
    margin-top: var(--space-2);
  }
  .ov__facts > div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--line);
    font-size: var(--text-sm);
  }
  .ov__facts > div:last-child {
    border-bottom: 0;
  }
  .ov__facts dt {
    color: var(--ink-3);
  }
  .ov__facts dd {
    color: var(--ink);
  }
  .ov__facts dd.ov__muted {
    color: var(--ink-3);
  }

  .ov__settings {
    margin-top: var(--space-10);
  }
  .ov__settings-head {
    margin-bottom: var(--space-4);
  }
  .ov__setting {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    padding: var(--space-4) var(--space-5);
  }
  .ov__setting + .ov__setting {
    border-top: 1px solid var(--line);
  }
  .ov__setting-title {
    color: var(--ink);
    font-size: var(--text-ui);
    font-weight: var(--weight-semibold);
  }
  .ov__setting-body {
    margin-top: 2px;
    color: var(--ink-3);
    font-size: var(--text-sm);
  }

  @media (min-width: 640px) {
    .ov__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1280px) {
    .ov__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
