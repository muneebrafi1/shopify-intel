---
/**
 * Account overview: plan (from Whop memberships), boards, profile, billing on Whop, sign-out and
 * account deletion. Signed-in only (middleware). noindex, no-store.
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import Badge from '~/components/ui/Badge.astro';
import Button from '~/components/ui/Button.astro';
import Card from '~/components/ui/Card.astro';
import AccountShell from '~/components/static/AccountShell.astro';
import { MONTHLY_PRICE } from '~/components/static/content';
import { accountDb } from '~/server/account/env';
import { listBoards } from '~/server/account/boards';
import { isPaid, PLAN_LABEL } from '~/server/account/entitlements';
import { membershipsFor } from '~/server/account/users';
import { formatDate } from '~/lib/format';

Astro.response.headers.set('Cache-Control', 'no-store');
const user = Astro.locals.user!;
const db = accountDb();
const [boards, memberships, profile] = await Promise.all([
  listBoards(db, user.id),
  membershipsFor(db, user.whopUserId),
  db.first<{ created_at: string }>('SELECT created_at FROM users WHERE id = ?', [user.id]),
]);
const paid = isPaid(user.plan);
const membership = memberships[0] ?? null;
const STATUS: Record<string, string> = {
  active: 'Active',
  trialing: 'Trial',
  canceling: 'Cancels at period end',
  past_due: 'Payment due',
  canceled: 'Cancelled',
  expired: 'Expired',
  completed: 'Ended',
};
const statusLabel = membership
  ? membership.cancelAtPeriodEnd && membership.status === 'active'
    ? 'Cancels at period end'
    : (STATUS[membership.status] ?? membership.status)
  : null;
const renewLabel =
  membership?.currentPeriodEnd && paid
    ? `${membership.cancelAtPeriodEnd || membership.status === 'canceling' ? 'Access until' : 'Renews'} ${formatDate(membership.currentPeriodEnd)}`
    : null;
const placeholderEmail = user.email.endsWith('@users.whop.invalid');
const error = Astro.url.searchParams.get('error');
---

<BaseLayout title="Account" description="Your plan, boards and settings." noindex>
  <AccountShell current="overview">
    <header class="ov__head">
      <h1 class="h2">Account</h1>
      <p class="ov__sub">Your plan, boards and settings.</p>
    </header>

    <div class="ov__grid">
      <Card padding="md" class="ov__card">
        <p class="ov__label">Plan</p>
        <p class="ov__value" data-plan={user.plan}>
          {PLAN_LABEL[user.plan] ?? 'Free'}{' '}
          {statusLabel && (
            <Badge tone={paid ? 'positive' : 'neutral'} size="sm">
              {statusLabel}
            </Badge>
          )}
        </p>
        {paid ? (
          <p class="ov__note">
            Every page type, full-page and section screenshots, boards and exports.
            {renewLabel && <span class="ov__renew"> {renewLabel}.</span>}
          </p>
        ) : (
          <p class="ov__note">
            Home page screenshots and basic theme and app data. Pro adds every page type, full-page
            and section screenshots, boards and exports, from ${MONTHLY_PRICE.pro} a month.
          </p>
        )}
        <div class="ov__actions">
          {membership?.manageUrl ? (
            <Button href={membership.manageUrl} variant="secondary" size="sm" rel="noopener" arrow>
              Manage on Whop
            </Button>
          ) : (
            <Button href="/pro" variant="accent" size="sm" arrow>
              {paid ? 'Compare plans' : 'Get Pro'}
            </Button>
          )}
        </div>
      </Card>
      <Card padding="md" class="ov__card">
        <p class="ov__label">Boards</p>
        <p class="ov__value num">{boards.length}</p>
        <p class="ov__note">Save stores, pages and sections to compare them or share them.</p>
        <div class="ov__actions">
          <Button href="/account/boards" variant="secondary" size="sm" arrow>
            Open boards
          </Button>
        </div>
      </Card>
      <Card padding="md" class="ov__card">
        <p class="ov__label">Profile</p>
        <dl class="ov__facts">
          <div>
            <dt>Name</dt>
            <dd class:list={[!user.name && 'ov__muted']}>{user.name ?? '—'}</dd>
          </div>
          <div>
            <dt>Email</dt>
            <dd class:list={['ov__email', placeholderEmail && 'ov__muted']}>
              {placeholderEmail ? 'Not shared by Whop' : user.email}
            </dd>
          </div>
          <div>
            <dt>Member since</dt>
            <dd>{profile ? formatDate(profile.created_at) : '—'}</dd>
          </div>
          <div>
            <dt>Seats</dt>
            <dd class="num">{user.plan === 'team' ? 3 : 1}</dd>
          </div>
        </dl>
      </Card>
    </div>

    <section class="ov__settings" aria-labelledby="settings-title">
      <div class="ov__settings-head">
        <h2 class="h3" id="settings-title">
          Settings
        </h2>
        <p class="ov__sub">Name and email come from your Whop account.</p>
      </div>
      <Card padding="none">
        <ul class="ov__list">
          <li class="ov__setting">
            <div>
              <h3 class="ov__setting-title">Billing</h3>
              <p class="ov__setting-body">Plan, invoices and cancellation are managed on Whop.</p>
            </div>
            {membership?.manageUrl ? (
              <Button href={membership.manageUrl} variant="secondary" size="sm" rel="noopener">
                Open Whop
              </Button>
            ) : (
              <Button href="/pro" variant="secondary" size="sm">
                See plans
              </Button>
            )}
          </li>
          <li class="ov__setting">
            <div>
              <h3 class="ov__setting-title">Sign out</h3>
              <p class="ov__setting-body">Ends this session on this device.</p>
            </div>
            <form method="post" action="/auth/sign-out">
              <Button type="submit" variant="secondary" size="sm">
                Sign out
              </Button>
            </form>
          </li>
          <li class="ov__setting ov__setting--danger">
            <div>
              <h3 class="ov__setting-title">Delete account</h3>
              <p class="ov__setting-body">
                Removes your account and every board. This can’t be undone. A paid plan keeps
                running until you cancel it on Whop.
              </p>
              {error === 'confirm' && (
                <p class="ov__error" role="alert">
                  Type “delete” to confirm.
                </p>
              )}
            </div>
            <details class="ov__confirm">
              <summary class="ov__confirm-btn">Delete</summary>
              <form method="post" action="/account/actions" class="ov__confirm-form">
                <input type="hidden" name="intent" value="delete-account" />
                <label for="confirm-delete">Type “delete” to confirm</label>
                <input
                  id="confirm-delete"
                  name="confirm"
                  autocomplete="off"
                  required
                  pattern="delete"
                />
                <Button type="submit" variant="primary" size="sm">
                  Delete my account
                </Button>
              </form>
            </details>
          </li>
        </ul>
      </Card>
    </section>
  </AccountShell>
</BaseLayout>

<style>
  .ov__renew {
    color: var(--ink);
  }
  .ov__email {
    overflow-wrap: anywhere;
  }
  .ov__error {
    margin-top: var(--space-2);
    color: var(--critical);
    font-size: var(--text-sm);
  }
  .ov__confirm {
    position: relative;
    flex: 0 1 auto;
    min-width: 0;
  }
  .ov__confirm[open] {
    flex-basis: 100%;
  }
  .ov__confirm-btn {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 var(--space-3);
    border-radius: var(--radius-control, 10px);
    box-shadow: inset 0 0 0 1px var(--line);
    color: var(--critical);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium, 500);
    cursor: pointer;
    list-style: none;
  }
  .ov__confirm-btn::-webkit-details-marker {
    display: none;
  }
  .ov__confirm-form {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-2);
    font-size: var(--text-sm);
  }
  .ov__confirm-form input {
    min-height: 36px;
    padding: 0 var(--space-2);
    border-radius: 8px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
    font: inherit;
  }
  .ov__setting--danger {
    flex-wrap: wrap;
    align-items: flex-start;
  }
  .ov__setting--danger > div {
    flex: 1 1 240px;
    min-width: 0;
  }
  .ov__confirm-form {
    max-width: 320px;
  }

  .ov__head {
    padding-block: var(--space-8) var(--space-6);
  }
  .ov__sub {
    margin-top: var(--space-1);
    color: var(--ink-3);
    font-size: var(--text-ui);
  }
  .ov__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
  }
  .ov__label {
    color: var(--ink-3);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }
  .ov__value {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-2);
    color: var(--ink);
    font-size: var(--text-h2);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.025em;
    line-height: 1.15;
  }
  .ov__note {
    margin-top: var(--space-2);
    color: var(--ink-2);
    font-size: var(--text-sm);
    line-height: 1.5;
  }
  .ov__actions {
    margin-top: auto;
    padding-top: var(--space-4);
  }
  .ov__facts {
    margin-top: var(--space-2);
  }
  .ov__facts > div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--line);
    font-size: var(--text-sm);
  }
  .ov__facts > div:last-child {
    border-bottom: 0;
  }
  .ov__facts dt {
    color: var(--ink-3);
  }
  .ov__facts dd {
    color: var(--ink);
  }
  .ov__facts dd.ov__muted {
    color: var(--ink-3);
  }

  .ov__settings {
    margin-top: var(--space-10);
  }
  .ov__settings-head {
    margin-bottom: var(--space-4);
  }
  .ov__setting {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    padding: var(--space-4) var(--space-5);
  }
  .ov__setting + .ov__setting {
    border-top: 1px solid var(--line);
  }
  .ov__setting-title {
    color: var(--ink);
    font-size: var(--text-ui);
    font-weight: var(--weight-semibold);
  }
  .ov__setting-body {
    margin-top: 2px;
    color: var(--ink-3);
    font-size: var(--text-sm);
  }

  @media (min-width: 640px) {
    .ov__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1280px) {
    .ov__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
