---
/**
 * Board detail — placeholder. Example boards (ids in EXAMPLE_BOARDS) show items from the
 * sections library, labelled as an example; any other id shows the empty board a new account
 * would see. Ids that aren't slugs are 404s.
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/ui/Breadcrumbs.astro';
import Button from '~/components/ui/Button.astro';
import Badge from '~/components/ui/Badge.astro';
import EmptyState from '~/components/ui/EmptyState.astro';
import SectionCard from '~/components/domain/SectionCard.astro';
import AccountShell from '~/components/static/AccountShell.astro';
import { EXAMPLE_BOARDS, isBoardId } from '~/components/static/content';
import { loadExampleItems } from '~/components/static/boards';
import { pageTypeName } from '~/lib/taxonomy';

const { id } = Astro.params;
if (!isBoardId(id)) return Astro.rewrite('/404');

const example = EXAMPLE_BOARDS.find((b) => b.id === id) ?? null;
const items = example ? await loadExampleItems(example, 24) : [];
const title = example ? example.name : 'Untitled board';
Astro.response.headers.set('Cache-Control', 'no-store');
---

<BaseLayout title={title} description="A board of saved stores, pages and sections." noindex>
  <AccountShell current="boards">
    <header class="bd__head">
      <Breadcrumbs
        items={[
          { label: 'Account', href: '/account' },
          { label: 'Boards', href: '/account/boards' },
          { label: title },
        ]}
      />
      <div class="bd__row">
        <div class="bd__text">
          <h1 class="h2 bd__title">
            {title} <span class="bd__count num">{items.length}</span>
          </h1>
          {example ? (
            <p class="bd__desc">{example.description}</p>
          ) : (
            <p class="bd__desc">Boards you create will live here.</p>
          )}
          {example && (
            <p class="bd__flag">
              <Badge tone="outline" size="sm">
                Example board
              </Badge>
              <span>From the sections library. Not saved.</span>
            </p>
          )}
        </div>
        <div class="bd__actions">
          <Button variant="secondary" size="sm" icon="link-simple" disabled>
            Share
          </Button>
          <Button variant="secondary" size="sm" icon="download-simple" disabled>
            Export CSV
          </Button>
        </div>
      </div>
    </header>

    {items.length > 0 ? (
      <div class="grid grid--sections bd__grid">
        {items.map((s, i) => (
          <SectionCard
            href={s.href}
            crop={{ src: s.crop.src, width: s.crop.width, height: s.crop.height }}
            device={s.device}
            typeName={s.type.name}
            storeLabel={s.store.display_name}
            meta={`${s.theme?.name ?? 'Custom theme'} · ${pageTypeName(s.page_type)} · ${s.device}`}
            app={s.app ? { name: s.app.name, iconUrl: s.app.icon_url } : null}
            eager={i < 4}
          />
        ))}
      </div>
    ) : (
      <EmptyState
        title="Nothing on this board yet"
        body="Use Save on any store, page or section to add it here. Saving opens with accounts."
        icon="bookmark-simple"
      >
        <Button href="/sections" variant="primary" size="sm">
          Browse sections
        </Button>
        <Button href="/account/boards" variant="secondary" size="sm">
          All boards
        </Button>
      </EmptyState>
    )}
  </AccountShell>
</BaseLayout>

<style>
  .bd__head {
    padding-block: var(--space-8) var(--space-6);
  }
  .bd__row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4) var(--space-8);
    margin-top: var(--space-4);
  }
  .bd__text {
    min-width: 0;
  }
  .bd__count {
    margin-left: 0.25em;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 450;
    letter-spacing: 0;
    vertical-align: 0.35em;
  }
  .bd__desc {
    margin-top: var(--space-1);
    color: var(--ink-2);
    font-size: var(--text-body);
  }
  .bd__flag {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
    color: var(--ink-3);
    font-size: var(--text-sm);
  }
  .bd__actions {
    display: flex;
    gap: var(--space-2);
  }
</style>
