---
/**
 * Boards (saved collections) — placeholder until accounts open. Shows the empty state a new
 * account will see, plus example boards built from the library and labelled as examples.
 * `?save=<type>:<id>` (from SaveButton → sign-in) explains that saving needs an account.
 * Data model: collections + collection_items (migrations/0001_init.sql).
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import Button from '~/components/ui/Button.astro';
import Icon from '~/components/ui/Icon.astro';
import EmptyState from '~/components/ui/EmptyState.astro';
import AccountShell from '~/components/static/AccountShell.astro';
import BoardCard from '~/components/static/BoardCard.astro';
import { EXAMPLE_BOARDS } from '~/components/static/content';
import { loadExampleItems } from '~/components/static/boards';

Astro.response.headers.set('Cache-Control', 'no-store');

const SAVE_NOUN: Record<string, string> = {
  screenshot: 'screenshot',
  section: 'section',
  store: 'store',
  theme: 'theme',
  app: 'app',
};
const save = Astro.url.searchParams.get('save') ?? '';
const [saveType = '', saveId = ''] = save.split(':');
const saveNoun = /^[\w.-]{1,120}$/.test(saveId) ? (SAVE_NOUN[saveType] ?? null) : null;

const examples = await Promise.all(
  EXAMPLE_BOARDS.map(async (board) => ({ board, items: await loadExampleItems(board, 24) })),
);
const shown = examples.filter((e) => e.items.length > 0);
---

<BaseLayout
  title="Boards"
  description="Save stores, pages and sections to boards."
  noindex
  canonical="/account/boards"
>
  <AccountShell current="boards" hideNotice={!!saveNoun}>
    {saveNoun && (
      <div class="save-note" role="status">
        <Icon name="bookmark-simple" size={20} class="save-note__icon" />
        <div class="save-note__text">
          <p class="save-note__title">Not saved yet</p>
          <p>
            <strong>Saving needs an account.</strong> Accounts open with Pro. When they do, this{' '}
            {saveNoun} goes straight onto a board.
          </p>
        </div>
        <div class="save-note__actions">
          <Button
            href={`/sign-in?next=${encodeURIComponent(`/account/boards?save=${save}`)}`}
            variant="primary"
            size="sm"
            rel="nofollow"
          >
            Sign in
          </Button>
          <Button href="/pro" variant="secondary" size="sm">
            See Pro
          </Button>
        </div>
      </div>
    )}

    <header class="bh">
      <div>
        <h1 class="h2 bh__title">
          Boards <span class="bh__count num">0</span>
        </h1>
        <p class="bh__sub">Collections of stores, pages and sections, for a pitch or a brief.</p>
      </div>
      <Button
        href="/sign-in?next=/account/boards"
        variant="primary"
        size="sm"
        icon="plus"
        rel="nofollow"
      >
        New board
      </Button>
    </header>

    <EmptyState
      title="No boards yet"
      body="Save stores, pages and sections to compare them later or share them with a client."
      icon="squares-four"
    >
      <Button href="/sections" variant="primary" size="sm">
        Browse sections
      </Button>
      <Button href="/stores" variant="secondary" size="sm">
        Top stores
      </Button>
    </EmptyState>

    {shown.length > 0 && (
      <section class="examples" aria-labelledby="examples-title">
        <div class="examples__head">
          <h2 class="h3" id="examples-title">
            Example boards
          </h2>
          <p class="examples__sub">
            Made from our library to show how boards work. Not yours, and not saved.
          </p>
        </div>
        <div class="examples__grid">
          {shown.map(({ board, items }) => (
            <BoardCard
              href={`/account/boards/${board.id}`}
              name={board.name}
              description={board.description}
              count={items.length}
              thumbs={items
                .slice(0, 3)
                .map((i) => ({ src: i.crop.src, width: i.crop.width, height: i.crop.height }))}
              example
            />
          ))}
        </div>
      </section>
    )}
  </AccountShell>
</BaseLayout>

<style>
  .save-note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
    padding: var(--space-4);
    border-radius: var(--radius-card);
    background: var(--surface);
    box-shadow:
      inset 0 0 0 1.5px var(--ink),
      var(--shadow-sm);
  }
  .save-note :global(.save-note__icon) {
    color: var(--ink);
  }
  .save-note__text {
    flex: 1 1 260px;
    min-width: 0;
    color: var(--ink-2);
    font-size: var(--text-sm);
    line-height: 1.5;
  }
  .save-note__title {
    color: var(--ink);
    font-size: var(--text-ui);
    font-weight: var(--weight-semibold);
  }
  .save-note__text strong {
    color: var(--ink);
    font-weight: var(--weight-semibold);
  }
  .save-note__actions {
    display: flex;
    gap: var(--space-2);
  }
  .bh {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-8) var(--space-6);
  }
  .bh__count {
    margin-left: 0.25em;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 450;
    letter-spacing: 0;
    vertical-align: 0.35em;
  }
  .bh__sub {
    margin-top: var(--space-1);
    color: var(--ink-3);
    font-size: var(--text-ui);
  }
  .examples {
    margin-top: var(--space-12);
  }
  .examples__head {
    margin-bottom: var(--space-4);
  }
  .examples__sub {
    margin-top: var(--space-1);
    color: var(--ink-3);
    font-size: var(--text-ui);
  }
  .examples__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
  }
  @media (min-width: 640px) {
    .examples__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1280px) {
    .examples__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
