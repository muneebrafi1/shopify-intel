---
/** Not found: an empty plate, a search box and the main ways back in. No data calls. */
import BaseLayout from '~/layouts/BaseLayout.astro';
import Button from '~/components/ui/Button.astro';
import Icon from '~/components/ui/Icon.astro';
import MonoLabel from '~/components/ui/MonoLabel.astro';

Astro.response.status = 404;
Astro.response.headers.set('Cache-Control', 'no-store');

const WAYS = [
  { href: '/stores', label: 'Stores', note: 'Real storefronts, page by page' },
  { href: '/themes', label: 'Themes', note: 'Every theme on the stores using it' },
  { href: '/apps', label: 'Apps', note: 'Where each app shows up' },
  { href: '/sections', label: 'Sections', note: 'Headers, heroes, buy boxes and more' },
];
---

<BaseLayout title="Page not found" description="This page isn’t here." noindex>
  <div class="nf container">
    <div class="nf__plate marks" aria-hidden="true">
      <span class="nf__page">
        <span class="nf__bar"></span>
        <span class="nf__block"></span>
        <span class="nf__line"></span>
        <span class="nf__line nf__line--short"></span>
      </span>
      <span class="nf__no">N°404</span>
    </div>

    <MonoLabel as="p" class="nf__flag">
      Not found
    </MonoLabel>
    <h1 class="nf__title display">This page isn’t in the archive.</h1>
    <p class="nf__sub">
      The link may be out of date, or the store may have been removed at its owner’s request. Try a
      search, or start from one of these.
    </p>

    <form class="nf__search" action="/search" method="get" role="search">
      <label class="visually-hidden" for="nf-q">
        Search stores, themes, apps and sections
      </label>
      <span class="nf__search-field">
        <Icon name="magnifying-glass" size={16} />
        <input
          id="nf-q"
          name="q"
          type="search"
          placeholder="Search stores, themes, apps"
          autocomplete="off"
        />
      </span>
      <Button type="submit" variant="primary">
        Search
      </Button>
    </form>

    <ol class="nf__ways">
      {WAYS.map((w, i) => (
        <li>
          <a href={w.href}>
            <span class="nf__n">{String(i + 1).padStart(2, '0')}</span>
            <span class="nf__label">{w.label}</span>
            <span class="nf__note">{w.note}</span>
            <span class="nf__arrow" aria-hidden="true">
              →
            </span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</BaseLayout>

<style>
  .nf {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 640px;
    padding-top: var(--space-16);
    text-align: center;
  }

  .nf__plate {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 168px;
    aspect-ratio: 4 / 3;
    margin-bottom: var(--space-10);
    border-radius: var(--radius-lg);
    background: var(--tile);
  }
  .nf__page {
    display: flex;
    flex-direction: column;
    gap: 7px;
    width: 58%;
    height: 72%;
    padding: 9px;
    border-radius: 4px;
    background: var(--surface);
    box-shadow: var(--shadow-shot);
  }
  .nf__bar {
    height: 5px;
    border-radius: 3px;
    background: var(--ph-line);
  }
  .nf__block {
    flex: 1;
    border-radius: 3px;
    background: var(--ph-block);
  }
  .nf__line {
    height: 4px;
    width: 80%;
    border-radius: 2px;
    background: var(--ph-line);
  }
  .nf__line--short {
    width: 50%;
  }
  .nf__no {
    position: absolute;
    right: 8px;
    bottom: 6px;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.04em;
  }

  .nf :global(.nf__flag) {
    margin-bottom: var(--space-4);
  }
  .nf__title {
    font-size: var(--text-5xl);
  }
  .nf__sub {
    max-width: 460px;
    margin-top: var(--space-4);
    color: var(--ink-2);
    font-size: var(--text-md);
    line-height: var(--leading-normal);
  }

  .nf__search {
    display: flex;
    gap: var(--space-2);
    width: 100%;
    max-width: 460px;
    margin-top: var(--space-8);
  }
  .nf__search-field {
    display: flex;
    flex: 1;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
    height: 34px;
    padding: 0 var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line-strong);
    color: var(--ink-3);
    transition: box-shadow var(--dur-fast) var(--ease-out);
  }
  .nf__search-field:focus-within {
    box-shadow:
      inset 0 0 0 1px var(--ink),
      0 0 0 3px var(--accent-wash);
  }
  .nf__search input {
    flex: 1;
    min-width: 0;
    height: 100%;
    border: 0;
    background: none;
    color: var(--ink);
    font-size: var(--text-md);
  }
  .nf__search input:focus-visible {
    outline: none;
    box-shadow: none;
  }
  .nf__search input::placeholder {
    color: var(--ink-4);
  }

  .nf__ways {
    width: 100%;
    margin-top: var(--space-12);
    border-top: 1px solid var(--ink);
    text-align: left;
  }
  .nf__ways a {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 2px var(--space-3);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--line);
    transition: background-color var(--dur-fast) var(--ease-out);
  }
  .nf__ways a:hover .nf__label {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .nf__n {
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
  }
  .nf__label {
    font-size: var(--text-md);
    font-weight: var(--weight-medium);
  }
  .nf__note {
    grid-column: 2;
    color: var(--ink-3);
    font-size: var(--text-sm);
  }
  .nf__arrow {
    grid-column: 3;
    grid-row: 1 / span 2;
    align-self: center;
    color: var(--ink-3);
  }

  @media (max-width: 639px) {
    .nf {
      padding-top: var(--space-10);
    }
    .nf__title {
      font-size: var(--text-4xl);
    }
  }
  @media (min-width: 640px) {
    .nf__ways a {
      grid-template-columns: 2rem 8rem minmax(0, 1fr) auto;
    }
    .nf__note {
      grid-column: 3;
    }
    .nf__arrow {
      grid-column: 4;
      grid-row: auto;
    }
  }
</style>
