---
/**
 * /themes/<slug>: a theme as an app view. Breadcrumb → identity row (name, vendor, price,
 * latest version seen, usage rank; Compare, Save and the Theme Store CTA) → "Seen on" (the theme
 * on a real store, page by page, with pinned section tags) beside a sticky facts card → every
 * detected store running it → apps most used with it → versions → sections from those stores →
 * similar themes and side-by-side comparisons.
 *
 * URL state: ?page=&device= (Seen on), ?cursor=&p= (stores list paging). Unknown slugs are 404s.
 * Ranks are the API's usage ranks (equal usage shares a rank, shown as "#3").
 * D1 budget: getTheme + listStores + getScreenshot + getMeta ≈ 33 queries (limit 50).
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/ui/PageHeader.astro';
import Breadcrumbs from '~/components/ui/Breadcrumbs.astro';
import SectionHeader from '~/components/ui/SectionHeader.astro';
import SourceNote from '~/components/ui/SourceNote.astro';
import FactsCard from '~/components/ui/FactsCard.astro';
import Badge from '~/components/ui/Badge.astro';
import Button from '~/components/ui/Button.astro';
import Chip from '~/components/ui/Chip.astro';
import ChipRow from '~/components/ui/ChipRow.astro';
import EmptyState from '~/components/ui/EmptyState.astro';
import AffiliateCta from '~/components/domain/AffiliateCta.astro';
import SaveButton from '~/components/domain/SaveButton.astro';
import ThemeCard from '~/components/domain/ThemeCard.astro';
import SectionCard from '~/components/domain/SectionCard.astro';
import type { FullPageSection } from '~/components/media/FullPage.astro';
import SeenOn from '~/components/themes/SeenOn.astro';
import ThemeStores from '~/components/themes/ThemeStores.astro';
import VersionList from '~/components/themes/VersionList.astro';
import ThemeApps from '~/components/themes/ThemeApps.astro';
import CompareList from '~/components/themes/CompareList.astro';
import { detailHref, latestVersion, rankLabel, readPlateState } from '~/components/themes/params';
import { api, isApiError, orNotFound } from '~/server/api';
import type { StoreListItem } from '~/server/api/v1/types';
import { CORE_PAGE_TYPES, PAGE_TYPES, type PageType } from '~/lib/taxonomy';
import { formatCount, formatDate, formatPercent } from '~/lib/format';

const STORES_PAGE = 24;
const slug = (Astro.params.slug ?? '').toLowerCase();
if (!/^[a-z0-9][a-z0-9-]{0,79}$/.test(slug)) return Astro.rewrite('/404');

const sp = Astro.url.searchParams;
const cursor = sp.get('cursor') || undefined;
const listPage = Math.max(1, Math.min(9999, Number.parseInt(sp.get('p') ?? '1', 10) || 1));

const detailRes = await orNotFound(api.getTheme({ slug, stores_limit: 0 }));
if (!detailRes) return Astro.rewrite('/404');
const { data: detail, meta } = detailRes;
const theme = detail.theme;
if (theme.slug !== Astro.params.slug) return Astro.redirect(theme.href, 301);

// Every detected store running the theme (the API defaults to the curated stores only).
let storesRes;
try {
  storesRes = await api.listStores({ theme: slug, scope: 'all', limit: STORES_PAGE, cursor });
} catch (err) {
  if (isApiError(err) && err.status === 400) return Astro.redirect(`${theme.href}#stores`, 302);
  throw err;
}
const stores: StoreListItem[] = storesRes.data.items;
const storesTotal = storesRes.meta.pagination?.total ?? detail.stores.total;
const nextCursor = storesRes.meta.pagination?.next_cursor ?? null;

// ---- Seen on: page types with captures, the current view and its lead capture's sections ----
const curated = detail.curated_stores;
const pageSet = new Set(curated.flatMap((c) => c.pages.map((p) => p.page_type)));
const pages: PageType[] = PAGE_TYPES.map((p) => p.slug).filter((p) => pageSet.has(p));
const plate = readPlateState(sp, pages.length ? pages : CORE_PAGE_TYPES);
const keep = { cursor: cursor ?? null, p: listPage };
const leadShot = curated
  .map((c) => c.pages.find((p) => p.page_type === plate.page)?.[plate.device])
  .find(Boolean);

const [shotRes, metaRes] = await Promise.all([
  leadShot ? api.getScreenshot({ id: leadShot.id }).catch(() => null) : null,
  api.getMeta({}),
]);
const leadSections: FullPageSection[] = (shotRes?.data.sections ?? []).map((s) => ({
  id: s.id,
  type: s.type.slug,
  name: s.type.name,
  y: s.rect.y,
  height: s.rect.h,
  x: s.rect.x,
  w: s.rect.w,
  app: s.app ? { name: s.app.short_name, slug: s.app.slug, iconUrl: s.app.icon_url } : null,
  href: s.href,
}));
// Detected app counts for the curated stores in the caption (they lead the stores list).
const appCounts = new Map(stores.map((s) => [s.domain, s.app_count]));

// ---- Identity + facts ----------------------------------------------------------------------
const usage = theme.usage;
const source = meta.sources[usage.source];
const asOf = formatDate(usage.as_of);
const sourceLabel = (source?.label ?? 'Our scan').replace(/ of .*$/, '');
const priceText = theme.price.is_free ? 'Free' : (theme.price.label ?? 'Price not listed');
const latest = latestVersion(detail.versions.map((v) => v.version));
const latestStores = detail.versions.find((v) => v.version === latest)?.stores ?? 0;
const sharePct = formatPercent(usage.share * 100);
const themeCount = metaRes.data.counts.themes;
const rank = usage.stores > 0 ? usage.rank : null;

// Published on the theme's Theme Store page (read on store.checked_at).
const store = detail.theme_store;
const storeCheckedOn = store ? formatDate(store.checked_at) : null;
const featureCount = store?.features.reduce((n, g) => n + g.items.length, 0) ?? 0;

// Price and vendor lead the facts card; the rows with notes follow in its slot.
const facts = [
  { label: 'Price', value: priceText },
  theme.vendor_info
    ? { label: 'Vendor', value: theme.vendor_info.name, href: theme.vendor_info.href }
    : { label: 'Vendor', value: 'Unknown' },
];
const moreFacts = [
  ...(theme.theme_store_id
    ? [{ label: 'Theme Store ID', value: String(theme.theme_store_id) }]
    : []),
  ...(theme.marketplace ? [{ label: 'Listed on', value: theme.marketplace }] : []),
  ...(detail.presets.length
    ? [{ label: 'Presets', value: detail.presets.map((p) => p.name).join(', ') }]
    : []),
  ...(store?.version ? [{ label: 'Theme Store version', value: store.version }] : []),
  ...(store?.review_count && store.review_positive_pct !== null
    ? [
        {
          label: 'Theme Store reviews',
          value: `${store.review_positive_pct}% positive of ${formatCount(store.review_count)}`,
        },
      ]
    : []),
];

const cta =
  theme.cta ??
  (detail.official_url
    ? { href: detail.official_url, label: 'View in Theme Store', is_affiliate: false }
    : null);
const similar = detail.similar.slice(0, 3);
const comparisons = detail.comparisons;
const compareHref =
  similar.length > 0 || comparisons.length > 0 ? '#compare' : `/alternatives/${slug}`;

const lead =
  usage.stores > 0
    ? `Running on ${formatCount(usage.stores)} of the ${formatCount(usage.denominator)} Shopify stores in our scan, shown here on a real storefront, page by page.`
    : `Not yet seen on the ${formatCount(usage.denominator)} Shopify stores in our scan.`;
// Section types by how often they appear; the rest are one click away in the library.
const TYPE_CHIPS = 10;
const typeChips = [...detail.sections.by_type].sort((a, b) => b.count - a.count);

// ---- Lower blocks --------------------------------------------------------------------------
const sections = detail.sections;
// Lead with the sections that carry a theme's look; chrome (header, footer) goes last.
const SAMPLE_ORDER = [
  'hero',
  'product-gallery',
  'buy-box',
  'featured-collection',
  'image-with-text',
  'collection-list',
  'product-grid',
  'reviews',
  'testimonials',
  'ugc-gallery',
  'slideshow',
  'collection-header',
  'cart-items',
  'newsletter',
  'upsell',
];
const orderOf = (t: string) => {
  const i = SAMPLE_ORDER.indexOf(t);
  return i === -1 ? SAMPLE_ORDER.length + (t === 'header' || t === 'footer' ? 10 : 0) : i;
};
const sectionSamples = [...sections.items]
  .sort((a, b) => orderOf(a.type.slug) - orderOf(b.type.slug))
  .slice(0, 8);
const pageName = (p: string) => PAGE_TYPES.find((x) => x.slug === p)?.name ?? p;
const sectionsHref = `/sections?theme=${encodeURIComponent(slug)}`;
const similarReason = (r: string[]) =>
  r
    .map(
      (x) =>
        ({
          'same-vendor': 'Same vendor',
          'similar-price': 'Similar price',
          'shared-apps': 'Shared apps',
        })[x] ?? x,
    )
    .join(' · ');

const storesFrom = (listPage - 1) * STORES_PAGE + 1;
const storesTo = storesFrom + stores.length - 1;

// ---- SEO ---------------------------------------------------------------------------------
const site = Astro.site ?? Astro.url;
const abs = (path: string) => new URL(path, site).href;
const title = `${theme.name} theme${theme.vendor ? ` by ${theme.vendor}` : ''} on real Shopify stores`;
const description = `${theme.name}${theme.vendor ? ` by ${theme.vendor}` : ''} (${priceText}) seen on ${formatCount(usage.stores)} of ${formatCount(usage.denominator)} scanned Shopify stores: home, collection, product and cart pages on desktop and mobile, the sections they use, apps installed alongside it and similar themes.`;
const jsonLd = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: 'Themes', item: abs('/themes') },
      { '@type': 'ListItem', position: 3, name: theme.name, item: abs(theme.href) },
    ],
  },
  {
    '@type': 'CreativeWork',
    name: `${theme.name} Shopify theme`,
    genre: 'Shopify theme',
    url: abs(theme.href),
    description,
    ...(theme.vendor ? { creator: { '@type': 'Organization', name: theme.vendor } } : {}),
    ...(detail.official_url ? { sameAs: detail.official_url } : {}),
    ...(theme.theme_store_id ? { identifier: String(theme.theme_store_id) } : {}),
    ...(typeof theme.price.cents === 'number'
      ? {
          offers: {
            '@type': 'Offer',
            price: (theme.price.cents / 100).toFixed(2),
            priceCurrency: 'USD',
            ...(detail.official_url ? { url: detail.official_url } : {}),
          },
        }
      : {}),
  },
];

Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=600');
---

<BaseLayout
  {title}
  {description}
  canonical={meta.canonical ?? theme.href}
  noindex={listPage > 1}
  {jsonLd}
>
  <div class="container th">
    <PageHeader title={theme.name} class="th-id">
      <Breadcrumbs
        slot="top"
        items={[
          { label: 'Home', href: '/' },
          { label: 'Themes', href: '/themes' },
          { label: theme.name },
        ]}
      />
      <div slot="meta" class="th-chips">
        {theme.vendor_info ? (
          <span class="th-chips__by">
            by <a href={theme.vendor_info.href}>{theme.vendor_info.name}</a>
          </span>
        ) : (
          <span class="th-chips__by">Vendor unknown</span>
        )}
        <Badge tone={theme.price.is_free ? 'positive' : 'neutral'}>{priceText}</Badge>
        {latest && (
          <Badge tone="outline" mono title="Latest version seen on stores in our scan">
            v{latest}
          </Badge>
        )}
        {rank && (
          <Badge tone="outline" title="Rank by stores using it; equal usage shares a rank">
            {rankLabel(rank)} most used
          </Badge>
        )}
      </div>
      <p slot="meta" class="th-lead lead">
        {lead}
      </p>
      <div slot="actions" class="th-actions">
        <Button href={compareHref} variant="secondary" icon="scales" class="th-act">
          Compare
        </Button>
        <SaveButton itemType="theme" itemId={slug} size="md" class="th-act" />
        {cta && (
          <AffiliateCta
            href={cta.href}
            label={cta.label}
            isAffiliate={cta.is_affiliate}
            size="md"
            class="th-cta"
          />
        )}
      </div>
    </PageHeader>

    <div class="th-layout">
      <SeenOn
        slug={slug}
        name={theme.name}
        curated={curated}
        state={plate}
        pages={pages}
        sections={leadSections}
        appCounts={appCounts}
        keep={keep}
        class="th-main"
      />

      <aside class="th-side" aria-label={`${theme.name} facts`}>
        <FactsCard
          title="Theme facts"
          items={facts}
          source={sourceLabel}
          asOf={asOf}
          sourceHref={source?.url ?? '/methodology'}
          sticky
        >
          <div class="facts__row">
            <dt>Stores using it</dt>
            <dd class="th-fact">
              <span class="num">
                {formatCount(usage.stores)} of {formatCount(usage.denominator)}
              </span>
              <span class="th-fact__note num">{sharePct} of the scan</span>
            </dd>
          </div>
          {rank && (
            <div class="facts__row">
              <dt>Rank by usage</dt>
              <dd class="num" title="Equal usage shares a rank">
                {rankLabel(rank)} of {themeCount} themes
              </dd>
            </div>
          )}
          <div class="facts__row">
            <dt>Latest version seen</dt>
            <dd class="th-fact">
              {latest ? (
                <>
                  <span class="mono">{latest}</span>
                  <span class="th-fact__note">
                    on {latestStores} {latestStores === 1 ? 'store' : 'stores'} · {asOf}
                  </span>
                </>
              ) : (
                <span class="th-fact__muted">Not recorded</span>
              )}
            </dd>
          </div>
          {moreFacts.map((f) => (
            <div class="facts__row">
              <dt>{f.label}</dt>
              <dd
                class:list={[
                  { mono: f.label === 'Theme Store ID' || f.label === 'Theme Store version' },
                ]}
              >
                {f.value}
              </dd>
            </div>
          ))}
          <p slot="footer" class="th-side__bias">
            Stores were found through Theme Store example lists, so counts show reach in our scan,
            not market share.
            {store && (
              <>
                {' '}
                Presets, version and reviews: <a href={store.url}>Shopify Theme Store</a>, checked{' '}
                {storeCheckedOn}.
              </>
            )}
          </p>
        </FactsCard>
      </aside>

      <section class="th-main th-block" id="stores" aria-labelledby="th-stores-title">
        <SectionHeader
          id="th-stores-title"
          title={`Stores using ${theme.name}`}
          count={storesTotal}
          description="Every active store in our scan where we detected this theme. Stores without a capture still have a page with their theme and apps."
        />
        {stores.length === 0 ? (
          <EmptyState
            title={`No store in our scan runs ${theme.name} right now`}
            body="A theme drops out of this list when we stop detecting it on a store's storefront."
            size="sm"
            level={3}
            class="th-empty"
          >
            <Button href="/themes" size="sm" variant="secondary">
              Browse all themes
            </Button>
          </EmptyState>
        ) : (
          <ThemeStores stores={stores} label={`Stores using ${theme.name}`} class="th-table" />
        )}
        <div class="th-pager">
          <p class="th-pager__status">
            {stores.length > 0 && (
              <span class="num">
                {storesTotal > stores.length
                  ? `${formatCount(storesFrom)}–${formatCount(storesTo)} of `
                  : ''}
                {formatCount(storesTotal)} {storesTotal === 1 ? 'store' : 'stores'} ·{' '}
              </span>
            )}
            Detected in the {sourceLabel} · {asOf}.{' '}
            <a href={source?.url ?? '/methodology'}>How we detect</a>
          </p>
          {(listPage > 1 || nextCursor) && (
            <div class="th-pager__buttons">
              {listPage > 1 && (
                <Button
                  href={detailHref(slug, plate, { hash: 'stores' })}
                  size="sm"
                  icon="caret-left"
                >
                  First page
                </Button>
              )}
              {nextCursor && (
                <Button
                  href={detailHref(slug, plate, {
                    cursor: nextCursor,
                    p: listPage + 1,
                    hash: 'stores',
                  })}
                  size="sm"
                  iconRight="caret-right"
                  rel="next"
                >
                  Next {Math.min(STORES_PAGE, storesTotal - storesTo)}
                </Button>
              )}
            </div>
          )}
        </div>
      </section>

      {detail.top_apps.length > 0 && (
        <section class="th-main th-block" aria-labelledby="th-apps-title">
          <SectionHeader
            id="th-apps-title"
            title={`Apps most used with ${theme.name}`}
            count={detail.top_apps.length}
            description={`Share of the ${formatCount(usage.stores)} ${theme.name} ${usage.stores === 1 ? 'store' : 'stores'} in our scan running each app.`}
          />
          <ThemeApps apps={detail.top_apps} of={usage.stores} />
          <p class="th-note">Detected on storefronts · {asOf}.</p>
        </section>
      )}

      <section class="th-main th-block" aria-labelledby="th-versions-title">
        <SectionHeader
          id="th-versions-title"
          title="Versions in the wild"
          count={detail.versions.filter((v) => v.version).length}
          description="A version is recorded when the storefront exposes it; the rest count under “Not recorded”."
        />
        <VersionList versions={detail.versions} />
        <p class="th-note">Detected on storefronts · {asOf}.</p>
      </section>

      {store && featureCount > 0 && (
        <section class="th-main th-block" id="features" aria-labelledby="th-features-title">
          <SectionHeader
            id="th-features-title"
            title="Published features"
            count={featureCount}
            description={`What ${theme.name}'s Theme Store page lists, in its own groups. Listed by the vendor, not tested by us.`}
          />
          <div class="th-features">
            {store.features.map((g) => (
              <div class="th-features__group">
                <h3 class="th-features__title">{g.group}</h3>
                <ul class="th-features__list">
                  {g.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
          <p class="th-note">
            Source: <a href={store.url}>Shopify Theme Store</a> · checked {storeCheckedOn}.
          </p>
        </section>
      )}
    </div>

    {sections.total > 0 && (
      <section class="th-wide" aria-labelledby="th-sections-title">
        <SectionHeader
          id="th-sections-title"
          title={`Sections from stores on ${theme.name}`}
          count={sections.total}
          description={`Each captured page is sliced into tagged sections: ${sections.by_type.length} types so far. Start from a type, or open them all in the library.`}
          href={sectionsHref}
          linkLabel="Open in the library"
        />
        <ChipRow label="Section types" class="th-types">
          {typeChips.slice(0, TYPE_CHIPS).map((t) => (
            <Chip href={`${t.type.href}?theme=${encodeURIComponent(slug)}`} count={t.count}>
              {t.type.name}
            </Chip>
          ))}
          {typeChips.length > TYPE_CHIPS && (
            <Chip href={sectionsHref}>{`+${typeChips.length - TYPE_CHIPS} more types`}</Chip>
          )}
        </ChipRow>
        <div class="grid grid--sections th-sections">
          {sectionSamples.map((s) => (
            <SectionCard
              href={s.href}
              crop={s.crop}
              device={s.device}
              typeName={s.type.name}
              storeLabel={s.store.display_name}
              meta={`${s.type.name} · ${pageName(s.page_type)} · ${s.device === 'mobile' ? 'Mobile' : 'Desktop'}`}
              app={s.app ? { name: s.app.short_name, iconUrl: s.app.icon_url } : null}
            />
          ))}
        </div>
      </section>
    )}

    {(similar.length > 0 || comparisons.length > 0) && (
      <section class="th-wide th-compare" id="compare" aria-labelledby="th-compare-title">
        <SectionHeader
          id="th-compare-title"
          title={`Compare ${theme.name} with similar themes`}
          description="Picked for the same vendor, a similar price, or apps their stores share."
          href={`/alternatives/${slug}`}
          linkLabel={`All ${theme.name} alternatives`}
        />
        {similar.length > 0 && (
          <div class="grid grid--themes th-similar">
            {similar.map((s) => (
              <div class="th-similar__item">
                <ThemeCard
                  slug={s.theme.slug}
                  name={s.theme.name}
                  href={s.theme.href}
                  vendor={s.theme.vendor ?? 'Unknown vendor'}
                  priceLabel={s.theme.price.is_free ? 'Free' : (s.theme.price.label ?? '—')}
                  storesCount={s.theme.usage.stores}
                  share={s.theme.usage.share}
                  rank={s.theme.usage.rank}
                  shots={s.theme.previews.map((p) => ({
                    src: p.image.src,
                    width: p.image.width,
                    height: p.image.height,
                    device: p.device,
                    alt: `${s.theme.name} theme on a live store, home page`,
                  }))}
                />
                {s.reasons.length > 0 && <p class="th-similar__why">{similarReason(s.reasons)}</p>}
              </div>
            ))}
          </div>
        )}
        {comparisons.length > 0 && (
          <div class="th-pairs">
            <h3 class="th-pairs__title">Side by side</h3>
            <CompareList slug={slug} items={comparisons} />
          </div>
        )}
      </section>
    )}

    <footer class="th-source">
      <SourceNote
        source={source?.label ?? 'Our scan'}
        asOf={source?.label.includes(asOf) ? undefined : asOf}
        href={source?.url ?? '/methodology'}
      />
    </footer>
  </div>
</BaseLayout>

<style>
  /* ---- Identity row ---- */
  .th-chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }
  .th-lead {
    margin-top: var(--space-4);
    max-width: 600px;
  }
  .th-chips__by {
    margin-right: var(--space-1);
    color: var(--ink-2);
    font-size: var(--text-ui);
  }
  .th-chips__by a {
    color: var(--ink);
    font-weight: var(--weight-medium);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
  }
  .th-chips__by a:hover {
    text-decoration-color: currentColor;
  }
  .th-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-2);
  }
  /* The CTA's button joins the action row; its disclosure note sits under the whole row. */
  .th-actions :global(.th-cta) {
    display: contents;
  }
  .th-actions :global(.th-cta .cta__note) {
    flex-basis: 100%;
    max-width: none;
    text-align: right;
  }
  /* Below 1280 the actions sit under the identity (primary first), so the text keeps its
     width; below 640 the primary spans the row and Compare/Save split the next one. */
  @media (max-width: 1279px) {
    .th-actions {
      justify-content: flex-start;
      width: 100%;
    }
    .th-actions :global(.th-cta .btn) {
      order: -1;
    }
    .th-actions :global(.th-cta .cta__note) {
      text-align: left;
    }
  }
  @media (min-width: 1024px) and (max-width: 1279px) {
    .th :global(.th-id .ph__row) {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-5);
    }
  }
  @media (max-width: 639px) {
    .th-actions :global(.th-cta .btn) {
      flex-basis: 100%;
    }
    .th-actions :global(.th-act) {
      flex: 1 1 0;
    }
  }

  /* ---- Main column + sticky facts ---- */
  .th-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: var(--space-12);
  }
