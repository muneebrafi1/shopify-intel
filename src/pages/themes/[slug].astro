---
/**
 * /themes/<slug>: a theme's specimen sheet. The name set large in the serif with its spec rows,
 * then the plates (the theme on real stores, page by page, desktop and mobile) on a dark stage,
 * then what those stores are made of: sections, the stores themselves, versions, apps, and
 * similar themes to compare.
 *
 * URL state: ?page=&device= (plates), ?cursor=&p= (stores list paging). Unknown slugs are 404s.
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/ui/Breadcrumbs.astro';
import MonoLabel from '~/components/ui/MonoLabel.astro';
import SectionHeader from '~/components/ui/SectionHeader.astro';
import SourceNote from '~/components/ui/SourceNote.astro';
import IndexList from '~/components/ui/IndexList.astro';
import IndexRow from '~/components/ui/IndexRow.astro';
import Button from '~/components/ui/Button.astro';
import Count from '~/components/ui/Count.astro';
import AffiliateCta from '~/components/domain/AffiliateCta.astro';
import ThemeCard from '~/components/domain/ThemeCard.astro';
import SectionCard from '~/components/domain/SectionCard.astro';
import SpecRows, { type SpecRow } from '~/components/themes/SpecRows.astro';
import ThemePlates from '~/components/themes/ThemePlates.astro';
import VersionList from '~/components/themes/VersionList.astro';
import ThemeApps from '~/components/themes/ThemeApps.astro';
import CompareList from '~/components/themes/CompareList.astro';
import { detailHref, latestVersion, readPlateState, specimenNo } from '~/components/themes/params';
import { api, isApiError, orNotFound } from '~/server/api';
import type { StoreListItem } from '~/server/api/v1/types';
import { CORE_PAGE_TYPES, PAGE_TYPES, type PageType } from '~/lib/taxonomy';
import { formatCount, formatDate, formatPercent } from '~/lib/format';

const STORES_PAGE = 24;
const slug = (Astro.params.slug ?? '').toLowerCase();
if (!/^[a-z0-9][a-z0-9-]{0,79}$/.test(slug)) return Astro.rewrite('/404');

const sp = Astro.url.searchParams;
const cursor = sp.get('cursor') || undefined;
const listPage = Math.max(1, Math.min(9999, Number.parseInt(sp.get('p') ?? '1', 10) || 1));

const detailRes = await orNotFound(api.getTheme({ slug, stores_limit: 0 }));
if (!detailRes) return Astro.rewrite('/404');
const { data: detail, meta } = detailRes;
const theme = detail.theme;
if (theme.slug !== Astro.params.slug) return Astro.redirect(theme.href, 301);

// Stores using the theme (with currency and capture state) and the catalogue order for N°.
let storesRes;
try {
  storesRes = await api.listStores({ theme: slug, limit: STORES_PAGE, cursor });
} catch (err) {
  if (isApiError(err) && err.status === 400) return Astro.redirect(`${theme.href}#stores`, 302);
  throw err;
}
const order = await api.listThemes({ sort: 'usage', limit: 100 });
const position = order.data.items.findIndex((t) => t.slug === slug);
const n = position >= 0 ? position + 1 : (theme.usage.rank ?? 0);

const stores: StoreListItem[] = storesRes.data.items;
const storesTotal = storesRes.meta.pagination?.total ?? detail.stores.total;
const nextCursor = storesRes.meta.pagination?.next_cursor ?? null;

// Plates: page types that have captures, in taxonomy order.
const curated = detail.curated_stores;
const pageSet = new Set(curated.flatMap((c) => c.pages.map((p) => p.page_type)));
const pages: PageType[] = PAGE_TYPES.map((p) => p.slug).filter((p) => pageSet.has(p));
const plate = readPlateState(sp, pages.length ? pages : CORE_PAGE_TYPES);
const appCounts = new Map(stores.map((s) => [s.domain, s.app_count]));
const keep = { cursor: cursor ?? null, p: listPage };

// ---- Facts -------------------------------------------------------------------------------
const usage = theme.usage;
const source = meta.sources[usage.source];
const asOf = formatDate(usage.as_of);
const sourceShort = `${(source?.label ?? 'Scan').replace(/ of .*$/, '')} · ${asOf}`;
const priceText = theme.price.is_free ? 'Free' : (theme.price.label ?? 'Price not listed');
const latest = latestVersion(detail.versions.map((v) => v.version));
const latestStores = detail.versions.find((v) => v.version === latest)?.stores ?? 0;
const sharePct = formatPercent(usage.share * 100);

const specs: SpecRow[] = [
  theme.vendor_info
    ? { label: 'Vendor', value: theme.vendor_info.name, href: theme.vendor_info.href }
    : { label: 'Vendor', value: 'Unknown', muted: true },
  { label: 'Price', value: priceText, mono: !theme.price.is_free && !!theme.price.label },
  ...(theme.marketplace ? [{ label: 'Marketplace', value: theme.marketplace }] : []),
  ...(theme.theme_store_id
    ? [{ label: 'Theme Store ID', value: String(theme.theme_store_id), mono: true }]
    : []),
  latest
    ? {
        label: 'Latest version seen',
        value: latest,
        mono: true,
        note: `on ${latestStores} ${latestStores === 1 ? 'store' : 'stores'}`,
      }
    : { label: 'Latest version seen', value: 'Not recorded', muted: true },
  {
    label: 'Stores in scan',
    value: `${formatCount(usage.stores)} of ${formatCount(usage.denominator)} · ${sharePct}`,
    note: sourceShort,
  },
  detail.presets.length
    ? { label: 'Presets', value: detail.presets.map((p) => p.name).join(', ') }
    : {
        label: 'Presets',
        value: 'Not detected yet',
        muted: true,
        note: 'Lands with the capture pipeline',
      },
];

// The name is the page's one very large thing; it is sized to fit its longest word on one line.
const nameChars = Math.max(6, ...theme.name.split(/\s+/).map((w) => w.length));

const dek = (() => {
  const what = theme.price.is_free
    ? 'A free theme'
    : theme.price.label
      ? `A ${theme.price.label} theme`
      : 'A theme';
  const by = theme.vendor_info ? ` by ${theme.vendor_info.name}` : '';
  const where =
    usage.stores > 0
      ? `, running on ${formatCount(usage.stores)} of the ${formatCount(usage.denominator)} stores in our scan.`
      : `, not yet seen on the ${formatCount(usage.denominator)} stores in our scan.`;
  return { what, by, where };
})();

// ---- Lower blocks ------------------------------------------------------------------------
const sections = detail.sections;
// Lead with the sections that carry a theme's look; chrome (header, footer) goes last.
const SAMPLE_ORDER = [
  'hero',
  'product-gallery',
  'buy-box',
  'featured-collection',
  'image-with-text',
  'collection-list',
  'product-grid',
  'reviews',
  'testimonials',
  'ugc-gallery',
  'slideshow',
  'collection-header',
  'cart-items',
  'newsletter',
  'upsell',
];
const rankOf = (t: string) => {
  const i = SAMPLE_ORDER.indexOf(t);
  return i === -1 ? SAMPLE_ORDER.length + (t === 'header' || t === 'footer' ? 10 : 0) : i;
};
const sectionSamples = [...sections.items]
  .sort((a, b) => rankOf(a.type.slug) - rankOf(b.type.slug))
  .slice(0, 8);
const pageName = (p: string) => PAGE_TYPES.find((x) => x.slug === p)?.name ?? p;
const sectionsHref = `/sections?theme=${encodeURIComponent(slug)}`;
const similar = detail.similar.slice(0, 3);
const comparisons = detail.comparisons;
const similarReason = (r: string[]) =>
  r
    .map(
      (x) =>
        ({
          'same-vendor': 'Same vendor',
          'similar-price': 'Similar price',
          'shared-apps': 'Shared apps',
        })[x] ?? x,
    )
    .join(' · ');

const storesFrom = (listPage - 1) * STORES_PAGE + 1;
const storesTo = storesFrom + stores.length - 1;

// ---- SEO ---------------------------------------------------------------------------------
const site = Astro.site ?? Astro.url;
const abs = (path: string) => new URL(path, site).href;
const title = `${theme.name} theme${theme.vendor ? ` by ${theme.vendor}` : ''} on real Shopify stores`;
const description = `${theme.name}${theme.vendor ? ` by ${theme.vendor}` : ''} (${priceText}) seen on ${formatCount(usage.stores)} of ${formatCount(usage.denominator)} scanned Shopify stores: home, collection, product and cart pages on desktop and mobile, the sections they use, apps installed alongside it and similar themes.`;
const jsonLd = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: 'Themes', item: abs('/themes') },
      { '@type': 'ListItem', position: 3, name: theme.name, item: abs(theme.href) },
    ],
  },
  {
    '@type': 'CreativeWork',
    name: `${theme.name} Shopify theme`,
    genre: 'Shopify theme',
    url: abs(theme.href),
    description,
    ...(theme.vendor ? { creator: { '@type': 'Organization', name: theme.vendor } } : {}),
    ...(detail.official_url ? { sameAs: detail.official_url } : {}),
    ...(theme.theme_store_id ? { identifier: String(theme.theme_store_id) } : {}),
    ...(typeof theme.price.cents === 'number'
      ? {
          offers: {
            '@type': 'Offer',
            price: (theme.price.cents / 100).toFixed(2),
            priceCurrency: 'USD',
            ...(detail.official_url ? { url: detail.official_url } : {}),
          },
        }
      : {}),
  },
];

Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=600');
---

<BaseLayout
  {title}
  {description}
  canonical={meta.canonical ?? theme.href}
  noindex={listPage > 1}
  {jsonLd}
>
  <div class="container">
    <Breadcrumbs
      items={[
        { label: 'Home', href: '/' },
        { label: 'Themes', href: '/themes' },
        { label: theme.name },
      ]}
      class="th-crumbs"
    />

    <header class="th-head cols-12">
      <div class="th-head__id span-8">
        <MonoLabel as="p" tone="ink">{`${specimenNo(n)} — Theme`}</MonoLabel>
        <div>
          <h1 class="th-name" style={`--chars:${nameChars}`}>
            {theme.name}
          </h1>
          <p class="th-dek">
            {dek.what}
            {theme.vendor_info ? (
              <>
                {' '}
                by <a href={theme.vendor_info.href}>{theme.vendor_info.name}</a>
              </>
            ) : (
              dek.by
            )}
            {dek.where}
          </p>
        </div>
      </div>
      <aside class="th-head__spec start-9" aria-label={`${theme.name} specifications`}>
        <SpecRows rows={specs} />
        {theme.cta && (
          <AffiliateCta
            href={theme.cta.href}
            label={theme.cta.label}
            isAffiliate={theme.cta.is_affiliate}
            size="md"
            full
            class="th-cta"
          />
        )}
      </aside>
    </header>
  </div>

  <ThemePlates
    slug={slug}
    name={theme.name}
    curated={curated}
    state={plate}
    pages={pages}
    appCounts={appCounts}
    keep={keep}
  />

  <div class="container">
    {sections.total > 0 && (
      <section class="page-block" aria-labelledby="th-sections">
        <SectionHeader
          id="th-sections"
          label={`${sections.by_type.length} section types`}
          title={`Sections from stores on ${theme.name}`}
          count={sections.total}
          description="Each page is sliced into tagged sections. Start from a type, or browse them all in the library."
          href={sectionsHref}
          linkLabel="Open in the library"
          rule
        />
        <ul class="th-types" aria-label="Section types">
          {sections.by_type.map((t) => (
            <li>
              <a href={`${t.type.href}?theme=${encodeURIComponent(slug)}`}>
                {t.type.name}
                <Count value={t.count} label={t.count === 1 ? 'section' : 'sections'} />
              </a>
            </li>
          ))}
        </ul>
        <div class="grid grid--sections th-sections">
          {sectionSamples.map((s) => (
            <SectionCard
              href={s.href}
              crop={s.crop}
              device={s.device}
              typeName={s.type.name}
              storeLabel={s.store.display_name}
              meta={`${s.type.name} · ${pageName(s.page_type)} · ${s.device}`}
              app={s.app ? { name: s.app.short_name, iconUrl: s.app.icon_url } : null}
            />
          ))}
        </div>
      </section>
    )}

    <section class="page-block th-stores" id="stores" aria-labelledby="th-stores-title">
      <SectionHeader
        id="th-stores-title"
        label="Detected in the scan"
        title={`Stores using ${theme.name}`}
        count={storesTotal}
        description="Every active store where we detected this theme. Stores without a capture still have a page with their theme and apps."
        rule
      />
      {stores.length === 0 ? (
        <p class="th-empty">No active store in our scan runs {theme.name} right now.</p>
      ) : (
        <IndexList
          columns="56px minmax(0,2.4fr) 112px 96px minmax(0,1fr) 140px"
          head={['N°', 'Store', 'Version', 'Currency', 'Capture', 'Apps']}
          label={`Stores using ${theme.name}`}
          class="th-index"
        >
          {stores.map((s, i) => (
            <IndexRow
              n={storesFrom + i}
              href={s.href}
              title={s.display_name}
              subtitle={
                [s.name ? s.domain : null, s.theme.version, s.currency]
                  .filter(Boolean)
                  .join(' · ') || undefined
              }
              preview={
                s.preview
                  ? {
                      src: s.preview.image.src,
                      width: s.preview.image.width,
                      height: s.preview.image.height,
                      device: 'desktop',
                    }
                  : null
              }
              cells={[
                { value: s.theme.version ?? '—', mono: true, muted: !s.theme.version },
                { value: s.currency ?? '—', mono: true, muted: !s.currency },
                {
                  value: s.is_captured
                    ? 'Captured'
                    : s.is_curated
                      ? 'Layout preview'
                      : 'Not captured',
                  muted: !s.is_captured,
                },
                {
                  value: `(${s.app_count} ${s.app_count === 1 ? 'app' : 'apps'})`,
                  serif: true,
                  mobile: true,
                },
              ]}
            />
          ))}
        </IndexList>
      )}
      <div class="th-pager">
        <p class="th-pager__status">
          {stores.length > 0 && (
            <span class="num">
              {storesTotal > stores.length
                ? `${formatCount(storesFrom)}–${formatCount(storesTo)} of `
                : ''}
              {formatCount(storesTotal)} {storesTotal === 1 ? 'store' : 'stores'} ·{' '}
            </span>
          )}
          Detected in the {sourceShort}. <a href={source?.url ?? '/methodology'}>How we detect</a>
        </p>
        {(listPage > 1 || nextCursor) && (
          <div class="th-pager__buttons">
            {listPage > 1 && (
              <Button
                href={detailHref(slug, plate, { hash: 'stores' })}
                size="sm"
                icon="caret-left"
              >
                First page
              </Button>
            )}
            {nextCursor && (
              <Button
                href={detailHref(slug, plate, {
                  cursor: nextCursor,
                  p: listPage + 1,
                  hash: 'stores',
                })}
                size="sm"
                iconRight="caret-right"
                rel="next"
              >
                Next {Math.min(STORES_PAGE, storesTotal - storesTo)}
              </Button>
            )}
          </div>
        )}
      </div>
    </section>

    <div class="page-block th-pair cols-12">
      {detail.top_apps.length > 0 && (
        <section class="th-apps span-7" aria-labelledby="th-apps-title">
          <SectionHeader
            id="th-apps-title"
            label="Installed alongside"
            title={`Apps most used with ${theme.name}`}
            count={detail.top_apps.length}
            rule
          />
          <ThemeApps apps={detail.top_apps} of={usage.stores} />
          <p class="th-note">
            Share of the {formatCount(usage.stores)} {theme.name} stores in our scan running each
            app · {asOf}.
          </p>
        </section>
      )}
      <section class="th-versions start-9" aria-labelledby="th-versions-title">
        <SectionHeader
          id="th-versions-title"
          label="Versions seen"
          title="Versions in the wild"
          count={detail.versions.filter((v) => v.version).length}
          level={2}
          rule
        />
        <VersionList versions={detail.versions} />
        <p class="th-note">
          A version is recorded when the storefront exposes it. Others count under “Not recorded” ·{' '}
          {asOf}.
        </p>
      </section>
    </div>

    {(similar.length > 0 || comparisons.length > 0) && (
      <section class="page-block th-similar" aria-labelledby="th-similar-title">
        <SectionHeader
          id="th-similar-title"
          label="Next to it on the shelf"
          title={`Similar to ${theme.name}`}
          count={similar.length}
          href={`/alternatives/${slug}`}
          linkLabel={`All ${theme.name} alternatives`}
          rule
        />
        {similar.length > 0 && (
          <div class="grid grid--themes">
            {similar.map((s) => (
              <div class="th-similar__item">
                <ThemeCard
                  slug={s.theme.slug}
                  name={s.theme.name}
                  href={s.theme.href}
                  vendor={s.theme.vendor ?? 'Unknown vendor'}
                  priceLabel={s.theme.price.label ?? '—'}
                  storesCount={s.theme.usage.stores}
                  shots={s.theme.previews.map((p) => ({
                    src: p.image.src,
                    width: p.image.width,
                    height: p.image.height,
                    device: p.device,
                    alt: `${s.theme.name} theme on a live store, home page`,
                  }))}
                />
                {s.reasons.length > 0 && (
                  <p class="th-similar__why mlabel mlabel--bullet">{similarReason(s.reasons)}</p>
                )}
              </div>
            ))}
          </div>
        )}
        {comparisons.length > 0 && (
          <div class="th-compare">
            <MonoLabel as="h3" class="th-compare__label">
              Compare side by side
            </MonoLabel>
            <CompareList slug={slug} items={comparisons} />
          </div>
        )}
      </section>
    )}

    <footer class="th-source">
      <SourceNote
        source={source?.label ?? 'Our scan'}
        asOf={source?.label.includes(asOf) ? undefined : asOf}
        href={source?.url ?? '/methodology'}
      />
      <p class="th-source__bias">
        Stores were found through Shopify Theme Store example lists, so counts show reach in our
        scan of {formatCount(usage.denominator)} stores, not market share.
      </p>
    </footer>
  </div>
</BaseLayout>

<style>
  :global(.th-crumbs) {
    padding-top: var(--space-6);
  }
  .th-head {
    padding-block: var(--space-8) var(--space-12);
  }
  .th-head__id {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-8);
    min-width: 0;
  }
  .th-head__id :global(.mlabel) {
    padding-top: 9px;
  }
  .th-name {
    font-family: var(--font-serif);
    /* ≈0.5em per letter in Newsreader at this tracking: never wider than the column. */
    font-size: min(12rem, calc((100vw - 2 * var(--page-gutter)) / (var(--chars) * 0.5)));
    font-weight: 400;
    font-optical-sizing: auto;
    letter-spacing: -0.045em;
    line-height: 0.88;
    margin-left: -0.04em;
    text-wrap: balance;
  }
  @media (min-width: 1024px) {
    .th-name {
      font-size: min(
        12rem,
        calc((min(100vw, var(--page-max)) - 2 * var(--page-gutter)) * 0.64 / (var(--chars) * 0.5))
      );
    }
  }
  .th-dek {
    margin-top: var(--space-6);
    max-width: 30ch;
    color: var(--ink-2);
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 1rem + 0.9vw, 1.75rem);
    letter-spacing: -0.01em;
    line-height: 1.2;
  }
  .th-dek a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
  }
  .th-dek a:hover {
    text-decoration-color: currentColor;
  }
  .th-head__spec {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    min-width: 0;
  }
  @media (max-width: 1023px) {
    .th-head {
      padding-block: var(--space-6) var(--space-10);
    }
    .th-head__spec {
      margin-top: var(--space-4);
    }
  }

  @media (max-width: 639px) {
    .th-sections > :global(:nth-child(n + 5)) {
      display: none;
    }
  }
  .th-types {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin-bottom: var(--space-8);
    font-size: var(--text-md);
  }
  .th-types a {
    color: var(--ink-2);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.2em;
    transition:
      color var(--dur-fast) var(--ease-out),
      text-decoration-color var(--dur-fast) var(--ease-out);
  }
  .th-types a:hover {
    color: var(--ink);
    text-decoration-color: var(--line-strong);
  }

  .th-empty {
    padding: var(--space-8) 0;
    color: var(--ink-3);
    border-top: 1px solid var(--ink);
  }
  .th-pager {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: var(--space-4) var(--space-5);
  }
  .th-pager__status {
    color: var(--ink-3);
    font-size: var(--text-xs);
  }
  .th-pager__status a {
    color: var(--ink-2);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
  }
  .th-pager__buttons {
    display: flex;
    gap: var(--space-2);
  }

  .th-pair {
    row-gap: var(--space-12);
  }
  .th-note {
    margin-top: var(--space-3);
    color: var(--ink-3);
    font-size: var(--text-xs);
    line-height: 1.45;
  }
  .th-note a {
    color: var(--ink-2);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
  }
  @media (min-width: 1024px) {
    .th-versions {
      position: sticky;
      top: calc(var(--header-h) + var(--space-6));
      align-self: start;
    }
  }

  .th-similar__item {
    min-width: 0;
  }
  .th-similar__why {
    margin-top: var(--space-2);
  }
  .th-compare {
    margin-top: var(--space-12);
  }
  :global(.th-compare__label) {
    margin-bottom: var(--space-3);
  }

  .th-source {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: var(--space-16);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }
  .th-source__bias {
    max-width: 640px;
    color: var(--ink-3);
    font-size: var(--text-xs);
    line-height: 1.45;
  }
</style>
