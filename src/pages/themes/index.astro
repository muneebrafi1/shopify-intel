---
/**
 * /themes: every theme we track, each shown on the real stores that run it (Base44 browse
 * pattern). Page header → BrowseBar (search, price pills, vendor, sort, grid/table) → ThemeCard
 * grid, or a ranked table (?view=index) → vendors → source.
 * Filters are URL state: q, price (free, paid or a price band), vendor, sort, view, p; see
 * params.ts. Ranks are the API's usage ranks (equal usage shares a rank).
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/ui/PageHeader.astro';
import BrowseBar, { type FilterGroup } from '~/components/ui/BrowseBar.astro';
import SectionHeader from '~/components/ui/SectionHeader.astro';
import EmptyState from '~/components/ui/EmptyState.astro';
import Button from '~/components/ui/Button.astro';
import Pagination from '~/components/ui/Pagination.astro';
import SourceNote from '~/components/ui/SourceNote.astro';
import ThemeCard from '~/components/domain/ThemeCard.astro';
import ThemeTable from '~/components/themes/ThemeTable.astro';
import VendorStrip from '~/components/themes/VendorStrip.astro';
import {
  SORTS,
  apiPriceInput,
  indexHref,
  readIndexState,
  type IndexState,
  type PriceFilter,
} from '~/components/themes/params';
import { api } from '~/server/api';
import { encodeCursor } from '~/server/api/v1/pagination';
import type { ThemeListItem } from '~/server/api/v1/types';
import { formatCount, formatDate } from '~/lib/format';

const PAGE_SIZE = 48;
const state = readIndexState(Astro.url.searchParams);
const filtered = !!(state.price || state.vendor || state.q);

const [list, all, metaRes] = await Promise.all([
  api.listThemes({
    ...apiPriceInput(state.price),
    vendor: state.vendor,
    q: state.q,
    sort: state.sort,
    limit: PAGE_SIZE,
    // The theme catalogue is small and offset-paged (docs/API.md), so page N is a known offset.
    cursor: state.p > 1 ? encodeCursor([(state.p - 1) * PAGE_SIZE]) : undefined,
  }),
  // Unfiltered facets for the header numbers and the vendor index.
  filtered ? api.listThemes({ limit: 1 }) : null,
  api.getMeta({}),
]);

const themes: ThemeListItem[] = list.data.items;
const total = list.meta.pagination?.total ?? themes.length;
const facets = list.data.facets;
const allFacets = (all ?? list).data.facets;
const allTotal = (all ?? list).meta.pagination?.total ?? total;
const meta = metaRes.data;
const source = list.meta.sources[themes[0]?.usage.source ?? meta.source.id] ?? meta.source;
const asOf = formatDate(meta.data_as_of);
const scanned = meta.counts.stores_scanned;

// Page past the end (e.g. after a filter change): back to the first page.
if (state.p > 1 && themes.length === 0) return Astro.redirect(indexHref(state, { p: 1 }), 302);

// ---- Browse bar ----------------------------------------------------------------------------
const bandCount = (v: string) => facets.price_bands.find((b) => b.value === v)?.count;
const paidCount = facets.price_bands
  .filter((b) => b.value !== 'free')
  .reduce((n, b) => n + b.count, 0);
const PRICE_OPTIONS: { value: PriceFilter | undefined; label: string; count: number | null }[] = [
  { value: undefined, label: 'Any price', count: null },
  // With "paid" selected the band facet has no free row, so the free count is unknown there.
  { value: 'free', label: 'Free', count: state.price === 'paid' ? null : (bandCount('free') ?? 0) },
  { value: 'paid', label: 'Paid', count: paidCount },
  ...(['under-300', '300-399', '400-plus'] as const).map((value) => ({
    value,
    label: allFacets.price_bands.find((b) => b.value === value)?.label ?? value,
    count: bandCount(value) ?? 0,
  })),
];

const vendorLabel = (slug: string) =>
  allFacets.vendors.find((v) => v.value === slug)?.label ??
  facets.vendors.find((v) => v.value === slug)?.label ??
  slug;
const vendorOptions = [...facets.vendors];
if (state.vendor && !vendorOptions.some((v) => v.value === state.vendor)) {
  vendorOptions.push({ value: state.vendor, label: vendorLabel(state.vendor), count: 0 });
}

const groups: FilterGroup[] = [
  {
    key: 'price',
    label: 'Price',
    options: PRICE_OPTIONS.map((o) => ({
      label: o.label,
      href: indexHref(state, { price: o.value }),
      selected: state.price === o.value,
      count: o.count,
    })),
  },
  {
    key: 'vendor',
    label: 'Vendor',
    options: [
      {
        label: 'Any vendor',
        href: indexHref(state, { vendor: undefined }),
        selected: !state.vendor,
      },
      ...vendorOptions.map((v) => ({
        label: v.label,
        href: indexHref(state, { vendor: v.value }),
        selected: state.vendor === v.value,
        count: v.count,
      })),
    ],
  },
];
const sort = SORTS.map((s) => ({
  label: s.label,
  href: indexHref(state, { sort: s.value }),
  selected: state.sort === s.value,
}));
const clearHref = indexHref({ sort: state.sort, view: state.view, p: 1 });

// ---- Copy, SEO ---------------------------------------------------------------------------
const priceLabel = PRICE_OPTIONS.find((o) => o.value === state.price)?.label;
let heading = 'Shopify themes';
if (state.vendor) heading = `${vendorLabel(state.vendor)} themes`;
if (state.price === 'free' || state.price === 'paid')
  heading = `${priceLabel} ${state.vendor ? heading : 'Shopify themes'}`;
else if (state.price) heading = `${heading} ${priceLabel?.replace(/^U/, 'u')}`;
const facetFiltered = !!(state.price || state.vendor);
const title = state.q
  ? `Themes matching “${state.q}”`
  : facetFiltered
    ? heading
    : 'Shopify themes on real stores';
const description = facetFiltered
  ? `${formatCount(total)} ${heading.toLowerCase()} we track, each shown on the real Shopify stores that run it, with prices, vendors and usage in our scan of ${formatCount(scanned)} stores.`
  : `Every Shopify theme we track (${allTotal}), shown on the real stores that run it: home, collection and product pages, desktop and mobile, with price, vendor and usage in our scan.`;

const singleFilter = !state.q && (state.price ? 1 : 0) + (state.vendor ? 1 : 0) === 1;
const canonical = singleFilter
  ? indexHref({ price: state.price, vendor: state.vendor, sort: 'usage', view: 'grid', p: 1 })
  : '/themes';
const noindex = (filtered && !singleFilter) || state.p > 1;

const offset = (state.p - 1) * PAGE_SIZE;
const jsonLd = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: new URL('/', Astro.site ?? Astro.url).href,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Themes',
        item: new URL('/themes', Astro.site ?? Astro.url).href,
      },
    ],
  },
  {
    '@type': 'ItemList',
    name: title,
    numberOfItems: total,
    itemListElement: themes.map((t, i) => ({
      '@type': 'ListItem',
      position: offset + i + 1,
      name: t.name,
      url: new URL(t.href, Astro.site ?? Astro.url).href,
    })),
  },
];

const free = allFacets.price_bands.find((b) => b.value === 'free')?.count ?? 0;
const headerFacts = [
  `${free} free`,
  `${allTotal - free} paid`,
  `${allFacets.vendors.length} vendors`,
  `${formatCount(scanned)} stores scanned`,
];

const vendors = allFacets.vendors.map((v) => ({
  label: v.label,
  count: v.count,
  href: indexHref({ sort: state.sort, view: state.view, p: 1 }, { vendor: v.value }),
  selected: state.vendor === v.value,
}));

const viewState = (view: IndexState['view']) => indexHref(state, { view, p: state.p });
const noun = total === 1 ? 'theme' : 'themes';

Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=600');
---

<BaseLayout {title} {description} {canonical} {noindex} {jsonLd} wide>
  <div class="container--wide ti">
    <PageHeader
      title={state.q ? 'Themes' : facetFiltered ? heading : 'Themes'}
      count={filtered ? total : allTotal}
      description={
        state.q
          ? `Matching “${state.q}”, shown on the real stores that run them.`
          : 'Every Shopify theme we track, shown on the real stores that run it.'
      }
    >
      <Fragment slot="actions">
        <Button href="/compare?kind=theme" variant="secondary" icon="scales">
          Compare themes
        </Button>
      </Fragment>
    </PageHeader>

    <BrowseBar
      {groups}
      pills="price"
      {total}
      {noun}
      {sort}
      view={{ current: state.view, gridHref: viewState('grid'), indexHref: viewState('index') }}
      {clearHref}
      search={{
        action: '/themes',
        value: state.q ?? '',
        placeholder: 'Search themes',
        hidden: {
          price: state.price,
          vendor: state.vendor,
          sort: state.sort !== 'usage' ? state.sort : undefined,
          view: state.view === 'index' ? 'index' : undefined,
        },
      }}
    />

    <section class="ti-results" aria-label="Themes">
      {themes.length === 0 ? (
        <EmptyState
          title={
            state.q && !facetFiltered
              ? `No themes match “${state.q}”`
              : 'No themes match these filters'
          }
          body={
            state.q
              ? `We search theme names and vendors. Try a shorter search${facetFiltered ? ', or clear the filters' : ''} to see every theme we track.`
              : 'Try another price or vendor, or clear the filters to see every theme we track.'
          }
          class="ti-empty"
        >
          <Button
            href={indexHref({ sort: state.sort, view: state.view, p: 1 })}
            variant="secondary"
            size="sm"
          >
            {state.q && !facetFiltered ? 'Clear search' : 'Clear filters'}
          </Button>
        </EmptyState>
      ) : state.view === 'grid' ? (
        <div class="grid grid--themes ti-grid">
          {themes.map((t, i) => (
            <ThemeCard
              slug={t.slug}
              name={t.name}
              href={t.href}
              vendor={t.vendor ?? 'Unknown vendor'}
              priceLabel={t.price.is_free ? 'Free' : (t.price.label ?? '—')}
              storesCount={t.usage.stores}
              share={t.usage.share}
              rank={t.usage.rank}
              eager={i < 4}
              shots={t.previews.map((p) => ({
                src: p.image.src,
                width: p.image.width,
                height: p.image.height,
                device: p.device,
                alt: `${t.name} theme on a live store, home page`,
              }))}
            />
          ))}
        </div>
      ) : (
        <ThemeTable themes={themes} label={title} />
      )}

      {total > PAGE_SIZE && (
        <Pagination
          page={state.p}
          pageSize={PAGE_SIZE}
          {total}
          hrefFor={(p) => indexHref(state, { p })}
          {noun}
          class="ti-pager"
        />
      )}
    </section>

    {vendors.length > 0 && (
      <section class="ti-vendors" aria-labelledby="ti-vendors-title">
        <SectionHeader
          id="ti-vendors-title"
          eyebrow="By vendor"
          title={`${vendors.length} studios make the themes we track`}
          description="Pick one to see only its themes."
        />
        <VendorStrip vendors={vendors} />
      </section>
    )}

    <footer class="ti-source">
      <SourceNote
        source={source.label}
        asOf={source.label.includes(asOf) ? undefined : asOf}
        href={source.url ?? '/methodology'}
      />
    </footer>
  </div>
</BaseLayout>

<style>
  .ti-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 2px var(--space-2);
    margin-top: var(--space-4);
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.01em;
  }
  .ti-facts__sep {
    color: var(--ink-4);
  }
  .ti-results {
    padding-top: var(--space-6);
  }
  @media (min-width: 1024px) {
    .ti-results {
      padding-top: var(--space-8);
    }
  }
  @media (min-width: 1280px) {
    .ti-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  /* 390: a two-up gallery (20 themes in ten rows, not twenty screens). */
  @media (max-width: 639px) {
    .ti-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-4) var(--space-3);
    }
    /* Name and price share the first line; the vendor gets the card's full width. */
    .ti-grid :global(.theme-card__body) {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 0 var(--space-2);
      padding: 10px var(--space-3) 0;
    }
    .ti-grid :global(.theme-card__text) {
      display: contents;
    }
    .ti-grid :global(.theme-card__name) {
      grid-area: 1 / 1;
    }
    .ti-grid :global(.theme-card__body .badge) {
      grid-area: 1 / 2;
      justify-self: end;
    }
    .ti-grid :global(.theme-card__meta) {
      grid-area: 2 / 1 / 3 / 3;
    }
    .ti-grid :global(:is(.theme-card__name, .theme-card__meta)) {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .ti-grid :global(.theme-card__count) {
      padding: var(--space-2) var(--space-3) var(--space-3);
    }
  }
  :global(.ti-empty) {
    margin-top: var(--space-2);
  }
  :global(.ti-pager) {
    margin-top: var(--space-10);
  }
  .ti-vendors {
    margin-top: var(--space-16);
    padding-top: var(--section-y-app);
    border-top: 1px solid var(--line);
  }
  .ti-vendors :global(.vstrip) {
    margin-top: var(--space-6);
  }
  .ti-source {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: var(--space-12);
    padding-block: var(--space-4) var(--space-4);
    border-top: 1px solid var(--line);
  }
  .ti-source__bias {
    max-width: 640px;
    color: var(--ink-3);
    font-size: var(--text-xs);
    line-height: 1.45;
  }
</style>
