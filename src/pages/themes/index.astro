---
/**
 * /themes: every theme we track, each shown on the real stores that run it.
 * Grid of ThemeCard decks (default) or a numbered index (?view=index) with hover previews.
 * Filters are URL state: price (free, paid or a price band), vendor, sort; see params.ts.
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/ui/PageHeader.astro';
import FilterBar, { type FilterGroup } from '~/components/ui/FilterBar.astro';
import IndexList from '~/components/ui/IndexList.astro';
import IndexRow from '~/components/ui/IndexRow.astro';
import EmptyState from '~/components/ui/EmptyState.astro';
import Button from '~/components/ui/Button.astro';
import Pagination from '~/components/ui/Pagination.astro';
import SourceNote from '~/components/ui/SourceNote.astro';
import MonoLabel from '~/components/ui/MonoLabel.astro';
import ThemeCard from '~/components/domain/ThemeCard.astro';
import SpecRows from '~/components/themes/SpecRows.astro';
import VendorStrip from '~/components/themes/VendorStrip.astro';
import {
  SORTS,
  apiPriceInput,
  indexHref,
  readIndexState,
  type IndexState,
  type PriceFilter,
} from '~/components/themes/params';
import { api } from '~/server/api';
import { encodeCursor } from '~/server/api/v1/pagination';
import type { ThemeListItem } from '~/server/api/v1/types';
import { formatCount, formatDate, formatPercent } from '~/lib/format';

const PAGE_SIZE = 48;
const state = readIndexState(Astro.url.searchParams);
const filtered = !!(state.price || state.vendor);

const [list, all, metaRes] = await Promise.all([
  api.listThemes({
    ...apiPriceInput(state.price),
    vendor: state.vendor,
    sort: state.sort,
    limit: PAGE_SIZE,
    // The theme catalogue is small and offset-paged (docs/API.md), so page N is a known offset.
    cursor: state.p > 1 ? encodeCursor([(state.p - 1) * PAGE_SIZE]) : undefined,
  }),
  // Unfiltered facets for the header numbers and the vendor index.
  filtered ? api.listThemes({ limit: 1 }) : null,
  api.getMeta({}),
]);

const themes: ThemeListItem[] = list.data.items;
const total = list.meta.pagination?.total ?? themes.length;
const facets = list.data.facets;
const allFacets = (all ?? list).data.facets;
const allTotal = (all ?? list).meta.pagination?.total ?? total;
const meta = metaRes.data;
const source = list.meta.sources[themes[0]?.usage.source ?? meta.source.id] ?? meta.source;
const asOf = formatDate(meta.data_as_of);
const scanned = meta.counts.stores_scanned;

// Page past the end (e.g. after a filter change): back to the first page.
if (state.p > 1 && themes.length === 0) return Astro.redirect(indexHref(state, { p: 1 }), 302);

// ---- Filter bar --------------------------------------------------------------------------
const bandCount = (v: string) => facets.price_bands.find((b) => b.value === v)?.count;
const paidCount = facets.price_bands
  .filter((b) => b.value !== 'free')
  .reduce((n, b) => n + b.count, 0);
const PRICE_OPTIONS: { value: PriceFilter | undefined; label: string; count: number | null }[] = [
  { value: undefined, label: 'Any price', count: null },
  // With "paid" selected the band facet has no free row, so the free count is unknown there.
  { value: 'free', label: 'Free', count: state.price === 'paid' ? null : (bandCount('free') ?? 0) },
  { value: 'paid', label: 'Paid', count: paidCount },
  ...(['under-300', '300-399', '400-plus'] as const).map((value) => ({
    value,
    label: allFacets.price_bands.find((b) => b.value === value)?.label ?? value,
    count: bandCount(value) ?? 0,
  })),
];

const vendorLabel = (slug: string) =>
  allFacets.vendors.find((v) => v.value === slug)?.label ??
  facets.vendors.find((v) => v.value === slug)?.label ??
  slug;
const vendorOptions = [...facets.vendors];
if (state.vendor && !vendorOptions.some((v) => v.value === state.vendor)) {
  vendorOptions.push({ value: state.vendor, label: vendorLabel(state.vendor), count: 0 });
}

const groups: FilterGroup[] = [
  {
    key: 'price',
    label: 'Price',
    options: PRICE_OPTIONS.map((o) => ({
      label: o.label,
      href: indexHref(state, { price: o.value }),
      selected: state.price === o.value,
      count: o.count,
    })),
  },
  {
    key: 'vendor',
    label: 'Vendor',
    options: [
      {
        label: 'Any vendor',
        href: indexHref(state, { vendor: undefined }),
        selected: !state.vendor,
      },
      ...vendorOptions.map((v) => ({
        label: v.label,
        href: indexHref(state, { vendor: v.value }),
        selected: state.vendor === v.value,
        count: v.count,
      })),
    ],
  },
];
const sort = SORTS.map((s) => ({
  label: s.label,
  href: indexHref(state, { sort: s.value }),
  selected: state.sort === s.value,
}));
const clearHref = indexHref({ sort: state.sort, view: state.view, p: 1 });

// ---- Copy, SEO ---------------------------------------------------------------------------
const priceLabel = PRICE_OPTIONS.find((o) => o.value === state.price)?.label;
let heading = 'Shopify themes';
if (state.vendor) heading = `${vendorLabel(state.vendor)} themes`;
if (state.price === 'free' || state.price === 'paid')
  heading = `${priceLabel} ${state.vendor ? heading : 'Shopify themes'}`;
else if (state.price) heading = `${heading} ${priceLabel?.replace(/^U/, 'u')}`;
const title = filtered ? heading : 'Shopify themes on real stores';
const description = filtered
  ? `${formatCount(total)} ${heading.toLowerCase()} we track, each shown on the real Shopify stores that run it, with prices, vendors and usage in our scan of ${formatCount(scanned)} stores.`
  : `Every Shopify theme we track (${allTotal}), shown on the real stores that run it: home, collection, product and cart pages, desktop and mobile, with price, vendor and usage in our scan.`;

const singleFilter = (state.price ? 1 : 0) + (state.vendor ? 1 : 0) === 1;
const canonical = singleFilter
  ? indexHref({ price: state.price, vendor: state.vendor, sort: 'usage', view: 'grid', p: 1 })
  : '/themes';
const noindex = (filtered && !singleFilter) || state.p > 1;

const offset = (state.p - 1) * PAGE_SIZE;
const jsonLd = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: new URL('/', Astro.site ?? Astro.url).href,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Themes',
        item: new URL('/themes', Astro.site ?? Astro.url).href,
      },
    ],
  },
  {
    '@type': 'ItemList',
    name: title,
    numberOfItems: total,
    itemListElement: themes.map((t, i) => ({
      '@type': 'ListItem',
      position: offset + i + 1,
      name: t.name,
      url: new URL(t.href, Astro.site ?? Astro.url).href,
    })),
  },
];

const free = allFacets.price_bands.find((b) => b.value === 'free')?.count ?? 0;
const headerSpecs = [
  { label: 'Themes profiled', value: formatCount(allTotal), mono: true },
  { label: 'Vendors', value: formatCount(allFacets.vendors.length), mono: true },
  { label: 'Free · paid', value: `${free} · ${allTotal - free}`, mono: true },
  {
    label: 'Stores scanned',
    value: formatCount(scanned),
    mono: true,
    note: `${meta.counts.theme_names_detected} theme names detected · ${asOf}`,
  },
];

const vendors = allFacets.vendors.map((v) => ({
  label: v.label,
  count: v.count,
  href: indexHref({ sort: state.sort, view: state.view, p: 1 }, { vendor: v.value }),
  selected: state.vendor === v.value,
}));

const viewState = (view: IndexState['view']) => indexHref(state, { view, p: state.p });

Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=600');
---

<BaseLayout {title} {description} {canonical} {noindex} {jsonLd}>
  <div class="container themes-index">
    <PageHeader
      title={filtered ? heading : 'Themes'}
      count={filtered ? total : allTotal}
      eyebrow={`Theme index · ${asOf}`}
      size="lg"
      class="ti-header"
    >
      <p slot="meta" class="ti-statement">
        Every theme we track, shown on the real stores that run it.
      </p>
      <div slot="actions" class="ti-specs">
        <SpecRows rows={headerSpecs} />
        <p class="ti-bias">
          Stores were found through Theme Store example lists, so a count shows reach in our scan,
          not market share.
        </p>
      </div>
    </PageHeader>

    <FilterBar
      {groups}
      {total}
      noun={total === 1 ? 'theme' : 'themes'}
      {sort}
      view={{ current: state.view, gridHref: viewState('grid'), indexHref: viewState('index') }}
      {clearHref}
    />

    <section class="ti-results" aria-label="Themes">
      {themes.length === 0 ? (
        <EmptyState
          title="No themes match these filters"
          body="Try another price or vendor, or clear the filters to see every theme we track."
          class="ti-empty"
        >
          <Button href={clearHref} variant="primary" size="sm">
            Clear filters
          </Button>
        </EmptyState>
      ) : state.view === 'grid' ? (
        <div class="grid grid--themes ti-grid">
          {themes.map((t, i) => (
            <ThemeCard
              slug={t.slug}
              name={t.name}
              href={t.href}
              vendor={t.vendor ?? 'Unknown vendor'}
              priceLabel={t.price.label ?? '—'}
              storesCount={t.usage.stores}
              eager={i < 3}
              shots={t.previews.map((p) => ({
                src: p.image.src,
                width: p.image.width,
                height: p.image.height,
                device: p.device,
                alt: `${t.name} theme on a live store, home page`,
              }))}
            />
          ))}
        </div>
      ) : (
        <IndexList
          columns="56px minmax(0,1.5fr) minmax(0,1.2fr) 96px 88px 150px"
          head={['N°', 'Theme', 'Vendor', 'Price', 'Share', 'Stores']}
          label="Themes"
          class="ti-index"
        >
          {themes.map((t, i) => {
            const shot = t.previews[0];
            return (
              <IndexRow
                n={offset + i + 1}
                href={t.href}
                title={t.name}
                subtitle={[t.vendor, t.price.label].filter(Boolean).join(' · ')}
                preview={
                  shot
                    ? {
                        src: shot.image.src,
                        width: shot.image.width,
                        height: shot.image.height,
                        device: 'desktop',
                      }
                    : null
                }
                cells={[
                  { value: t.vendor ?? '—' },
                  { value: t.price.label ?? '—', mono: true },
                  { value: formatPercent(t.usage.share * 100), mono: true, muted: true },
                  {
                    value: `(${formatCount(t.usage.stores)} ${t.usage.stores === 1 ? 'store' : 'stores'})`,
                    serif: true,
                    mobile: true,
                  },
                ]}
              />
            );
          })}
        </IndexList>
      )}

      {total > PAGE_SIZE && (
        <Pagination
          page={state.p}
          pageSize={PAGE_SIZE}
          {total}
          hrefFor={(p) => indexHref(state, { p })}
          noun={total === 1 ? 'theme' : 'themes'}
          class="ti-pager"
        />
      )}
    </section>

    {vendors.length > 0 && (
      <section class="page-block ti-vendors cols-12" aria-labelledby="ti-vendors-title">
        <div class="ti-vendors__head span-4">
          <MonoLabel as="p">By vendor</MonoLabel>
          <h2 id="ti-vendors-title" class="ti-vendors__title">
            {vendors.length} studios make the themes we track.
          </h2>
          <p class="ti-vendors__desc">Pick one to see only its themes.</p>
        </div>
        <VendorStrip vendors={vendors} class="ti-vendors__strip span-8" />
      </section>
    )}

    <footer class="ti-source">
      <SourceNote
        source={source.label}
        asOf={source.label.includes(asOf) ? undefined : asOf}
        href={source.url ?? '/methodology'}
      />
    </footer>
  </div>
</BaseLayout>

<style>
  .ti-statement {
    margin-top: var(--space-5);
    max-width: 24ch;
    color: var(--ink-2);
    font-family: var(--font-serif);
    font-size: clamp(1.375rem, 1.05rem + 1.2vw, 2rem);
    font-weight: 400;
    letter-spacing: -0.015em;
    line-height: 1.15;
  }
  .ti-specs {
    width: 100%;
    max-width: 420px;
  }
  @media (max-width: 639px) {
    .ti-specs :global(.specs) {
      display: none;
    }
  }
  .ti-bias {
    margin-top: var(--space-3);
    color: var(--ink-3);
    font-size: var(--text-xs);
    line-height: 1.45;
  }
  .ti-results {
    margin-top: var(--space-8);
  }
  .ti-grid {
    row-gap: var(--space-10);
  }
  :global(.ti-empty) {
    margin-top: var(--space-4);
  }
  /* Theme names are set in the serif, as on the theme pages. */
  :global(.ti-index .irow__name) {
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 1.05rem + 0.6vw, 1.625rem);
    font-weight: 400;
    letter-spacing: -0.015em;
    line-height: 1.15;
  }
  :global(.ti-index .irow__link) {
    align-items: center;
  }
  :global(.ti-pager) {
    margin-top: var(--space-2);
  }
  .ti-vendors {
    padding-top: var(--space-6);
    border-top: 1px solid var(--ink);
  }
  .ti-vendors__title {
    margin-top: var(--space-3);
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.02em;
    line-height: 1.2;
    max-width: 18ch;
  }
  .ti-vendors__desc {
    margin-top: var(--space-2);
    color: var(--ink-3);
    font-size: var(--text-sm);
  }
  @media (min-width: 1024px) {
    :global(.ti-vendors__strip) {
      grid-column: 5 / -1;
    }
  }
  .ti-source {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: var(--space-12);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }
  .ti-source__bias {
    max-width: 640px;
    color: var(--ink-3);
    font-size: var(--text-xs);
    line-height: 1.45;
  }
</style>
