---
/**
 * Home: value on the first screen. Centred hero (newest teardown pill, headline, search field,
 * three paths: stores / apps / compare) → a gallery of real store captures → the store viewer in
 * a product window →
 * "How it works" dark band → feature bento of real UI → latest captures → Pro band.
 *
 * Every number and capture comes from the in-process API (the same one behind /api/v1). The page
 * stays inside D1's 50-queries-per-request budget (`npm run budget:queries`): one teardown detail
 * (with its store) feeds the window, the steps and the teardown card, and one sections query
 * (items only, no facets) feeds the captures wall; one stores query (domains filter) the gallery.
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import HomeHero from '~/components/home/HomeHero.astro';
import HomeGallery, { type GalleryTile } from '~/components/home/HomeGallery.astro';
import galleryManifest from '../../data/curation/home-gallery.json';
import ProductWindow, {
  type WindowPage,
  type WindowShot,
} from '~/components/home/ProductWindow.astro';
import HowItWorks from '~/components/home/HowItWorks.astro';
import type { HowData, CompareSide } from '~/components/home/HowVisual.astro';
import FeatureBento, {
  type BentoApp,
  type BentoCompare,
  type BentoSection,
  type BentoTeardown,
  type BentoTheme,
} from '~/components/home/FeatureBento.astro';
import Wall, { type WallTile } from '~/components/home/Wall.astro';
import { PRO_ENABLED } from '~/config/flags';
import ProBand from '~/components/home/ProBand.astro';
import SectionHeader from '~/components/ui/SectionHeader.astro';
import type { CropRegion } from '~/components/home/CaptureCrop.astro';
import { api, orNotFound } from '~/server/api';
import type {
  AppListItem,
  ScreenshotDetail,
  StoreDetail,
  TeardownDetail,
} from '~/server/api/v1/types';
import { SITE_NAME } from '~/config/site';
import { formatCount, formatDate } from '~/lib/format';
import { pageTypeName } from '~/lib/taxonomy';

Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=600');

const [
  { data: meta, meta: env },
  { data: teardownList },
  themes,
  apps,
  { data: comparisons },
  { data: homeShots },
  galleryStores,
] = await Promise.all([
  api.getMeta({}),
  api.listTeardowns({}),
  api.listThemes({ limit: 5 }),
  api.listApps({ limit: 24 }),
  api.listComparisons({ kind: 'app', limit: 200 }),
  // One header section per captured home page, in catalogue order: each carries its full
  // screenshot and store, so this one query gives the strip and the gallery (desktop + phone).
  // Items only: the facet counts are not shown here.
  api.listSections({ type: 'header', page_type: 'home', limit: 40, facets: false }),
  // The gallery under the hero: the stores we cut tiles for (data/curation/home-gallery.json).
  api.listStores({
    domains: galleryManifest.tiles.map((t) => t.domain),
    limit: 60,
    facets: false,
  }),
]);

const c = meta.counts;
const asOf = formatDate(meta.source.as_of ?? meta.data_as_of);
const scanShort = `${env.sources[meta.source.id] ? 'StorePeek scan' : meta.source.label} of ${formatCount(c.stores_scanned)} stores`;
const appStoreLabel = env.sources['shopify-app-store']?.label ?? 'Shopify App Store listing';

// ---- Newest teardown: the hero pill, and (with its store) the window, the steps and its card.
const lead =
  [...teardownList.items].sort((a, b) =>
    (b.published_at ?? '').localeCompare(a.published_at ?? ''),
  )[0] ?? null;
let teardown: TeardownDetail | null = null;
if (lead) {
  try {
    teardown = (await api.getTeardown({ slug: lead.slug })).data;
  } catch {
    teardown = null;
  }
}
let detail: StoreDetail | null = teardown?.store ?? null;
if (!detail?.pages.some((p) => p.screenshots.desktop)) {
  const domain = homeShots.items[0]?.store.domain;
  detail = domain ? ((await orNotFound(api.getStore({ domain })))?.data ?? null) : null;
}

const announcement = lead
  ? {
      href: lead.href,
      text: `Teardown: ${lead.store.display_name}${lead.theme ? ` on ${lead.theme.name}` : ''}`,
    }
  : null;

// ---- Product window: the store viewer for the lead store, product page first.
const toShot = (
  shot: ScreenshotDetail,
  storeHref: string,
  page: string,
  prefix: string,
): WindowShot => ({
  src: shot.image.src,
  width: shot.width,
  height: shot.height,
  device: shot.device,
  isPlaceholder: shot.is_placeholder,
  sections: [...shot.sections]
    .sort((a, b) => a.order_index - b.order_index)
    .map((s) => ({
      id: `${prefix}${s.id}`,
      type: s.type.slug,
      name: s.type.name,
      y: s.rect.y,
      height: s.rect.h,
      x: s.rect.x,
      w: s.rect.w,
      app: s.app ? { name: s.app.short_name, slug: s.app.slug, iconUrl: s.app.icon_url } : null,
      href: `${storeHref}?page=${page}&device=${shot.device}#section-${s.id}`,
    })),
});

const store = detail?.store ?? null;
const windowPages: WindowPage[] =
  detail && store
    ? detail.pages
        .filter((p) => p.screenshots.desktop)
        .map((p) => ({
          slug: p.page_type.slug,
          name: p.page_type.name,
          href: `${store.href}?page=${p.page_type.slug}&device=desktop`,
          desktop: toShot(p.screenshots.desktop!, store.href, p.page_type.slug, 'pw-'),
        }))
    : [];
const initialPage = windowPages.some((p) => p.slug === 'product')
  ? 'product'
  : (windowPages[0]?.slug ?? 'home');
const mobileShot = detail?.pages.find((p) => p.page_type.slug === initialPage)?.screenshots.mobile;
const windowMobile =
  mobileShot && store ? toShot(mobileShot, store.href, initialPage, 'pwm-') : null;

// ---- How it works: another page of the same store, the one whose first screen has the most
// app-rendered sections (then the most sections), so "Tag" shows apps on it.
const VIEW = 900;
const stepPage = detail
  ? detail.pages
      .filter((p) => p.screenshots.desktop && p.page_type.slug !== initialPage)
      .map((p) => {
        const s = p.screenshots.desktop!;
        const top = s.sections.filter((x) => x.rect.y < VIEW - 80);
        return { p, s, apps: top.filter((x) => x.app).length, n: top.length };
      })
      .sort((a, b) => b.apps - a.apps || b.n - a.n)[0]
  : undefined;

let pair: HowData['pair'] = null;
if (detail && store) {
  const own = new Set(detail.apps.groups.flatMap((g) => g.apps.map((a) => a.slug)));
  const best = [...detail.similar]
    .map((sim) => ({ sim, overlap: sim.store.top_apps.filter((a) => own.has(a.slug)).length }))
    .sort((x, y) => y.overlap - x.overlap || y.sim.shared_apps - x.sim.shared_apps)[0];
  if (best && best.overlap > 0) {
    const theirs = new Set(best.sim.store.top_apps.map((a) => a.slug));
    const allOwn = detail.apps.groups.flatMap((g) => g.apps);
    const ownShown = [
      ...allOwn.filter((a) => theirs.has(a.slug)),
      ...allOwn.filter((a) => !theirs.has(a.slug)),
    ].slice(0, 5);
    const side = (
      s: { domain: string; display_name: string; href: string },
      theme: string,
      appCount: number,
      list: { slug: string; short_name: string; icon_url: string | null }[],
      other: Set<string>,
    ): CompareSide => ({
      name: s.display_name,
      domain: s.domain,
      href: s.href,
      theme,
      appCount,
      apps: list.map((a) => ({
        name: a.short_name,
        iconUrl: a.icon_url,
        shared: other.has(a.slug),
      })),
    });
    pair = {
      a: side(store, store.theme.label, store.app_count, ownShown, theirs),
      b: side(
        best.sim.store,
        best.sim.store.theme.label,
        best.sim.store.app_count,
        best.sim.store.top_apps.slice(0, 5),
        own,
      ),
      shared: best.sim.shared_apps,
    };
  }
}

const how: HowData | null =
  stepPage && store
    ? {
        store: { name: store.display_name, domain: store.domain, theme: store.theme.label },
        page: stepPage.p.page_type.name,
        isPlaceholder: stepPage.s.is_placeholder,
        desktop: {
          src: stepPage.s.image.src,
          width: stepPage.s.width,
          height: stepPage.s.height,
          regions: [...stepPage.s.sections]
            .sort((a, b) => a.order_index - b.order_index)
            .map((s) => ({
              key: s.id,
              y: s.rect.y,
              h: s.rect.h,
              x: s.rect.x,
              w: s.rect.w,
              label: s.app ? `${s.type.name} · ${s.app.short_name}` : s.type.name,
              active: !!s.app,
            })),
        },
        mobile: stepPage.p.screenshots.mobile
          ? {
              src: stepPage.p.screenshots.mobile.image.src,
              width: stepPage.p.screenshots.mobile.width,
              height: stepPage.p.screenshots.mobile.height,
            }
          : null,
        view: VIEW,
        pair,
      }
    : null;

// ---- Bento: apps ranking (ranks from usage.rank: ties share a rank), top themes, a curated pair.
const bentoApps: BentoApp[] = apps.data.items.slice(0, 6).map((a) => ({
  rank: a.usage.rank,
  name: a.short_name,
  href: a.href,
  iconUrl: a.icon_url,
  category: a.category?.name ?? null,
  stores: a.usage.stores,
  share: a.usage.share,
}));
const bentoThemes: BentoTheme[] = themes.data.items.map((t) => ({
  rank: t.usage.rank,
  name: t.name,
  vendor: t.vendor,
  href: t.href,
  price: t.price.label,
  stores: t.usage.stores,
  share: t.usage.share,
}));

const appBySlug = new Map(apps.data.items.map((a) => [a.slug, a]));
const pairPick = comparisons.items
  .filter((p) => p.kind === 'app' && appBySlug.has(p.a.slug) && appBySlug.has(p.b.slug))
  .map((p) => ({
    p,
    score: Math.min(appBySlug.get(p.a.slug)!.usage.stores, appBySlug.get(p.b.slug)!.usage.stores),
  }))
  .sort((x, y) => y.score - x.score)[0]?.p;
const money = (cents: number) => {
  const d = cents / 100;
  return `$${Number.isInteger(d) ? d : d.toFixed(2)}`;
};
const paidFrom = (a: AppListItem) =>
  a.pricing.from_cents ? `${money(a.pricing.from_cents)}/mo` : a.pricing.free_plan ? 'Free' : '—';
const compare: BentoCompare | null = pairPick
  ? (() => {
      const a = appBySlug.get(pairPick.a.slug)!;
      const b = appBySlug.get(pairPick.b.slug)!;
      const row = (label: string, f: (x: AppListItem) => string) => ({ label, a: f(a), b: f(b) });
      return {
        href: pairPick.href,
        a: { name: a.short_name, iconUrl: a.icon_url },
        b: { name: b.short_name, iconUrl: b.icon_url },
        rows: [
          row('Stores', (x) => formatCount(x.usage.stores)),
          row('Share', (x) => `${(x.usage.share * 100).toFixed(1)}%`),
          row('Rating', (x) => (x.rating != null ? x.rating.toFixed(1) : '—')),
          row('Reviews', (x) => (x.reviews != null ? formatCount(x.reviews) : '—')),
          row('Paid from', paidFrom),
        ],
        shared: pairPick.shared_stores ?? null,
      };
    })()
  : null;

// ---- Bento: tagged section crops from the lead store: two rendered by apps, two rich layouts.
const RICH = ['hero', 'product-gallery', 'featured-collection', 'image-with-text', 'product-grid'];
const pageSections = (detail?.pages ?? []).flatMap((p) =>
  p.screenshots.desktop
    ? p.screenshots.desktop.sections.map((s) => ({ s, page: p.page_type.name }))
    : [],
);
const THIN = new Set(['announcement-bar', 'header', 'breadcrumbs', 'footer', 'filters']);
const withApp = pageSections.filter(({ s }) => s.app && !THIN.has(s.type.slug));
const rich = RICH.flatMap((slug) =>
  pageSections.filter(({ s }) => s.type.slug === slug).slice(0, 1),
);
const seenTypes = new Set<string>();
const bentoSections: BentoSection[] = [...withApp.slice(0, 2), ...rich, ...withApp.slice(2)]
  .filter(({ s }) => (seenTypes.has(s.type.slug) ? false : (seenTypes.add(s.type.slug), true)))
  .slice(0, 4)
  .map(({ s, page }) => ({
    href: s.href,
    src: s.crop.src,
    width: s.crop.width,
    height: s.crop.height,
    device: 'desktop',
    type: s.type.name,
    app: s.app?.short_name ?? null,
    page: page.toLowerCase(),
  }));

// ---- Bento: the teardown's notes on the capture that holds most of them.
const benteardown: BentoTeardown | null = (() => {
  if (!teardown || !detail) return null;
  const shots = detail.pages.flatMap((p) =>
    [p.screenshots.desktop, p.screenshots.mobile].filter((s): s is ScreenshotDetail => !!s),
  );
  const byShot = new Map<number, number>();
  for (const n of teardown.notes) {
    if (n.screenshot_id != null && n.section)
      byShot.set(n.screenshot_id, (byShot.get(n.screenshot_id) ?? 0) + 1);
  }
  const coverId = teardown.teardown.cover?.id;
  const shotId = [...byShot.entries()].sort(
    (a, b) => b[1] - a[1] || Number(b[0] === coverId) - Number(a[0] === coverId),
  )[0]?.[0];
  const shot = shots.find((s) => s.id === shotId && s.device === 'desktop');
  if (!shot) return null;
  const notesHere = teardown.notes.filter((n) => n.screenshot_id === shot.id && n.section);
  const view = 1300;
  const starts = notesHere.map((n) => Math.max(0, n.section!.rect.y - 120));
  const inView = (from: number, n: (typeof notesHere)[number]) =>
    n.section!.rect.y >= from && n.section!.rect.y < from + view - 100;
  const from =
    starts.sort(
      (a, b) =>
        notesHere.filter((n) => inView(b, n)).length - notesHere.filter((n) => inView(a, n)).length,
    )[0] ?? 0;
  const noteBySection = new Map(notesHere.map((n) => [n.section!.id, n]));
  const regions: CropRegion[] = shot.sections.map((s) => {
    const note = noteBySection.get(s.id);
    return {
      key: s.id,
      y: s.rect.y,
      h: s.rect.h,
      x: s.rect.x,
      w: s.rect.w,
      n: note?.n,
      active: !!note,
    };
  });
  return {
    href: teardown.teardown.href,
    title: teardown.teardown.title,
    dek: teardown.teardown.dek,
    store: teardown.teardown.store.display_name,
    page: shot.page_type.name.toLowerCase(),
    isSample: teardown.teardown.is_sample,
    notes: teardown.notes.map((n) => ({
      n: n.n,
      title: n.title,
      meta: `${pageTypeName(n.page_type)} · ${n.device} · ${n.section_type.name}`,
      inView: n.screenshot_id === shot.id && !!n.section && inView(from, n),
    })),
    crop: { src: shot.image.src, width: shot.width, height: shot.height, from, view },
    regions,
  };
})();

// ---- Hero gallery: real captures only, in the manifest's order.
const storeByDomain = new Map(galleryStores.data.items.map((i) => [i.domain, i]));
const galleryTiles: GalleryTile[] = galleryManifest.tiles.flatMap((t) => {
  const st = storeByDomain.get(t.domain);
  const shot = st?.preview;
  if (!st || !shot || shot.is_placeholder) return [];
  // The cut tiles belong to one specific capture; if the store was re-captured since, use the
  // regular top thumbnail of the current one instead.
  const fresh = shot.image.src.endsWith(t.desktop.src);
  const live = { src: shot.image.src, width: shot.image.width, height: shot.image.height, tile: false };
  return [
    {
      domain: st.domain,
      name: st.display_name,
      href: st.href,
      theme: st.theme.label,
      appCount: st.app_count,
      apps: st.top_apps.map((a) => ({ name: a.short_name, iconUrl: a.icon_url })),
      desktop: fresh
        ? { src: `/media/${t.desktop.key}`, width: t.desktop.w, height: t.desktop.h, tile: true }
        : live,
      mobile: fresh
        ? { src: `/media/${t.mobile.key}`, width: t.mobile.w, height: t.mobile.h, tile: true }
        : live,
    },
  ];
});

// ---- Strip + gallery: every curated store's home page, desktop and phone.
const homeItems = homeShots.items.filter((s) => s.store.is_curated);
const toTile = (s: (typeof homeItems)[number]): WallTile => ({
  domain: s.store.domain,
  name: s.store.display_name,
  href: `${s.store.href}?page=${s.page_type}&device=${s.device}`,
  pageType: s.page_type,
  device: s.device,
  src: s.screenshot.image.src,
  width: s.screenshot.width,
  height: s.screenshot.height,
  isPlaceholder: s.screenshot.image.is_placeholder,
});
const wallDesktop = homeItems.filter((s) => s.device === 'desktop').map(toTile);
const wallMobile = homeItems.filter((s) => s.device === 'mobile').map(toTile);
const allPlaceholders = [...wallDesktop, ...wallMobile].every((t) => t.isPlaceholder);

const siteUrl = new URL('/', Astro.site ?? Astro.url).href.replace(/\/$/, '');
const jsonLd = [
  {
    '@type': 'WebSite',
    name: SITE_NAME,
    url: `${siteUrl}/`,
    potentialAction: {
      '@type': 'SearchAction',
      target: { '@type': 'EntryPoint', urlTemplate: `${siteUrl}/search?q={search_term_string}` },
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@type': 'Organization',
    name: SITE_NAME,
    url: `${siteUrl}/`,
    logo: `${siteUrl}/favicon.svg`,
  },
];
// The layout's chrome numbers, from the meta call above (saves the layout a query).
const navCounts = {
  '/stores': c.stores_scanned,
  '/themes': c.themes,
  '/apps': c.apps,
  '/sections': c.sections,
  '/teardowns': c.teardowns,
};
const dataNote = `${formatCount(c.stores_scanned)} stores scanned · ${c.stores_curated} curated · data as of ${formatDate(meta.data_as_of)}`;
---

<BaseLayout
  description={`The theme and apps behind ${formatCount(c.stores_scanned)} Shopify stores, plus ${c.stores_curated} stores shown page by page and section by section, on desktop and mobile.`}
  jsonLd={jsonLd}
  navCounts={navCounts}
  dataNote={dataNote}
  canonical="/"
>
  <div class="home">
    <div class="home__spot bg-spotlight" aria-hidden="true"></div>
    <div class="container guides home__inner">
      <HomeHero
        announcement={announcement}
        lead={`Real storefronts, page by page, with the theme and apps behind them.`}
        paths={[
          { href: '/stores', label: 'Stores', count: formatCount(c.stores_curated), icon: 'squares-four' },
          { href: '/apps', label: 'Apps', count: formatCount(c.apps), icon: 'puzzle-piece' },
          { href: '/compare', label: 'Compare', count: formatCount(c.comparisons), icon: 'arrows-down-up' },
        ]}
        asOf={asOf}
      />

      {galleryTiles.length > 0 && <HomeGallery tiles={galleryTiles} total={c.stores_curated} />}

      {store && windowPages.length > 0 && (
        <div class="home__window">
          <div class="home__grid bg-grid" aria-hidden="true"></div>
          <ProductWindow
            store={{
              domain: store.domain,
              name: store.display_name,
              href: store.href,
              themeLabel: store.theme.label,
              themeHref: store.theme.theme?.href ?? null,
              appCount: store.app_count,
              apps: store.top_apps.map((a) => ({ name: a.short_name, iconUrl: a.icon_url })),
              teardown: detail?.teardown ?? null,
              lastSeen: formatDate(detail?.detection.last_seen ?? meta.data_as_of),
            }}
            pages={windowPages}
            initial={initialPage}
            mobile={windowMobile}
          />
        </div>
      )}

      <section class="home__block" aria-labelledby="home-features">
        <FeatureBento
          apps={bentoApps}
          appsTotal={apps.meta.pagination?.total ?? c.apps}
          themes={bentoThemes}
          themesTotal={themes.meta.pagination?.total ?? c.themes}
          sections={bentoSections}
          sectionCounts={{ sections: c.sections, types: c.section_types }}
          compare={compare}
          comparisonsTotal={c.comparisons}
          teardown={benteardown}
          source={{ scan: scanShort, appStore: appStoreLabel, asOf }}
        />
      </section>

      {wallDesktop.length + wallMobile.length > 0 && (
        <section class="home__block reveal" aria-labelledby="home-captures">
          <SectionHeader
            id="home-captures"
            size="lg"
            eyebrow="Latest captures"
            title={`${c.stores_curated} stores, as their customers see them.`}
            titleMuted="Home pages on desktop and phone."
            description={
              allPlaceholders
                ? 'Layout previews drawn from each page’s detected sections until the first capture run.'
                : undefined
            }
            href="/stores"
            linkLabel="Browse all stores"
          />
          <Wall desktop={wallDesktop} mobile={wallMobile} />
        </section>
      )}

      <div class="home__block home__block--last reveal">{PRO_ENABLED && <ProBand />}</div>
    </div>
  </div>
</BaseLayout>

<style>
  /* Big section heads: the muted half of a two-tone title gets its own line on wide screens. */
  @media (min-width: 768px) {
    .home :global(.sh--lg .sh__title .tone-muted) {
      display: block;
    }
  }
  .home {
    position: relative;
    overflow-x: clip;
    isolation: isolate;
  }
  .home__spot {
    position: absolute;
    inset: 0 0 auto;
    z-index: -1;
    height: 880px;
    pointer-events: none;
  }
  .home__window {
    position: relative;
    margin-top: var(--space-12);
  }
  .home__grid {
    position: absolute;
    inset: -72px calc(var(--page-gutter) * -1) 30%;
    z-index: -1;
    pointer-events: none;
  }
  .home__strip {
    margin-top: var(--space-12);
  }
  .home__block {
    padding-top: var(--section-y);
    /* Below the fold: skip style and layout work until it is near the viewport. */
    content-visibility: auto;
    contain-intrinsic-size: auto 900px;
  }
  .home__window {
    content-visibility: auto;
    contain-intrinsic-size: auto 760px;
  }
  .home__block--last {
    padding-bottom: var(--section-y);
  }
  /* The last block already ends with a full section of space, so the footer sits directly
     under it and the guide lines run into the footer's top border instead of stopping short. */
  :global(main:has(.home) + .footer) {
    margin-top: 0;
  }
  @media (min-width: 1024px) {
    .home__window {
      margin-top: var(--space-16);
    }
    .home__strip {
      margin-top: var(--space-16);
    }
  }
</style>
