---
import AdminLayout from '~/layouts/AdminLayout.astro';
import { requireAdmin } from '~/server/admin/page';
import AdminHeader from '~/components/admin/AdminHeader.astro';
import AuditList from '~/components/admin/AuditList.astro';
import CaptureBlocked from '~/components/admin/CaptureBlocked.astro';
import FlashNotice from '~/components/admin/FlashNotice.astro';
import Metrics from '~/components/admin/Metrics.astro';
import Panel from '~/components/admin/Panel.astro';
import Badge from '~/components/ui/Badge.astro';
import Button from '~/components/ui/Button.astro';
import Icon from '~/components/ui/Icon.astro';
import { adminDb } from '~/server/admin/env';
import {
  getJobStatusCounts,
  getMeta,
  getOverviewCounts,
  getPendingRemovals,
  getAuthSummary,
  getRecentAudit,
} from '~/server/admin/queries';
import { fullTime, shortDate, timeAgo } from '~/server/admin/format';

const denied = requireAdmin(Astro);
if (denied) return denied;

const db = adminDb();
const [c, meta, jobs, pending, audit] = await Promise.all([
  getOverviewCounts(db),
  getMeta(db),
  getJobStatusCounts(db),
  getPendingRemovals(db, 6),
  getRecentAudit(db, { limit: 12, excludeAuth: true }),
]);
const auth = await getAuthSummary(db, new Date());
const pendingTotal =
  (
    await db.first<{ n: number }>(
      "SELECT COUNT(*) AS n FROM removal_requests WHERE status = 'pending'",
    )
  )?.n ?? 0;
const now = new Date();
const asOf = shortDate(meta.dataAsOf);

const metrics = [
  {
    label: 'Stores',
    value: c.stores,
    note: `${c.storesActive.toLocaleString('en-US')} active · ${c.storesHidden} hidden · ${c.storesOptedOut} opted out`,
    href: '/admin/stores',
  },
  {
    label: 'Curated',
    value: c.curated,
    note: 'Hand-picked for the library',
    href: '/admin/stores?curated=yes',
  },
  {
    label: 'Captured',
    value: c.captured,
    note: `${c.realShots.toLocaleString('en-US')} real screenshots in storage`,
    href: '/admin/stores?captured=yes',
  },
  {
    label: 'Captures pending',
    value: c.placeholderShots,
    note: `Layout previews on ${c.placeholderStores} ${c.placeholderStores === 1 ? 'store' : 'stores'}`,
    href: '/admin/stores?captured=placeholder',
  },
  {
    label: 'Themes',
    value: c.themes,
    note: `${c.themesActive} visible on the site`,
    href: '/admin/themes',
  },
  {
    label: 'Apps',
    value: c.apps,
    note: `${c.appsFull} full profiles · ${c.appsActive} visible`,
    href: '/admin/apps',
  },
];
const jobCells = [
  { status: 'queued', label: 'Queued', n: jobs.queued },
  { status: 'running', label: 'Running', n: jobs.running },
  { status: 'failed', label: 'Failed', n: jobs.failed },
  { status: 'done', label: 'Done', n: jobs.done },
] as const;
const dataRows = [
  { label: 'Data as of', value: asOf },
  { label: 'Data version', value: meta.dataVersion ?? '—', mono: true },
  { label: 'Detection rules', value: meta.rulesVersion ?? '—', mono: true },
  { label: 'Stores scanned', value: (meta.scannedTotal ?? 0).toLocaleString('en-US') },
  { label: 'Tombstones', value: c.tombstones.toLocaleString('en-US') },
  { label: 'Teardowns', value: `${c.teardownsPublished} published of ${c.teardowns}` },
  { label: 'Affiliate links', value: `${c.linksActive} active` },
];
const SCOPE: Record<string, string> = {
  store: 'Whole store',
  screenshots: 'Screenshots',
  details: 'Details',
};
const oldest = pending[0];
---

<AdminLayout title="Overview" section="overview">
  <Fragment slot="actions">
    <Button href="/admin/scans" variant="secondary" size="sm" icon="arrow-clockwise">
      Scan queue
    </Button>
    {pendingTotal > 0 && (
      <Button href="/admin/removals" variant="primary" size="sm" icon="flag">
        {`Review ${pendingTotal} ${pendingTotal === 1 ? 'removal' : 'removals'}`}
      </Button>
    )}
  </Fragment>
  <AdminHeader
    title="Overview"
    description={meta.sourceLabel ? `${meta.sourceLabel}.` : 'The state of the library.'}
  />
  <FlashNotice />

  <Metrics
    items={metrics}
    source={`Source: database · data as of ${asOf}${meta.dataVersion ? ` · version ${meta.dataVersion}` : ''}`}
  />

  <div class="a-split a-block overview">
    <div class="a-stack">
      <Panel
        title="Removal requests"
        count={pendingTotal}
        description={
          oldest
            ? `Oldest first · the oldest has waited ${timeAgo(oldest.created_at, now).replace(' ago', '')}.`
            : 'Store owners file these from the opt-out page.'
        }
        flush
      >
        <Fragment slot="actions">
          {pendingTotal > 0 && (
            <Badge tone="caution" dot>
              Needs review
            </Badge>
          )}
          <a href="/admin/removals" class="a-link a-nowrap">
            All requests
          </a>
        </Fragment>
        {pending.length === 0 ? (
          <p class="clear">
            <Icon name="check-circle" size={16} />
            Nothing waiting. New requests from the opt-out page appear here, oldest first.
          </p>
        ) : (
          <div class="a-tablewrap">
            <table class="table a-table a-table--stack">
              <thead>
                <tr>
                  <th scope="col">Store</th>
                  <th scope="col">Reference</th>
                  <th scope="col">Scope</th>
                  <th scope="col">Received</th>
                  <th scope="col" class="is-actions">
                    <span class="visually-hidden">Actions</span>
                  </th>
                </tr>
              </thead>
              <tbody>
                {pending.map((r) => (
                  <tr>
                    <td class="is-primary">
                      <span class="a-strong a-nowrap">{r.domain}</span>
                      <span class="a-sub">
                        {r.store_id ? (r.store_name ?? 'In the library') : 'Not in the library'}
                      </span>
                    </td>
                    <td class="is-meta a-mono a-nowrap">{r.reference}</td>
                    <td class="is-meta a-nowrap">
                      {SCOPE[r.scope] ?? r.scope}
                      {r.capture_blocked ? <CaptureBlocked class="inline-badge" /> : null}
                    </td>
                    <td class="is-meta a-nowrap" title={fullTime(r.created_at)}>
                      {timeAgo(r.created_at, now)}
                    </td>
                    <td class="is-actions">
                      <Button href={`/admin/removals/${r.id}`} size="sm" variant="secondary">
                        Review
                      </Button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </Panel>

      <Panel
        title="Scan and capture queue"
        description="Jobs wait here until the external crawler picks them up."
        flush
      >
        <a slot="actions" href="/admin/scans" class="a-link a-nowrap">
          Open queue
        </a>
        <ul class="jobs">
          {jobCells.map((j) => (
            <li>
              <a
                href={`/admin/scans?status=${j.status}`}
                class:list={['jobs__cell', `jobs__cell--${j.status}`, { 'is-zero': j.n === 0 }]}
              >
                <span class="jobs__label">{j.label}</span>
                <span class="jobs__n num">{j.n.toLocaleString('en-US')}</span>
              </a>
            </li>
          ))}
        </ul>
      </Panel>
    </div>

    <div class="a-side">
      <Panel title="Recent activity" flush>
        <AuditList
          rows={audit}
          empty="No changes yet. Edits, queued jobs and removal decisions appear here."
        />
      </Panel>

      <Panel title="Data" flush>
        <dl class="a-facts">
          {dataRows.map((row) => (
            <div class="a-facts__row">
              <dt>{row.label}</dt>
              <dd class:list={[{ 'a-mono': row.mono }]}>{row.value}</dd>
            </div>
          ))}
        </dl>
      </Panel>

      <Panel title="Sign-ins" flush>
        <dl class="a-facts">
          <div class="a-facts__row">
            <dt>Last sign-in</dt>
            <dd title={auth.lastSignIn ? fullTime(auth.lastSignIn) : undefined}>
              {auth.lastSignIn ? timeAgo(auth.lastSignIn, now) : 'None yet'}
            </dd>
          </div>
          <div class="a-facts__row">
            <dt>Last 24 hours</dt>
            <dd>
              {auth.signIns24h} signed in{' · '}
              <span class:list={{ warn: auth.failed24h > 0 }}>{auth.failed24h} failed</span>
            </dd>
          </div>
        </dl>
      </Panel>
    </div>
  </div>
</AdminLayout>

<style>
  .clear {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-5) var(--space-4);
    color: var(--ink-3);
    font-size: var(--text-sm);
  }
  .clear :global(.icon) {
    color: var(--positive);
  }
  :global(.inline-badge) {
    margin-left: var(--space-2);
  }
  .jobs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (min-width: 640px) {
    .jobs {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .jobs li + li {
    border-left: 1px solid var(--line);
  }
  @media (max-width: 639px) {
    .jobs li:nth-child(3) {
      border-left: 0;
    }
    .jobs li:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }
  .jobs__cell {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4);
    transition: background-color var(--dur-fast) var(--ease-out);
  }
  .jobs li:first-child .jobs__cell {
    border-bottom-left-radius: var(--radius-card);
  }
  .jobs__cell:hover {
    background: var(--bg-subtle);
  }
  .jobs__label {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--ink-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }
  .jobs__label::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ink-4);
  }
  .jobs__cell--queued:not(.is-zero) .jobs__label::before {
    background: var(--caution);
  }
  .jobs__cell--running:not(.is-zero) .jobs__label::before {
    background: var(--accent);
  }
  .jobs__cell--failed:not(.is-zero) .jobs__label::before {
    background: var(--critical);
  }
  .jobs__cell--done:not(.is-zero) .jobs__label::before {
    background: var(--positive);
  }
  .jobs__n {
    color: var(--ink);
    font-size: var(--text-2xl);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.025em;
    line-height: 1;
  }
  .is-zero .jobs__n {
    color: var(--ink-3);
    font-weight: var(--weight-medium);
  }
  .warn {
    color: var(--critical);
  }
</style>
