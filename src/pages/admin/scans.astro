---
import AdminLayout from '~/layouts/AdminLayout.astro';
import AdminHeader from '~/components/admin/AdminHeader.astro';
import FlashNotice from '~/components/admin/FlashNotice.astro';
import Panel from '~/components/admin/Panel.astro';
import StatusPill from '~/components/admin/StatusPill.astro';
import Button from '~/components/ui/Button.astro';
import Field from '~/components/ui/Field.astro';
import Input from '~/components/ui/Input.astro';
import Pagination from '~/components/ui/Pagination.astro';
import Tabs from '~/components/ui/Tabs.astro';
import { adminDb } from '~/server/admin/env';
import { cancelJob, queueJob } from '~/server/admin/actions';
import { int, oneOf, text } from '~/server/admin/forms';
import { runAction, requireAdmin } from '~/server/admin/page';
import {
  getJobStatusCounts,
  JOB_STATUSES,
  listJobs,
  PAGE_SIZE,
  type JobStatus,
} from '~/server/admin/queries';
import { fullTime, hrefWith, timeAgo } from '~/server/admin/format';

const denied = requireAdmin(Astro);
if (denied) return denied;

if (Astro.request.method === 'POST') {
  return runAction(Astro, async (form, ctx) => {
    const intent = text(form, 'intent', 20);
    if (intent === 'cancel') {
      const id = int(form, 'id');
      return id === null ? { ok: false, flash: 'bad_request' } : cancelJob(ctx, id);
    }
    if (intent === 'queue') {
      const kind = oneOf(form, 'kind', ['rescan', 'capture', 'detect'] as const);
      if (!kind) return { ok: false, flash: 'bad_request' };
      return queueJob(ctx, { domain: text(form, 'domain', 300), kind });
    }
    return { ok: false, flash: 'bad_request' };
  });
}

const raw = Astro.url.searchParams.get('status');
const status: JobStatus = (JOB_STATUSES as readonly string[]).includes(raw ?? '')
  ? (raw as JobStatus)
  : 'queued';
const page = Math.max(1, Number.parseInt(Astro.url.searchParams.get('p') ?? '1', 10) || 1);
const db = adminDb();
const [counts, { rows, total, page: current }] = await Promise.all([
  getJobStatusCounts(db),
  listJobs(db, status, page),
]);
const now = new Date();
const LABELS: Record<JobStatus, string> = {
  queued: 'Queued',
  running: 'Running',
  done: 'Done',
  failed: 'Failed',
  cancelled: 'Cancelled',
};
const tabs = JOB_STATUSES.map((s) => ({
  label: LABELS[s],
  href: s === 'queued' ? '/admin/scans' : `/admin/scans?status=${s}`,
  selected: s === status,
  count: counts[s],
}));
const KIND: Record<string, string> = { rescan: 'Rescan', capture: 'Capture', detect: 'Detect' };
const scope = (json: string | null, fallback: string) => {
  if (!json) return fallback;
  try {
    const v = JSON.parse(json) as unknown;
    return Array.isArray(v) ? v.join(', ') : fallback;
  } catch {
    return fallback;
  }
};
const EMPTY: Record<JobStatus, string> = {
  queued:
    'The queue is empty. Queue a rescan or capture with the form above, or from a store page.',
  running: 'Nothing is running. The crawler takes queued jobs on its next run.',
  done: 'No finished jobs yet.',
  failed: 'No failed jobs.',
  cancelled: 'No cancelled jobs.',
};
const timeCol = status === 'queued' ? 'Queued' : status === 'running' ? 'Started' : 'Finished';
---

<AdminLayout title="Scans" section="scans" trail={[{ label: 'Scans' }]}>
  <AdminHeader
    title="Scan and capture jobs"
    description="The external crawler takes queued jobs by priority, then age. Cancel a job before it starts."
  />
  <FlashNotice />

  <Panel title="Queue a job" class="queue">
    <form method="post" class="queue-form" aria-label="Queue a job">
      <input type="hidden" name="intent" value="queue" />
      <Field label="Store domain" for="q-domain" hint="A bare domain, like example.com.">
        <Input
          id="q-domain"
          name="domain"
          placeholder="example.com"
          required
          maxlength={300}
          autocomplete="off"
          spellcheck="false"
        />
      </Field>
      <Field
        label="Job"
        for="q-kind"
        hint="Captures are refused for stores with an approved removal request."
      >
        <Input as="select" id="q-kind" name="kind">
          <option value="rescan">Rescan: detect theme and apps</option>
          <option value="capture">Capture: take screenshots</option>
          <option value="detect">Detect: a new domain</option>
        </Input>
      </Field>
      <div class="queue-form__submit">
        <Button type="submit" variant="primary" size="md" icon="plus">
          Queue job
        </Button>
      </div>
    </form>
  </Panel>

  <Tabs items={tabs} label="Job status" class="jtabs" />

  <Panel flush>
    <div class="a-tablewrap">
      <table class="table a-table a-table--stack jobs">
        <thead>
          <tr>
            <th scope="col">Store</th>
            <th scope="col" class="is-num">
              Job
            </th>
            <th scope="col">Kind</th>
            <th scope="col">Pages · devices</th>
            <th scope="col" class="is-num">
              Priority
            </th>
            <th scope="col">Requested by</th>
            <th scope="col">{timeCol}</th>
            {(status === 'failed' || status === 'cancelled') && <th scope="col">Note</th>}
            <th scope="col">Status</th>
            {status === 'queued' && (
              <th scope="col" class="is-actions">
                <span class="visually-hidden">Actions</span>
              </th>
            )}
          </tr>
        </thead>
        <tbody>
          {rows.length === 0 ? (
            <tr>
              <td colspan="10" class="a-empty-cell">
                {EMPTY[status]}
              </td>
            </tr>
          ) : (
            rows.map((j) => {
              const when =
                status === 'queued'
                  ? j.created_at
                  : status === 'running'
                    ? (j.started_at ?? j.created_at)
                    : (j.finished_at ?? j.created_at);
              return (
                <tr>
                  <td class="is-primary">
                    {j.store_id ? (
                      <a class="a-row-link" href={`/admin/stores/${j.domain}`}>
                        {j.domain}
                      </a>
                    ) : (
                      <span class="a-strong">{j.domain}</span>
                    )}
                    {j.store_name && <span class="a-sub">{j.store_name}</span>}
                  </td>
                  <td class="is-meta is-num a-mono a-muted">#{j.id}</td>
                  <td class="is-meta">{KIND[j.kind] ?? j.kind}</td>
                  <td class="is-meta a-muted">
                    {scope(j.page_types_json, 'Core pages')} ·{' '}
                    {scope(j.devices_json, 'both devices')}
                  </td>
                  <td class="is-meta is-num" data-label="Priority">
                    {j.priority}
                  </td>
                  <td class="a-muted a-hide-sm">{j.requested_by ?? 'crawler'}</td>
                  <td class="is-meta a-nowrap" title={fullTime(when)}>
                    {timeAgo(when, now)}
                    {j.attempts > 0 && (
                      <span class="a-sub">
                        {j.attempts} {j.attempts === 1 ? 'attempt' : 'attempts'}
                      </span>
                    )}
                  </td>
                  {(status === 'failed' || status === 'cancelled') && (
                    <td class="is-meta a-muted note">{j.error ?? '—'}</td>
                  )}
                  <td class="is-meta">
                    <StatusPill status={j.status} variant="dot" />
                  </td>
                  {status === 'queued' && (
                    <td class="is-actions">
                      <form method="post" data-confirm={`Cancel job #${j.id} for ${j.domain}?`}>
                        <input type="hidden" name="intent" value="cancel" />
                        <input type="hidden" name="id" value={j.id} />
                        <Button
                          type="submit"
                          size="sm"
                          variant="ghost"
                          icon="x"
                          label={`Cancel job ${j.id}`}
                        />
                      </form>
                    </td>
                  )}
                </tr>
              );
            })
          )}
        </tbody>
      </table>
    </div>
  </Panel>
  <Pagination
    page={current}
    pageSize={PAGE_SIZE}
    total={total}
    hrefFor={(p) =>
      hrefWith('/admin/scans', {
        status: status === 'queued' ? undefined : status,
        p: p > 1 ? p : undefined,
      })
    }
    noun="jobs"
  />
</AdminLayout>

<style>
  :global(.queue) {
    margin-bottom: var(--space-6);
  }
  .queue-form {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
  }
  @media (min-width: 900px) {
    .queue-form {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto;
      align-items: start;
    }
    .queue-form__submit {
      padding-top: 26px;
    }
  }
  :global(.jtabs) {
    margin-bottom: var(--space-4);
  }
  .note {
    max-width: 260px;
  }
</style>
