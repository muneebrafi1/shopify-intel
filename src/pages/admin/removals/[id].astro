---
/**
 * Review one removal request. Approving is irreversible, so it needs an explicit, server-checked
 * confirmation (a required checkbox), not only a client-side dialog. Approving a whole-store or
 * screenshots request also blocks every future capture of the store (capture_blocks).
 */
import AdminLayout from '~/layouts/AdminLayout.astro';
import AdminHeader from '~/components/admin/AdminHeader.astro';
import AuditList from '~/components/admin/AuditList.astro';
import CaptureBlocked from '~/components/admin/CaptureBlocked.astro';
import FlashNotice from '~/components/admin/FlashNotice.astro';
import Panel from '~/components/admin/Panel.astro';
import StatusPill from '~/components/admin/StatusPill.astro';
import Badge from '~/components/ui/Badge.astro';
import Button from '~/components/ui/Button.astro';
import Checkbox from '~/components/ui/Checkbox.astro';
import EmptyState from '~/components/ui/EmptyState.astro';
import Field from '~/components/ui/Field.astro';
import Icon from '~/components/ui/Icon.astro';
import Input from '~/components/ui/Input.astro';
import Notice from '~/components/ui/Notice.astro';
import StoreMark from '~/components/ui/StoreMark.astro';
import { adminDb } from '~/server/admin/env';
import { approveRemoval, rejectRemoval, retryRemovalMedia } from '~/server/admin/actions';
import { checkbox, optionalText, text } from '~/server/admin/forms';
import { idParam, runAction, requireAdmin } from '~/server/admin/page';
import {
  getRecentAudit,
  getRemoval,
  getRemovalsForDomain,
  getStore,
  getStoreMediaSummary,
} from '~/server/admin/queries';
import { fullTime, shortDate, timeAgo } from '~/server/admin/format';
import { normalizeDomain } from '~/server/lib/slug';

const denied = requireAdmin(Astro);
if (denied) return denied;

const id = idParam(Astro.params.id);

if (Astro.request.method === 'POST' && id !== null) {
  return runAction(Astro, async (form, ctx) => {
    const intent = text(form, 'intent', 20);
    if (intent === 'approve') {
      return approveRemoval(ctx, id, {
        note: optionalText(form, 'note', 1000),
        confirmed: checkbox(form, 'confirm'),
      });
    }
    if (intent === 'reject')
      return rejectRemoval(ctx, id, { note: optionalText(form, 'note', 1000) });
    if (intent === 'retry') return retryRemovalMedia(ctx, id);
    return { ok: false, flash: 'bad_request' };
  });
}

const db = adminDb();
const req = id !== null ? await getRemoval(db, id) : null;
if (!req) Astro.response.status = 404;

const domain = req ? (normalizeDomain(req.domain) ?? req.domain) : '';
const [store, media, related, audit] = req
  ? await Promise.all([
      getStore(db, domain),
      getStoreMediaSummary(db, req.store_id, domain),
      getRemovalsForDomain(db, req.domain),
      getRecentAudit(db, { targetType: 'removal', targetId: String(req.id), limit: 6 }),
    ])
  : [null, null, [], []];
const now = new Date();
const SCOPE: Record<string, string> = {
  store: 'Remove the whole store',
  screenshots: 'Remove screenshots only',
  details: 'Correct or remove details',
};
const SCOPE_SHORT: Record<string, string> = {
  store: 'Whole store',
  screenshots: 'Screenshots',
  details: 'Details',
};
const pending = req?.status === 'pending';
const blocksCaptures = req?.scope === 'store' || req?.scope === 'screenshots';
const blocked = !!req?.capture_blocked || !!media?.captureBlocked;
const plural = (n: number, one: string, many = `${one}s`) =>
  `${n.toLocaleString('en-US')} ${n === 1 ? one : many}`;

// What approval will do, with the real numbers for this store.
const effects: string[] = [];
if (req && media) {
  if (req.scope === 'store') {
    effects.push(
      store
        ? `Hide ${domain} everywhere on the site, including counts and search (status becomes opted out).`
        : `${domain} is not in the library, so there is nothing to hide.`,
    );
    effects.push('Tombstone the domain so the crawler never adds it again.');
  }
  if (blocksCaptures) {
    effects.push(
      req.scope === 'store'
        ? `Block every future capture of ${domain}.`
        : `Block every future capture of ${domain}. Detection rescans still run.`,
    );
    effects.push(
      media.r2Objects > 0
        ? `Delete ${plural(media.r2Objects, 'stored image')} from media storage.`
        : `No stored images to delete${media.placeholders ? ` (its ${plural(media.placeholders, 'layout preview')} are drawn, not stored)` : ''}.`,
    );
    if (media.screenshots > 0)
      effects.push(
        `Retire ${plural(media.screenshots, 'screenshot')} and ${plural(media.sections, 'section')}.`,
      );
    const capturesQueued = req.scope === 'screenshots' ? media.queuedJobs : 0;
    if (capturesQueued > 0) effects.push('Cancel any queued capture jobs.');
  }
  if (req.scope === 'store' && media.teardownsPublished > 0)
    effects.push(`Unpublish ${plural(media.teardownsPublished, 'teardown')}.`);
  if (req.scope === 'store' && media.queuedJobs > 0)
    effects.push(`Cancel ${plural(media.queuedJobs, 'queued job')}.`);
  if (req.scope === 'details') {
    effects.push('Mark the request as done. Make the corrections by hand on the store page first.');
  }
}
const approveLabel =
  req?.scope === 'details'
    ? 'Mark as done'
    : req?.scope === 'screenshots'
      ? 'Approve and delete screenshots'
      : 'Approve and remove store';
const STATUS_LABEL: Record<string, string> = { approved: 'Approved · media pending' };
const mailto = req
  ? `mailto:${req.email}?subject=${encodeURIComponent(`Your removal request ${req.reference}`)}`
  : '';
---

<AdminLayout
  title={req ? `Removal ${req.reference}` : 'Request not found'}
  section="removals"
  trail={[
    { label: 'Removals', href: '/admin/removals' },
    { label: req ? req.reference : 'Not found' },
  ]}
>
  {req && (
    <Fragment slot="actions">
      <Button href={mailto} variant="secondary" size="sm" iconRight="arrow-up-right">
        Email requester
      </Button>
    </Fragment>
  )}
  {!req ? (
    <>
      <AdminHeader title="Request not found" />
      <EmptyState title="No removal request with that id" body="It may have been typed wrong.">
        <Button href="/admin/removals" variant="primary" size="sm">
          Back to the queue
        </Button>
      </EmptyState>
    </>
  ) : (
    <>
      <AdminHeader title={req.domain}>
        <p slot="meta" class="meta">
          <StatusPill status={req.status} label={STATUS_LABEL[req.status]} size="md" />
          {blocked && <CaptureBlocked size="md" reference={req.reference} />}
          <Badge tone="outline">{SCOPE_SHORT[req.scope] ?? req.scope}</Badge>
          <span class="a-mono a-muted">{req.reference}</span>
          <span class="a-muted" title={fullTime(req.created_at)}>
            Received {timeAgo(req.created_at, now)}
          </span>
        </p>
      </AdminHeader>
      <FlashNotice />

      <div class="a-split">
        <div class="a-stack">
          <Panel title="Request" flush>
            <dl class="a-facts">
              <div class="a-facts__row">
                <dt>Asks to</dt>
                <dd class="a-strong">{SCOPE[req.scope] ?? req.scope}</dd>
              </div>
              <div class="a-facts__row">
                <dt>Store</dt>
                <dd>
                  {store ? (
                    <a class="a-link" href={`/admin/stores/${store.domain}`}>
                      {store.domain}
                    </a>
                  ) : (
                    <>
                      {req.domain} <span class="a-muted">· not in the library</span>
                    </>
                  )}
                </dd>
              </div>
              <div class="a-facts__row">
                <dt>From</dt>
                <dd>
                  {req.name && <span>{req.name} · </span>}
                  <a class="a-link" href={mailto}>
                    {req.email}
                  </a>
                </dd>
              </div>
              <div class="a-facts__row">
                <dt>Received</dt>
                <dd>{fullTime(req.created_at)}</dd>
              </div>
              {req.handled_at && (
                <div class="a-facts__row">
                  <dt>Handled</dt>
                  <dd>{fullTime(req.handled_at)}</dd>
                </div>
              )}
              {req.admin_note && (
                <div class="a-facts__row">
                  <dt>Admin note</dt>
                  <dd class="a-pre">{req.admin_note}</dd>
                </div>
              )}
            </dl>
            <figure class="reason">
              <figcaption>Their reason</figcaption>
              <blockquote class="a-pre">{req.reason}</blockquote>
            </figure>
          </Panel>

          {pending && (
            <Panel
              title="Approve"
              description="Reply to the requester by email after deciding. They are not notified automatically."
              id="decide"
            >
              <form method="post" class="a-form approve">
                <input type="hidden" name="intent" value="approve" />
                <p class="decide__title">Approving will:</p>
                <ol class="effects">
                  {effects.map((e) => (
                    <li>{e}</li>
                  ))}
                </ol>
                {blocksCaptures && (
                  <Notice tone="caution" title="Future captures stay blocked" icon="lock-simple">
                    {req.scope === 'store' ? 'A whole-store' : 'A screenshots'} removal stops the
                    crawler from capturing {domain} again, for good. The block outlives this request
                    record (purged after two years) and cannot be lifted from the admin.
                  </Notice>
                )}
                <Field
                  label="Note"
                  for="approve-note"
                  optional
                  hint="Kept with the request and in the audit log."
                >
                  <Input
                    as="textarea"
                    id="approve-note"
                    name="note"
                    maxlength={1000}
                    rows={2}
                    class="input--short"
                  />
                </Field>
                <Checkbox
                  name="confirm"
                  required
                  label={
                    req.scope === 'details'
                      ? 'I have made the corrections.'
                      : 'I understand this cannot be undone.'
                  }
                />
                <div class="a-form__actions">
                  <Button type="submit" variant="primary" size="md">
                    {approveLabel}
                  </Button>
                </div>
              </form>
            </Panel>
          )}

          {pending && (
            <Panel title="Reject">
              <form method="post" class="a-form">
                <input type="hidden" name="intent" value="reject" />
                <Field
                  label="Reject with a note"
                  for="reject-note"
                  hint="Say why, e.g. the email does not match the store's domain."
                >
                  <Input
                    as="textarea"
                    id="reject-note"
                    name="note"
                    required
                    minlength={3}
                    maxlength={1000}
                    rows={2}
                    class="input--short"
                  />
                </Field>
                <div class="a-form__actions">
                  <Button type="submit" variant="secondary" size="md">
                    Reject request
                  </Button>
                </div>
              </form>
            </Panel>
          )}

          {req.status === 'approved' && (
            <Panel title="Media cleanup is not finished" tone="caution">
              <p class="retry__text">
                The request is approved{blocksCaptures ? ' and captures are blocked' : ''}, but
                deleting the stored images failed or could not run. Retry once media storage is
                available.
              </p>
              <form method="post" class="retry">
                <input type="hidden" name="intent" value="retry" />
                <Button type="submit" variant="primary" size="sm" icon="arrow-clockwise">
                  Retry media cleanup
                </Button>
              </form>
            </Panel>
          )}
        </div>

        <aside class="a-side" aria-label="Store and history">
          <Panel title={store ? 'In the library' : 'Not in the library'} flush>
            {store ? (
              <>
                <div class="snapshot">
                  <StoreMark domain={store.domain} name={store.name} size={32} />
                  <span>
                    <a class="a-row-link" href={`/admin/stores/${store.domain}`}>
                      {store.name ?? store.domain}
                    </a>
                    {store.name && <span class="a-sub">{store.domain}</span>}
                  </span>
                  <StatusPill status={store.status} />
                </div>
                <dl class="a-facts">
                  <div class="a-facts__row">
                    <dt>Theme</dt>
                    <dd>{store.theme_name ?? store.current_theme_name ?? '—'}</dd>
                  </div>
                  <div class="a-facts__row">
                    <dt>Apps</dt>
                    <dd>{store.app_count}</dd>
                  </div>
                  <div class="a-facts__row">
                    <dt>Screenshots</dt>
                    <dd>
                      {media ? `${media.screenshots} current · ${media.r2Objects} stored` : '—'}
                    </dd>
                  </div>
                  <div class="a-facts__row">
                    <dt>Captures</dt>
                    <dd>{blocked ? <CaptureBlocked reference={req.reference} /> : 'Allowed'}</dd>
                  </div>
                  <div class="a-facts__row">
                    <dt>Last seen</dt>
                    <dd>{shortDate(store.last_seen)}</dd>
                  </div>
                </dl>
              </>
            ) : (
              <p class="not-in-library">
                <Icon name="info" size={16} />
                <span>
                  <strong>{domain}</strong> is not in the library.{' '}
                  {req.scope === 'store'
                    ? 'Approving still tombstones it and blocks its captures, so it is never added later.'
                    : req.scope === 'screenshots'
                      ? 'Approving still blocks its captures, so it is never captured if it is added later.'
                      : 'There are no details to correct.'}
                </span>
              </p>
            )}
          </Panel>

          {related.length > 1 && (
            <Panel title="Other requests for this domain" flush>
              <ul class="a-list">
                {related
                  .filter((r) => r.id !== req.id)
                  .map((r) => (
                    <li>
                      <span>
                        <a class="a-row-link a-mono" href={`/admin/removals/${r.id}`}>
                          {r.reference}
                        </a>
                        <span class="a-sub">
                          {SCOPE_SHORT[r.scope] ?? r.scope} · {timeAgo(r.created_at, now)}
                        </span>
                      </span>
                      <StatusPill status={r.status} />
                    </li>
                  ))}
              </ul>
            </Panel>
          )}

          <Panel title="History" flush>
            <AuditList rows={audit} hideTarget empty="No decisions yet." />
          </Panel>
        </aside>
      </div>
    </>
  )}
</AdminLayout>

<style>
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin-top: var(--space-3);
    font-size: var(--text-sm);
  }
  .reason {
    padding: var(--space-4);
    border-top: 1px solid var(--line);
  }
  .reason figcaption {
    margin-bottom: var(--space-2);
    color: var(--ink-3);
    font-size: var(--text-sm);
  }
  .reason blockquote {
    padding: var(--space-1) 0 var(--space-1) var(--space-4);
    border-left: 2px solid var(--line-strong);
    color: var(--ink);
    font-size: var(--text-body);
    line-height: var(--leading-relaxed);
    overflow-wrap: anywhere;
  }
  .decide__title {
    color: var(--ink);
    font-weight: var(--weight-semibold);
  }
  .effects {
    margin-top: calc(var(--space-2) * -1);
    padding-left: 1.6em;
    list-style: decimal;
    color: var(--ink-2);
    font-size: var(--text-sm);
  }
  .effects li {
    padding-left: var(--space-1);
  }
  .effects li + li {
    margin-top: var(--space-1-5);
  }
  .effects li::marker {
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }
  .retry__text {
    color: var(--ink-2);
    font-size: var(--text-sm);
  }
  .retry {
    margin-top: var(--space-3);
  }
  .snapshot {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--line);
  }
  .not-in-library {
    display: flex;
    gap: var(--space-2);
    padding: var(--space-4);
    color: var(--ink-2);
    font-size: var(--text-sm);
  }
  .not-in-library :global(.icon) {
    margin-top: 2px;
    color: var(--ink-3);
  }
  .not-in-library strong {
    color: var(--ink);
    font-weight: var(--weight-medium);
  }
</style>
