---
import AdminLayout from '~/layouts/AdminLayout.astro';
import AdminHeader from '~/components/admin/AdminHeader.astro';
import AuditList from '~/components/admin/AuditList.astro';
import CaptureBlocked from '~/components/admin/CaptureBlocked.astro';
import Panel from '~/components/admin/Panel.astro';
import FlashNotice from '~/components/admin/FlashNotice.astro';
import StatusPill from '~/components/admin/StatusPill.astro';
import Button from '~/components/ui/Button.astro';
import Checkbox from '~/components/ui/Checkbox.astro';
import Badge from '~/components/ui/Badge.astro';
import EmptyState from '~/components/ui/EmptyState.astro';
import Field from '~/components/ui/Field.astro';
import Input from '~/components/ui/Input.astro';
import Notice from '~/components/ui/Notice.astro';
import StoreMark from '~/components/ui/StoreMark.astro';
import { adminDb } from '~/server/admin/env';
import { queueJob, updateStore } from '~/server/admin/actions';
import { checkbox, oneOf, optionalText, text } from '~/server/admin/forms';
import { runAction, requireAdmin } from '~/server/admin/page';
import {
  getRecentAudit,
  getRemovalsForDomain,
  getStore,
  getStoreCategories,
  getStoreHistory,
  getStoreJobs,
} from '~/server/admin/queries';
import { fullTime, shortDate, timeAgo } from '~/server/admin/format';
import { PAGE_TYPES } from '~/lib/taxonomy';

const denied = requireAdmin(Astro);
if (denied) return denied;

const domain = (Astro.params.domain ?? '').toLowerCase();

if (Astro.request.method === 'POST') {
  return runAction(Astro, async (form, ctx) => {
    const intent = text(form, 'intent', 20);
    if (intent === 'update') {
      return updateStore(ctx, domain, {
        name: optionalText(form, 'name', 120),
        category: optionalText(form, 'category', 80),
        country: optionalText(form, 'country', 2),
        status: oneOf(form, 'status', ['active', 'hidden'] as const),
        curated: checkbox(form, 'curated'),
      });
    }
    if (intent === 'rescan' || intent === 'capture') {
      return queueJob(ctx, { domain, kind: intent });
    }
    return { ok: false, flash: 'bad_request' };
  });
}

const db = adminDb();
const store = await getStore(db, domain);
if (!store) Astro.response.status = 404;

const [categories, history, jobs, audit, removals] = store
  ? await Promise.all([
      getStoreCategories(db),
      getStoreHistory(db, store.id),
      getStoreJobs(db, store.id, store.domain),
      getRecentAudit(db, { targetType: 'store', targetId: store.domain, limit: 8 }),
      getRemovalsForDomain(db, store.domain),
    ])
  : [[], null, [], [], []];

const now = new Date();
const pageLabel = (type: string) => PAGE_TYPES.find((p) => p.slug === type)?.name ?? type;
const optedOut = store?.status === 'opted_out';
const blocked = !!store?.capture_blocked;
// The approved request that set the block (scope store or screenshots), when it is still on file.
const blockedBy = blocked
  ? removals.find((r) => (r.status === 'approved' || r.status === 'done') && r.scope !== 'details')
  : undefined;
const spec = store
  ? [
      { label: 'Theme', value: store.theme_name ?? store.current_theme_name ?? '—' },
      { label: 'Version', value: store.current_theme_version ?? '—', mono: true },
      { label: 'Apps', value: String(store.app_count) },
      {
        label: 'Tranco rank',
        value: store.tranco_rank ? store.tranco_rank.toLocaleString('en-US') : '—',
      },
      { label: 'Country', value: store.country ?? '—' },
      { label: 'Currency', value: store.currency ?? '—' },
      { label: 'Category', value: store.category_name ?? '—' },
      { label: 'First seen', value: shortDate(store.first_seen) },
      { label: 'Last seen', value: shortDate(store.last_seen) },
      { label: 'Edited', value: timeAgo(store.updated_at, now) },
    ]
  : [];
const STATE_STATUS: Record<string, string> = {
  Captured: 'done',
  'Layout preview': 'preview',
  'Not captured': 'none',
  'No image': 'none',
};
const captureState = (c: {
  screenshot_id: number | null;
  is_placeholder: number | null;
  has_r2: number | null;
}) =>
  !c.screenshot_id
    ? 'Not captured'
    : c.is_placeholder
      ? 'Layout preview'
      : c.has_r2
        ? 'Captured'
        : 'No image';
---

<AdminLayout
  title={store ? (store.name ?? store.domain) : 'Store not found'}
  section="stores"
  trail={[{ label: 'Stores', href: '/admin/stores' }, { label: store?.domain ?? (domain || '—') }]}
>
  {store && (
    <Fragment slot="actions">
      {store.status === 'active' && (
        <Button
          href={`/stores/${store.domain}`}
          variant="ghost"
          size="sm"
          iconRight="arrow-up-right"
        >
          Public page
        </Button>
      )}
      <Button
        href={store.url ?? `https://${store.domain}`}
        variant="secondary"
        size="sm"
        iconRight="arrow-up-right"
        external
        rel="noreferrer nofollow"
      >
        Visit store
      </Button>
    </Fragment>
  )}
  {!store ? (
    <>
      <AdminHeader title="Store not found" />
      <EmptyState
        title="No store with that domain"
        body="It may have been typed wrong, or it was never scanned."
      >
        <Button href="/admin/stores" variant="primary" size="sm">
          Back to stores
        </Button>
      </EmptyState>
    </>
  ) : (
    <>
      <AdminHeader title={store.name ?? store.domain}>
        <StoreMark slot="mark" domain={store.domain} name={store.name} size={40} />
        <p slot="meta" class="meta">
          <span class="a-mono a-muted">{store.domain}</span>
          <StatusPill status={store.status} size="md" />
          {store.is_curated ? <Badge tone="outline">Curated</Badge> : null}
          {blocked && <CaptureBlocked size="md" reference={blockedBy?.reference} />}
        </p>
      </AdminHeader>
      <FlashNotice />

      {optedOut && (
        <Notice tone="critical" title="Opted out" class="state-notice">
          Removed on {shortDate(store.opted_out_at)} after a removal request. It is hidden
          everywhere, its media was deleted and the domain is tombstoned, so the crawler never adds
          it again.
        </Notice>
      )}
      {store.status === 'hidden' && (
        <Notice tone="caution" title="Hidden" class="state-notice">
          Not shown anywhere on the public site, including counts. Set the status back to active to
          show it.
        </Notice>
      )}

      <div class="detail">
        <Panel title="Store" flush as="aside" class="detail__facts">
          <dl class="a-facts">
            {spec.map((row) => (
              <div class="a-facts__row">
                <dt>{row.label}</dt>
                <dd class:list={[{ 'a-mono': row.mono }]}>{row.value}</dd>
              </div>
            ))}
            <div class="a-facts__row">
              <dt>Captures</dt>
              <dd>
                {blocked ? (
                  <CaptureBlocked reference={blockedBy?.reference} />
                ) : (
                  <span class="a-muted">Allowed</span>
                )}
              </dd>
            </div>
          </dl>
          {!optedOut && (
            <div class="facts-actions">
              <div class="facts-actions__row">
                <form method="post">
                  <input type="hidden" name="intent" value="rescan" />
                  <Button type="submit" size="sm" variant="secondary" icon="arrow-clockwise" full>
                    Queue rescan
                  </Button>
                </form>
                <form method="post">
                  <input type="hidden" name="intent" value="capture" />
                  <Button
                    type="submit"
                    size="sm"
                    variant="secondary"
                    icon="desktop"
                    full
                    disabled={blocked}
                    aria-describedby={blocked ? 'capture-blocked-note' : undefined}
                  >
                    Queue capture
                  </Button>
                </form>
              </div>
              {blocked ? (
                <p class="facts-actions__note" id="capture-blocked-note">
                  {blockedBy ? (
                    <>
                      Captures are blocked by removal request{' '}
                      <a class="a-link" href={`/admin/removals/${blockedBy.id}`}>
                        {blockedBy.reference}
                      </a>
                      . Detection rescans still work.
                    </>
                  ) : (
                    'Captures are blocked by an approved removal request. Detection rescans still work.'
                  )}
                </p>
              ) : (
                <p class="facts-actions__note">The crawler takes queued jobs on its next run.</p>
              )}
            </div>
          )}
        </Panel>

        <div class="a-stack detail__main">
          <Panel
            title="Details"
            description="Editorial fields. Detection data comes from scans and is not edited here."
          >
            <form method="post" class="a-form">
              <input type="hidden" name="intent" value="update" />
              <div class="a-form__row">
                <Field
                  label="Display name"
                  for="s-name"
                  optional
                  hint="Leave empty to show the domain."
                >
                  <Input
                    id="s-name"
                    name="name"
                    value={store.name ?? ''}
                    maxlength={120}
                    placeholder={store.domain}
                  />
                </Field>
                <Field label="Category" for="s-category" optional>
                  <Input as="select" id="s-category" name="category">
                    <option value="">No category</option>
                    {categories.map((c) => (
                      <option value={c.value} selected={c.value === store.category_slug}>
                        {c.label}
                      </option>
                    ))}
                  </Input>
                </Field>
              </div>
              <div class="a-form__row">
                <Field
                  label="Country"
                  for="s-country"
                  optional
                  hint="Two-letter ISO code, only when unambiguous."
                >
                  <Input
                    id="s-country"
                    name="country"
                    value={store.country ?? ''}
                    maxlength={2}
                    pattern="[A-Za-z]{2}"
                    autocomplete="off"
                    class="country"
                  />
                </Field>
                <Field
                  label="Status"
                  for="s-status"
                  hint={
                    optedOut
                      ? 'Opted-out stores stay removed.'
                      : 'Hidden stores disappear from every public page and count.'
                  }
                >
                  <Input as="select" id="s-status" name="status" disabled={optedOut}>
                    {optedOut && (
                      <option value="" selected>
                        Opted out
                      </option>
                    )}
                    <option value="active" selected={store.status === 'active'}>
                      Active
                    </option>
                    <option value="hidden" selected={store.status === 'hidden'}>
                      Hidden
                    </option>
                  </Input>
                </Field>
              </div>
              <Checkbox
                name="curated"
                checked={!!store.is_curated}
                label="Curated"
                hint="Part of the hand-picked library: gets full captures and ranks above uncurated stores."
              />
              <div class="a-form__actions">
                <Button type="submit" variant="primary" size="sm">
                  Save changes
                </Button>
              </div>
            </form>
          </Panel>

          <Panel
            title="Pages and captures"
            count={history?.captures.length ?? 0}
            description="Layout previews are drawn from detected sections until a real capture replaces them."
            flush
          >
            <div class="a-tablewrap">
              <table class="table a-table a-table--stack">
                <thead>
                  <tr>
                    <th scope="col">Page</th>
                    <th scope="col">Device</th>
                    <th scope="col">State</th>
                    <th scope="col" class="is-num">
                      Sections
                    </th>
                    <th scope="col" class="is-num">
                      Height
                    </th>
                    <th scope="col">Captured</th>
                  </tr>
                </thead>
                <tbody>
                  {history && history.captures.length === 0 ? (
                    <tr>
                      <td colspan="6" class="a-empty-cell">
                        {blocked
                          ? 'No pages planned, and captures of this store are blocked.'
                          : 'No pages planned yet. Queue a capture to add them.'}
                      </td>
                    </tr>
                  ) : (
                    history?.captures.map((c) => (
                      <tr>
                        <td class="is-primary a-strong">{pageLabel(c.page_type)}</td>
                        <td class="is-meta a-muted">
                          {c.device ? c.device[0]!.toUpperCase() + c.device.slice(1) : '—'}
                        </td>
                        <td class="is-meta">
                          <StatusPill
                            status={STATE_STATUS[captureState(c)] ?? 'none'}
                            label={captureState(c)}
                            variant="dot"
                          />
                        </td>
                        <td class="is-meta is-num" data-label="Sections">
                          {c.sections}
                        </td>
                        <td class="is-meta is-num a-muted a-nowrap">
                          {c.height ? `${c.height.toLocaleString('en-US')} px` : '—'}
                        </td>
                        <td
                          class:list={['is-meta a-muted a-nowrap', { 'a-hide-sm': !c.captured_at }]}
                        >
                          {c.captured_at ? shortDate(c.captured_at) : '—'}
                        </td>
                      </tr>
                    ))
                  )}
                </tbody>
              </table>
            </div>
          </Panel>

          <Panel
            title="Theme history"
            description="Each row is one theme and version span. Switches close the old row."
            flush
          >
            <div class="a-tablewrap">
              <table class="table a-table a-table--stack">
                <thead>
                  <tr>
                    <th scope="col">Theme</th>
                    <th scope="col">Version</th>
                    <th scope="col">First seen</th>
                    <th scope="col">Last seen</th>
                    <th scope="col">State</th>
                  </tr>
                </thead>
                <tbody>
                  {history && history.themes.length === 0 ? (
                    <tr>
                      <td colspan="5" class="a-empty-cell">
                        No theme detected yet.
                      </td>
                    </tr>
                  ) : (
                    history?.themes.map((t) => (
                      <tr>
                        <td class="is-primary">
                          <span class="a-strong">{t.theme_name ?? t.raw_name ?? 'Unknown'}</span>
                          {t.preset_name || t.is_custom === 1 ? (
                            <span class="a-sub">
                              {t.is_custom ? 'Custom theme' : `Preset ${t.preset_name}`}
                            </span>
                          ) : null}
                        </td>
                        <td class="is-meta a-mono">{t.version ?? '—'}</td>
                        <td class="is-meta a-nowrap a-muted" data-label="From">
                          {shortDate(t.first_seen)}
                        </td>
                        <td class="is-meta a-nowrap a-muted" data-label="to">
                          {shortDate(t.last_seen)}
                        </td>
                        <td class="is-meta">
                          {t.replaced_at ? (
                            <span class="a-muted a-nowrap">
                              Replaced {shortDate(t.replaced_at)}
                            </span>
                          ) : (
                            <StatusPill status="active" label="Current" variant="dot" />
                          )}
                        </td>
                      </tr>
                    ))
                  )}
                </tbody>
              </table>
            </div>
          </Panel>

          <Panel
            title="App history"
            count={history?.apps.length ?? 0}
            description="Unmatched detections have no app profile yet and show their detection slug."
            flush
          >
            <div class="a-tablewrap">
              <table class="table a-table a-table--stack">
                <thead>
                  <tr>
                    <th scope="col">App</th>
                    <th scope="col">First seen</th>
                    <th scope="col">Last seen</th>
                    <th scope="col">State</th>
                  </tr>
                </thead>
                <tbody>
                  {history && history.apps.length === 0 ? (
                    <tr>
                      <td colspan="4" class="a-empty-cell">
                        No apps detected.
                      </td>
                    </tr>
                  ) : (
                    history?.apps.map((a) => (
                      <tr>
                        <td class="is-primary">
                          {a.resolved ? (
                            <a
                              class="a-row-link"
                              href={`/admin/apps?q=${encodeURIComponent(a.slug ?? a.name)}`}
                            >
                              {a.name}
                            </a>
                          ) : (
                            <span class="a-mono">{a.name}</span>
                          )}
                          {!a.resolved && <span class="a-sub">No profile yet</span>}
                        </td>
                        <td class="is-meta a-nowrap a-muted" data-label="From">
                          {shortDate(a.first_seen)}
                        </td>
                        <td class="is-meta a-nowrap a-muted" data-label="to">
                          {shortDate(a.last_seen)}
                        </td>
                        <td class="is-meta">
                          {a.removed_at ? (
                            <span class="a-muted a-nowrap">Removed {shortDate(a.removed_at)}</span>
                          ) : (
                            <StatusPill status="active" label="Current" variant="dot" />
                          )}
                        </td>
                      </tr>
                    ))
                  )}
                </tbody>
              </table>
            </div>
          </Panel>

          {history && history.scans.length > 0 && (
            <Panel title="Recent scans" flush>
              <div class="a-tablewrap">
                <table class="table a-table a-table--stack">
                  <thead>
                    <tr>
                      <th scope="col">Ran</th>
                      <th scope="col">Source</th>
                      <th scope="col">Rules</th>
                      <th scope="col" class="is-num">
                        HTTP
                      </th>
                    </tr>
                  </thead>
                  <tbody>
                    {history.scans.map((s) => (
                      <tr>
                        <td class="is-primary a-nowrap">{shortDate(s.ran_at)}</td>
                        <td class="is-meta a-mono">{s.source}</td>
                        <td class="is-meta a-mono" data-label="Rules">
                          {s.rules_version ?? '—'}
                        </td>
                        <td class="is-meta is-num" data-label="HTTP">
                          {s.http_status ?? '—'}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </Panel>
          )}
        </div>

        <aside class="a-side detail__side" aria-label="Jobs and activity">
          <Panel title="Jobs" flush>
            <a slot="actions" class="a-link" href="/admin/scans">
              Queue
            </a>
            {jobs.length === 0 ? (
              <p class="a-quiet">No scan or capture jobs yet.</p>
            ) : (
              <ul class="a-list">
                {jobs.map((j) => (
                  <li>
                    <span>
                      <span class="a-strong">{j.kind[0]!.toUpperCase() + j.kind.slice(1)}</span>
                      <span class="a-sub" title={fullTime(j.created_at)}>
                        #{j.id} · {timeAgo(j.created_at, now)} · {j.requested_by ?? 'crawler'}
                      </span>
                    </span>
                    <StatusPill status={j.status} />
                  </li>
                ))}
              </ul>
            )}
          </Panel>

          {removals.length > 0 && (
            <Panel title="Removal requests" flush>
              <ul class="a-list">
                {removals.map((r) => (
                  <li>
                    <span>
                      <a class="a-row-link a-mono" href={`/admin/removals/${r.id}`}>
                        {r.reference}
                      </a>
                      <span class="a-sub">{timeAgo(r.created_at, now)}</span>
                    </span>
                    <StatusPill status={r.status} />
                  </li>
                ))}
              </ul>
            </Panel>
          )}

          <Panel title="Activity" flush>
            <AuditList rows={audit} hideTarget empty="No admin changes to this store yet." />
          </Panel>
        </aside>
      </div>
    </>
  )}
</AdminLayout>

<style>
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin-top: var(--space-2);
    font-size: var(--text-sm);
  }
  :global(.state-notice) {
    margin-bottom: var(--space-5);
  }
  :global(.country) {
    max-width: 96px;
    text-transform: uppercase;
  }
  /* Phones and tablets: facts + actions first, then the main column, then jobs and activity.
     Wide: main column on the left; facts above jobs/activity on the right. */
  .detail {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    align-items: start;
  }
  @media (min-width: 1180px) {
    .detail {
      grid-template-columns: minmax(0, 1fr) 320px;
      grid-template-rows: auto 1fr;
    }
    .detail__main {
      grid-column: 1;
      grid-row: 1 / span 2;
    }
    :global(.detail__facts) {
      grid-column: 2;
      grid-row: 1;
    }
    .detail__side {
      grid-column: 2;
      grid-row: 2;
    }
  }
  .facts-actions {
    padding: var(--space-3) var(--space-4) var(--space-4);
    border-top: 1px solid var(--line);
  }
  .facts-actions__row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2);
  }
  .facts-actions__note {
    margin-top: var(--space-2);
    color: var(--ink-3);
    font-size: var(--text-xs);
    line-height: var(--leading-normal);
  }
</style>
