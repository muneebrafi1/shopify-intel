---
/**
 * /alternatives — every app and theme with an alternatives page. Browse pattern: header,
 * browse bar (search, kind pills, category, sort; all URL state), then cards grouped by app
 * category (busiest first) and a themes group. Each app card names the most used apps stores
 * run instead (the order the detail page ranks them in); theme cards show a curated store.
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/ui/PageHeader.astro';
import BrowseBar, { type FilterGroup } from '~/components/ui/BrowseBar.astro';
import Card from '~/components/ui/Card.astro';
import AppIcon from '~/components/ui/AppIcon.astro';
import Button from '~/components/ui/Button.astro';
import EmptyState from '~/components/ui/EmptyState.astro';
import Icon from '~/components/ui/Icon.astro';
import SourceNote from '~/components/ui/SourceNote.astro';
import Shot from '~/components/media/Shot.astro';
import { api } from '~/server/api';
import { formatCount, formatDate } from '~/lib/format';

const params = Astro.url.searchParams;
const kindParam = params.get('kind');
const kind = kindParam === 'app' || kindParam === 'theme' ? kindParam : null;
const q = (params.get('q') ?? '').trim().slice(0, 100);
const sort = params.get('sort') === 'name' ? 'name' : 'usage';
const catParam = params.get('category');

const [{ data, meta }, { data: themes }] = await Promise.all([
  api.listAlternatives(),
  api.listThemes({ limit: 100, sort: 'usage' }),
]);
const themeInfo = new Map(themes.items.map((t) => [t.slug, t]));
const scan = Object.entries(meta.sources).find(([k]) => k.startsWith('storepeek-scan'))?.[1];
const asOf = formatDate(meta.data_as_of);

const norm = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
const nq = norm(q);
const hit = (...parts: Array<string | null | undefined>) =>
  !nq || parts.some((p) => p && norm(p).includes(nq));

type AppAlt = (typeof data.apps)[number];
interface Group {
  key: string;
  label: string;
  href?: string;
  weight: number;
  apps: AppAlt[];
}
// Every category, ranked by its most used app (for the dropdown, ignoring search).
const byCat = new Map<string, Group>();
for (const a of data.apps) {
  const key = a.app.category?.slug ?? 'other';
  const g = byCat.get(key) ?? {
    key,
    label: a.app.category?.name ?? 'Other apps',
    href: a.app.category?.href,
    weight: 0,
    apps: [],
  };
  g.weight = Math.max(g.weight, a.stores);
  g.apps.push(a);
  byCat.set(key, g);
}
const allGroups = [...byCat.values()].sort((x, y) => y.weight - x.weight);
const catSel = catParam && (catParam === 'themes' || byCat.has(catParam)) ? catParam : null;

// "Instead": the most used other apps in the same category (what the detail page ranks first).
const insteadOf = (a: AppAlt) => {
  const g = byCat.get(a.app.category?.slug ?? 'other');
  return (g?.apps ?? [])
    .filter((o) => o.app.slug !== a.app.slug)
    .sort((x, y) => y.stores - x.stores)
    .slice(0, 3);
};

const order = <T extends { stores: number }>(items: T[], name: (x: T) => string) =>
  items
    .slice()
    .sort((x, y) => (sort === 'name' ? name(x).localeCompare(name(y)) : y.stores - x.stores));

const showApps = kind !== 'theme' && (!catSel || catSel !== 'themes');
const showThemes = kind !== 'app' && (!catSel || catSel === 'themes');
const appGroups = showApps
  ? allGroups
      .filter((g) => !catSel || g.key === catSel)
      .map((g) => ({
        ...g,
        apps: order(
          g.apps.filter((a) => hit(a.app.short_name, a.app.name, g.label)),
          (a) => a.app.short_name,
        ),
      }))
      .filter((g) => g.apps.length > 0)
  : [];
const themeItems = showThemes
  ? order(
      data.themes.filter((t) => hit(t.theme.name, themeInfo.get(t.theme.slug)?.vendor)),
      (t) => t.theme.name,
    )
  : [];
const shown = appGroups.reduce((n, g) => n + g.apps.length, 0) + themeItems.length;
const total = data.apps.length + data.themes.length;

// ---- URLs ------------------------------------------------------------------------------------
const hrefWith = (next: Record<string, string | null | undefined>) => {
  const state: Record<string, string | null> = {
    q: q || null,
    kind,
    category: catSel,
    sort: sort === 'name' ? 'name' : null,
  };
  for (const [k, v] of Object.entries(next)) if (v !== undefined) state[k] = v;
  const u = new URLSearchParams();
  for (const [k, v] of Object.entries(state)) if (v) u.set(k, v);
  const s = u.toString();
  return s ? `/alternatives?${s}` : '/alternatives';
};
const groups: FilterGroup[] = [
  {
    key: 'kind',
    label: 'Kind',
    options: [
      { label: 'All', href: hrefWith({ kind: null }), selected: !kind, count: total },
      {
        label: 'Apps',
        href: hrefWith({ kind: 'app', category: catSel === 'themes' ? null : undefined }),
        selected: kind === 'app',
        count: data.apps.length,
      },
      {
        label: 'Themes',
        href: hrefWith({
          kind: 'theme',
          category: catSel && catSel !== 'themes' ? null : undefined,
        }),
        selected: kind === 'theme',
        count: data.themes.length,
      },
    ],
  },
  {
    key: 'category',
    label: 'Category',
    options: [
      { label: 'All categories', href: hrefWith({ category: null }), selected: !catSel },
      ...(kind !== 'theme'
        ? allGroups.map((g) => ({
            label: g.label,
            href: hrefWith({ category: g.key }),
            selected: g.key === catSel,
            count: g.apps.length,
          }))
        : []),
      ...(kind !== 'app'
        ? [
            {
              label: 'Themes',
              href: hrefWith({ category: 'themes' }),
              selected: catSel === 'themes',
              count: data.themes.length,
            },
          ]
        : []),
    ],
  },
];
const sortOptions = [
  { label: 'Most used', href: hrefWith({ sort: null }), selected: sort === 'usage' },
  { label: 'A–Z', href: hrefWith({ sort: 'name' }), selected: sort === 'name' },
];

const abs = (p: string) => new URL(p, Astro.site ?? Astro.url).href;
const jsonLd = {
  '@type': 'ItemList',
  name: 'Alternatives to Shopify apps and themes',
  numberOfItems: total,
  itemListElement: data.apps.slice(0, 40).map((a, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: `Alternatives to ${a.app.short_name}`,
    url: abs(a.href),
  })),
};
const filtered = !!kind || !!catSel || !!q || sort !== 'usage';

Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=600');
---

<BaseLayout
  title="Alternatives to Shopify apps and themes"
  description="What else stores run instead: every app we track with the other apps in its category, and every theme with the themes closest to it, ranked by usage on real stores."
  canonical="/alternatives"
  noindex={filtered}
  jsonLd={jsonLd}
>
  <div class="container alti">
    <PageHeader
      title="Alternatives"
      count={total}
      description="Start from what you run now and see what else stores in the same category use, ranked by how many scanned stores run it. Usage, not quality."
    >
      <a slot="actions" class="alti__cmp" href="/compare">
        Or compare two side by side
        <Icon name="arrow-right" size={14} />
      </a>
    </PageHeader>

    <BrowseBar
      groups={groups}
      pills="kind"
      total={shown}
      noun={shown === 1 ? 'page' : 'pages'}
      sort={sortOptions}
      clearHref="/alternatives"
      search={{
        value: q,
        placeholder: 'Search apps and themes',
        hidden: { kind, category: catSel, sort: sort === 'name' ? 'name' : null },
      }}
    />

    {shown === 0 && (
      <div class="page-block">
        <EmptyState
          title={q ? `Nothing matches “${q}”` : 'Nothing in this view'}
          body="Try another name, or clear the filters to see every app and theme."
          align="start"
        >
          <Button href="/alternatives" variant="secondary">
            Clear filters
          </Button>
        </EmptyState>
      </div>
    )}

    {appGroups.length > 0 && (
      <section class="alti__kind" aria-labelledby="alti-apps">
        <div class="alti__kind-head">
          <h2 id="alti-apps" class="h2">
            Apps<span class="alti__kind-n num">{data.apps.length}</span>
          </h2>
        </div>
        {appGroups.map((g) => (
          <section class="alti__group" aria-labelledby={`cat-${g.key}`}>
            <div class="alti__ghead">
              <h3 id={`cat-${g.key}`} class="alti__gtitle">
                {g.label}
              </h3>
              <p class="alti__gnote">{`${g.apps.length} ${g.apps.length === 1 ? 'app' : 'apps'}`}</p>
              {g.href && (
                <a class="alti__glink" href={g.href}>
                  Category page
                  <Icon name="arrow-right" size={14} />
                </a>
              )}
            </div>
            <ul class="alti__grid">
              {g.apps.map((a) => {
                const instead = insteadOf(a);
                const named = Math.min(2, instead.length);
                return (
                  <li>
                    <Card interactive padding="sm" class="acard">
                      <div class="acard__top">
                        <AppIcon src={a.app.icon_url} name={a.app.short_name} size={36} />
                        <div class="acard__id">
                          <h4 class="acard__name">
                            <a href={a.href} class="stretched-link">
                              <span class="visually-hidden">Alternatives to </span>
                              {a.app.short_name}
                            </a>
                          </h4>
                          <p class="acard__meta">
                            <span class="num">{formatCount(a.stores)}</span> stores ·{' '}
                            {a.alternatives} alternatives
                          </p>
                        </div>
                      </div>
                      {instead.length > 0 && (
                        <p class="acard__instead">
                          <span class="acard__stack" aria-hidden="true">
                            {instead.map((o) => (
                              <AppIcon src={o.app.icon_url} name={o.app.short_name} size={20} />
                            ))}
                          </span>
                          <span class="acard__names">
                            {instead
                              .slice(0, 2)
                              .map((o) => o.app.short_name)
                              .join(', ')}
                            {a.alternatives > named && ` +${a.alternatives - named}`}
                          </span>
                        </p>
                      )}
                    </Card>
                  </li>
                );
              })}
            </ul>
          </section>
        ))}
      </section>
    )}

    {themeItems.length > 0 && (
      <section class="alti__kind" aria-labelledby="alti-themes">
        <div class="alti__kind-head">
          <h2 id="alti-themes" class="h2">
            Themes<span class="alti__kind-n num">{data.themes.length}</span>
          </h2>
        </div>
        <ul class="alti__grid alti__grid--themes">
          {themeItems.map((t) => {
            const info = themeInfo.get(t.theme.slug);
            const p = info?.previews[0];
            return (
              <li>
                <Card interactive padding="sm" class="acard acard--theme">
                  {p && (
                    <Shot
                      slot="media"
                      src={p.image.src}
                      width={p.image.width}
                      height={p.image.height}
                      device="desktop"
                      ratio="16 / 10"
                      flush
                      alt={`${t.theme.name} on a curated store, home page`}
                    />
                  )}
                  <h3 class="acard__name">
                    <a href={t.href} class="stretched-link">
                      <span class="visually-hidden">Alternatives to </span>
                      {t.theme.name}
                    </a>
                  </h3>
                  <p class="acard__meta">
                    {[info?.vendor, info?.price.label].filter(Boolean).join(' · ') || 'Theme'}
                  </p>
                  <p class="acard__meta acard__meta--n">
                    <span class="num">{formatCount(t.stores)}</span> stores · {t.alternatives} close{' '}
                    {t.alternatives === 1 ? 'match' : 'matches'}
                  </p>
                </Card>
              </li>
            );
          })}
        </ul>
      </section>
    )}

    <footer class="alti__foot">
      <SourceNote
        source={`${scan?.label ?? 'Our scan of public storefronts'}. Ordered by usage, not quality; data as of ${asOf}`}
      />
    </footer>
  </div>
</BaseLayout>

<style>
  .alti {
    padding-bottom: var(--section-y-app);
  }
  .alti__cmp {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 40px;
    color: var(--ink-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    white-space: nowrap;
  }
  .alti__cmp:hover {
    color: var(--ink);
  }
  .alti__cmp :global(.icon),
  .alti__glink :global(.icon) {
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .alti__cmp:hover :global(.icon),
  .alti__glink:hover :global(.icon) {
    transform: translateX(2px);
  }
  .alti__kind {
    margin-top: var(--space-10);
  }
  .alti__kind + .alti__kind {
    margin-top: var(--space-16);
  }
  .alti__kind-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-6);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--line);
  }
  .alti__kind-n {
    margin-left: var(--space-2);
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 400;
    letter-spacing: 0;
    vertical-align: 0.35em;
  }
  .alti__kind-desc {
    max-width: 440px;
    color: var(--ink-3);
    font-size: var(--text-ui);
  }
  .alti__group {
    padding-block: var(--space-6);
    border-bottom: 1px solid var(--line);
  }
  .alti__ghead {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 2px var(--space-4);
    margin-bottom: var(--space-4);
  }
  .alti__gtitle {
    font-size: var(--text-h4);
    font-weight: var(--weight-strong);
    letter-spacing: -0.01em;
  }
  .alti__gnote {
    grid-column: 1;
    color: var(--ink-3);
    font-size: var(--text-xs);
  }
  .alti__glink {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 40px;
    color: var(--ink-2);
    font-size: var(--text-sm);
    white-space: nowrap;
  }
  .alti__glink:hover {
    color: var(--ink);
  }

  /* <640: a shelf per category; ≥640: a grid. */
  .alti__grid {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(78%, 300px);
    gap: var(--space-3);
    margin-inline: calc(var(--page-gutter) * -1);
    padding: 4px var(--page-gutter) var(--space-2);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--page-gutter);
    scrollbar-width: none;
  }
  .alti__grid::-webkit-scrollbar {
    display: none;
  }
  .alti__grid > li {
    min-width: 0;
    scroll-snap-align: start;
  }
  .alti__grid--themes {
    margin-top: var(--space-6);
  }

  .acard {
    height: 100%;
  }
  .acard__top {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-width: 0;
  }
  .acard__id {
    min-width: 0;
  }
  .acard__name {
    overflow: hidden;
    font-size: var(--text-md);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.01em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .acard__name a {
    color: var(--ink);
  }
  .acard__meta {
    color: var(--ink-3);
    font-size: var(--text-xs);
  }
  .acard__meta .num {
    color: var(--ink-2);
  }
  .acard--theme .acard__name {
    margin-top: 2px;
  }
  .acard__meta--n {
    margin-top: var(--space-2);
  }
  .acard__instead {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--line);
    color: var(--ink-3);
    font-size: var(--text-xs);
  }
  .acard__stack {
    display: inline-flex;
    flex: none;
  }
  .acard__stack :global(.app-icon) {
    box-shadow: 0 0 0 2px var(--surface);
  }
  .acard__stack :global(.app-icon + .app-icon) {
    margin-left: -6px;
  }
  .acard__names {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .alti__foot {
    margin-top: var(--space-8);
  }

  @media (min-width: 640px) {
    .alti__grid {
      grid-auto-flow: row;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-columns: auto;
      gap: var(--space-3);
      margin-inline: 0;
      padding: 0;
      overflow: visible;
      scroll-snap-type: none;
    }
  }
  @media (min-width: 1024px) {
    .alti__group {
      display: grid;
      grid-template-columns: 232px minmax(0, 1fr);
      gap: var(--space-8);
      padding-block: var(--space-8);
    }
    .alti__ghead {
      position: sticky;
      top: calc(var(--header-h) + 88px);
      align-self: start;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
      margin: 0;
      padding-top: 6px;
    }
    .alti__glink {
      align-self: flex-start;
      min-height: 32px;
      margin-top: var(--space-2);
    }
    .alti__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .alti__grid--themes {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-4);
    }
  }
</style>
