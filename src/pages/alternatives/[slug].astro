---
/**
 * /alternatives/<slug> — what else stores run instead of an app (same category, ranked by usage
 * in our scan) or a theme (same vendor, similar price, similar app stacks). Rank = usage or
 * closeness, never quality; the page says so.
 *
 * Composition: the subject (identity, one-line statement, where it renders in place on a real
 * page) → the ranked alternatives as rich rows ("Compare" only for curated pairs, the item's
 * own page otherwise) → facts about the subject and its curated comparisons.
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/ui/Breadcrumbs.astro';
import AppIcon from '~/components/ui/AppIcon.astro';
import Badge from '~/components/ui/Badge.astro';
import Button from '~/components/ui/Button.astro';
import EmptyState from '~/components/ui/EmptyState.astro';
import FactsCard from '~/components/ui/FactsCard.astro';
import Icon from '~/components/ui/Icon.astro';
import SectionHeader from '~/components/ui/SectionHeader.astro';
import SourceNote from '~/components/ui/SourceNote.astro';
import Window from '~/components/ui/Window.astro';
import AltRow from '~/components/compare/AltRow.astro';
import InContext from '~/components/compare/InContext.astro';
import PairCard from '~/components/compare/PairCard.astro';
import { api, orNotFound } from '~/server/api';
import type { SectionCard } from '~/server/api/v1/types';
import { APP_CATEGORY_SURFACES, type SectionType } from '~/lib/taxonomy';
import { formatCount, formatDate } from '~/lib/format';
import { appPairLine, sharePct, themePairLine } from '~/components/compare/compare';
import { thumbUrl } from '~/lib/media';

const slug = Astro.params.slug ?? '';
const res = await orNotFound(api.getAlternatives({ slug }));
if (!res) return Astro.rewrite('/404');
const { data: alt, meta } = res;
// Alias slugs resolve to the canonical item: send them to its page.
if (alt.slug !== slug) return Astro.redirect(`/alternatives/${alt.slug}`, 301);

Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=600');

const isApp = alt.kind === 'app';
const app = alt.app;
const theme = alt.theme;
const name = app?.short_name ?? theme?.name ?? alt.slug;
const usage = app?.usage ?? theme!.usage;
const scan = Object.entries(meta.sources).find(([k]) => k.startsWith('storepeek-scan'))?.[1];
const asOf = formatDate(meta.data_as_of);

// Apps: one crop of where each app renders, from the category's primary surface.
const crops = new Map<string, SectionCard>();
let categoryTotal: number | null = null;
let surfaceName: string | null = null;
if (isApp && alt.category) {
  const surface = (APP_CATEGORY_SURFACES[alt.category.name] ?? [])[0] as SectionType | undefined;
  const [sections, catApps] = await Promise.all([
    surface ? api.listSections({ type: surface, device: 'desktop', limit: 60 }) : null,
    api.listApps({ category: alt.category.slug, limit: 1 }),
  ]);
  categoryTotal = catApps.meta.pagination?.total ?? null;
  if (sections && surface) {
    for (const s of sections.data.items) {
      surfaceName ??= s.type.name;
      if (s.app && !crops.has(s.app.slug)) crops.set(s.app.slug, s);
    }
    // Apps that render this section but fell outside the first page of results.
    const wanted = new Set([
      alt.slug,
      ...alt.items.map((i) => i.app?.slug).filter((x): x is string => !!x),
    ]);
    const missing = sections.data.facets.apps
      .map((f) => f.value)
      .filter((v) => wanted.has(v) && !crops.has(v));
    const more = await Promise.all(
      missing.map((a) =>
        api.listSections({ type: surface, app: a, device: 'desktop', limit: 1 }).catch(() => null),
      ),
    );
    for (const m of more) {
      const s = m?.data.items[0];
      if (s?.app) crops.set(s.app.slug, s);
    }
  }
}
const own = crops.get(alt.slug) ?? null;
const ownPreview = theme?.previews[0] ?? null;

const count = alt.items.length;
const others = categoryTotal !== null ? Math.max(count, categoryTotal - 1) : count;
const statement = isApp
  ? `${count === others ? `${count}` : `The ${count} most used of ${others}`} other ${alt.category?.name ?? ''} apps, in order of how many of ${formatCount(usage.denominator)} scanned stores run them.`
  : `${count} themes close to ${name}: from the same vendor, at a similar price, or on stores that run similar apps.`;
const ratingSource = app?.cta ? 'Shopify App Store listing' : undefined;
const curatedCount = alt.items.filter((i) => i.compare_available).length;

// Subject facts (end of the page).
const facts = [
  ...(app
    ? [
        {
          label: 'Rating',
          value:
            app.rating !== null
              ? `${app.rating.toFixed(1)} from ${formatCount(app.reviews ?? 0)} reviews`
              : 'Not listed',
        },
        { label: 'Price', value: app.pricing.label ?? 'Not listed' },
        { label: 'Developer', value: app.developer ?? 'Not listed' },
        ...(alt.category
          ? [{ label: 'Category', value: alt.category.name, href: alt.category.href }]
          : []),
        {
          label: 'Built for Shopify',
          value:
            app.built_for_shopify === null ? 'Not listed' : app.built_for_shopify ? 'Yes' : 'No',
        },
      ]
    : [
        { label: 'Vendor', value: theme?.vendor ?? 'Not listed', href: theme?.vendor_info?.href },
        { label: 'Price', value: theme?.price.label ?? 'Not listed' },
        { label: 'Sold on', value: theme?.marketplace ?? 'Not listed' },
        { label: 'Curated stores', value: formatCount(theme?.curated_store_count ?? 0) },
      ]),
  {
    label: 'Seen on',
    value: `${formatCount(usage.stores)} of ${formatCount(usage.denominator)} stores (${sharePct(usage.share)})`,
  },
  ...(usage.rank ? [{ label: 'Usage rank', value: `#${usage.rank}`, mono: true }] : []),
].map((f) => (f.href ? f : { ...f, href: undefined }));

// Curated comparisons with the subject, as cards.
const byAppSlug = new Map(alt.items.flatMap((i) => (i.app ? [[i.app.slug, i.app] as const] : [])));
const byThemeSlug = new Map(
  alt.items.flatMap((i) => (i.theme ? [[i.theme.slug, i.theme] as const] : [])),
);
if (app) byAppSlug.set(app.slug, app);
if (theme) byThemeSlug.set(theme.slug, theme);
const pairs = alt.comparisons.map((c) => {
  const [na, nb] = c.title.split(' vs ');
  const aa = byAppSlug.get(c.a.slug);
  const ab = byAppSlug.get(c.b.slug);
  const ta = byThemeSlug.get(c.a.slug);
  const tb = byThemeSlug.get(c.b.slug);
  return {
    href: c.href,
    a: {
      name: na ?? c.a.name,
      iconUrl: c.a.icon_url,
      stores: aa?.usage.stores ?? ta?.usage.stores ?? null,
    },
    b: {
      name: nb ?? c.b.name,
      iconUrl: c.b.icon_url,
      stores: ab?.usage.stores ?? tb?.usage.stores ?? null,
    },
    line: aa && ab ? appPairLine(aa, ab) : ta && tb ? themePairLine(ta, tb) : c.title,
    shared: c.shared_stores ?? null,
  };
});

const abs = (p: string) => new URL(p, Astro.site ?? Astro.url).href;
const jsonLd = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: 'Alternatives', item: abs('/alternatives') },
      {
        '@type': 'ListItem',
        position: 3,
        name: `Alternatives to ${name}`,
        item: abs(`/alternatives/${alt.slug}`),
      },
    ],
  },
  {
    '@type': 'ItemList',
    name: `Alternatives to ${name}`,
    itemListOrder: 'https://schema.org/ItemListOrderDescending',
    numberOfItems: count,
    itemListElement: alt.items.map((i, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      name: i.app?.short_name ?? i.theme?.name,
      url: abs(i.app?.href ?? i.theme!.href),
    })),
  },
];
const top3 = alt.items
  .slice(0, 3)
  .map((i) => i.app?.short_name ?? i.theme?.name)
  .filter(Boolean)
  .join(', ');
const description = isApp
  ? `Alternatives to ${name} on real Shopify stores: ${top3} and more ${alt.category?.name ? `${alt.category.name} ` : ''}apps, ranked by how many of ${formatCount(usage.denominator)} scanned stores use them.`
  : `Themes like ${name}: ${top3} and more, with the stores that use them.`;
const altTitleLong = isApp
  ? `${name} alternatives: ${count} ${alt.category?.name ? `${alt.category.name} ` : ''}apps ranked by use`
  : `Themes like ${name}: ${count} alternatives`;
const altTitle = altTitleLong.length <= 62 ? altTitleLong : `${name} alternatives on real Shopify stores`;
const eyebrow = ['Alternatives', isApp ? (alt.category?.name ?? 'Apps') : 'Themes'].join(' · ');
---

<BaseLayout
  title={altTitle}
  description={description}
  canonical={`/alternatives/${alt.slug}`}
  jsonLd={jsonLd}
>
  <div class="container altp">
    <Breadcrumbs
      class="altp__crumbs"
      items={[
        { label: 'Home', href: '/' },
        { label: 'Alternatives', href: '/alternatives' },
        { label: name },
      ]}
    />

    <header class="altp__head">
      <div class="altp__intro">
        <div class="altp__id">
          <AppIcon src={app?.icon_url ?? null} name={name} size={56} />
          <p class="eyebrow">{eyebrow}</p>
        </div>
        <h1 class="display-md altp__title">Alternatives to {name}</h1>
        <p class="lead altp__lead">{statement}</p>
        <ul class="altp__chips" aria-label={`${name} at a glance`}>
          <li>
            <Badge tone="neutral">
              {`Seen on ${formatCount(usage.stores)} of ${formatCount(usage.denominator)} stores`}
            </Badge>
          </li>
          {app?.rating != null && (
            <li>
              <Badge tone="neutral" icon="star-fill">
                {`${app.rating.toFixed(1)} on the App Store`}
              </Badge>
            </li>
          )}
          {theme?.price.label && (
            <li>
              <Badge tone="neutral">{theme.price.label}</Badge>
            </li>
          )}
          {curatedCount > 0 && (
            <li>
              <Badge tone="outline">
                {`${curatedCount} side-by-side ${curatedCount === 1 ? 'comparison' : 'comparisons'}`}
              </Badge>
            </li>
          )}
        </ul>
        <div class="altp__actions">
          <Button href={app?.href ?? theme!.href} variant="secondary" arrow>
            {isApp ? `${name} profile` : `${name} theme page`}
          </Button>
          <a class="altp__jump" href="#ranked">
            See the {count} alternatives
            <Icon name="arrow-right" size={14} />
          </a>
        </div>
      </div>

      <figure class="altp__visual">
        {own ? (
          <>
            <InContext
              section={own}
              label={`${own.type.name} · ${name}`}
              alt={`${own.type.name} by ${name} on ${own.store.display_name}, ${own.page_type} page, desktop`}
              eager
            />
            <figcaption class="altp__cap">
              Where {name} renders: the {own.type.name.toLowerCase()} on{' '}
              <a href={own.store.href}>{own.store.display_name}</a>
              {own.is_placeholder && ' (layout preview)'}
            </figcaption>
          </>
        ) : ownPreview ? (
          <>
            <Window title="Home page · curated store">
              <a href={theme!.href} class="altp__shot" data-theme="light">
                <img
                  src={thumbUrl(ownPreview.image.src, {
                    cropHeight: Math.round(ownPreview.image.width * 0.625),
                    width: 1200,
                  })}
                  alt={`${name} on a curated store, home page, desktop`}
                  width={ownPreview.image.width}
                  height={Math.round(ownPreview.image.width * 0.625)}
                  loading="eager"
                  decoding="async"
                />
              </a>
            </Window>
            <figcaption class="altp__cap">
              {name} on a curated store, top of the home page
              {ownPreview.is_placeholder && ' (layout preview)'}
            </figcaption>
          </>
        ) : (
          <div class="altp__novisual">
            <p>
              {isApp
                ? `We haven’t attributed a visible section to ${name} on a curated store yet.`
                : `No curated store runs ${name} yet.`}
            </p>
          </div>
        )}
      </figure>
    </header>

    <section class="altp__block" id="ranked" aria-labelledby="ranked-title">
      <SectionHeader
        id="ranked-title"
        eyebrow={isApp ? 'Ranked by usage' : 'Ranked by closeness'}
        title={isApp ? `Other ${alt.category?.name ?? ''} apps` : `Themes close to ${name}`}
        count={count}
        description={
          isApp
            ? `Position is how many scanned stores run each app, not how good it is.${surfaceName ? ` Crops show the ${surfaceName.toLowerCase()} each one renders.` : ''}`
            : 'Position is how much each theme has in common with the original, not how good it is.'
        }
      />
      {count > 0 ? (
        <div class="altp__table">
          <div class="altp__lhead" aria-hidden="true">
            <span>#</span>
            <span>{isApp ? 'App' : 'Theme'}</span>
            <span>{isApp ? 'Rating' : 'Why it’s here'}</span>
            <span>Price</span>
            <span>Seen on</span>
            <span>{isApp ? 'Where it renders' : 'Home page'}</span>
            <span />
          </div>
          <ol class="altp__list" aria-label={`Alternatives to ${name}`}>
            {alt.items.map((i, idx) => (
              <AltRow
                n={idx + 1}
                app={i.app}
                theme={i.theme}
                originalName={name}
                sharedStores={i.shared_stores}
                compareHref={i.compare_href}
                compareAvailable={i.compare_available}
                reasons={i.reasons}
                crop={i.app ? (crops.get(i.app.slug) ?? null) : null}
                ratingSource={ratingSource}
              />
            ))}
          </ol>
        </div>
      ) : (
        <EmptyState
          title="No alternatives in our data yet"
          body={`We don’t track another ${isApp ? 'app in this category' : 'theme close to this one'} yet. Browse the full catalogue instead.`}
          align="start"
        >
          <Button href={isApp ? '/apps' : '/themes'} variant="secondary">
            {isApp ? 'All apps' : 'All themes'}
          </Button>
        </EmptyState>
      )}
      <SourceNote
        class="altp__source"
        source={`${scan?.label ?? 'our scan of public storefronts'}; ratings and prices from each listing. The order is ${isApp ? 'usage in our scan' : 'overlap in vendor, price and apps'}, not a judgement of quality`}
      />
    </section>

    <section class="altp__block altp__facts" aria-labelledby="facts-title">
      <div class="altp__facts-main">
        <SectionHeader
          id="facts-title"
          eyebrow="Facts"
          title={`${name}, compared`}
          description={
            pairs.length > 0
              ? `Side-by-side pages for ${name} and the alternatives with the most data behind them.`
              : `No side-by-side page for ${name} yet: we only publish comparisons for popular pairs.`
          }
        />
        {pairs.length > 0 ? (
          <ul class="altp__pairs">
            {pairs.map((p) => (
              <li>
                <PairCard
                  href={p.href}
                  a={p.a}
                  b={p.b}
                  line={p.line}
                  shared={p.shared}
                  sharedVerb={isApp ? 'run' : 'ran'}
                  level={3}
                />
              </li>
            ))}
          </ul>
        ) : (
          <a class="altp__browse" href="/compare">
            Browse every comparison
            <Icon name="arrow-right" size={14} />
          </a>
        )}
      </div>
      <FactsCard
        title={`${name} at a glance`}
        items={facts}
        source={isApp ? 'App Store listing and our scan' : 'Theme listing and our scan'}
        asOf={asOf}
      />
    </section>

    <nav class="altp__foot" aria-label="More">
      <a href="/alternatives">
        All alternatives
        <Icon name="arrow-right" size={14} />
      </a>
      <a href="/compare">
        All comparisons
        <Icon name="arrow-right" size={14} />
      </a>
    </nav>
  </div>
</BaseLayout>

<style>
  .altp {
    padding-bottom: var(--section-y-app);
  }
  .altp__crumbs {
    padding-top: var(--space-6);
  }
  .altp__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-8);
    padding-top: var(--space-6);
  }
  .altp__id {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }
  .altp__title {
    overflow-wrap: anywhere;
  }
  .altp__lead {
    max-width: 560px;
    margin-top: var(--space-3);
  }
  .altp__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-5);
  }
  .altp__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-6);
    margin-top: var(--space-6);
  }
  .altp__jump,
  .altp__browse,
  .altp__foot a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 40px;
    color: var(--ink-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .altp__jump:hover,
  .altp__browse:hover,
  .altp__foot a:hover {
    color: var(--ink);
  }
  .altp__jump :global(.icon),
  .altp__browse :global(.icon),
  .altp__foot a :global(.icon) {
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .altp__jump:hover :global(.icon),
  .altp__browse:hover :global(.icon),
  .altp__foot a:hover :global(.icon) {
    transform: translateX(2px);
  }
  .altp__visual {
    min-width: 0;
  }
  .altp__cap {
    margin-top: var(--space-3);
    color: var(--ink-3);
    font-size: var(--text-sm);
  }
  .altp__cap a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
  }
  .altp__shot {
    display: block;
    background: var(--capture-bg);
  }
  .altp__shot img {
    display: block;
    width: 100%;
    height: auto;
  }
  .altp__novisual {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    padding: var(--space-6);
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-card);
    color: var(--ink-3);
    font-size: var(--text-sm);
    text-align: center;
  }
  .altp__block {
    padding-top: var(--space-12);
    scroll-margin-top: var(--header-h);
  }
  .altp__table {
    --alt-cols: 28px minmax(0, 1.7fr) 132px minmax(0, 1fr) 176px 132px 120px;
    border-radius: var(--radius-card);
    background: var(--surface);
    box-shadow:
      inset 0 0 0 1px var(--line),
      var(--shadow-xs),
      var(--highlight);
    overflow: hidden;
  }
  .altp__lhead {
    display: none;
  }
  :global(.altp__source) {
    margin-top: var(--space-4);
  }
  .altp__facts {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-8);
  }
  .altp__pairs {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
  }
  .altp__foot {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-8);
    margin-top: var(--space-12);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }
  @media (min-width: 640px) {
    .altp__pairs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-4);
    }
  }
  @media (min-width: 1024px) {
    .altp__head {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      gap: var(--space-12);
      align-items: center;
      padding-top: var(--space-10);
    }
    .altp__block {
      padding-top: var(--space-16);
    }
    .altp__lhead {
      display: grid;
      grid-template-columns: var(--alt-cols);
      gap: var(--space-5);
      padding: var(--space-3) var(--space-6);
      border-bottom: 1px solid var(--line);
      background: var(--bg-subtle);
      color: var(--ink-3);
      font-family: var(--font-mono);
      font-size: var(--text-2xs);
      letter-spacing: var(--tracking-eyebrow);
      text-transform: uppercase;
    }
    .altp__facts {
      grid-template-columns: minmax(0, 1fr) 340px;
      gap: var(--space-12);
      align-items: start;
    }
  }
</style>
