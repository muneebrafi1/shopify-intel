---
/**
 * Sign-in placeholder. Accounts open with Pro (Whop). Both options are designed and routed;
 * neither signs anyone in yet, and the email typed here is never read or stored.
 * `next` (a same-site path) is preserved for when sign-in is wired.
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import Button from '~/components/ui/Button.astro';
import Field from '~/components/ui/Field.astro';
import Input from '~/components/ui/Input.astro';
import Badge from '~/components/ui/Badge.astro';
import Icon from '~/components/ui/Icon.astro';
import { safeNext } from '~/components/static/content';

const next = safeNext(Astro.url.searchParams.get('next'));
const submitted = Astro.request.method === 'POST';
Astro.response.headers.set('Cache-Control', 'no-store');

// Context-aware headline when we arrive from a "Save" button (/account/boards?save=<type>:<id>).
const SAVE_NOUN: Record<string, string> = {
  screenshot: 'this screenshot',
  section: 'this section',
  store: 'this store',
  theme: 'this theme',
  app: 'this app',
};
let saveNoun: string | null = null;
try {
  const save = new URL(next, 'http://x').searchParams.get('save');
  saveNoun = save ? (SAVE_NOUN[save.split(':')[0] ?? ''] ?? null) : null;
} catch {
  saveNoun = null;
}
const headline = saveNoun
  ? `Sign in to save ${saveNoun}.`
  : next === '/pro'
    ? 'Sign in to get Pro.'
    : 'Sign in to save boards.';
const action = `/sign-in?next=${encodeURIComponent(next)}`;
const backHref = next.startsWith('/account') ? '/' : next;
---

<BaseLayout
  title="Sign in"
  description="Sign in to save stores, pages and sections to boards."
  noindex
  chrome="minimal"
  canonical="/sign-in"
>
  <div class="auth">
    <div class="auth__inner">
      <div class="auth__card">
        <p class="auth__flag">
          <Badge tone="neutral" icon="lock-simple">
            Accounts open with Pro
          </Badge>
        </p>
        <h1 class="auth__title">{headline}</h1>
        <p class="auth__sub">
          Accounts aren’t open yet. They arrive with Pro; until then, everything else is free to
          browse without one.
        </p>

        <div class="auth__notice" data-signin-notice role="status" hidden={!submitted}>
          <Icon name="info" size={16} class="auth__notice-icon" />
          <div>
            <p class="auth__notice-title">Nothing was sent.</p>
            <p>
              Sign-in links start working when accounts open with Pro. We didn’t keep the address
              you typed.
            </p>
            <p class="auth__notice-links">
              <a href="/pro">See what Pro includes</a>
              <a href={backHref}>Keep browsing</a>
            </p>
          </div>
        </div>

        <div class="auth__options">
          <Button variant="secondary" size="lg" full disabled aria-describedby="whop-note">
            Continue with Whop
          </Button>
          <p class="auth__fine" id="whop-note">
            Coming soon. Memberships and checkout run on Whop.
          </p>
        </div>

        <div class="auth__or" aria-hidden="true">
          <span>or</span>
        </div>

        <form class="auth__form" method="post" action={action} novalidate data-signin-form>
          <input type="hidden" name="next" value={next} />
          <Field label="Email" for="signin-email">
            <Input
              id="signin-email"
              name="email"
              type="email"
              autocomplete="email"
              autocapitalize="none"
              spellcheck="false"
              placeholder="you@studio.com"
            />
          </Field>
          <Button type="submit" variant="primary" size="lg" full>
            Email me a sign-in link
          </Button>
        </form>
      </div>

      <p class="auth__legal">
        By continuing you agree to the <a href="/terms">Terms</a> and the{' '}
        <a href="/privacy">Privacy policy</a>.
      </p>
      <p class="auth__back">
        <a href={backHref}>
          <Icon name="arrow-left" size={14} />
          <span>Back</span>
        </a>
      </p>
    </div>
  </div>
</BaseLayout>

<script>
  // Without JS the form posts and the page answers with the same notice; with JS, no round trip.
  const form = document.querySelector<HTMLFormElement>('[data-signin-form]');
  const notice = document.querySelector<HTMLElement>('[data-signin-notice]');
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const email = form.querySelector<HTMLInputElement>('input[name="email"]');
    if (email) email.value = '';
    if (notice) {
      notice.hidden = false;
      notice.setAttribute('tabindex', '-1');
      notice.focus();
    }
  });
</script>

<style>
  /* Auth screen: a centred card on --bg-subtle (direction.md "Account and sign-in"). */
  .auth {
    display: flex;
    justify-content: center;
    min-height: calc(100dvh - var(--header-h));
    padding: var(--space-8) var(--page-gutter) var(--space-12);
    background: var(--bg-subtle);
    border-top: 1px solid var(--line);
  }
  .auth__inner {
    width: 100%;
    max-width: 420px;
  }
  .auth__card {
    padding: var(--space-6);
    border-radius: var(--radius-card);
    background: var(--surface);
    box-shadow:
      inset 0 0 0 1px var(--line),
      var(--shadow-sm),
      var(--highlight);
  }
  .auth__flag {
    margin-bottom: var(--space-5);
  }
  .auth__title {
    color: var(--ink);
    font-size: var(--text-h2);
    font-weight: var(--weight-semibold);
    line-height: 1.15;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .auth__sub {
    margin-top: var(--space-2);
    color: var(--ink-2);
    font-size: var(--text-body);
    line-height: var(--leading-relaxed);
  }
  .auth__notice {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-5);
    padding: var(--space-4);
    border-radius: var(--radius-control);
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--line);
    color: var(--ink-2);
    font-size: var(--text-sm);
    line-height: 1.5;
  }
  .auth__notice[hidden] {
    display: none;
  }
  .auth__notice:focus {
    outline: none;
  }
  .auth__notice :global(.auth__notice-icon) {
    margin-top: 2px;
    color: var(--ink-3);
  }
  .auth__notice-title {
    color: var(--ink);
    font-weight: var(--weight-semibold);
  }
  .auth__notice-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-2);
  }
  .auth__notice-links a {
    color: var(--ink);
    font-weight: var(--weight-medium);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
  }
  .auth__options {
    margin-top: var(--space-6);
  }
  .auth__fine {
    margin-top: var(--space-2);
    color: var(--ink-3);
    font-size: var(--text-xs);
    text-align: center;
  }
  .auth__or {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-block: var(--space-5);
    color: var(--ink-3);
    font-size: var(--text-xs);
  }
  .auth__or::before,
  .auth__or::after {
    content: '';
    flex: 1;
    border-top: 1px solid var(--line);
  }
  .auth__form {
    display: grid;
    gap: var(--space-4);
  }
  .auth__legal {
    margin-top: var(--space-5);
    color: var(--ink-3);
    font-size: var(--text-xs);
    text-align: center;
  }
  .auth__legal a {
    color: var(--ink-2);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
  }
  .auth__back {
    margin-top: var(--space-6);
    text-align: center;
  }
  .auth__back a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 40px;
    padding: 0 var(--space-3);
    border-radius: var(--radius-control);
    color: var(--ink-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .auth__back a:hover {
    background: var(--surface-3);
    color: var(--ink);
  }

  @media (min-width: 640px) {
    .auth {
      align-items: center;
      padding-block: var(--space-16);
    }
    .auth__card {
      padding: var(--space-8);
    }
  }
</style>
