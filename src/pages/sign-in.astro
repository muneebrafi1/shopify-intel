---
/**
 * Sign in. "Continue with Whop" (OAuth, /auth/whop/start) once a Whop app is configured; until
 * then the button is off and says so. Locally, DEV_SIGN_IN=1 adds a dev form (/auth/dev) that
 * signs in without Whop, on 127.0.0.1/localhost only.
 * `next` (a same-site path) is where the visitor lands afterwards.
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import Button from '~/components/ui/Button.astro';
import Field from '~/components/ui/Field.astro';
import Input from '~/components/ui/Input.astro';
import Badge from '~/components/ui/Badge.astro';
import Icon from '~/components/ui/Icon.astro';
import { safeNext } from '~/components/static/content';
import { SITE_NAME } from '~/config/site';
import { whopConfig } from '~/server/account/env';
import { isLocalHost } from '~/server/whop/config';

const next = safeNext(Astro.url.searchParams.get('next'));
const user = Astro.locals.user ?? null;
const config = whopConfig();
const whopOpen = !!config.oauth;
const devForm = config.devSignIn && isLocalHost(Astro.url);
Astro.response.headers.set('Cache-Control', 'no-store');

// Context-aware headline when we arrive from a "Save" button (/account/save?item=<type>:<id>).
const SAVE_NOUN: Record<string, string> = {
  screenshot: 'this screenshot',
  section: 'this section',
  store: 'this store',
  theme: 'this theme',
  app: 'this app',
};
let saveNoun: string | null = null;
try {
  const q = new URL(next, 'http://x').searchParams;
  const save = q.get('item') ?? q.get('save');
  saveNoun = save ? (SAVE_NOUN[save.split(':')[0] ?? ''] ?? null) : null;
} catch {
  saveNoun = null;
}
const headline = user
  ? 'You’re signed in.'
  : saveNoun
    ? `Sign in to save ${saveNoun}.`
    : next === '/pro'
      ? 'Sign in to get Pro.'
      : `Sign in to ${SITE_NAME}.`;

const ERRORS: Record<string, string> = {
  closed: 'Sign-in isn’t open yet. It opens with Pro.',
  expired: 'That sign-in took too long or was opened in another browser. Try again.',
  denied: 'Whop sign-in was cancelled. Nothing was shared.',
  state: 'That sign-in link didn’t match this browser. Try again.',
  whop: 'Whop didn’t answer as expected. Try again in a minute.',
  email: 'Enter an email address.',
};
const error = ERRORS[Astro.url.searchParams.get('error') ?? ''] ?? null;
const startHref = `/auth/whop/start?next=${encodeURIComponent(next)}`;
const backHref = next.startsWith('/account') ? '/' : next;
---

<BaseLayout
  title="Sign in"
  description="Sign in to save stores, pages and sections to boards."
  noindex
  chrome="minimal"
  canonical="/sign-in"
>
  <div class="auth">
    <div class="auth__inner">
      <div class="auth__card">
        <p class="auth__flag">
          {whopOpen || user ? (
            <Badge tone="neutral" icon="lock-simple">
              Accounts run on Whop
            </Badge>
          ) : (
            <Badge tone="neutral" icon="lock-simple">
              Accounts open with Pro
            </Badge>
          )}
        </p>
        <h1 class="auth__title">{headline}</h1>
        {user ? (
          <p class="auth__sub">
            As <strong>{user.name ?? user.email}</strong>. Carry on where you were, or sign out.
          </p>
        ) : whopOpen ? (
          <p class="auth__sub">
            Sign in with your Whop account. Checkout and memberships run on Whop, so one sign-in
            covers both.
          </p>
        ) : (
          <p class="auth__sub">
            Accounts aren’t open yet. They arrive with Pro; until then, everything else is free to
            browse without one.
          </p>
        )}

        {error && !user && (
          <div class="auth__notice" role="alert">
            <Icon name="info" size={16} class="auth__notice-icon" />
            <div>
              <p class="auth__notice-title">Not signed in.</p>
              <p>{error}</p>
            </div>
          </div>
        )}

        {user ? (
          <div class="auth__options">
            <Button href={next} variant="primary" size="lg" full>
              Continue
            </Button>
            <form method="post" action="/auth/sign-out">
              <Button type="submit" variant="secondary" size="lg" full>
                Sign out
              </Button>
            </form>
          </div>
        ) : (
          <div class="auth__options">
            {whopOpen ? (
              <Button href={startHref} variant="primary" size="lg" full rel="nofollow">
                Continue with Whop
              </Button>
            ) : (
              <Button variant="secondary" size="lg" full disabled aria-describedby="whop-note">
                Continue with Whop
              </Button>
            )}
            <p class="auth__fine" id="whop-note">
              {whopOpen
                ? 'You’ll come straight back here. We get your name and email, nothing else.'
                : 'Coming soon. Memberships and checkout run on Whop.'}
            </p>
          </div>
        )}

        {devForm && !user && (
          <>
            <div class="auth__or" aria-hidden="true">
              <span>local only</span>
            </div>
            <form class="auth__form" method="post" action="/auth/dev" data-dev-signin>
              <input type="hidden" name="next" value={next} />
              <Field label="Email (dev sign-in)" for="dev-email">
                <Input
                  id="dev-email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  autocapitalize="none"
                  spellcheck="false"
                  placeholder="you@studio.com"
                  required
                />
              </Field>
              <Field label="Plan" for="dev-plan">
                <select id="dev-plan" name="plan" class="auth__select">
                  <option value="free">Free</option>
                  <option value="pro" selected>
                    Pro
                  </option>
                  <option value="team">Team</option>
                </select>
              </Field>
              <Button type="submit" variant="secondary" size="lg" full>
                Dev sign-in
              </Button>
              <p class="auth__fine">
                DEV_SIGN_IN=1 on a local host. Never available in production.
              </p>
            </form>
          </>
        )}
      </div>

      <p class="auth__legal">
        By continuing you agree to the <a href="/terms">Terms</a> and the{' '}
        <a href="/privacy">Privacy policy</a>.
      </p>
      <p class="auth__back">
        <a href={backHref}>
          <Icon name="arrow-left" size={14} />
          <span>Back</span>
        </a>
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  .auth__select {
    width: 100%;
    min-height: 44px;
    padding: 0 var(--space-3);
    border-radius: var(--radius-control, 10px);
    border: 1px solid var(--line-strong, var(--line));
    background: var(--surface);
    color: var(--ink);
    font: inherit;
  }

  /* Auth screen: a centred card on --bg-subtle (direction.md "Account and sign-in"). */
  .auth {
    display: flex;
    justify-content: center;
    min-height: calc(100dvh - var(--header-h));
    padding: var(--space-8) var(--page-gutter) var(--space-12);
    background: var(--bg-subtle);
    border-top: 1px solid var(--line);
  }
  .auth__inner {
    width: 100%;
    max-width: 420px;
  }
  .auth__card {
    padding: var(--space-6);
    border-radius: var(--radius-card);
    background: var(--surface);
    box-shadow:
      inset 0 0 0 1px var(--line),
      var(--shadow-sm),
      var(--highlight);
  }
  .auth__flag {
    margin-bottom: var(--space-5);
  }
  .auth__title {
    color: var(--ink);
    font-size: var(--text-h2);
    font-weight: var(--weight-semibold);
    line-height: 1.15;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .auth__sub {
    margin-top: var(--space-2);
    color: var(--ink-2);
    font-size: var(--text-body);
    line-height: var(--leading-relaxed);
  }
  .auth__notice {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-5);
    padding: var(--space-4);
    border-radius: var(--radius-control);
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--line);
    color: var(--ink-2);
    font-size: var(--text-sm);
    line-height: 1.5;
  }
  .auth__notice[hidden] {
    display: none;
  }
  .auth__notice:focus {
    outline: none;
  }
  .auth__notice :global(.auth__notice-icon) {
    margin-top: 2px;
    color: var(--ink-3);
  }
  .auth__notice-title {
    color: var(--ink);
    font-weight: var(--weight-semibold);
  }
  .auth__notice-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-2);
  }
  .auth__notice-links a {
    color: var(--ink);
    font-weight: var(--weight-medium);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
  }
  .auth__options {
    margin-top: var(--space-6);
  }
  .auth__fine {
    margin-top: var(--space-2);
    color: var(--ink-3);
    font-size: var(--text-xs);
    text-align: center;
  }
  .auth__or {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-block: var(--space-5);
    color: var(--ink-3);
    font-size: var(--text-xs);
  }
  .auth__or::before,
  .auth__or::after {
    content: '';
    flex: 1;
    border-top: 1px solid var(--line);
  }
  .auth__form {
    display: grid;
    gap: var(--space-4);
  }
  .auth__legal {
    margin-top: var(--space-5);
    color: var(--ink-3);
    font-size: var(--text-xs);
    text-align: center;
  }
  .auth__legal a {
    color: var(--ink-2);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
  }
  .auth__back {
    margin-top: var(--space-6);
    text-align: center;
  }
  .auth__back a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 40px;
    padding: 0 var(--space-3);
    border-radius: var(--radius-control);
    color: var(--ink-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .auth__back a:hover {
    background: var(--surface-3);
    color: var(--ink);
  }

  @media (min-width: 640px) {
    .auth {
      align-items: center;
      padding-block: var(--space-16);
    }
    .auth__card {
      padding: var(--space-8);
    }
  }
</style>
