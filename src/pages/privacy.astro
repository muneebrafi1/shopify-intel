---
/**
 * Privacy policy — a plain-language pre-launch draft (not legal advice).
 * OWNER: draft. Decided 17 Nov 2026: operator LEGAL_ENTITY (config/site), removal records kept
 * REMOVAL_RETENTION, new removal requests email the admin. Still open: a lawyer's review and
 * the list of sub-processors. Bump LEGAL_UPDATED in src/components/static/content.ts on edits.
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import Button from '~/components/ui/Button.astro';
import DocShell from '~/components/static/DocShell.astro';
import AsideCard from '~/components/static/AsideCard.astro';
import { CONTACT, LEGAL_ENTITY, SITE_NAME } from '~/config/site';
import { LEGAL_UPDATED, REMOVAL_RETENTION } from '~/components/static/content';

Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=600');

const toc = [
  { id: 'who-we-are', label: 'Who we are' },
  { id: 'what-we-collect', label: 'What we collect' },
  { id: 'what-we-dont', label: 'What we don’t do' },
  { id: 'store-data', label: 'Store data' },
  { id: 'cookies', label: 'Cookies' },
  { id: 'processors', label: 'Who else handles data' },
  { id: 'retention', label: 'How long we keep it' },
  { id: 'your-rights', label: 'Your rights' },
  { id: 'changes', label: 'Changes to this policy' },
  { id: 'contact', label: 'Contact' },
];
---

<BaseLayout
  title="Privacy"
  description={`What ${SITE_NAME} collects (very little), what it never does, and how to ask for your data or your store to be removed.`}
>
  <DocShell
    title="Privacy"
    eyebrow="Legal"
    lede="We collect as little as we can. There are no ad pixels, no tracking cookies and nothing for sale."
    updated={LEGAL_UPDATED}
    draft
    toc={toc}
    current="/privacy"
  >
    <Fragment slot="summary">
      <ul>
        <li>
          Browsing is anonymous. We count affiliate clicks per link per day, with nothing that
          identifies you.
        </li>
        <li>
          If you send a removal request, our administrator gets an email about it. We keep the
          details for {REMOVAL_RETENTION} as a record that we handled it.
        </li>
        <li>Store data comes from public storefront pages only.</li>
        <li>The only cookie we set is a sign-in session, and only once accounts exist.</li>
      </ul>
    </Fragment>

    <h2 id="who-we-are">Who we are</h2>
    <p>
      {SITE_NAME} is an independent library of public Shopify storefronts: which theme and apps a
      store runs, and what its pages look like on desktop and mobile. It is run by {LEGAL_ENTITY},
      which is responsible for the personal data described here. We are not affiliated with or
      endorsed by Shopify Inc.
    </p>
    <p>
      This policy covers this website, its public API at <code>/api/v1</code> and, once it launches,
      the MCP server built on that API. You can reach us at{' '}
      <a href={`mailto:${CONTACT.hello}`}>{CONTACT.hello}</a>.
    </p>

    <h2 id="what-we-collect">What we collect</h2>
    <h3>When you browse</h3>
    <p>
      Nothing that identifies you. We don’t run analytics scripts or ad pixels. Our hosting provider
      handles standard request data (such as IP address and browser type) to serve pages and block
      abuse. We don’t use it to identify or profile anyone.
    </p>
    <h3>When you click an affiliate link</h3>
    <p>
      Affiliate links go through a short redirect at <code>/go/…</code>. The redirect adds one to a
      daily total for that link and sends you on. We store the link, the day and the count. We don’t
      store your IP address, a cookie or any other identifier with it.
    </p>
    <h3>When you ask us to remove a store</h3>
    <p>
      The <a href="/opt-out">removal form</a> asks for the store domain, your email, your name
      (optional), what to remove and why. We use these to check the request, do the removal and
      reply to you. To stop spam we also keep a salted, one-way hash of your IP address. It can’t be
      turned back into the address.
    </p>
    <p>
      Each new request also sends an email notification to our administrator, with the details of
      the request, so that someone looks at it quickly. The notification goes only to us.
    </p>
    <h3>When accounts open</h3>
    <p>
      Accounts arrive with Pro, and you sign in with your Whop account. An account holds the name
      and email address Whop shares with us, your Whop user ID, your plan and its status and renewal
      date as Whop reports them, and the boards you create. Card details go straight to Whop and
      never reach us. Deleting your account removes it and every board straight away.
    </p>

    <h2 id="what-we-dont">What we don’t do</h2>
    <ul>
      <li>No advertising or social-media tracking pixels.</li>
      <li>No third-party analytics that follow you across sites.</li>
      <li>No selling, renting or trading of personal data.</li>
      <li>No fingerprinting and no cross-site profiles.</li>
      <li>
        No data about a store’s shoppers. We never log in to a store or go through its checkout.
      </li>
    </ul>

    <h2 id="store-data">Store data</h2>
    <p>
      Our crawler reads public storefront pages the way a visitor’s browser would. It respects{' '}
      <code>robots.txt</code> and keeps a low request rate. From those pages we record the store’s
      domain, its detected theme and apps, public details such as currency, and screenshots of the
      pages. See the <a href="/methodology">methodology</a> for the details.
    </p>
    <p>
      This is information about businesses, not people. If a page we captured shows a person, or you
      own a store and want it gone, <a href="/opt-out">ask us to remove it</a>. Removal hides the
      store everywhere and deletes its screenshots.
    </p>

    <h2 id="cookies">Cookies</h2>
    <p>
      We only set cookies that the site needs to work, so there is no cookie banner. Today that
      means a session cookie for our own staff on the admin area. Once accounts open, signed-in
      visitors get a session cookie, a small “signed in” flag so pages can show your account link,
      and during sign-in a ten-minute cookie that checks the answer really comes from Whop. We set
      no marketing, advertising or analytics cookies.
    </p>
    <p>
      The sites we link to (app listings, theme stores, the stores themselves) have their own
      cookies and policies.
    </p>

    <h2 id="processors">Who else handles data</h2>
    <p>We use a small number of providers, each only for its job:</p>
    <ul>
      <li>
        <strong>Cloudflare</strong> hosts the site, its database and the screenshots.
      </li>
      <li>
        <strong>Whop</strong> will run Pro checkout and memberships when accounts open.
      </li>
      <li>
        An email service, to notify our administrator about new removal requests and reply to you.
      </li>
    </ul>
    <p>
      Affiliate partners don’t get any personal data from us. When you follow an affiliate link, the
      partner’s own site may set its cookies under its policy.
    </p>

    <h2 id="retention">How long we keep it</h2>
    <ul>
      <li>
        <strong>Affiliate click counts</strong>: as long as the link exists. They hold no personal
        data.
      </li>
      <li>
        <strong>Removal requests</strong>: while we handle them, then {REMOVAL_RETENTION} as a
        record that we did, and then we delete them. A removed store’s domain stays on a block list
        for good, so our crawler never adds it again.
      </li>
      <li>
        <strong>Accounts</strong>: until you delete your account, plus any period the law requires
        for billing records.
      </li>
    </ul>

    <h2 id="your-rights">Your rights</h2>
    <p>
      Wherever you live, you can ask to see, correct or delete the personal data we hold about you,
      or object to how we use it. Write to <a href={`mailto:${CONTACT.hello}`}>{CONTACT.hello}</a>{' '}
      and we will reply within 30 days. If you’re in the EU or UK you can also complain to your data
      protection authority.
    </p>
    <p>
      Store owners can remove a store with the <a href="/opt-out">removal form</a>, or write to{' '}
      <a href={`mailto:${CONTACT.removals}`}>{CONTACT.removals}</a>.
    </p>
    <p>
      The site is not aimed at children, and we don’t knowingly collect data from anyone under 16.
    </p>

    <h2 id="changes">Changes to this policy</h2>
    <p>
      This is a pre-launch draft and it will change before launch. When we change it we update the
      date at the top. If a change matters for people with accounts, we will email them before it
      takes effect.
    </p>

    <h2 id="contact">Contact</h2>
    <p>
      {SITE_NAME} is operated by {LEGAL_ENTITY}. Questions about privacy:{' '}
      <a href={`mailto:${CONTACT.hello}`}>{CONTACT.hello}</a>. Store removals:{' '}
      <a href={`mailto:${CONTACT.removals}`}>{CONTACT.removals}</a> or the{' '}
      <a href="/opt-out">removal form</a>.
    </p>

    <Fragment slot="aside">
      <AsideCard title="Own a store we list?">
        <p>Hide it everywhere and delete its screenshots. No account needed.</p>
        <Button href="/opt-out" variant="secondary" size="sm">
          Request removal
        </Button>
      </AsideCard>
      <AsideCard title="Questions">
        <p>
          <a href={`mailto:${CONTACT.hello}`}>{CONTACT.hello}</a>
        </p>
      </AsideCard>
    </Fragment>
  </DocShell>
</BaseLayout>
