---
/**
 * Remove your store. A plain HTML form that POSTs here: we validate, call the API in-process
 * (same rules as POST /api/v1/removal-requests) and redirect to `/opt-out?sent=<ref>`. With JS
 * the form validates inline and submits to the JSON API instead (see RemovalForm).
 * `?domain=` pre-fills the store (store pages link here). New requests email the admin (API side).
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import Card from '~/components/ui/Card.astro';
import FactsCard from '~/components/ui/FactsCard.astro';
import RemovalForm from '~/components/static/RemovalForm.astro';
import RemovalReceipt from '~/components/static/RemovalReceipt.astro';
import RemovalSteps from '~/components/static/RemovalSteps.astro';
import { api, isApiError } from '~/server/api';
import { CONTACT, SITE_NAME } from '~/config/site';
import { REMOVAL_RETENTION, REMOVAL_SLA } from '~/components/static/content';
import {
  FIELD_ORDER,
  isReference,
  isScope,
  normalizeDomain,
  sentPath,
  validateRemoval,
  valuesFromForm,
  type RemovalErrors,
  type RemovalField,
  type RemovalValues,
} from '~/components/static/removal';

const params = Astro.url.searchParams;
const sentRef = params.get('sent');
const sent = isReference(sentRef) ? sentRef : null;
const sentDomain = sent ? normalizeDomain(params.get('domain') ?? '') : null;
const sentScope = sent && isScope(params.get('scope')) ? (params.get('scope') as string) : 'store';

let values: RemovalValues = {
  domain: normalizeDomain(params.get('domain') ?? '') ?? '',
  email: '',
  name: '',
  scope: isScope(params.get('scope')) ? (params.get('scope') as RemovalValues['scope']) : 'store',
  reason: '',
  owner: false,
  website: '',
};
let errors: RemovalErrors = {};
let formError: string | null = null;

const GENERIC_ERROR = `Something went wrong on our side. Please try again in a moment, or email ${CONTACT.removals}.`;

if (Astro.request.method === 'POST') {
  try {
    values = valuesFromForm(await Astro.request.formData());
  } catch {
    formError = 'We couldn’t read that form. Please try again.';
  }
  if (!formError) errors = validateRemoval(values);
  if (!formError && Object.keys(errors).length === 0) {
    let ip: string | null = Astro.request.headers.get('cf-connecting-ip');
    if (!ip) {
      try {
        ip = Astro.clientAddress;
      } catch {
        ip = null;
      }
    }
    try {
      const { data } = await api.createRemovalRequest(
        {
          domain: values.domain.trim(),
          email: values.email.trim(),
          name: values.name.trim() || undefined,
          reason: values.reason.trim(),
          scope: values.scope,
          website: values.website,
        },
        { request: { ip } },
      );
      return Astro.redirect(sentPath(data.reference, data.domain, data.scope), 303);
    } catch (err) {
      if (isApiError(err) && err.code === 'validation_error' && err.details?.length) {
        for (const d of err.details) {
          const field = d.path.split('.')[0] as RemovalField;
          if (FIELD_ORDER.includes(field)) errors[field] = d.message;
        }
        if (Object.keys(errors).length === 0) formError = err.message;
      } else if (isApiError(err) && err.code === 'rate_limited') {
        formError = `Too many requests from your connection. Please try again in an hour, or email ${CONTACT.removals}.`;
        Astro.response.status = 429;
      } else {
        console.error('removal request failed', err);
        formError = GENERIC_ERROR;
        Astro.response.status = 500;
      }
    }
  }
  if (Astro.response.status === 200) Astro.response.status = 400;
}
Astro.response.headers.set('Cache-Control', 'no-store');

/** 'within 3 business days' → 'Within 3 business days' for the facts card. */
const SLA_SHORT = REMOVAL_SLA.charAt(0).toUpperCase() + REMOVAL_SLA.slice(1);
const site = Astro.site ?? Astro.url;
const jsonLd = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', site).href },
      {
        '@type': 'ListItem',
        position: 2,
        name: `Remove your store · ${SITE_NAME}`,
        item: new URL('/opt-out', site).href,
      },
    ],
  },
  {
    '@type': 'WebPage',
    name: `Remove your store · ${SITE_NAME}`,
    url: new URL('/opt-out', site).href,
    description: `Own a Shopify store listed on ${SITE_NAME}? Ask us to hide it everywhere and delete its screenshots, or correct a detail.`,
  },
];
---

<BaseLayout
  title={sent ? 'Removal request received' : 'Remove your store'}
  description={`Own a Shopify store listed on ${SITE_NAME}? Ask us to hide it everywhere and delete its screenshots, or correct a detail. No account needed.`}
  canonical="/opt-out"
  noindex={!!sent || Astro.request.method === 'POST'}
  jsonLd={jsonLd}
>
  <div class="optout">
    <div class="container">
      {sent ? (
        <div class="optout__grid optout__grid--sent">
          <div class="optout__main">
            <RemovalReceipt reference={sent} domain={sentDomain} scope={sentScope} />
          </div>
          <aside class="optout__side" aria-label="Next steps">
            <div class="optout__panel">
              <RemovalSteps done={1} />
            </div>
          </aside>
        </div>
      ) : (
        <>
          <header class="optout__head">
            <p class="eyebrow">Store owners · No account needed</p>
            <h1 class="display-md optout__title">Remove your store</h1>
            <p class="lead optout__lede">
              If you run a store we list, you can have it taken down or corrected. We aim to handle
              requests {REMOVAL_SLA}.
            </p>
          </header>
          <div class="optout__grid">
            <div class="optout__main">
              <Card padding="lg" class="optout__form">
                <RemovalForm values={values} errors={errors} formError={formError} />
              </Card>
            </div>
            <aside class="optout__side" aria-label="How removal works">
              <FactsCard
                title="How removal works"
                items={[
                  { label: 'Handling time', value: SLA_SHORT },
                  { label: 'Account needed', value: 'No' },
                  { label: 'New requests', value: 'Emailed to our admin' },
                  { label: 'Requests kept', value: REMOVAL_RETENTION },
                ]}
                sourceHref=""
              >
                <p slot="footer" class="optout__facts-note">
                  A removed store’s domain stays on a block list, so our crawler never adds it back.
                </p>
              </FactsCard>
              <div class="optout__panel">
                <RemovalSteps />
              </div>
              <p class="optout__note">
                How we collect data: <a href="/methodology">methodology</a>. What we keep about you:{' '}
                <a href="/privacy#retention">privacy</a>.
              </p>
            </aside>
          </div>
        </>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  .optout {
    padding-block: var(--space-10) var(--section-y);
  }
  .optout__head {
    max-width: 640px;
    padding-bottom: var(--space-8);
  }
  .optout__title {
    margin-top: var(--space-3);
  }
  .optout__lede {
    margin-top: var(--space-3);
  }
  .optout__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-8);
  }
  .optout__main {
    min-width: 0;
  }
  .optout__side {
    display: grid;
    gap: var(--space-4);
    align-content: start;
    min-width: 0;
  }
  .optout__panel {
    padding: var(--space-5);
    border-radius: var(--radius-card);
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .optout__facts-note {
    color: var(--ink-3);
    font-size: var(--text-sm);
    line-height: 1.45;
  }
  .optout__note {
    color: var(--ink-3);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }
  .optout__note a {
    color: var(--ink-2);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
  }
  .optout__note a:hover {
    color: var(--ink);
  }

  @media (max-width: 639px) {
    /* The form card goes edge to edge-ish at 390 so fields keep their width. */
    .optout :global(.optout__form) {
      --card-pad: var(--space-4);
    }
  }
  @media (min-width: 1024px) {
    .optout {
      padding-top: var(--space-16);
    }
    .optout__grid {
      grid-template-columns: minmax(0, 1fr) 340px;
      gap: var(--space-10);
      align-items: start;
    }
    .optout__grid--sent {
      grid-template-columns: minmax(0, 1fr) 380px;
    }
    .optout__side {
      position: sticky;
      top: calc(var(--header-h) + var(--space-6));
    }
  }
</style>
