---
/**
 * Remove your store. A plain HTML form that POSTs here: we validate, call the API in-process
 * (same rules as POST /api/v1/removal-requests) and redirect to `/opt-out?sent=<ref>`. With JS
 * the form validates inline and submits to the JSON API instead (see RemovalForm).
 * `?domain=` pre-fills the store (store pages link here).
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import MonoLabel from '~/components/ui/MonoLabel.astro';
import RemovalForm from '~/components/static/RemovalForm.astro';
import RemovalReceipt from '~/components/static/RemovalReceipt.astro';
import RemovalSteps from '~/components/static/RemovalSteps.astro';
import { api, isApiError } from '~/server/api';
import { CONTACT, SITE_NAME } from '~/config/site';
import { REMOVAL_SLA } from '~/components/static/content';
import {
  FIELD_ORDER,
  isReference,
  isScope,
  normalizeDomain,
  sentPath,
  validateRemoval,
  valuesFromForm,
  type RemovalErrors,
  type RemovalField,
  type RemovalValues,
} from '~/components/static/removal';

const params = Astro.url.searchParams;
const sentRef = params.get('sent');
const sent = isReference(sentRef) ? sentRef : null;
const sentDomain = sent ? normalizeDomain(params.get('domain') ?? '') : null;
const sentScope = sent && isScope(params.get('scope')) ? (params.get('scope') as string) : 'store';

let values: RemovalValues = {
  domain: normalizeDomain(params.get('domain') ?? '') ?? '',
  email: '',
  name: '',
  scope: isScope(params.get('scope')) ? (params.get('scope') as RemovalValues['scope']) : 'store',
  reason: '',
  owner: false,
  website: '',
};
let errors: RemovalErrors = {};
let formError: string | null = null;

const GENERIC_ERROR = `Something went wrong on our side. Please try again in a moment, or email ${CONTACT.removals}.`;

if (Astro.request.method === 'POST') {
  try {
    values = valuesFromForm(await Astro.request.formData());
  } catch {
    formError = 'We couldn’t read that form. Please try again.';
  }
  if (!formError) errors = validateRemoval(values);
  if (!formError && Object.keys(errors).length === 0) {
    let ip: string | null = Astro.request.headers.get('cf-connecting-ip');
    if (!ip) {
      try {
        ip = Astro.clientAddress;
      } catch {
        ip = null;
      }
    }
    try {
      const { data } = await api.createRemovalRequest(
        {
          domain: values.domain.trim(),
          email: values.email.trim(),
          name: values.name.trim() || undefined,
          reason: values.reason.trim(),
          scope: values.scope,
          website: values.website,
        },
        { request: { ip } },
      );
      return Astro.redirect(sentPath(data.reference, data.domain, data.scope), 303);
    } catch (err) {
      if (isApiError(err) && err.code === 'validation_error' && err.details?.length) {
        for (const d of err.details) {
          const field = d.path.split('.')[0] as RemovalField;
          if (FIELD_ORDER.includes(field)) errors[field] = d.message;
        }
        if (Object.keys(errors).length === 0) formError = err.message;
      } else if (isApiError(err) && err.code === 'rate_limited') {
        formError = `Too many requests from your connection. Please try again in an hour, or email ${CONTACT.removals}.`;
        Astro.response.status = 429;
      } else {
        console.error('removal request failed', err);
        formError = GENERIC_ERROR;
        Astro.response.status = 500;
      }
    }
  }
  if (Astro.response.status === 200) Astro.response.status = 400;
}
Astro.response.headers.set('Cache-Control', 'no-store');
---

<BaseLayout
  title={sent ? 'Removal request received' : 'Remove your store'}
  description={`Own a Shopify store listed on ${SITE_NAME}? Ask us to hide it everywhere and delete its screenshots, or correct a detail. No account needed.`}
  canonical="/opt-out"
  noindex={!!sent || Astro.request.method === 'POST'}
>
  <div class="optout container">
    {sent ? (
      <div class="optout__grid">
        <div class="optout__main">
          <RemovalReceipt reference={sent} domain={sentDomain} scope={sentScope} />
        </div>
        <aside class="optout__side">
          <RemovalSteps />
        </aside>
      </div>
    ) : (
      <div class="optout__grid">
        <div class="optout__main">
          <header class="optout__head">
            <MonoLabel as="p" class="optout__eyebrow">
              Store owners · No account needed
            </MonoLabel>
            <h1 class="optout__title display">Remove your store</h1>
            <p class="optout__lede">
              If you run a store we list, you can have it taken down. We hide it everywhere, delete
              its screenshots and make sure our crawler never adds it back. We aim to handle
              requests {REMOVAL_SLA}.
            </p>
          </header>
          <RemovalForm values={values} errors={errors} formError={formError} />
        </div>
        <aside class="optout__side">
          <section class="optout__does" aria-labelledby="does-title">
            <MonoLabel as="h2" tone="ink" id="does-title" class="optout__side-title">
              What removal does
            </MonoLabel>
            <ul class="optout__list">
              <li>
                <strong>Hides the store everywhere.</strong> Its page, every list and count, search
                and the API.
              </li>
              <li>
                <strong>Deletes its screenshots</strong> and section crops from our storage.
              </li>
              <li>
                <strong>Keeps only the domain</strong> on a block list, so our crawler never adds
                the store again.
              </li>
            </ul>
          </section>
          <RemovalSteps class="optout__steps" />
          <p class="optout__note">
            Something we show is wrong but you’re happy to stay listed? Choose “Correct a detail”.
            How we collect data: <a href="/methodology">methodology</a>. What we keep about you:{' '}
            <a href="/privacy">privacy</a>.
          </p>
        </aside>
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .optout {
    padding-top: var(--space-10);
  }
  .optout__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-16);
  }
  .optout__head {
    padding-bottom: var(--space-10);
  }
  .optout__head :global(.optout__eyebrow) {
    display: flex;
    margin-bottom: var(--space-5);
  }
  .optout__title {
    font-size: var(--text-5xl);
  }
  .optout__lede {
    max-width: 560px;
    margin-top: var(--space-4);
    color: var(--ink-2);
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
  }
  .optout__main {
    min-width: 0;
    max-width: 640px;
  }
  .optout__side {
    min-width: 0;
  }
  .optout__side :global(.optout__side-title) {
    display: flex;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--ink);
  }
  .optout__list li {
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink-2);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }
  .optout__list strong {
    color: var(--ink);
    font-weight: var(--weight-semibold);
  }
  .optout__side :global(.optout__steps) {
    margin-top: var(--space-10);
  }
  .optout__note {
    margin-top: var(--space-6);
    color: var(--ink-3);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }
  .optout__note a {
    color: var(--ink-2);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
  }

  @media (max-width: 639px) {
    .optout {
      padding-top: var(--space-8);
    }
    .optout__title {
      font-size: var(--text-4xl);
    }
    .optout__lede {
      font-size: var(--text-md);
    }
  }
  @media (min-width: 1024px) {
    .optout {
      padding-top: var(--space-16);
    }
    .optout__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: var(--space-6);
    }
    .optout__main {
      grid-column: 1 / span 7;
    }
    .optout__side {
      position: sticky;
      top: calc(var(--header-h) + var(--space-8));
      align-self: start;
      grid-column: 9 / -1;
      padding-top: var(--space-2);
    }
  }
</style>
