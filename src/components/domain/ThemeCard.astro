---
/**
 * A theme as a v2 card: a --surface-2 well holding a small deck of real stores (the front
 * capture plus up to two peeking behind it; a desktop + phone pair when only one store is
 * captured), then the name, vendor, price badge and store count. One link (stretched title).
 */
import { thumbCropHeight, thumbUrl } from '~/lib/media';
import Badge from '~/components/ui/Badge.astro';

interface ShotRef {
  src: string;
  width: number;
  height: number;
  alt?: string;
  device?: 'desktop' | 'mobile';
}
interface Props {
  slug: string;
  name: string;
  vendor: string;
  priceLabel: string;
  storesCount: number;
  shots: ShotRef[];
  href?: string;
  eager?: boolean;
  class?: string;
}
const {
  slug,
  name,
  vendor,
  priceLabel,
  storesCount,
  shots,
  href = `/themes/${slug}`,
  eager = false,
  class: className,
} = Astro.props;
const desktops = shots.filter((s) => (s.device ?? 'desktop') === 'desktop');
const mobile = shots.find((s) => s.device === 'mobile');
const deck = desktops.slice(0, 3).map((s) => {
  const h = thumbCropHeight(s.width, s.height, 'desktop');
  return { ...s, thumb: thumbUrl(s.src, { cropHeight: h, width: 640 }), cropH: h };
});
// One store only: pair its desktop and mobile home pages instead of a lonely single capture.
const pair =
  deck.length < 2 && mobile
    ? (() => {
        const h = thumbCropHeight(mobile.width, mobile.height, 'mobile');
        return { ...mobile, thumb: thumbUrl(mobile.src, { cropHeight: h, width: 240 }), cropH: h };
      })()
    : null;
// Front card last in the DOM so it paints on top.
const ordered = [...deck].reverse();
---

<article class:list={['theme-card', className]}>
  <div class:list={['theme-card__well', { 'theme-card__well--pair': !!pair }]}>
    {deck.length === 0 ? (
      <span class="theme-card__none">No captured stores yet</span>
    ) : (
      ordered.map((s, i) => (
        <img
          class={`theme-card__img theme-card__img--${deck.length - 1 - i}`}
          src={s.thumb}
          alt={i === ordered.length - 1 ? (s.alt ?? `${name} on a live store`) : ''}
          width={s.width}
          height={s.cropH}
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
        />
      ))
    )}
    {pair && (
      <img
        class="theme-card__mobile"
        src={pair.thumb}
        alt=""
        width={pair.width}
        height={pair.cropH}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
    )}
  </div>
  <div class="theme-card__body">
    <div class="theme-card__text">
      <h3 class="theme-card__name">
        <a href={href} class="stretched-link">
          {name}
        </a>
      </h3>
      <p class="theme-card__meta">{vendor}</p>
    </div>
    <Badge tone={/^free$/i.test(priceLabel) ? 'positive' : 'neutral'} size="sm">
      {priceLabel}
    </Badge>
  </div>
  <p class="theme-card__count">
    <span class="theme-card__count-n num">{storesCount.toLocaleString('en-US')}</span>
    <span class="theme-card__count-l">{storesCount === 1 ? 'store' : 'stores'} in our scan</span>
  </p>
</article>

<style>
  .theme-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    border-radius: var(--radius-card);
    background: var(--surface);
    box-shadow:
      inset 0 0 0 1px var(--line),
      var(--shadow-xs),
      var(--highlight);
    transition:
      box-shadow var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }
  .theme-card:hover {
    box-shadow:
      inset 0 0 0 1px var(--line-strong),
      var(--shadow-md),
      var(--highlight);
    transform: translateY(-2px);
  }
  .theme-card:has(.stretched-link:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .theme-card .stretched-link:focus-visible {
    outline: none;
  }
  .theme-card__well {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius-card) var(--radius-card) 0 0;
    background: var(--surface-2);
    box-shadow: inset 0 -1px 0 var(--line);
  }
  .theme-card__img {
    position: absolute;
    left: 50%;
    width: 78%;
    height: auto;
    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
    box-shadow: var(--shadow-shot);
    background: var(--capture-bg);
    transform-origin: 50% 0;
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .theme-card__img--0 {
    top: 16%;
    transform: translateX(-50%);
  }
  .theme-card__img--1 {
    top: 10.5%;
    transform: translateX(-50%) scale(0.92);
    opacity: 0.85;
  }
  .theme-card__img--2 {
    top: 5.5%;
    transform: translateX(-50%) scale(0.84);
    opacity: 0.65;
  }
  .theme-card:hover .theme-card__img--0 {
    transform: translateX(-50%) translateY(-2px);
  }
  .theme-card:hover .theme-card__img--1 {
    transform: translateX(-50%) translateY(-5px) scale(0.92);
  }
  .theme-card:hover .theme-card__img--2 {
    transform: translateX(-50%) translateY(-8px) scale(0.84);
  }
  /* Desktop + mobile pair: desktop shifted left, phone overlapping at the bottom right. */
  .theme-card__well--pair .theme-card__img--0 {
    left: 8%;
    width: 70%;
    transform: none;
  }
  .theme-card:hover .theme-card__well--pair .theme-card__img--0 {
    transform: translateY(-3px);
  }
  .theme-card__mobile {
    position: absolute;
    right: 8%;
    top: 28%;
    width: 21%;
    height: auto;
    border-radius: 10px 10px 0 0;
    box-shadow: var(--shadow-shot), var(--shadow-md);
    background: var(--capture-bg);
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .theme-card:hover .theme-card__mobile {
    transform: translateY(-6px);
  }
  .theme-card__none {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--ink-3);
    font-size: var(--text-sm);
  }
  .theme-card__body {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4) 0;
  }
  .theme-card__text {
    min-width: 0;
  }
  .theme-card__name {
    font-size: var(--text-body);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.015em;
    line-height: 1.3;
  }
  .theme-card__meta {
    margin-top: 1px;
    color: var(--ink-3);
    font-size: var(--text-sm);
  }
  .theme-card__body :global(.badge) {
    margin-top: 1px;
  }
  .theme-card__count {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin-top: auto;
    padding: var(--space-3) var(--space-4) var(--space-4);
    color: var(--ink-3);
    font-size: var(--text-xs);
  }
  .theme-card__count-n {
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
  }
</style>
