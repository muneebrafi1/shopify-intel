---
/**
 * A theme as a small deck of real stores: the front capture plus up to two more peeking
 * behind it. Says "this theme on several stores" without words.
 */
import { thumbCropHeight, thumbUrl } from '~/lib/media';

interface ShotRef {
  src: string;
  width: number;
  height: number;
  alt?: string;
  device?: 'desktop' | 'mobile';
}
interface Props {
  slug: string;
  name: string;
  vendor: string;
  priceLabel: string;
  storesCount: number;
  shots: ShotRef[];
  href?: string;
  eager?: boolean;
  class?: string;
}
const { slug, name, vendor, priceLabel, storesCount, shots, href = `/themes/${slug}`, eager = false, class: className } =
  Astro.props;
const desktops = shots.filter((s) => (s.device ?? 'desktop') === 'desktop');
const mobile = shots.find((s) => s.device === 'mobile');
const deck = desktops.slice(0, 3).map((s) => {
  const h = thumbCropHeight(s.width, s.height, 'desktop');
  return { ...s, thumb: thumbUrl(s.src, { cropHeight: h, width: 640 }), cropH: h };
});
// One store only: pair its desktop and mobile home pages instead of a lonely single capture.
const pair = deck.length < 2 && mobile
  ? (() => {
      const h = thumbCropHeight(mobile.width, mobile.height, 'mobile');
      return { ...mobile, thumb: thumbUrl(mobile.src, { cropHeight: h, width: 240 }), cropH: h };
    })()
  : null;
// Front card last in the DOM so it paints on top.
const ordered = [...deck].reverse();
---

<article class:list={['theme-card', className]}>
  <a href={href} class:list={['theme-card__well', { 'theme-card__well--pair': !!pair }]} aria-label={`${name} theme`}>
    {
      deck.length === 0 ? (
        <span class="theme-card__none">No captured stores yet</span>
      ) : (
        ordered.map((s, i) => (
          <img
            class={`theme-card__img theme-card__img--${deck.length - 1 - i}`}
            src={s.thumb}
            alt={i === ordered.length - 1 ? (s.alt ?? `${name} on a live store`) : ''}
            width={s.width}
            height={s.cropH}
            loading={eager ? 'eager' : 'lazy'}
            decoding="async"
          />
        ))
      )
    }
    {
      pair && (
        <img
          class="theme-card__mobile"
          src={pair.thumb}
          alt=""
          width={pair.width}
          height={pair.cropH}
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
        />
      )
    }
  </a>
  <div class="theme-card__caption">
    <div class="theme-card__text">
      <h3 class="theme-card__name display"><a href={href}>{name}</a></h3>
      <p class="theme-card__meta">{vendor} · {priceLabel}</p>
    </div>
    <p class="theme-card__count">
      <span class="theme-card__count-n">{storesCount.toLocaleString('en-US')}</span>
      <span class="theme-card__count-l">{storesCount === 1 ? 'store' : 'stores'}</span>
    </p>
  </div>
</article>

<style>
  .theme-card {
    min-width: 0;
  }
  .theme-card__well {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--tile);
    transition: background-color var(--dur-base) var(--ease-out);
  }
  .theme-card__well:hover {
    background: var(--tile-hover);
  }
  .theme-card__img {
    position: absolute;
    left: 50%;
    width: 80%;
    height: auto;
    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
    box-shadow: var(--shadow-shot);
    background: var(--surface);
    transform-origin: 50% 0;
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .theme-card__img--0 {
    top: 14%;
    transform: translateX(-50%);
  }
  .theme-card__img--1 {
    top: 9%;
    transform: translateX(-50%) scale(0.92);
    opacity: 0.9;
  }
  .theme-card__img--2 {
    top: 4.5%;
    transform: translateX(-50%) scale(0.84);
    opacity: 0.75;
  }
  .theme-card__well:hover .theme-card__img--1 {
    transform: translateX(-50%) translateY(-4px) scale(0.92);
  }
  .theme-card__well:hover .theme-card__img--2 {
    transform: translateX(-50%) translateY(-8px) scale(0.84);
  }
  /* Desktop + mobile pair: desktop shifted left, phone overlapping at the bottom right. */
  .theme-card__well--pair .theme-card__img--0 {
    left: 7%;
    width: 72%;
    transform: none;
  }
  .theme-card__well--pair:hover .theme-card__img--0 {
    transform: translateY(-3px);
  }
  .theme-card__mobile {
    position: absolute;
    right: 7%;
    top: 26%;
    width: 22%;
    height: auto;
    border-radius: 10px 10px 0 0;
    box-shadow:
      0 0 0 1px rgb(25 24 22 / 0.08),
      0 10px 24px rgb(25 24 22 / 0.16);
    background: var(--surface);
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .theme-card__well--pair:hover .theme-card__mobile {
    transform: translateY(-6px);
  }
  .theme-card__none {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--ink-3);
    font-size: var(--text-sm);
  }
  .theme-card__caption {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }
  .theme-card__text {
    min-width: 0;
  }
  .theme-card__name {
    font-size: var(--text-2xl);
    line-height: 1.05;
  }
  .theme-card__meta {
    margin-top: 4px;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .theme-card__count {
    display: flex;
    flex: none;
    flex-direction: column;
    align-items: flex-end;
  }
  .theme-card__count-n {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    line-height: 1.05;
    font-variant-numeric: lining-nums tabular-nums;
  }
  .theme-card__count-l {
    margin-top: 4px;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
</style>
