---
/** Column header + list wrapper for <AppRow>. */
interface Props {
  ranked?: boolean;
  usageLabel?: string;
  class?: string;
}
const { ranked = true, usageLabel = 'Stores', class: className } = Astro.props;
---

<div class:list={['app-table', { 'app-table--ranked': ranked }, className]}>
  <div class="app-table__head" aria-hidden="true">
    <span>#</span><span></span><span>App</span><span>Rating</span><span>Price from</span><span>{usageLabel}</span>
  </div>
  <ol class="app-table__list">
    <slot />
  </ol>
</div>

<style>
  .app-table__head {
    display: none;
  }
  .app-table__list {
    border-top: 1px solid var(--line);
  }
  @media (min-width: 768px) {
    .app-table__head {
      display: grid;
      grid-template-columns: 28px 36px minmax(0, 1fr) 150px 110px 96px;
      column-gap: var(--space-4);
      padding: 0 0 var(--space-2);
      color: var(--ink-3);
      font-size: var(--text-xs);
      font-weight: var(--weight-medium);
    }
    .app-table__head span:first-child,
    .app-table__head span:last-child {
      text-align: right;
    }
    .app-table:not(.app-table--ranked) .app-table__head span:first-child {
      visibility: hidden;
    }
  }
</style>
