---
/**
 * "Save to board" — a Pro feature. Links to /account/save with the item and this page as
 * `back`; signed-out visitors go through sign-in first (middleware), Free users see the Pro note.
 * A plain link keeps public pages user-agnostic (CDN-cacheable).
 */
import Button from '~/components/ui/Button.astro';
import { PRO_ENABLED } from '~/config/flags';

interface Props {
  itemType: 'screenshot' | 'section' | 'store' | 'theme' | 'app';
  itemId: string | number;
  size?: 'sm' | 'md';
  iconOnly?: boolean;
  class?: string;
}
const { itemType, itemId, size = 'sm', iconOnly = false, class: className } = Astro.props;
const href = `/account/save?item=${encodeURIComponent(`${itemType}:${itemId}`)}&back=${encodeURIComponent(Astro.url.pathname)}`;
---

{PRO_ENABLED &&
  (iconOnly ? (
    <Button
      href={href}
      variant="secondary"
      size={size}
      icon="bookmark-simple"
      label="Save to board"
      class={className}
      rel="nofollow"
    />
  ) : (
    <Button
      href={href}
      variant="secondary"
      size={size}
      icon="bookmark-simple"
      class={className}
      rel="nofollow"
    >
      Save
    </Button>
  ))}
