---
/**
 * "Save to board" — a Pro feature. Until accounts exist it links to sign-in with the item
 * encoded, so wiring it later needs no UI change.
 */
import Button from '~/components/ui/Button.astro';

interface Props {
  itemType: 'screenshot' | 'section' | 'store' | 'theme' | 'app';
  itemId: string | number;
  size?: 'sm' | 'md';
  iconOnly?: boolean;
  class?: string;
}
const { itemType, itemId, size = 'sm', iconOnly = false, class: className } = Astro.props;
const href = `/sign-in?next=${encodeURIComponent(`/account/boards?save=${itemType}:${itemId}`)}`;
---

{
  iconOnly ? (
    <Button href={href} variant="secondary" size={size} icon="bookmark-simple" label="Save to board" class={className} rel="nofollow" />
  ) : (
    <Button href={href} variant="secondary" size={size} icon="bookmark-simple" class={className} rel="nofollow">
      Save
    </Button>
  )
}
