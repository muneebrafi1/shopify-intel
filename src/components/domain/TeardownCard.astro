---
/**
 * A teardown as a v2 card: capture well (16:10), a mono kicker (store · date), the title and
 * the dek. size="lg" for the lead story. One link (stretched title).
 */
import Shot from '~/components/media/Shot.astro';
import { formatDate } from '~/lib/format';

interface Props {
  slug: string;
  title: string;
  dek?: string | null;
  storeLabel: string;
  publishedAt?: string | null;
  shot?: { src: string; width: number; height: number } | null;
  size?: 'md' | 'lg';
  isSample?: boolean;
  class?: string;
}
const {
  slug,
  title,
  dek,
  storeLabel,
  publishedAt,
  shot,
  size = 'md',
  isSample = false,
  class: className,
} = Astro.props;
const href = `/teardowns/${slug}`;
---

<article class:list={['td-card', `td-card--${size}`, className]}>
  {shot && (
    <div class="td-card__media">
      <Shot
        src={shot.src}
        width={shot.width}
        height={shot.height}
        device="desktop"
        alt={`${storeLabel} home page`}
        ratio="16 / 10"
        flush
      />
    </div>
  )}
  <div class="td-card__body">
    <p class="td-card__kicker">
      Teardown · {storeLabel}
      {publishedAt && (
        <>
          {' '}
          · <span class="num">{formatDate(publishedAt)}</span>
        </>
      )}
      {isSample && <> · Sample</>}
    </p>
    <h3 class="td-card__title">
      <a href={href} class="stretched-link">
        {title}
      </a>
    </h3>
    {dek && <p class="td-card__dek">{dek}</p>}
  </div>
</article>

<style>
  .td-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    border-radius: var(--radius-card);
    background: var(--surface);
    box-shadow:
      inset 0 0 0 1px var(--line),
      var(--shadow-xs),
      var(--highlight);
    transition:
      box-shadow var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }
  .td-card:hover {
    box-shadow:
      inset 0 0 0 1px var(--line-strong),
      var(--shadow-md),
      var(--highlight);
    transform: translateY(-2px);
  }
  .td-card:hover :global(.shot__img) {
    transform: translateX(-50%) translateY(-3px);
  }
  .td-card:has(.stretched-link:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .td-card .stretched-link:focus-visible {
    outline: none;
  }
  .td-card__media {
    overflow: hidden;
    border-radius: var(--radius-card) var(--radius-card) 0 0;
    background: var(--surface-2);
    box-shadow: inset 0 -1px 0 var(--line);
  }
  .td-card__body {
    padding: var(--space-4) var(--space-5) var(--space-5);
  }
  .td-card__kicker {
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
  }
  .td-card__title {
    margin-top: var(--space-2);
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.02em;
    line-height: 1.3;
  }
  .td-card--lg .td-card__title {
    font-size: var(--text-h2);
    letter-spacing: -0.025em;
    line-height: 1.15;
  }
  .td-card__dek {
    margin-top: var(--space-2);
    color: var(--ink-2);
    font-size: var(--text-ui);
    line-height: var(--leading-normal);
  }
</style>
