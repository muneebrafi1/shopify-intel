---
/**
 * A sliced section as a v2 card: the crop in a --surface-2 well (a link to the section page),
 * then the store, a meta line ("Prestige · Product page") and the app that renders it.
 */
import SectionCrop from '~/components/media/SectionCrop.astro';
import AppIcon from '~/components/ui/AppIcon.astro';
import type { Device } from '~/lib/taxonomy';

interface Props {
  href: string;
  crop: { src: string; width: number; height: number };
  device: Device;
  typeName: string;
  storeLabel: string;
  /** e.g. "Prestige · Product page" */
  meta?: string;
  app?: { name: string; iconUrl?: string | null } | null;
  eager?: boolean;
  class?: string;
}
const {
  href,
  crop,
  device,
  typeName,
  storeLabel,
  meta,
  app,
  eager,
  class: className,
} = Astro.props;
---

<article class:list={['section-card', className]}>
  <SectionCrop
    src={crop.src}
    width={crop.width}
    height={crop.height}
    device={device}
    alt={`${typeName} section on ${storeLabel} (${device})`}
    href={href}
    eager={eager}
  />
  <div class="section-card__caption">
    <div class="section-card__text">
      <h3 class="section-card__title">
        <a href={href}>{storeLabel}</a>
      </h3>
      <p class="section-card__meta">{meta ?? typeName}</p>
    </div>
    {app && (
      <span class="section-card__app" title={`Rendered by ${app.name}`}>
        <AppIcon src={app.iconUrl} name={app.name} size={20} />
      </span>
    )}
  </div>
</article>

<style>
  .section-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    border-radius: var(--radius-card);
    background: var(--surface);
    box-shadow:
      inset 0 0 0 1px var(--line),
      var(--shadow-xs),
      var(--highlight);
    transition:
      box-shadow var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }
  .section-card:hover {
    box-shadow:
      inset 0 0 0 1px var(--line-strong),
      var(--shadow-md),
      var(--highlight);
    transform: translateY(-2px);
  }
  .section-card :global(.crop) {
    border-radius: var(--radius-card) var(--radius-card) 0 0;
    box-shadow: inset 0 -1px 0 var(--line);
  }
  .section-card__caption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4) var(--space-4);
  }
  .section-card__text {
    min-width: 0;
  }
  .section-card__title {
    font-size: var(--text-ui);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .section-card__title a:hover {
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
  }
  .section-card__meta {
    margin-top: 1px;
    color: var(--ink-3);
    font-size: var(--text-sm);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .section-card__app {
    flex: none;
  }
</style>
