---
/**
 * The way into a store's teardown, under the facts card on the store page: kicker, title, dek
 * and the note count. The whole card is one link.
 */
import Icon from '~/components/ui/Icon.astro';
import { formatDate } from '~/lib/format';

interface Props {
  href: string;
  title: string;
  dek: string | null;
  isSample: boolean;
  noteCount: number;
  publishedAt: string | null;
  class?: string;
}
const { href, title, dek, isSample, noteCount, publishedAt, class: className } = Astro.props;
---

<article class:list={['stdc', className]}>
  <p class="stdc__kicker">
    Teardown{isSample ? ' · Sample' : ''}
    {publishedAt && (
      <>
        {' · '}
        <span class="num">{formatDate(publishedAt)}</span>
      </>
    )}
  </p>
  <h2 class="stdc__title">
    <a href={href} class="stretched-link">
      {title}
    </a>
  </h2>
  <p class="stdc__foot">
    <span>
      {noteCount} {noteCount === 1 ? 'note' : 'notes'} on the captures
    </span>
    <span class="stdc__read">
      Read
      <Icon name="arrow-right" size={14} />
    </span>
  </p>
</article>

<style>
  .stdc {
    position: relative;
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-card);
    background: var(--surface);
    box-shadow:
      inset 0 0 0 1px var(--line),
      var(--shadow-xs),
      var(--highlight);
    transition:
      box-shadow var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }
  .stdc:hover {
    box-shadow:
      inset 0 0 0 1px var(--line-strong),
      var(--shadow-md),
      var(--highlight);
    transform: translateY(-2px);
  }
  .stdc:has(.stretched-link:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .stdc .stretched-link:focus-visible {
    outline: none;
  }
  .stdc__kicker {
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  .stdc__title {
    margin-top: var(--space-2);
    color: var(--ink);
    font-size: var(--text-h4);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.01em;
    line-height: 1.35;
    text-wrap: balance;
  }
  .stdc__dek {
    margin-top: var(--space-1-5);
    color: var(--ink-2);
    font-size: var(--text-sm);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .stdc__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--line);
    color: var(--ink-3);
    font-size: var(--text-xs);
  }
  .stdc__read {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }
  .stdc__read :global(.icon) {
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .stdc:hover .stdc__read :global(.icon) {
    transform: translateX(2px);
  }
</style>
