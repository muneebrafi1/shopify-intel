---
/**
 * The store page's one dark moment, when the store has a teardown: the article's title in the
 * editorial serif and the way in.
 */
import MonoLabel from '~/components/ui/MonoLabel.astro';
import Icon from '~/components/ui/Icon.astro';
import { formatDate } from '~/lib/format';

interface Props {
  href: string;
  title: string;
  dek: string | null;
  isSample: boolean;
  noteCount: number;
  publishedAt: string | null;
}
const { href, title, dek, isSample, noteCount, publishedAt } = Astro.props;
---

<section class="tdband" aria-labelledby="tdband-title">
  <div class="container cols-12 tdband__grid">
    <div class="tdband__meta span-4">
      <MonoLabel as="p" class="tdband__label">Teardown{isSample ? ' · Sample' : ''}</MonoLabel>
      <p class="tdband__facts mono num">
        {`${noteCount} ${noteCount === 1 ? 'note' : 'notes'} on the plates`}{publishedAt && ` · ${formatDate(publishedAt)}`}
      </p>
    </div>
    <div class="tdband__main span-8">
      <h2 id="tdband-title" class="tdband__title display"><a href={href}>{title}</a></h2>
      {dek && <p class="tdband__dek">{dek}</p>}
      <a class="tdband__cta" href={href} aria-label={`Read the teardown: ${title}`}>
        Read the teardown
        <Icon name="arrow-right" size={16} />
      </a>
    </div>
  </div>
</section>

<style>
  .tdband {
    margin-top: var(--space-16);
    padding-block: var(--space-12);
    background: var(--inverse);
    color: var(--ink-inverse);
  }
  @media (min-width: 1024px) {
    .tdband {
      margin-top: var(--space-20);
      padding-block: var(--space-20);
    }
  }
  .tdband :global(.tdband__label) {
    color: var(--ink-inverse-2);
  }
  .tdband__facts {
    margin-top: var(--space-3);
    color: var(--ink-inverse-2);
    font-size: var(--text-2xs);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .tdband__title {
    font-size: clamp(2rem, 1.3rem + 2.8vw, 3.5rem);
    line-height: 1.04;
    text-wrap: balance;
  }
  .tdband__title a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.12em;
  }
  .tdband__dek {
    margin-top: var(--space-4);
    max-width: 56ch;
    color: var(--ink-inverse-2);
    font-size: var(--text-md);
    line-height: var(--leading-normal);
  }
  .tdband__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-6);
    padding-bottom: 3px;
    border-bottom: 1px solid var(--ink-inverse-2);
    font-weight: var(--weight-medium);
  }
  .tdband__cta:hover {
    border-color: var(--ink-inverse);
  }
</style>
