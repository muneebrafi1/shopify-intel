---
/**
 * Specimen-sheet rows: mono label on the left, value in sans on the right, an optional mono
 * source line under the value. Used in the store header and the teardown sidebar.
 */
export interface SpecRow {
  label: string;
  value: string;
  href?: string | null;
  /** Mono note under the value (source, version, date). */
  note?: string | null;
  mono?: boolean;
  muted?: boolean;
  /** Open in a new tab (official/off-site links). */
  external?: boolean;
}
interface Props {
  rows: SpecRow[];
  label?: string;
  class?: string;
}
const { rows, label, class: className } = Astro.props;
---

<dl class:list={['spec', className]} aria-label={label}>
  {rows.map((r) => (
    <div class="spec__row">
      <dt class="spec__label">{r.label}</dt>
      <dd
        class:list={['spec__value', { 'spec__value--mono': r.mono, 'spec__value--muted': r.muted }]}
      >
        {r.href ? (
          <a
            href={r.href}
            class="spec__link"
            target={r.external ? '_blank' : undefined}
            rel={r.external ? 'noopener' : undefined}
          >
            {r.value}
          </a>
        ) : (
          <span>{r.value}</span>
        )}
        {r.note && <span class="spec__note">{r.note}</span>}
      </dd>
    </div>
  ))}
</dl>

<style>
  .spec {
    border-top: 1px solid var(--ink);
  }
  .spec__row {
    display: grid;
    grid-template-columns: minmax(96px, 0.8fr) minmax(0, 1.4fr);
    gap: var(--space-4);
    align-items: baseline;
    padding: 9px 0;
    border-bottom: 1px solid var(--line);
  }
  .spec__label {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .spec__value {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    color: var(--ink);
    font-size: var(--text-sm);
    text-align: right;
    overflow-wrap: anywhere;
  }
  .spec__value--mono {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.01em;
  }
  .spec__value--muted {
    color: var(--ink-3);
  }
  .spec__link {
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.22em;
    text-decoration-thickness: 1px;
    transition: text-decoration-color var(--dur-fast) var(--ease-out);
  }
  .spec__link:hover {
    text-decoration-color: currentColor;
  }
  /* Small screens: two columns of label-over-value cells, so the sheet stays short. */
  @media (max-width: 639px) {
    .spec {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-4);
    }
    .spec__row {
      grid-template-columns: minmax(0, 1fr);
      gap: 3px;
      align-content: start;
    }
    .spec__value {
      text-align: left;
    }
  }
  .spec__note {
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.02em;
  }
</style>
