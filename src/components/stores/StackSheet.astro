---
/**
 * A store's detected stack as a grouped list in a card: the theme first, then the apps by
 * category, each with where it renders on this store's captures (linking into the viewer at
 * that section), then detections we have no profile for yet and tracking pixels.
 */
import AppIcon from '~/components/ui/AppIcon.astro';
import Icon from '~/components/ui/Icon.astro';
import Badge from '~/components/ui/Badge.astro';
import type { StoreDetail } from '~/server/api/v1/types';
import { formatDate } from '~/lib/format';
import { plateHref } from './plates';

interface Props {
  detail: StoreDetail;
  basePath: string;
  class?: string;
}
const { detail, basePath, class: className } = Astro.props;
const { apps, pixels, pages, theme } = detail;
const hasPlates = pages.length > 0;

interface Placement {
  type: string;
  typeSlug: string;
  page: string;
  pageSlug: string;
  device: 'desktop' | 'mobile';
  id: number;
}
// Where each app renders on the plates (desktop first; one entry per section type + page).
const placements = new Map<string, Placement[]>();
for (const device of ['desktop', 'mobile'] as const) {
  for (const p of pages) {
    for (const s of p.screenshots[device]?.sections ?? []) {
      if (!s.app) continue;
      const list = placements.get(s.app.slug) ?? [];
      if (!list.some((x) => x.typeSlug === s.type.slug && x.pageSlug === p.page_type.slug)) {
        list.push({
          type: s.type.name,
          typeSlug: s.type.slug,
          page: p.page_type.name,
          pageSlug: p.page_type.slug,
          device,
          id: s.id,
        });
      }
      placements.set(s.app.slug, list);
    }
  }
}
// Which app holds each section type on this store (for "attributed to …").
const holder = new Map<string, string>();
for (const g of apps.groups)
  for (const a of g.apps)
    for (const s of a.seen_in) if (!holder.has(s.slug)) holder.set(s.slug, a.short_name);

type Where =
  { kind: 'link'; items: { label: string; href: string }[] } | { kind: 'text'; text: string };
const whereFor = (a: StoreDetail['apps']['groups'][number]['apps'][number]): Where => {
  const placed = placements.get(a.slug) ?? [];
  if (placed.length) {
    return {
      kind: 'link',
      items: placed.slice(0, 2).map((x) => ({
        label: `${x.type} on the ${x.page.toLowerCase()} page`,
        href: plateHref(basePath, x.pageSlug, x.device, `#section-${x.id}`),
      })),
    };
  }
  const surface = a.surfaces[0];
  if (!surface) return { kind: 'text', text: 'Not sliced as a section' };
  const name = surface.name.toLowerCase();
  if (!hasPlates) return { kind: 'text', text: `Usually renders in the ${name}` };
  const other = holder.get(surface.slug);
  if (other && other !== a.short_name)
    return { kind: 'text', text: `${surface.name}: attributed to ${other}` };
  return { kind: 'text', text: `Usually in the ${name}, not on this plan` };
};

const themeInfo = theme.current;
const replaced = theme.history.filter((h) => h.replaced_at);
---

<div class:list={['stack', className]}>
  <div class="stack__group">
    <p class="stack__cat">Theme</p>
    <ul class="stack__apps">
      <li class="stack__app">
        <span class="stack__name">
          <span class="stack__glyph" aria-hidden="true">
            <Icon name="paint-brush" size={14} />
          </span>
          {themeInfo.theme ? (
            <a href={themeInfo.theme.href} class="stack__label">
              {themeInfo.theme.name}
            </a>
          ) : (
            <span class:list={['stack__label', { stack__muted: !themeInfo.name }]}>
              {themeInfo.name ?? themeInfo.label}
            </span>
          )}
          {themeInfo.version && <span class="stack__version mono">{themeInfo.version}</span>}
        </span>
        <span class="stack__where">
          <span class="stack__muted">
            {themeInfo.theme?.vendor
              ? `By ${themeInfo.theme.vendor}`
              : themeInfo.is_custom
                ? 'Custom theme'
                : themeInfo.name
                  ? 'No theme profile yet'
                  : 'Not detected on this scan'}
            {replaced.length > 0 && ` · replaced ${replaced.length}×`}
          </span>
        </span>
      </li>
    </ul>
  </div>

  {apps.groups.map((g) => (
    <div class="stack__group">
      <p class="stack__cat">
        {g.category ? <a href={g.category.href}>{g.category.name}</a> : 'Other'}
        <span class="stack__count num">{g.apps.length}</span>
      </p>
      <ul class="stack__apps">
        {g.apps.map((a) => {
          const where = whereFor(a);
          return (
            <li class="stack__app">
              <a class="stack__name" href={a.href} title={a.name}>
                <AppIcon src={a.icon_url} name={a.short_name} size={24} />
                <span class="stack__label">{a.short_name}</span>
              </a>
              <span class="stack__where">
                {where.kind === 'link' ? (
                  where.items.map((w) => (
                    <a href={w.href} class="stack__jump">
                      {w.label}
                      <Icon name="arrow-right" size={12} />
                    </a>
                  ))
                ) : (
                  <span class="stack__muted">{where.text}</span>
                )}
              </span>
            </li>
          );
        })}
      </ul>
    </div>
  ))}

  {apps.unresolved.count > 0 && (
    <div class="stack__group">
      <p class="stack__cat">
        Unresolved
        <span class="stack__count num">{apps.unresolved.count}</span>
      </p>
      <div class="stack__body">
        <p class="stack__lead">
          {apps.unresolved.count === 1 ? 'A detection' : `${apps.unresolved.count} detections`}{' '}
          without an app profile yet
        </p>
        <p class="stack__slugs">
          {apps.unresolved.slugs.map((slug) => (
            <Badge tone="outline" size="sm" mono>
              {slug}
            </Badge>
          ))}
        </p>
      </div>
    </div>
  )}

  <div class="stack__group">
    <p class="stack__cat">
      Tracking pixels
      {pixels.length > 0 && <span class="stack__count num">{pixels.length}</span>}
    </p>
    <div class="stack__body">
      {pixels.length ? (
        <p class="stack__slugs">
          {pixels.map((p) => (
            <Badge tone="neutral" size="sm">
              {p.name}
            </Badge>
          ))}
        </p>
      ) : (
        <p class="stack__muted">No tracking pixels detected</p>
      )}
    </div>
  </div>
  <p class="stack__foot">
    Detected <span class="num">{formatDate(detail.detection.last_seen)}</span> · rules{' '}
    <span class="mono">{detail.detection.rules_version ?? 'unknown'}</span>
  </p>
</div>

<style>
  .stack {
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--surface);
    box-shadow:
      inset 0 0 0 1px var(--line),
      var(--shadow-xs),
      var(--highlight);
  }
  .stack__group + .stack__group {
    border-top: 1px solid var(--line);
  }
  .stack__cat {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    height: 34px;
    padding: 0 var(--space-4);
    border-bottom: 1px solid var(--line);
    background: var(--bg-subtle);
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-eyebrow, 0.06em);
    text-transform: uppercase;
  }
  .stack__cat a {
    transition: color var(--dur-fast) var(--ease-out);
  }
  .stack__cat a:hover {
    color: var(--ink);
  }
  .stack__count {
    color: var(--ink-3);
    opacity: 0.8;
  }
  .stack__app {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-1);
    padding: var(--space-3) var(--space-4);
  }
  .stack__app + .stack__app {
    border-top: 1px solid var(--line);
  }
  @media (min-width: 640px) {
    .stack__app {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      align-items: center;
      gap: var(--space-4);
      min-height: 52px;
      padding-block: var(--space-2);
    }
  }
  .stack__name {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-width: 0;
    color: var(--ink);
    font-size: var(--text-ui);
    font-weight: var(--weight-medium);
  }
  .stack__label {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  a.stack__name:hover .stack__label,
  .stack__name a:hover {
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
  .stack__version {
    color: var(--ink-3);
    font-size: var(--text-xs);
    font-weight: 400;
  }
  .stack__glyph {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 24px;
    height: 24px;
    border-radius: 6px;
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--line);
    color: var(--ink-2);
  }
  .stack__where {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-2);
    padding-left: 36px;
    color: var(--ink-2);
    font-size: var(--text-sm);
  }
  @media (min-width: 640px) {
    .stack__where {
      padding-left: 0;
    }
  }
  .stack__jump {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-height: 26px;
    padding: 0 var(--space-2);
    border-radius: var(--radius-pill);
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--line);
    color: var(--ink);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    transition:
      box-shadow var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }
  .stack__jump:hover {
    background: var(--accent-soft);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 40%, transparent);
  }
  .stack__jump :global(.icon) {
    color: var(--ink-3);
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .stack__jump:hover :global(.icon) {
    color: var(--accent-text);
    transform: translateX(2px);
  }
  .stack__muted {
    color: var(--ink-3);
  }
  .stack__body {
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-sm);
  }
  .stack__lead {
    color: var(--ink-2);
  }
  .stack__slugs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1-5);
    margin-top: var(--space-2);
  }
  .stack__body > .stack__slugs:first-child {
    margin-top: 0;
  }
  .stack__foot {
    padding: var(--space-3) var(--space-4);
    border-top: 1px solid var(--line);
    background: var(--bg-subtle);
    color: var(--ink-3);
    font-size: var(--text-xs);
  }
</style>
