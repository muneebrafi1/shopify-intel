---
/**
 * The store page hero: page-type tabs (with section counts) + desktop/mobile toggle, a contact
 * strip of every plate, and the selected capture full size in the shared <FullPage> viewer
 * (sections rail, outlines, crop marks). Only the selected capture is rendered full size; the
 * strip requests the top slice of each plate. State is the URL (?page=&device=), so every plate
 * has a shareable link and works without JS.
 */
import Tabs from '~/components/ui/Tabs.astro';
import Segmented from '~/components/ui/Segmented.astro';
import MonoLabel from '~/components/ui/MonoLabel.astro';
import Shot from '~/components/media/Shot.astro';
import FullPage, { type FullPageSection } from '~/components/media/FullPage.astro';
import type { ScreenshotDetail, StorePage } from '~/server/api/v1/types';
import type { Device } from '~/lib/taxonomy';
import { formatCount, formatDate } from '~/lib/format';
import { plateHref } from './plates';

interface Props {
  basePath: string;
  storeLabel: string;
  pages: StorePage[];
  page: string;
  device: Device;
}
const { basePath, storeLabel, pages, page, device } = Astro.props;

const current = pages.find((p) => p.page_type.slug === page) ?? pages[0]!;
const shot: ScreenshotDetail | null = current.screenshots[device];

// Every plate (page × device) in reading order, for the contact strip and "Plate 03/08".
const plates = pages.flatMap((p) =>
  (['desktop', 'mobile'] as const)
    .map((d) => ({ page: p, device: d, shot: p.screenshots[d] }))
    .filter((x) => x.shot !== null),
);
const plateIndex = plates.findIndex((x) => x.page.page_type.slug === current.page_type.slug && x.device === device);
const pad = (n: number) => String(n).padStart(2, '0');

const tabs = pages.map((p) => ({
  label: p.page_type.name,
  href: plateHref(basePath, p.page_type.slug, device, '#plates'),
  selected: p.page_type.slug === current.page_type.slug,
  count: p.screenshots[device]?.sections.length ?? p.screenshots.desktop?.sections.length ?? null,
}));
const hasMobile = pages.some((p) => p.screenshots.mobile);
const hasDesktop = pages.some((p) => p.screenshots.desktop);

const sections: FullPageSection[] = shot
  ? [...shot.sections]
      .sort((a, b) => a.order_index - b.order_index)
      .map((s) => ({
        id: s.id,
        type: s.type.slug,
        name: s.type.name,
        y: s.rect.y,
        height: s.rect.h,
        x: s.rect.x,
        w: s.rect.w,
        app: s.app ? { name: s.app.short_name, slug: s.app.slug, iconUrl: s.app.icon_url } : null,
        href: s.href,
      }))
  : [];
const deviceName = device === 'desktop' ? 'Desktop' : 'Mobile';
---

<section id="plates" class="plates" aria-label="Pages">
  <div class="plates__bar">
    <Tabs items={tabs} label="Page type" class="plates__tabs" />
    {
      hasDesktop && hasMobile && (
        <Segmented
          label="Device"
          size="sm"
          class="plates__device"
          items={[
            {
              label: 'Desktop',
              value: 'desktop',
              icon: 'desktop',
              href: plateHref(basePath, current.page_type.slug, 'desktop', '#plates'),
              selected: device === 'desktop',
            },
            {
              label: 'Mobile',
              value: 'mobile',
              icon: 'device-mobile',
              href: plateHref(basePath, current.page_type.slug, 'mobile', '#plates'),
              selected: device === 'mobile',
            },
          ]}
        />
      )
    }
  </div>

  <div class="plates__head">
    <div class="plates__meta">
      <p class="plates__frame mono num">
        Plate {pad(plateIndex + 1)}<span>/{pad(plates.length)}</span>
      </p>
      <p class="plates__what">{current.page_type.name} page · {deviceName}</p>
      {
        shot && (
          <p class="plates__dims mono num">
            {formatCount(shot.viewport_w)} × {formatCount(shot.height)} px · {shot.sections.length} sections
          </p>
        )
      }
      {
        shot?.is_placeholder ? (
          <div class="plates__status">
            <MonoLabel tone="accent" as="p">Layout preview — capture pending</MonoLabel>
            <p class="plates__status-note">
              Drawn from the sections we expect on this page, with each app where its category usually renders. Not a
              screenshot.
            </p>
          </div>
        ) : (
          shot?.captured_at && <MonoLabel as="p">Captured {formatDate(shot.captured_at)}</MonoLabel>
        )
      }
    </div>

    <ol class="strip" aria-label="All plates">
      {
        plates.map((x, i) => {
          const isCurrent = i === plateIndex;
          return (
            <li class:list={['strip__item', `strip__item--${x.device}`, { 'is-current': isCurrent }]}>
              <Shot
                src={x.shot!.image.src}
                width={x.shot!.width}
                height={x.shot!.height}
                device={x.device}
                ratio="1 / 1"
                alt={`${storeLabel} ${x.page.page_type.name.toLowerCase()} page, ${x.device}`}
                href={plateHref(basePath, x.page.page_type.slug, x.device, '#plates')}
                class="strip__shot"
              />
              <span class="strip__cap mono num" aria-current={isCurrent ? 'true' : undefined}>
                <span>{pad(i + 1)}</span> {x.page.page_type.name}
                <span class="strip__dev">{x.device === 'desktop' ? 'D' : 'M'}</span>
              </span>
            </li>
          );
        })
      }
    </ol>
  </div>

  {
    shot ? (
      <FullPage
        src={shot.image.src}
        width={shot.width}
        height={shot.height}
        device={device}
        alt={`${storeLabel}, ${current.page_type.name.toLowerCase()} page on ${device}${shot.is_placeholder ? ' (layout preview, not a screenshot)' : ''}`}
        sections={sections}
        eager
        class="plates__viewer"
      />
    ) : (
      <p class="plates__missing">No {device} plate for this page.</p>
    )
  }
</section>

<style>
  .plates__bar {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    border-bottom: 1px solid var(--line);
  }
  .plates__bar :global(.plates__tabs) {
    flex: 1;
    min-width: 0;
    border-bottom: 0;
  }
  .plates__bar :global(.plates__device) {
    margin-bottom: 6px;
  }

  .plates__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    padding-block: var(--space-5) var(--space-6);
  }
  @media (min-width: 1024px) {
    .plates__head {
      grid-template-columns: 248px minmax(0, 1fr);
      gap: var(--space-8);
      padding-block: var(--space-6) var(--space-8);
    }
  }

  .plates__meta {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }
  .plates__frame {
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .plates__frame span {
    color: var(--ink-3);
  }
  .plates__what {
    font-size: var(--text-xl);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-snug);
    line-height: 1.2;
  }
  .plates__dims {
    color: var(--ink-3);
    font-size: var(--text-2xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .plates__status {
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--line);
  }
  .plates__status-note {
    margin-top: 6px;
    color: var(--ink-3);
    font-size: var(--text-xs);
    line-height: var(--leading-normal);
  }

  /* Contact strip */
  .strip {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 92px;
    gap: var(--space-3);
    margin-inline: calc(var(--page-gutter) * -1);
    padding-inline: var(--page-gutter);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .strip::-webkit-scrollbar {
    display: none;
  }
  @media (min-width: 1024px) {
    .strip {
      grid-auto-flow: row;
      grid-template-columns: repeat(8, minmax(0, 1fr));
      grid-auto-columns: auto;
      margin: 0;
      padding: 0;
      overflow: visible;
      align-self: end;
    }
  }
  .strip__item {
    min-width: 0;
  }
  .strip__item :global(.strip__shot) {
    border-radius: var(--radius-md);
    box-shadow: inset 0 0 0 1px transparent;
    transition:
      box-shadow var(--dur-fast) var(--ease-out),
      background-color var(--dur-base) var(--ease-out);
  }
  .strip__item.is-current :global(.strip__shot) {
    box-shadow: inset 0 0 0 1.5px var(--ink);
    background: var(--tile-hover);
  }
  .strip__cap {
    display: flex;
    align-items: baseline;
    gap: 5px;
    margin-top: 6px;
    color: var(--ink-3);
    font-size: var(--text-2xs);
    letter-spacing: 0.03em;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
  }
  .strip__cap > span:first-child {
    color: var(--ink-4);
  }
  .strip__item.is-current .strip__cap {
    color: var(--ink);
  }
  .strip__dev {
    margin-left: auto;
    color: var(--ink-4);
  }

  .plates__missing {
    padding: var(--space-12) 0;
    color: var(--ink-3);
    text-align: center;
  }
</style>
