---
/**
 * Every detected store as numbered catalogue rows (IndexList). Curated stores float a preview
 * of their home page on hover. Paging is a cursor link that works without JS; with JS the next
 * page is fetched and appended in place ("Load more").
 */
import IndexList from '~/components/ui/IndexList.astro';
import IndexRow from '~/components/ui/IndexRow.astro';
import Button from '~/components/ui/Button.astro';
import type { StoreListItem } from '~/server/api/v1/types';
import { formatCount, formatDate } from '~/lib/format';

interface Props {
  items: StoreListItem[];
  /** Rows before this page (N° continues across pages). */
  offset: number;
  total: number;
  nextHref?: string | null;
  firstHref?: string | null;
  label?: string;
}
const { items, offset, total, nextHref, firstHref, label = 'Stores' } = Astro.props;
const from = items.length ? offset + 1 : 0;
const to = offset + items.length;
const step = Math.min(items.length, Math.max(0, total - to));
---

<div class="sindex" data-store-index>
  <IndexList
    label={label}
    columns="64px minmax(0,1.5fr) minmax(0,1.15fr) 52px 72px minmax(0,0.95fr) 108px"
    head={['N°', 'Store', 'Theme', 'Apps', 'Currency', 'Capture', 'Detected']}
  >
    {
      items.map((s, i) => (
        <IndexRow
          n={offset + i + 1}
          href={s.href}
          title={s.domain}
          subtitle={`${s.theme.label} · ${s.is_curated ? 'Layout preview' : 'Not captured'}`}
          preview={s.preview ? { ...s.preview.image, device: s.preview.device } : null}
          class:list={['sindex__row', { 'sindex__row--curated': s.is_curated }]}
          cells={[
            { value: s.theme.label, muted: !s.theme.name },
            { value: String(s.app_count), mono: true },
            { value: s.currency ?? '—', mono: true, muted: !s.currency },
            { value: s.is_curated ? 'Layout preview' : 'Not captured', muted: !s.is_curated },
            {
              value: formatDate(s.first_seen),
              mono: true,
              muted: true,
            },
            { value: `${s.app_count} ${s.app_count === 1 ? 'app' : 'apps'}`, mono: true, mobile: true },
          ]}
        />
      ))
    }
  </IndexList>

  <div class="sindex__foot" data-store-index-foot>
    <p class="mlabel">
      <span class="num">{formatCount(from)}–{formatCount(to)}</span>&nbsp;of&nbsp;<span class="num">{formatCount(total)}</span>
    </p>
    <div class="sindex__actions">
      {firstHref && <a class="sindex__first" href={firstHref} rel="nofollow">Back to the top of the list</a>}
      {
        nextHref && step > 0 && (
          <Button href={nextHref} size="sm" variant="secondary" iconRight="arrow-right" rel="nofollow" data-load-more>
            Load {step} more
          </Button>
        )
      }
    </div>
  </div>
</div>

<script>
  // Progressive "Load more": fetch the next page and append its rows to this list.
  document.querySelectorAll<HTMLElement>('[data-store-index]').forEach((root) => {
    root.addEventListener('click', async (event) => {
      const link = (event.target as HTMLElement).closest<HTMLAnchorElement>('a[data-load-more]');
      if (!link || event.metaKey || event.ctrlKey || event.shiftKey) return;
      event.preventDefault();
      link.setAttribute('aria-busy', 'true');
      try {
        const res = await fetch(link.href, { headers: { Accept: 'text/html' } });
        if (!res.ok) throw new Error(String(res.status));
        const doc = new DOMParser().parseFromString(await res.text(), 'text/html');
        const next = doc.querySelector<HTMLElement>('[data-store-index]');
        const list = root.querySelector('ol');
        if (!next || !list) throw new Error('missing list');
        next.querySelectorAll('ol > li').forEach((li) => list.append(document.importNode(li, true)));
        const foot = root.querySelector('[data-store-index-foot]');
        const nextFoot = next.querySelector('[data-store-index-foot]');
        const range = foot?.querySelector('.num');
        if (foot && nextFoot) {
          // Keep the running range ("1–120 of 930"), take the new load-more link.
          const start = range?.textContent?.split('–')[0] ?? '1';
          foot.replaceWith(document.importNode(nextFoot, true));
          const fresh = root.querySelector('[data-store-index-foot] .num');
          if (fresh) fresh.textContent = `${start}–${fresh.textContent?.split('–')[1] ?? ''}`;
          root.querySelector('[data-store-index-foot] .sindex__first')?.remove();
        }
      } catch {
        window.location.href = link.href;
      }
    });
  });
</script>

<style>
  .sindex :global(.sindex__row--curated .irow__name)::after {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-left: 8px;
    vertical-align: 0.2em;
    background: var(--accent);
  }
  .sindex__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-top: var(--space-5);
  }
  .sindex__actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .sindex__first {
    color: var(--ink-2);
    font-size: var(--text-sm);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
  }
  .sindex__foot :global([aria-busy='true']) {
    opacity: 0.6;
    pointer-events: none;
  }
</style>
