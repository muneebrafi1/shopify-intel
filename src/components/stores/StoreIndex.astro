---
/**
 * The stores table with paging. Paging is a cursor link that works without JS ("?cursor=…&p=2");
 * with JS the next page is fetched and its rows appended in place ("Load more"). Row numbers
 * continue across pages.
 */
import Button from '~/components/ui/Button.astro';
import StoreTable from './StoreTable.astro';
import type { StoreListItem } from '~/server/api/v1/types';
import { formatCount } from '~/lib/format';

interface Props {
  items: StoreListItem[];
  /** Rows before this page. */
  offset: number;
  total: number;
  nextHref?: string | null;
  firstHref?: string | null;
  label?: string;
  markCurated?: boolean;
}
const {
  items,
  offset,
  total,
  nextHref,
  firstHref,
  label = 'Stores',
  markCurated = false,
} = Astro.props;
const from = items.length ? offset + 1 : 0;
const to = offset + items.length;
const step = Math.min(items.length, Math.max(0, total - to));
---

<div class="sindex" data-store-index>
  <StoreTable
    rows={items.map((store) => ({ store }))}
    label={label}
    offset={offset}
    numbered
    markCurated={markCurated}
  />

  <div class="sindex__foot" data-store-index-foot>
    <p class="sindex__range">
      Showing{' '}
      <span class="num" data-range>
        {formatCount(from)}–{formatCount(to)}
      </span>{' '}
      of <span class="num">{formatCount(total)}</span>
    </p>
    <div class="sindex__actions">
      {firstHref && (
        <a class="sindex__first" href={firstHref} rel="nofollow">
          Back to the start
        </a>
      )}
      {nextHref && step > 0 && (
        <Button
          href={nextHref}
          size="md"
          variant="secondary"
          iconRight="arrow-right"
          rel="nofollow"
          data-load-more
        >
          Load {step} more
        </Button>
      )}
    </div>
  </div>
</div>

<script>
  // Progressive "Load more": fetch the next page and append its rows to this table.
  document.querySelectorAll<HTMLElement>('[data-store-index]').forEach((root) => {
    root.addEventListener('click', async (event) => {
      const link = (event.target as HTMLElement).closest<HTMLAnchorElement>('a[data-load-more]');
      if (!link || event.metaKey || event.ctrlKey || event.shiftKey) return;
      event.preventDefault();
      link.setAttribute('aria-busy', 'true');
      try {
        const res = await fetch(link.href, { headers: { Accept: 'text/html' } });
        if (!res.ok) throw new Error(String(res.status));
        const doc = new DOMParser().parseFromString(await res.text(), 'text/html');
        const next = doc.querySelector<HTMLElement>('[data-store-index]');
        const body = root.querySelector('tbody');
        if (!next || !body) throw new Error('missing table');
        next
          .querySelectorAll('tbody > tr')
          .forEach((tr) => body.appendChild(document.importNode(tr, true)));
        const foot = root.querySelector('[data-store-index-foot]');
        const nextFoot = next.querySelector('[data-store-index-foot]');
        if (foot && nextFoot) {
          // Keep the running range ("1–120 of 930"), take the new load-more link.
          const start = foot.querySelector('[data-range]')?.textContent?.split('–')[0] ?? '1';
          foot.replaceWith(document.importNode(nextFoot, true));
          const fresh = root.querySelector('[data-store-index-foot] [data-range]');
          if (fresh)
            fresh.textContent = `${start.trim()}–${fresh.textContent?.split('–')[1] ?? ''}`;
          root.querySelector('[data-store-index-foot] .sindex__first')?.remove();
        }
      } catch {
        window.location.href = link.href;
      }
    });
  });
</script>

<style>
  .sindex__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-top: var(--space-5);
  }
  .sindex__range {
    color: var(--ink-3);
    font-size: var(--text-sm);
  }
  .sindex__range .num {
    color: var(--ink);
  }
  .sindex__actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .sindex__first {
    color: var(--ink-2);
    font-size: var(--text-sm);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
  }
  .sindex__foot :global([aria-busy='true']) {
    opacity: 0.6;
    pointer-events: none;
  }
</style>
