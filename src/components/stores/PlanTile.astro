---
/**
 * Closes a curated-stores grid row on desktop: what a curated store's capture plan is, drawn as
 * a tiny contact sheet (4 page types × 2 devices). Same footprint as a StoreCard.
 */
import { CORE_PAGE_TYPES, PAGE_TYPES } from '~/lib/taxonomy';
import { formatCount } from '~/lib/format';

interface Props {
  stores: number;
  href?: string;
  class?: string;
}
const { stores, href = '/methodology', class: className } = Astro.props;
const pages = CORE_PAGE_TYPES.map((slug) => PAGE_TYPES.find((p) => p.slug === slug)!.name);
const plates = stores * pages.length * 2;
---

<article class:list={['plan', className]} aria-label="The capture plan">
  <a class="plan__well" href={href}>
    <span class="plan__sheet" aria-hidden="true">
      {
        pages.map((name) => (
          <span class="plan__col">
            <span class="plan__frame plan__frame--desktop" />
            <span class="plan__frame plan__frame--mobile" />
            <span class="plan__name">{name}</span>
          </span>
        ))
      }
    </span>
  </a>
  <div class="plan__caption">
    <h3 class="plan__title"><a href={href}>The capture plan</a></h3>
    <p class="plan__meta">
      {pages.length} pages × 2 devices · {formatCount(plates)} plates
    </p>
  </div>
</article>

<style>
  .plan {
    min-width: 0;
  }
  .plan__well {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    border: 1px dashed var(--line-strong);
    background: var(--bg);
    transition: border-color var(--dur-base) var(--ease-out);
  }
  .plan__well:hover {
    border-color: var(--ink-3);
  }
  .plan__sheet {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 64px));
    gap: 16px;
    width: 76%;
    justify-content: center;
  }
  .plan__col {
    display: grid;
    grid-template-columns: 1fr 34%;
    grid-template-rows: auto auto;
    align-items: end;
    gap: 6px 4px;
  }
  .plan__frame {
    display: block;
    border-radius: 3px;
    background: var(--tile);
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }
  .plan__frame--desktop {
    aspect-ratio: 3 / 4;
  }
  .plan__frame--mobile {
    aspect-ratio: 9 / 16;
    border-radius: 4px;
  }
  .plan__name {
    grid-column: 1 / -1;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .plan__caption {
    margin-top: var(--space-3);
    padding-left: 28px;
  }
  .plan__title {
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
    line-height: 1.35;
  }
  .plan__meta {
    margin-top: 2px;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
</style>
