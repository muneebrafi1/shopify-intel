---
/**
 * Store page state for stores we detected but have not captured: where the viewer would be, an
 * honest empty product window (the four pages we would capture, as dashed outlines) and what we
 * do and don't have on file.
 */
import Window from '~/components/ui/Window.astro';
import Icon from '~/components/ui/Icon.astro';
import { CORE_PAGE_TYPES, PAGE_TYPES } from '~/lib/taxonomy';
import { formatDate } from '~/lib/format';

interface Props {
  domain: string;
  detectedOn: string;
  appCount: number;
  themeLabel: string;
  pixelCount: number;
}
const { domain, detectedOn, appCount, themeLabel, pixelCount } = Astro.props;
const pages = CORE_PAGE_TYPES.map((slug) => PAGE_TYPES.find((p) => p.slug === slug)!);
const onFile = [
  themeLabel,
  `${appCount} ${appCount === 1 ? 'app' : 'apps'}`,
  pixelCount ? `${pixelCount} tracking ${pixelCount === 1 ? 'pixel' : 'pixels'}` : 'no pixels',
].join(' · ');
---

<section id="not-captured" class="nc" aria-labelledby="nc-title">
  <Window url={domain} padded class="nc__window">
    <ol class="nc__pages" aria-label="Pages we capture for curated stores">
      {pages.map((p) => (
        <li class="nc__page">
          <span class="nc__frame" aria-hidden="true">
            <span class="nc__tag">{p.name}</span>
          </span>
          <span class="nc__name">{p.name}</span>
        </li>
      ))}
    </ol>
  </Window>

  <div class="nc__text">
    <h2 id="nc-title" class="nc__title">
      Not captured yet
    </h2>
    <p class="nc__body">
      We detected this store’s theme and apps on {formatDate(detectedOn)}. Pages are captured for
      curated stores first, so there are no screenshots or sections for it.
    </p>
    <dl class="nc__known">
      <div>
        <dt>On file</dt>
        <dd>{onFile}</dd>
      </div>
      <div>
        <dt>Not yet</dt>
        <dd>Home, collection and product pages on desktop and mobile, sliced into sections</dd>
      </div>
    </dl>
    <a class="nc__link" href="/methodology">
      How detection works
      <Icon name="arrow-right" size={14} />
    </a>
  </div>
</section>

<style>
  .nc {
    display: grid;
    gap: var(--space-6);
  }
  @media (min-width: 1280px) {
    .nc {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      gap: var(--space-10);
      align-items: center;
    }
  }
  .nc__pages {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-3);
  }
  @media (min-width: 640px) {
    .nc__pages {
      gap: var(--space-4);
    }
  }
  .nc__page {
    min-width: 0;
  }
  .nc__frame {
    position: relative;
    display: block;
    aspect-ratio: 3 / 4;
    border-radius: var(--radius-sm);
    border: 1.5px dashed var(--line-strong);
    background: var(--surface);
  }
  .nc__tag {
    position: absolute;
    left: 6px;
    top: 6px;
    display: none;
    height: 18px;
    padding: 0 6px;
    border-radius: var(--radius-pill);
    background: var(--surface-2);
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 18px;
  }
  @media (min-width: 640px) {
    .nc__tag {
      display: inline-block;
    }
  }
  .nc__name {
    display: block;
    margin-top: var(--space-2);
    color: var(--ink-3);
    font-size: var(--text-xs);
    text-align: center;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  @media (min-width: 640px) {
    .nc__name {
      display: none;
    }
  }

  .nc__title {
    color: var(--ink);
    font-size: var(--text-h2);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.025em;
    line-height: 1.15;
  }
  .nc__body {
    margin-top: var(--space-3);
    max-width: 48ch;
    color: var(--ink-2);
    font-size: var(--text-body);
    line-height: 1.6;
  }
  .nc__known {
    display: grid;
    margin-top: var(--space-5);
    border-top: 1px solid var(--line);
  }
  .nc__known > div {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--line);
    font-size: var(--text-sm);
  }
  .nc__known dt {
    color: var(--ink-3);
  }
  .nc__known dd {
    color: var(--ink);
  }
  .nc__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 40px;
    margin-top: var(--space-2);
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.22em;
  }
  .nc__link:hover {
    text-decoration-color: currentColor;
  }
</style>
