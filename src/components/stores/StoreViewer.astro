---
/**
 * The store page centrepiece: page-type tabs (with section counts) and a Desktop/Mobile switch
 * over a product window holding the full-page capture. Every section carries a pinned tag
 * ("02 Reviews · Loox"); the sections rail beside it (a chip row below 1024) outlines a
 * section on hover and scrolls to it on click. State is the URL (?page=&device=), so every
 * page has a shareable link and works without JS.
 */
import Tabs from '~/components/ui/Tabs.astro';
import Segmented from '~/components/ui/Segmented.astro';
import Badge from '~/components/ui/Badge.astro';
import Window from '~/components/ui/Window.astro';
import FullPage, { type FullPageSection } from '~/components/media/FullPage.astro';
import type { ScreenshotDetail, StorePage } from '~/server/api/v1/types';
import type { Device } from '~/lib/taxonomy';
import { formatCount, formatDate } from '~/lib/format';
import { plateHref } from './plates';

interface Props {
  basePath: string;
  domain: string;
  storeLabel: string;
  pages: StorePage[];
  page: string;
  device: Device;
}
const { basePath, domain, storeLabel, pages, page, device } = Astro.props;

const current = pages.find((p) => p.page_type.slug === page) ?? pages[0]!;
const shot: ScreenshotDetail | null = current.screenshots[device];

const tabs = pages.map((p) => ({
  label: p.page_type.name,
  href: plateHref(basePath, p.page_type.slug, device, '#plates'),
  selected: p.page_type.slug === current.page_type.slug,
  count: (() => {
    const n = p.screenshots[device]?.sections.length ?? p.screenshots.desktop?.sections.length ?? 0;
    return n > 0 ? n : null;
  })(),
}));
const hasMobile = pages.some((p) => p.screenshots.mobile);
const hasDesktop = pages.some((p) => p.screenshots.desktop);

const sections: FullPageSection[] = shot
  ? [...shot.sections]
      .sort((a, b) => a.order_index - b.order_index)
      .map((s) => ({
        id: s.id,
        type: s.type.slug,
        name: s.type.name,
        y: s.rect.y,
        height: s.rect.h,
        x: s.rect.x,
        w: s.rect.w,
        app: s.app ? { name: s.app.short_name, slug: s.app.slug, iconUrl: s.app.icon_url } : null,
        href: s.href,
      }))
  : [];
const withApps = sections.filter((s) => s.app).length;
const deviceName = device === 'desktop' ? 'desktop' : 'mobile';
// The window's address pill: the page's URL without the protocol, or the domain with the
// standard Shopify path for the page type.
const PATHS: Record<string, string> = {
  collection: '/collections/…',
  product: '/products/…',
  cart: '/cart',
};
const address = current.url
  ? current.url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')
  : `${domain}${PATHS[current.page_type.slug] ?? ''}`;
---

<section id="plates" class="viewer" aria-label="Pages">
  <div class="viewer__bar">
    <Tabs items={tabs} label="Page type" class="viewer__tabs" />
    {hasDesktop && hasMobile && (
      <Segmented
        label="Device"
        size="sm"
        class="viewer__device"
        items={[
          {
            label: 'Desktop',
            value: 'desktop',
            icon: 'desktop',
            href: plateHref(basePath, current.page_type.slug, 'desktop', '#plates'),
            selected: device === 'desktop',
          },
          {
            label: 'Mobile',
            value: 'mobile',
            icon: 'device-mobile',
            href: plateHref(basePath, current.page_type.slug, 'mobile', '#plates'),
            selected: device === 'mobile',
          },
        ]}
      />
    )}
  </div>

  <div class="viewer__status">
    <p class="viewer__what">
      <span class="viewer__page">{current.page_type.name} page</span>
      {shot && (
        <span class="viewer__dims mono num">
          {formatCount(shot.viewport_w)} px
          {shot.sections.length > 0 && ` · ${shot.sections.length} sections`}
          {withApps > 0 && ` · ${withApps} by apps`}
        </span>
      )}
    </p>
    {shot?.is_placeholder ? (
      <p class="viewer__state">
        <Badge tone="caution" size="sm">
          Layout preview
        </Badge>
        <span>
          Drawn from the sections we expect on this page, with apps where their category usually
          renders. Not a screenshot.
        </span>
      </p>
    ) : (
      shot?.captured_at && (
        <p class="viewer__state">
          <Badge tone="positive" size="sm" dot>
            Captured
          </Badge>
          <span class="mono num">{formatDate(shot.captured_at)}</span>
        </p>
      )
    )}
  </div>

  <Window url={address} class:list={['viewer__window', `viewer__window--${device}`]}>
    {shot ? (
      <FullPage
        src={shot.image.src}
        width={shot.width}
        height={shot.height}
        device={device}
        alt={`${storeLabel}, ${current.page_type.name.toLowerCase()} page on ${deviceName}${shot.is_placeholder ? ' (layout preview, not a screenshot)' : ''}`}
        sections={sections}
        eager
        bare
        class="viewer__fp"
      />
    ) : (
      <p class="viewer__missing">
        No {deviceName} capture planned for the {current.page_type.name.toLowerCase()} page.
      </p>
    )}
  </Window>
</section>

<style>
  .viewer {
    min-width: 0;
    scroll-margin-top: var(--header-h);
  }
  .viewer__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    box-shadow: inset 0 -1px 0 var(--line);
  }
  .viewer :global(.viewer__tabs) {
    flex: 1 1 auto;
    min-width: 0;
    box-shadow: none;
  }
  /* Small screens: tabs get the full row (they scroll sideways); the device switch sits with
     the page meta under them. */
  @media (max-width: 639px) {
    .viewer__bar {
      flex-wrap: nowrap;
      margin-inline: calc(var(--page-gutter) * -1);
      padding-inline: var(--page-gutter);
    }
    .viewer :global(.viewer__tabs) {
      gap: var(--space-5);
    }
    .viewer :global(.viewer__device .seg__item > span:not(.icon, .seg__count)) {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  .viewer__status {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-6);
    padding-block: var(--space-4);
  }
  .viewer__what {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
  }
  .viewer__page {
    color: var(--ink);
    font-size: var(--text-h4);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.01em;
  }
  .viewer__dims {
    color: var(--ink-3);
    font-size: var(--text-xs);
  }
  .viewer__state {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    max-width: 560px;
    color: var(--ink-3);
    font-size: var(--text-sm);
    line-height: 1.45;
  }
  .viewer__state :global(.badge) {
    transform: translateY(-1px);
  }

  /* The capture inside the product window: rail on --surface, capture on --surface-2. */
  .viewer :global(.viewer__fp .fp__stage) {
    padding: var(--space-3);
  }
  .viewer :global(.viewer__fp .fp__rail) {
    margin-inline: 0;
    padding: var(--space-2);
    background: var(--surface);
    box-shadow: 0 1px 0 var(--line);
  }
  .viewer :global(.viewer__fp) {
    gap: 0;
  }
  .viewer :global(.viewer__window--mobile .fp__stage) {
    padding: var(--space-5) var(--space-4);
  }
  @media (min-width: 640px) {
    .viewer :global(.viewer__fp .fp__stage) {
      padding: var(--space-6);
    }
  }
  @media (min-width: 1024px) {
    .viewer {
      --rail-w: 204px;
    }
    .viewer :global(.viewer__fp) {
      grid-template-columns: var(--rail-w) minmax(0, 1fr);
      gap: 0;
      background: linear-gradient(
        to right,
        var(--surface) var(--rail-w),
        var(--line) var(--rail-w) calc(var(--rail-w) + 1px),
        transparent calc(var(--rail-w) + 1px)
      );
    }
    .viewer :global(.viewer__fp .fp__rail) {
      top: calc(var(--header-h) + var(--space-4));
      max-height: calc(100dvh - var(--header-h) - var(--space-8));
      padding: var(--space-4) var(--space-2);
      background: none;
      box-shadow: none;
    }
    .viewer :global(.viewer__fp .fp__item[aria-current]) {
      background: var(--surface-2);
    }
    .viewer :global(.viewer__fp .fp__stage) {
      padding: var(--space-8);
    }
    .viewer :global(.viewer__window--mobile .fp__stage) {
      padding: var(--space-10) var(--space-8);
    }
  }
  @media (min-width: 1280px) {
    .viewer {
      --rail-w: 232px;
    }
  }

  .viewer__missing {
    padding: var(--space-16) var(--space-6);
    color: var(--ink-3);
    text-align: center;
  }
</style>
