---
/**
 * Similar stores (same theme / shared apps). Curated ones show their capture as StoreCards;
 * detected-only ones are rows of the stores table with a "Why similar" column, so the grid
 * never fills with empty wells. One or two cards sit beside the table on wide screens.
 */
import StoreCard from '~/components/domain/StoreCard.astro';
import StoreTable from './StoreTable.astro';
import type { SimilarStore } from '~/server/api/v1/types';
import { themeName } from './query';

interface Props {
  items: SimilarStore[];
}
const { items } = Astro.props;
const why = (s: SimilarStore) =>
  [
    s.same_theme ? 'Same theme' : null,
    s.shared_apps ? `${s.shared_apps} shared ${s.shared_apps === 1 ? 'app' : 'apps'}` : null,
  ]
    .filter(Boolean)
    .join(' · ') || 'Similar stack';
const curated = items.filter((s) => s.store.is_curated && s.store.preview);
const detected = items.filter((s) => !(s.store.is_curated && s.store.preview));
const split = detected.length > 0 && curated.length > 0 && curated.length <= 2;
---

<div
  class:list={[
    'similar',
    { 'similar--split': split, 'similar--two': split && curated.length === 2 },
  ]}
>
  {curated.length > 0 && (
    <div class="similar__cards">
      {curated.map((s) => (
        <StoreCard
          domain={s.store.domain}
          name={s.store.name}
          href={s.store.href}
          shot={
            s.store.preview ? { ...s.store.preview.image, device: s.store.preview.device } : null
          }
          meta={why(s)}
        >
          <span slot="aside" class="similar__theme">
            {themeName(s.store.theme)}
          </span>
        </StoreCard>
      ))}
    </div>
  )}
  {detected.length > 0 && (
    <StoreTable
      rows={detected.map((s) => ({ store: s.store, note: why(s) }))}
      label="Similar detected stores"
      noteLabel="Why similar"
      class="similar__table"
    />
  )}
</div>

<style>
  .similar {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-8);
  }
  .similar__cards {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
  }
  @media (min-width: 640px) {
    .similar__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .similar__cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .similar--split {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      align-items: start;
    }
    .similar--split .similar__cards {
      grid-template-columns: minmax(0, 1fr);
    }
    .similar--two {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    }
    .similar--two .similar__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .similar__theme {
    flex: none;
    max-width: 40%;
    color: var(--ink-2);
    font-size: var(--text-sm);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
