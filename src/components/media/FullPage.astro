---
/**
 * Full-page capture viewer with pinned section tags (the product's core visual).
 *
 * Left (≥1024): a sticky rail listing the page's sections in order, with the app that renders
 * each one; below 1024 it is a sticky, sideways-scrolling pill row. Right: the capture in a
 * --surface-2 well. Every section gets a pinned label pill (ink, mono 11px, "02 Reviews · App")
 * at its top-left and a dashed outline; the hovered/current one turns accent. Hovering either
 * side highlights the other, clicking a rail item scrolls to the section, scrolling marks the
 * section in view. Overlays are HTML positioned in percentages of the capture, so they work the
 * same for drawn placeholders and real captures.
 *
 * The capture area is always rendered with light tokens (data-theme="light"): store pages are
 * light, and the tags/outlines must read on them in either site theme.
 *
 * tags: 'pinned' (default) shows every label; 'hover' shows labels only on hover/current.
 * Very short sections (< 6% of the capture width tall) only show their tag on hover.
 */
import type { Device } from '~/lib/taxonomy';
import AppIcon from '~/components/ui/AppIcon.astro';
import { THUMB_TOP, captureDevice, isPlaceholderSrc, topThumbKey } from '~/lib/media';

export interface FullPageSection {
  id: string | number;
  type: string;
  name: string;
  y: number;
  height: number;
  /** Horizontal bounds for side-by-side slices (CSS px of the capture). Omit for full width. */
  x?: number | null;
  w?: number | null;
  app?: { name: string; slug: string; iconUrl?: string | null } | null;
  /** Link for the section (e.g. its page in the sections library). */
  href?: string;
}

interface Props {
  src: string;
  width: number;
  height: number;
  device: Device;
  alt: string;
  sections: FullPageSection[];
  /** Hide the rail (e.g. inside a narrow column). */
  rail?: boolean;
  /** Eager-load (when the viewer is the main content above the fold). */
  eager?: boolean;
  /** 'pinned': every section label visible; 'hover': labels on hover/current only. */
  tags?: 'pinned' | 'hover';
  /** Drop the --surface-2 well around the capture (e.g. inside a <Window>). */
  bare?: boolean;
  class?: string;
}

const {
  src,
  width,
  height,
  device,
  alt,
  sections,
  rail = true,
  eager = false,
  tags = 'pinned',
  bare = false,
  class: className,
} = Astro.props;
// Eager viewers paint the small pre-cut top of the page first (it is the LCP); the full-page
// capture loads behind it at low priority.
const poster =
  eager && captureDevice(src) && !src.endsWith('.top.webp') && !isPlaceholderSrc(src)
    ? topThumbKey(src)
    : null;
const ordered = [...sections].sort((a, b) => a.y - b.y);
const pct = (n: number) => `${((n / height) * 100).toFixed(4)}%`;
const pctX = (n: number) => `${((n / width) * 100).toFixed(4)}%`;
const regionStyle = (s: FullPageSection) => {
  const base = `top:${pct(s.y)};height:${pct(s.height)}`;
  if (s.x == null || s.w == null || s.w >= width) return base;
  return `${base};left:${pctX(s.x)};width:${pctX(s.w)};right:auto`;
};
const pad = (i: number) => String(i + 1).padStart(2, '0');
// Sections too short to carry a pinned tag without colliding with the next one (they still get
// it on hover/target). Phone pages are narrow, so the same tag covers far more of a section.
const isSmall = (s: FullPageSection) => s.height / width < (device === 'mobile' ? 0.1 : 0.06);
---

<div
  class:list={[
    'fp',
    `fp--${device}`,
    `fp--tags-${tags}`,
    { 'fp--no-rail': !rail, 'fp--bare': bare },
    className,
  ]}
  data-fullpage
>
  {rail && (
    <aside class="fp__rail" aria-label="Sections on this page">
      <p class="fp__rail-title">
        Sections <span class="num">{ordered.length}</span>
      </p>
      <ol class="fp__list">
        {ordered.map((s, i) => (
          <li>
            <a class="fp__item" href={`#section-${s.id}`} data-target={String(s.id)}>
              <span class="fp__n num">{pad(i)}</span>
              <span class="fp__name">{s.name}</span>
              {s.app && (
                <span class="fp__app" title={`Rendered by ${s.app.name}`}>
                  <AppIcon src={s.app.iconUrl} name={s.app.name} size={16} />
                  <span class="fp__app-name">{s.app.name}</span>
                </span>
              )}
            </a>
          </li>
        ))}
      </ol>
    </aside>
  )}

  <div class="fp__stage">
    <div class="fp__canvas" style={`aspect-ratio:${width} / ${height}`} data-theme="light">
      <img
        src={src}
        alt={alt}
        width={width}
        height={height}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? (poster ? 'low' : 'high') : undefined}
        decoding="async"
      />
      {poster && (
        <img
          class="fp__poster"
          src={poster}
          alt=""
          aria-hidden="true"
          width={width}
          height={Math.min(height, Math.round(width * THUMB_TOP[device]))}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      )}
      {ordered.map((s, i) => (
        <div
          class:list={['fp__region', { 'fp__region--small': isSmall(s) }]}
          id={`section-${s.id}`}
          data-region={String(s.id)}
          style={regionStyle(s)}
        >
          <span class="fp__tag">
            <span class="fp__tag-n num">{pad(i)}</span> {s.name}
            {s.app && <span class="fp__tag-app">· {s.app.name}</span>}
          </span>
        </div>
      ))}
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-fullpage]').forEach((root) => {
    const items = new Map<string, HTMLElement>();
    const regions = new Map<string, HTMLElement>();
    root
      .querySelectorAll<HTMLElement>('[data-target]')
      .forEach((el) => items.set(el.dataset.target!, el));
    root
      .querySelectorAll<HTMLElement>('[data-region]')
      .forEach((el) => regions.set(el.dataset.region!, el));

    const setHover = (id: string | null) => {
      regions.forEach((el, key) => el.classList.toggle('is-hover', key === id));
      items.forEach((el, key) => el.classList.toggle('is-hover', key === id));
    };
    items.forEach((el, id) => {
      el.addEventListener('mouseenter', () => setHover(id));
      el.addEventListener('mouseleave', () => setHover(null));
      el.addEventListener('focus', () => setHover(id));
      el.addEventListener('blur', () => setHover(null));
      el.addEventListener('click', (event) => {
        event.preventDefault();
        const region = regions.get(id);
        if (!region) return;
        region.scrollIntoView({
          behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
          block: 'start',
        });
        history.replaceState(null, '', `#section-${id}`);
      });
    });
    regions.forEach((el, id) => {
      el.addEventListener('mouseenter', () => setHover(id));
      el.addEventListener('mouseleave', () => setHover(null));
    });

    // Keep the current item visible inside the rail by scrolling only the rail's own scroller.
    // (scrollIntoView would also scroll the page and cancel a smooth scroll in progress.)
    const rail = root.querySelector<HTMLElement>('.fp__rail');
    const list = root.querySelector<HTMLElement>('.fp__list');
    const revealInRail = (el: HTMLElement) => {
      const r = el.getBoundingClientRect();
      if (list && list.scrollWidth > list.clientWidth + 1) {
        const box = list.getBoundingClientRect();
        list.scrollLeft += r.left - box.left - (box.width - r.width) / 2;
      } else if (rail && rail.scrollHeight > rail.clientHeight + 1) {
        const box = rail.getBoundingClientRect();
        if (r.top < box.top) rail.scrollTop -= box.top - r.top + 8;
        else if (r.bottom > box.bottom) rail.scrollTop += r.bottom - box.bottom + 8;
      }
    };

    // Mark the section crossing the middle of the viewport as current.
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const id = (entry.target as HTMLElement).dataset.region!;
          items.forEach((el, key) => {
            const current = key === id;
            el.toggleAttribute('aria-current', current);
            if (current) revealInRail(el);
          });
        }
      },
      { rootMargin: '-50% 0px -50% 0px' },
    );
    regions.forEach((el) => observer.observe(el));
  });
</script>

<style>
  .fp {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
  }
  @media (min-width: 1024px) {
    .fp {
      grid-template-columns: 240px minmax(0, 1fr);
      gap: var(--space-8);
      align-items: start;
    }
    .fp--no-rail {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Rail: a sticky pill row below 1024, a sticky list beside the capture above. */
  .fp__rail {
    position: sticky;
    top: var(--header-h);
    z-index: 2;
    margin-inline: calc(var(--page-gutter) * -1);
    padding: var(--space-2) var(--page-gutter);
    background: var(--header-bg);
    box-shadow: 0 1px 0 var(--line);
  }
  @supports (backdrop-filter: blur(1px)) {
    .fp__rail {
      backdrop-filter: saturate(1.5) blur(12px);
    }
  }
  .fp__rail-title {
    display: none;
  }
  .fp__list {
    display: flex;
    gap: var(--space-1);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .fp__list::-webkit-scrollbar {
    display: none;
  }
  .fp__item {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex: none;
    height: 32px;
    padding: 0 var(--space-3);
    border-radius: var(--radius-pill);
    color: var(--ink-2);
    font-size: var(--text-sm);
    white-space: nowrap;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .fp__item:hover,
  .fp__item.is-hover {
    background: var(--surface-2);
    color: var(--ink);
  }
  .fp__item[aria-current] {
    background: var(--btn-bg);
    color: var(--btn-fg);
  }
  .fp__item[aria-current] .fp__n,
  .fp__item[aria-current] .fp__app-name {
    color: var(--btn-fg-2);
  }
  .fp__n {
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
  }
  .fp__app {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .fp__app-name {
    display: none;
    color: var(--ink-3);
    font-size: var(--text-xs);
  }

  @media (min-width: 1024px) {
    .fp__rail {
      top: calc(var(--header-h) + var(--space-6));
      margin: 0;
      padding: 0;
      background: none;
      box-shadow: none;
      backdrop-filter: none;
      max-height: calc(100dvh - var(--header-h) - var(--space-12));
      overflow-y: auto;
      scrollbar-width: thin;
    }
    .fp__rail-title {
      display: flex;
      justify-content: space-between;
      padding: 0 var(--space-3) var(--space-3);
      color: var(--ink-3);
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      letter-spacing: var(--tracking-eyebrow);
      text-transform: uppercase;
    }
    .fp__list {
      flex-direction: column;
      overflow: visible;
      gap: 1px;
    }
    .fp__item {
      height: auto;
      min-height: 36px;
      padding: 6px var(--space-3);
      border-radius: var(--radius-control);
      white-space: normal;
    }
    .fp__item[aria-current] {
      background: var(--surface-2);
      color: var(--ink);
    }
    .fp__item[aria-current]::before {
      content: '';
      position: absolute;
      left: 0;
      top: 9px;
      bottom: 9px;
      width: 2px;
      border-radius: 2px;
      background: var(--accent);
    }
    .fp__item[aria-current] .fp__n {
      color: var(--accent-text);
    }
    .fp__item[aria-current] .fp__app-name {
      color: var(--ink-3);
    }
    .fp__name {
      flex: 1;
      min-width: 0;
    }
    .fp__app {
      margin-left: auto;
    }
    .fp__app-name {
      display: inline;
      max-width: 92px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  }

  /* Stage (well) + canvas (the capture, always light) */
  .fp__stage {
    min-width: 0;
    padding: var(--space-4);
    border-radius: var(--radius-card);
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  :global([data-theme='dark']) .fp__stage {
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }
  @media (min-width: 1024px) {
    .fp__stage {
      padding: var(--space-8);
    }
  }
  .fp--bare .fp__stage {
    padding: 0;
    border-radius: 0;
    background: none;
    box-shadow: none;
  }
  .fp__canvas {
    --tag-line: rgb(18 18 17 / 0.24);
    position: relative;
    width: 100%;
    max-width: 1040px;
    margin-inline: auto;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--capture-bg);
    box-shadow: var(--shadow-shot);
  }
  .fp--mobile .fp__canvas {
    max-width: 390px;
    border-radius: 18px;
  }
  .fp__canvas img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .fp__canvas .fp__poster {
    bottom: auto;
    height: auto;
    pointer-events: none;
  }

  /* Regions: an inset dashed outline per section, accent when hovered/current/targeted. */
  .fp__region {
    position: absolute;
    left: 0;
    right: 0;
    scroll-margin-top: calc(var(--header-h) + 64px);
  }
  .fp__region::before {
    content: '';
    position: absolute;
    inset: 3px;
    border: 1.5px dashed var(--tag-line);
    border-radius: 4px;
    transition:
      border-color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }
  .fp__region--small::before {
    border-color: transparent;
  }
  .fp__region.is-hover::before,
  .fp__region:target::before {
    border: 1.5px solid var(--accent);
    background: var(--accent-wash);
  }
  .fp__tag {
    position: absolute;
    left: 9px;
    top: 9px;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    max-width: calc(100% - 18px);
    height: 20px;
    padding: 0 7px;
    border-radius: var(--radius-pill);
    background: var(--btn-bg);
    color: var(--btn-fg);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    line-height: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.18);
    pointer-events: none;
    transition:
      opacity var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }
  .fp__tag-n,
  .fp__tag-app {
    color: var(--btn-fg-2);
  }
  .fp--tags-hover .fp__tag,
  .fp__region--small .fp__tag {
    opacity: 0;
    transform: translateY(-2px);
  }
  .fp__region.is-hover .fp__tag,
  .fp__region:target .fp__tag {
    opacity: 1;
    transform: none;
    background: var(--accent-btn);
    color: var(--accent-fg);
  }
  .fp__region.is-hover :is(.fp__tag-n, .fp__tag-app),
  .fp__region:target :is(.fp__tag-n, .fp__tag-app) {
    color: color-mix(in srgb, var(--accent-fg) 72%, transparent);
  }
  /* Captures drawn small (a phone page in a card or hero window): compact tags. */
  .fp__canvas {
    container-type: inline-size;
  }
  @container (max-width: 280px) {
    .fp__tag {
      left: 5px;
      top: 5px;
      height: 16px;
      padding: 0 5px;
      font-size: 9px;
    }
  }
  /* Narrow captures (a desktop page at 390px): smaller tags. */
  @media (max-width: 639px) {
    .fp--desktop .fp__tag {
      left: 6px;
      top: 6px;
      height: 16px;
      padding: 0 5px;
      font-size: 9px;
    }
    .fp--desktop .fp__region::before {
      inset: 2px;
      border-width: 1px;
    }
  }
</style>
