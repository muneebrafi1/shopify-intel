---
/**
 * A sliced section in a fixed-aspect well, so wide desktop strips and tall mobile slices
 * share one even grid. Crops are contained; long ones show their top and bleed off the bottom.
 */
import type { Device } from '~/lib/taxonomy';

interface Props {
  src: string;
  /** Crop size in CSS px. */
  width: number;
  height: number;
  device: Device;
  alt: string;
  href?: string;
  ratio?: string;
  eager?: boolean;
  class?: string;
}
const {
  src,
  width,
  height,
  device,
  alt,
  href,
  ratio,
  eager = false,
  class: className,
} = Astro.props;
const Tag = href ? 'a' : 'div';
const tall = height / width > 1.1;
// The well's inner box is 86% x 61% of its width (4:3 well, 7% padding). Fill whichever side
// binds, so the image has a definite size before it loads (lazy images need a box to load).
const wide = width / height > 0.86 / 0.61;
// Long sections (a desktop product grid, a mobile footer) would shrink to a sliver if contained.
// Show their top instead and let them bleed off the bottom edge, like page tiles do.
const long = height / width > (device === 'mobile' ? 2.4 : 1);
---

<Tag
  href={href}
  class:list={['crop', `crop--${device}`, { 'crop--tall': tall }, className]}
  style={ratio ? `--ratio:${ratio}` : undefined}
>
  <span class:list={['crop__frame', { 'crop__frame--long': long }]}>
    <img
      class:list={[long ? 'crop__img--long' : wide ? 'crop__img--wide' : 'crop__img--tall']}
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
  </span>
  <slot />
</Tag>

<style>
  .crop {
    --ratio: 4 / 3;
    position: relative;
    display: block;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    border-radius: var(--radius-well);
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--line);
    transition: background-color var(--dur-base) var(--ease-out);
  }
  :global([data-theme='dark']) .crop {
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }
  .crop__frame {
    position: absolute;
    inset: 7%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .crop img {
    max-width: 100%;
    max-height: 100%;
    border-radius: var(--radius-xs);
    box-shadow: var(--shadow-shot);
    background: var(--capture-bg);
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .crop__frame--long {
    inset: 7% 7% 0 7%;
    align-items: flex-start;
  }
  .crop .crop__img--long {
    width: 100%;
    height: auto;
    max-height: none;
    border-radius: var(--radius-xs) var(--radius-xs) 0 0;
  }
  .crop--mobile .crop__img--long {
    width: 54%;
    border-radius: 10px 10px 0 0;
  }
  .crop__img--wide {
    width: 100%;
    height: auto;
  }
  .crop__img--tall {
    height: 100%;
    width: auto;
  }
  .crop--tall img {
    border-radius: 10px;
  }
  a.crop:hover {
    background: var(--surface-3);
  }
  a.crop:hover img {
    transform: translateY(-2px);
  }
</style>
