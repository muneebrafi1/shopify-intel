---
/**
 * One search result row: a picture (page thumbnail, section crop, app icon, store mark or the
 * kind's glyph), the title with the matched word starts highlighted, the subtitle, the kind
 * (in mixed lists) and the action. The whole row is one link.
 */
import AppIcon from '~/components/ui/AppIcon.astro';
import Icon from '~/components/ui/Icon.astro';
import StoreMark from '~/components/ui/StoreMark.astro';
import { thumbUrl } from '~/lib/media';
import type { SearchHit } from '~/server/api/v1/types';
import { highlightParts } from './highlight';
import { KIND } from './kinds';

interface Props {
  hit: SearchHit;
  words: string[];
  /** Show the kind label (mixed lists). */
  showKind?: boolean;
  eager?: boolean;
}
const { hit, words, showKind = false, eager = false } = Astro.props;
const kind = KIND[hit.kind];
const parts = highlightParts(hit.title, words);
const t = hit.thumbnail;
const isCrop = hit.kind === 'section-type';
const cropH = t ? (isCrop ? t.height : Math.min(t.height, Math.round(t.width * 0.62))) : 0;
const thumb = t ? (isCrop ? t.src : thumbUrl(t.src, { cropHeight: cropH, width: 240 })) : null;
---

<li class="hit">
  <a href={hit.href} class="hit__link">
    <span
      class:list={[
        'hit__media',
        { 'hit__media--shot': thumb && !isCrop, 'hit__media--crop': thumb && isCrop },
      ]}
      data-theme={thumb ? 'light' : undefined}
    >
      {thumb ? (
        <img
          src={thumb}
          alt=""
          width={t!.width}
          height={cropH}
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
        />
      ) : hit.kind === 'app' ? (
        <AppIcon src={hit.icon_url} name={hit.title} size={32} />
      ) : hit.kind === 'store' ? (
        <StoreMark domain={hit.ref} name={hit.title} size={32} />
      ) : (
        <span class="hit__glyph" aria-hidden="true">
          <Icon name={kind.icon} size={16} />
        </span>
      )}
    </span>
    <span class="hit__text">
      <span class="hit__title">
        {parts.map((p) => (p.hit ? <mark class="hit__hl">{p.text}</mark> : p.text))}
      </span>
      {hit.subtitle && <span class="hit__sub">{hit.subtitle}</span>}
    </span>
    {showKind && <span class="hit__kind">{kind.one}</span>}
    <span class="hit__action">
      <span class="hit__action-label">{kind.action}</span>
      <Icon name="arrow-right" size={14} class="hit__arrow" />
    </span>
  </a>
</li>

<style>
  .hit__link {
    position: relative;
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    min-height: 60px;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-control);
    transition: background-color var(--dur-fast) var(--ease-out);
  }
  .hit__link:hover {
    background: var(--surface-2);
  }
  .hit__link:focus-visible {
    outline-offset: -2px;
  }
  .hit__media {
    display: grid;
    place-items: center;
    width: 56px;
    height: 36px;
  }
  .hit__media--shot,
  .hit__media--crop {
    overflow: hidden;
    border-radius: 6px;
    background: var(--capture-bg);
    box-shadow: var(--shadow-shot);
  }
  .hit__media--shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .hit__media--crop {
    background: var(--surface-2);
  }
  .hit__media--crop img {
    width: 100%;
    height: 100%;
    padding: 3px;
    object-fit: contain;
  }
  .hit__glyph {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-control);
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--line);
    color: var(--ink-2);
  }
  .hit__text {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }
  .hit__title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--ink);
    font-size: var(--text-ui);
    font-weight: var(--weight-medium);
    line-height: 1.4;
  }
  .hit__hl {
    padding: 0 1px;
    border-radius: 3px;
    background: var(--accent-soft);
    color: var(--ink);
    font-weight: var(--weight-semibold);
  }
  .hit__sub {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--ink-3);
    font-size: var(--text-sm);
  }
  .hit__kind {
    display: none;
  }
  .hit__action {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--ink-3);
    font-size: var(--text-sm);
    white-space: nowrap;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .hit__action-label {
    display: none;
  }
  .hit__link :global(.hit__arrow) {
    transition: transform var(--dur-base) var(--ease-out);
  }
  .hit__link:hover .hit__action {
    color: var(--ink);
  }
  .hit__link:hover :global(.hit__arrow) {
    transform: translateX(2px);
  }
  @media (min-width: 768px) {
    .hit__link {
      grid-template-columns: 64px minmax(0, 1fr) auto auto;
      gap: var(--space-4);
    }
    .hit__media {
      width: 64px;
      height: 40px;
    }
    .hit__kind {
      display: inline-flex;
      align-items: center;
      height: 20px;
      padding: 0 8px;
      border-radius: var(--radius-pill);
      box-shadow: inset 0 0 0 1px var(--line-strong);
      color: var(--ink-3);
      font-size: var(--text-xs);
    }
    .hit__action-label {
      display: inline;
    }
  }
</style>
