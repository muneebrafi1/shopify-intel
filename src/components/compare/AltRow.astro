---
/**
 * One ranked alternative as a rich row: position, identity, App Store facts (or why a theme is
 * here), price, usage in our scan with a share meter, a crop of where it renders (apps) or its
 * home page (themes), and one action. "Compare" appears only when the pair is a curated
 * comparison with a page (`compareAvailable`); otherwise the action is the item's own page.
 * The position is usage (apps) or closeness (themes), never a score.
 */
import AppIcon from '~/components/ui/AppIcon.astro';
import ThemeMark from '~/components/ui/ThemeMark.astro';
import Badge from '~/components/ui/Badge.astro';
import Button from '~/components/ui/Button.astro';
import Rating from '~/components/ui/Rating.astro';
import SectionCrop from '~/components/media/SectionCrop.astro';
import Shot from '~/components/media/Shot.astro';
import { formatCount } from '~/lib/format';
import type { AppListItem, SectionCard, ThemeListItem } from '~/server/api/v1/types';
import { sharePct } from './compare';

interface Props {
  n: number;
  app?: AppListItem | null;
  theme?: ThemeListItem | null;
  /** The item being replaced (for "with" and the compare label). */
  originalName: string;
  sharedStores: number;
  compareHref: string;
  compareAvailable: boolean;
  reasons?: string[];
  crop?: SectionCard | null;
  ratingSource?: string;
}
const {
  n,
  app,
  theme,
  originalName,
  sharedStores,
  compareHref,
  compareAvailable,
  reasons = [],
  crop,
  ratingSource,
} = Astro.props;
const REASON: Record<string, string> = {
  'same-vendor': 'Same vendor',
  'similar-price': 'Similar price',
  'shared-apps': 'Similar app stacks',
  'same-category': 'Same category',
};
const usage = app?.usage ?? theme!.usage;
const name = app?.short_name ?? theme!.name;
const href = app?.href ?? theme!.href;
const preview = theme?.previews[0] ?? null;
const sub = app
  ? [app.developer && `by ${app.developer}`, app.tagline].filter(Boolean).join(' · ')
  : [theme!.vendor && `by ${theme!.vendor}`, theme!.marketplace].filter(Boolean).join(' · ');
const price = app
  ? (app.pricing.label ?? 'Pricing not listed')
  : (theme!.price.label ?? 'Price not listed');
---

<li class:list={['alt', { 'alt--theme': !!theme }]}>
  <span class="alt__n num" aria-label={`Position ${n}`}>
    {n}
  </span>

  <div class="alt__id">
    {theme
      ? <ThemeMark slug={theme.slug} name={name} size={40} />
      : <AppIcon src={app?.icon_url ?? null} name={name} size={40} />}
    <div class="alt__id-text">
      <h3 class="alt__name">
        <a href={href}>{name}</a>
        {app?.built_for_shopify && (
          <Badge tone="outline" size="sm" title="Built for Shopify badge on the App Store">
            Built for Shopify
          </Badge>
        )}
      </h3>
      {sub && <p class="alt__sub">{sub}</p>}
    </div>
  </div>

  <dl class="alt__facts">
    {app ? (
      <div class="alt__fact alt__fact--rating">
        <dt>Rating</dt>
        <dd>
          <Rating rating={app.rating} reviews={app.reviews} size="sm" source={ratingSource} />
        </dd>
      </div>
    ) : (
      <div class="alt__fact alt__fact--why">
        <dt>Why it’s here</dt>
        <dd class="alt__reasons">
          {reasons.length ? (
            reasons.map((r) => (
              <Badge tone="neutral" size="sm">
                {REASON[r] ?? r}
              </Badge>
            ))
          ) : (
            <span class="alt__muted">Close match</span>
          )}
        </dd>
      </div>
    )}
    <div class="alt__fact alt__fact--price">
      <dt>Price</dt>
      <dd>{price}</dd>
    </div>
    <div class="alt__fact alt__fact--usage">
      <dt>Seen on</dt>
      <dd>
        <span class="alt__usage num">
          <strong>{formatCount(usage.stores)}</strong> of {formatCount(usage.denominator)}
          <span class="alt__share">{sharePct(usage.share)}</span>
        </span>
        <span
          class="alt__meter"
          style={`--w:${Math.max(1, Math.round(usage.share * 1000) / 10)}%`}
          aria-hidden="true"
        />
        {sharedStores > 0 && (
          <span class="alt__with">
            {formatCount(sharedStores)} {sharedStores === 1 ? 'store runs' : 'stores run'} it with{' '}
            {originalName}
          </span>
        )}
      </dd>
    </div>
  </dl>

  <div class:list={['alt__plate', { 'alt__plate--none': !crop && !preview }]}>
    {crop ? (
      <SectionCrop
        src={crop.crop.src}
        width={crop.crop.width}
        height={crop.crop.height}
        device={crop.device}
        href={crop.href}
        alt={`${crop.type.name} by ${name} on ${crop.store.display_name}`}
      />
    ) : preview ? (
      <Shot
        src={preview.image.src}
        width={preview.image.width}
        height={preview.image.height}
        device="desktop"
        href={href}
        alt={`${name} on a curated store, home page, desktop`}
      />
    ) : (
      <span class="alt__noplate">No capture yet</span>
    )}
  </div>

  <div class="alt__action">
    {compareAvailable ? (
      <Button href={compareHref} variant="secondary" size="sm" iconRight="arrow-right">
        Compare<span class="visually-hidden">{` ${originalName} and ${name}`}</span>
      </Button>
    ) : (
      <Button href={href} variant="link" size="sm" iconRight="arrow-right">
        {app ? 'App page' : 'Theme page'}
        <span class="visually-hidden">{`: ${name}`}</span>
      </Button>
    )}
  </div>
</li>

<style>
  /* <1024: a compact card (identity, facts, then the crop beside the action). */
  .alt {
    display: grid;
    grid-template-columns: 20px minmax(0, 1fr) auto;
    grid-template-areas:
      'n id id'
      '. facts facts'
      '. plate action';
    align-items: end;
    gap: var(--space-3) var(--space-3);
    padding: var(--space-4);
  }
  .alt + .alt {
    border-top: 1px solid var(--line);
  }
  .alt__n {
    grid-area: n;
    align-self: start;
    padding-top: 11px;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  .alt__id {
    grid-area: id;
    display: flex;
    gap: var(--space-3);
    align-items: center;
    min-width: 0;
  }
  .alt__id-text {
    min-width: 0;
  }
  .alt__name {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px var(--space-2);
    font-size: var(--text-h4);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  .alt__name a {
    color: var(--ink);
  }
  .alt__name a:hover {
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
  }
  .alt__sub {
    display: -webkit-box;
    margin-top: 2px;
    overflow: hidden;
    color: var(--ink-3);
    font-size: var(--text-sm);
    line-height: 1.4;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
  }
  .alt__facts {
    grid-area: facts;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-3) var(--space-5);
    font-size: var(--text-sm);
  }
  .alt__fact {
    display: grid;
    align-content: start;
    gap: 2px;
    min-width: 0;
  }
  .alt__fact dt {
    color: var(--ink-3);
    font-size: var(--text-xs);
  }
  .alt__fact dd {
    min-width: 0;
    color: var(--ink);
  }
  .alt__fact--usage,
  .alt__fact--why {
    grid-column: 1 / -1;
  }
  .alt--theme .alt__fact--usage {
    grid-column: auto;
  }
  .alt__reasons {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  .alt__muted {
    color: var(--ink-3);
  }
  .alt__usage {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 6px;
    color: var(--ink-2);
  }
  .alt__usage strong {
    color: var(--ink);
    font-weight: var(--weight-semibold);
  }
  .alt__share {
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
    font-size: var(--text-2xs);
  }
  .alt__meter {
    display: block;
    max-width: 200px;
    height: 6px;
    margin-top: 6px;
    border-radius: var(--radius-pill);
    background:
      linear-gradient(to right, var(--ink-2) 0 var(--w), transparent var(--w)), var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .alt__with {
    display: block;
    margin-top: 6px;
    color: var(--ink-3);
    font-size: var(--text-xs);
  }
  .alt__plate {
    grid-area: plate;
    width: 148px;
  }
  .alt__plate--none {
    display: none;
  }
  .alt__noplate {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    color: var(--ink-3);
    font-size: var(--text-xs);
  }
  .alt__action {
    grid-area: action;
    justify-self: end;
  }
  .alt__plate--none + .alt__action {
    grid-column: 2 / -1;
    justify-self: start;
  }

  /* ≥1024: one table-like row; the column heads live above the list (see --alt-cols). */
  @media (min-width: 1024px) {
    .alt {
      grid-template-columns: var(
        --alt-cols,
        28px minmax(0, 1.7fr) 132px minmax(0, 1fr) 176px 132px 120px
      );
      grid-template-areas: 'n id rating price usage plate action';
      align-items: center;
      gap: var(--space-5);
      padding: var(--space-4) var(--space-6);
      transition: background-color var(--dur-fast) var(--ease-out);
    }
    .alt:hover {
      background: var(--bg-subtle);
    }
    .alt__n {
      align-self: center;
      padding-top: 0;
    }
    .alt__facts {
      display: contents;
    }
    .alt__fact dt {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
    }
    .alt__fact--rating,
    .alt__fact--why {
      grid-area: rating;
    }
    .alt__fact--price {
      grid-area: price;
    }
    .alt__fact--usage {
      grid-area: usage;
    }
    .alt__plate {
      width: auto;
    }
    .alt__plate--none {
      display: block;
    }
    .alt__plate--none + .alt__action {
      grid-column: auto;
      justify-self: end;
    }
  }
</style>
