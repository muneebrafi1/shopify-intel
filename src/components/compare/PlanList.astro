---
/**
 * One app's plans from its App Store listing, as rows in a card: name and trial on the left,
 * price on the right, the first few features as a check list. The labelled outbound CTA sits
 * under the card. Mirrors ThemeSpec so the two sides line up.
 */
import AffiliateCta from '~/components/domain/AffiliateCta.astro';
import AppIcon from '~/components/ui/AppIcon.astro';
import Badge from '~/components/ui/Badge.astro';
import Icon from '~/components/ui/Icon.astro';
import type { AppFacts } from '~/server/api/v1/types';

interface Props {
  app: AppFacts;
}
const { app } = Astro.props;
const FEATURES = 3;
const price = (p: AppFacts['plans'][number]) =>
  p.price_cents === 0
    ? { value: 'Free', per: null }
    : {
        value: p.price_label,
        per: p.period
          ? p.period === 'month'
            ? '/mo'
            : p.period === 'year'
              ? '/yr'
              : `/${p.period}`
          : null,
      };
---

<div class="plans">
  <p class="plans__who">
    <AppIcon src={app.icon_url} name={app.short_name} size={28} />
    <span class="plans__name">{app.short_name}</span>
    <span class="plans__n">
      {`${app.plans.length} ${app.plans.length === 1 ? 'plan' : 'plans'}`}
    </span>
  </p>
  {app.plans.length > 0 ? (
    <ol class="plans__list">
      {app.plans.map((p) => {
        const pr = price(p);
        return (
          <li class="plan">
            <div class="plan__row">
              <div class="plan__id">
                <span class="plan__name">{p.name}</span>
                {p.trial_days ? (
                  <Badge size="sm" tone="neutral">
                    {p.trial_days}-day trial
                  </Badge>
                ) : null}
              </div>
              <span class="plan__price num">
                {pr.value}
                {pr.per && <span class="plan__per">{pr.per}</span>}
              </span>
            </div>
            {p.features.length > 0 && (
              <ul class="plan__features">
                {p.features.slice(0, FEATURES).map((f) => (
                  <li>
                    <Icon name="check" size={14} />
                    <span>{f}</span>
                  </li>
                ))}
                {p.features.length > FEATURES && (
                  <li class="plan__more">+{p.features.length - FEATURES} more on the listing</li>
                )}
              </ul>
            )}
          </li>
        );
      })}
    </ol>
  ) : (
    <p class="plans__none">{app.pricing.label ?? 'No plans listed on the App Store.'}</p>
  )}
  {app.cta && (
    <AffiliateCta
      href={app.cta.href}
      label={app.cta.label}
      isAffiliate={app.cta.is_affiliate}
      size="md"
      class="plans__cta"
    />
  )}
</div>

<style>
  .plans {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .plans__who {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }
  .plans__name {
    min-width: 0;
    overflow: hidden;
    font-size: var(--text-h3);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.015em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .plans__n {
    flex: none;
    margin-left: auto;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
  }
  .plans__list,
  .plans__none {
    border-radius: var(--radius-card);
    background: var(--surface);
    box-shadow:
      inset 0 0 0 1px var(--line),
      var(--shadow-xs),
      var(--highlight);
  }
  .plan {
    padding: var(--space-4) var(--space-5);
  }
  .plan + .plan {
    border-top: 1px solid var(--line);
  }
  .plan__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .plan__id {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px var(--space-2);
    min-width: 0;
  }
  .plan__name {
    font-size: var(--text-md);
    font-weight: var(--weight-semibold);
  }
  .plan__price {
    flex: none;
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.02em;
  }
  .plan__per {
    margin-left: 1px;
    color: var(--ink-3);
    font-size: var(--text-sm);
    font-weight: var(--weight-regular);
    letter-spacing: 0;
  }
  .plan__features {
    display: grid;
    gap: 4px;
    margin-top: var(--space-3);
    color: var(--ink-2);
    font-size: var(--text-sm);
    line-height: 1.4;
  }
  .plan__features li {
    display: grid;
    grid-template-columns: 14px minmax(0, 1fr);
    gap: var(--space-2);
  }
  .plan__features :global(.icon) {
    margin-top: 2px;
    color: var(--ink-3);
  }
  .plan__more {
    grid-template-columns: minmax(0, 1fr) !important;
    padding-left: 22px;
    color: var(--ink-3);
  }
  .plans__none {
    padding: var(--space-5);
    color: var(--ink-3);
    font-size: var(--text-sm);
  }
  .plans :global(.plans__cta) {
    margin-top: var(--space-5);
  }
</style>
