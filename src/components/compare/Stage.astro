---
/**
 * "Seen on real stores": both sides in two browser windows at the same scale, with the section
 * tags pinned on the captures (the product's signature). Apps show the same section type from
 * curated stores running each; themes show the same page of a curated store on each.
 * Page-type tabs and the Desktop/Mobile switch are links (`?page=&device=#stage`), so they work
 * without JS; with JS they switch in place and keep the URL shareable.
 */
import { thumbUrl } from '~/lib/media';
import { formatCount } from '~/lib/format';
import AppIcon from '~/components/ui/AppIcon.astro';
import Badge from '~/components/ui/Badge.astro';
import Tabs from '~/components/ui/Tabs.astro';
import Segmented from '~/components/ui/Segmented.astro';
import StoreMark from '~/components/ui/StoreMark.astro';
import Window from '~/components/ui/Window.astro';
import { frameKey, pageTypeName, type Frame, type SideInfo, type StageModel } from './compare';

interface Props {
  model: StageModel;
  a: SideInfo;
  b: SideInfo;
  /** Requested view from the query string, if valid. */
  page?: string | null;
  device?: string | null;
}
const { model, a, b, page, device } = Astro.props;
const requested = page && device ? frameKey(page, device) : null;
const current = requested && model.frames.has(requested) ? requested : model.defaultKey;
const [curPage, curDevice] = current.split(':') as [string, string];
const keys = [...model.frames.keys()];

/** Frame key for a tab or device link: keep the other dimension when it exists. */
const keyForPage = (p: string) => {
  if (model.frames.has(frameKey(p, curDevice))) return frameKey(p, curDevice);
  return keys.find((k) => k.startsWith(`${p}:`)) ?? null;
};
const keyForDevice = (d: string) => {
  if (model.frames.has(frameKey(curPage, d))) return frameKey(curPage, d);
  return keys.find((k) => k.endsWith(`:${d}`)) ?? null;
};
const hrefFor = (key: string) => {
  const [p, d] = key.split(':');
  return `?page=${p}&device=${d}#stage`;
};
const showControls = model.mode === 'sections' || model.mode === 'pages';
const tabs = model.pageTypes
  .map((p) => ({ p, key: keyForPage(p) }))
  .filter((t): t is { p: (typeof model.pageTypes)[number]; key: string } => !!t.key)
  .map((t) => ({ label: pageTypeName(t.p), href: hrefFor(t.key), selected: t.p === curPage }));
const devices = model.devices
  .map((d) => ({ d, key: keyForDevice(d) }))
  .filter((t): t is { d: (typeof model.devices)[number]; key: string } => !!t.key)
  .map((t) => ({
    label: t.d === 'desktop' ? 'Desktop' : 'Mobile',
    value: t.d,
    icon: t.d === 'desktop' ? ('desktop' as const) : ('device-mobile' as const),
    href: hrefFor(t.key),
    selected: t.d === curDevice,
  }));
const sideInfo = { a, b };

const imgSrc = (f: Frame) =>
  f.kind === 'page'
    ? thumbUrl(f.src, { cropHeight: f.height, width: f.device === 'desktop' ? 1200 : 600 })
    : f.src;
const emptyText = (s: SideInfo, key: string) => {
  const [p, d] = key.split(':');
  if (model.mode === 'empty' || model.mode === 'stores')
    return s.kind === 'app'
      ? `${s.name} isn’t on a curated store yet.`
      : `No curated store runs ${s.name} yet.`;
  return s.kind === 'app'
    ? `No ${pageTypeName(p ?? '').toLowerCase()} page section (${d}) attributed to ${s.name} yet.`
    : `No ${pageTypeName(p ?? '').toLowerCase()} page (${d}) captured for ${s.name} yet.`;
};
// A pinned tag needs ~30px of section height; hide it below the frame width where it would
// spill into the next section (container query on the canvas). Hover still outlines it.
const fitClass = (hw?: number) => {
  if (!hw) return null;
  const need = 30 / hw;
  return need > 900
    ? 'fit-none'
    : need > 640
      ? 'fit-900'
      : need > 480
        ? 'fit-640'
        : need > 340
          ? 'fit-480'
          : null;
};
const anyPlaceholder = [...model.frames.values()].some(
  (f) => f.a?.isPlaceholder || f.b?.isPlaceholder,
);
const title =
  model.mode === 'sections'
    ? 'Where each one renders'
    : model.mode === 'pages'
      ? 'The same page on each theme'
      : model.mode === 'stores'
        ? 'A store running each'
        : 'Nothing to show side by side yet';
---

<section class="seen" id="stage" aria-labelledby="stage-title" data-stage>
  <div class="container">
    <div class="seen__head">
      <div class="seen__text">
        <h2 class="h2" id="stage-title">
          {title}
        </h2>
      </div>
      {showControls && (tabs.length > 1 || devices.length > 1) && (
        <div class="seen__controls">
          {tabs.length > 1 && <Tabs label="Page type" size="sm" items={tabs} class="seen__tabs" />}
          {devices.length > 1 && <Segmented label="Device" size="sm" items={devices} />}
        </div>
      )}
    </div>

    {keys.map((key) => {
      const pair = model.frames.get(key)!;
      const [, d] = key.split(':');
      return (
        <div
          class:list={['seen__pair', `seen__pair--${d}`]}
          data-stage-frame={key}
          hidden={key !== current}
        >
          {(['a', 'b'] as const).map((side) => {
            const f = pair[side];
            const s = sideInfo[side];
            const twin = pair[side === 'a' ? 'b' : 'a'];
            return (
              <figure class:list={['seen__side', `seen__side--${side}`]}>
                <p class="seen__who">
                  <AppIcon src={s.iconUrl} name={s.name} size={22} />
                  <span class="seen__name">{s.name}</span>
                  <span class="seen__count num">{formatCount(s.stores)} stores</span>
                </p>
                {f ? (
                  <Window url={`${f.domain}${f.path === '/' ? '' : f.path}`} class="seen__window">
                    <a
                      href={f.href ?? undefined}
                      class:list={['seen__canvas', `seen__canvas--${f.kind}`]}
                      data-theme="light"
                    >
                      <img
                        src={imgSrc(f)}
                        alt={f.alt}
                        width={f.width}
                        height={f.height}
                        loading="lazy"
                        decoding="async"
                      />
                      {f.kind === 'crop'
                        ? f.tags.map((t) => (
                            <span class="seen__tag seen__tag--crop">{t.label}</span>
                          ))
                        : f.tags.map((t, i) => (
                            <span
                              class:list={['seen__region', fitClass(t.hw)]}
                              style={`top:${t.top.toFixed(2)}%;height:${t.height.toFixed(2)}%`}
                            >
                              <span class="seen__tag">
                                <span class="seen__tag-n num">
                                  {String(i + 1).padStart(2, '0')}
                                </span>
                                {t.label}
                              </span>
                            </span>
                          ))}
                    </a>
                  </Window>
                ) : (
                  <div
                    class="seen__empty"
                    style={twin ? `--empty-ratio:${twin.width} / ${twin.height}` : undefined}
                  >
                    <p>{emptyText(s, key)}</p>
                  </div>
                )}
                {f && (
                  <figcaption class="seen__cap">
                    <StoreMark domain={f.domain} name={f.storeName} size={20} />
                    <a href={f.storeHref} class="seen__store">
                      {f.storeName}
                    </a>
                    <span class="seen__ctx">
                      {[`${pageTypeName(f.pageType)} page`, f.context].filter(Boolean).join(' · ')}
                    </span>
                    {f.isPlaceholder && (
                      <Badge tone="outline" size="sm" title="Drawn from the detected sections">
                        Layout preview
                      </Badge>
                    )}
                  </figcaption>
                )}
              </figure>
            );
          })}
        </div>
      );
    })}
  </div>
</section>

<script>
  // Progressive enhancement: switch frames in place and keep the URL shareable.
  document.querySelectorAll<HTMLElement>('[data-stage]').forEach((stage) => {
    const frames = new Map<string, HTMLElement>();
    stage
      .querySelectorAll<HTMLElement>('[data-stage-frame]')
      .forEach((el) => frames.set(el.dataset.stageFrame!, el));
    const keys = [...frames.keys()];
    const parse = (a: HTMLAnchorElement) => {
      const u = new URL(a.href, location.href);
      const p = u.searchParams.get('page');
      const d = u.searchParams.get('device');
      return p && d ? { p, d } : null;
    };
    const tabLinks = Array.from(stage.querySelectorAll<HTMLAnchorElement>('.tabs a'));
    const devLinks = Array.from(stage.querySelectorAll<HTMLAnchorElement>('.seg a'));
    const href = (key: string) => {
      const [p, d] = key.split(':');
      return `?page=${p}&device=${d}#stage`;
    };
    const show = (page: string, device: string) => {
      const key = `${page}:${device}`;
      const frame = frames.get(key);
      if (!frame) return false;
      frames.forEach((el, k) => (el.hidden = k !== key));
      tabLinks.forEach((a) => {
        const t = parse(a);
        if (!t) return;
        const next = frames.has(`${t.p}:${device}`)
          ? `${t.p}:${device}`
          : (keys.find((k) => k.startsWith(`${t.p}:`)) ?? `${t.p}:${t.d}`);
        a.href = href(next);
        if (t.p === page) a.setAttribute('aria-current', 'page');
        else a.removeAttribute('aria-current');
      });
      devLinks.forEach((a) => {
        const t = parse(a);
        if (!t) return;
        const next = frames.has(`${page}:${t.d}`)
          ? `${page}:${t.d}`
          : (keys.find((k) => k.endsWith(`:${t.d}`)) ?? `${t.p}:${t.d}`);
        a.href = href(next);
        if (t.d === device) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
      });
      const url = new URL(location.href);
      url.searchParams.set('page', page);
      url.searchParams.set('device', device);
      history.replaceState(null, '', `${url.pathname}${url.search}#stage`);
      return true;
    };
    stage.addEventListener('click', (event) => {
      const link = (event.target as HTMLElement).closest<HTMLAnchorElement>('.tabs a, .seg a');
      if (!link || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      const t = parse(link);
      if (t && show(t.p, t.d)) event.preventDefault();
    });
  });
</script>

<style>
  .seen {
    padding-block: var(--space-10);
    background: var(--bg-subtle);
    box-shadow:
      inset 0 1px 0 var(--line),
      inset 0 -1px 0 var(--line);
    scroll-margin-top: calc(var(--header-h) + 48px);
  }
  .seen__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    margin-bottom: var(--space-6);
  }
  .seen__note {
    max-width: 620px;
    margin-top: var(--space-2);
    color: var(--ink-3);
    font-size: var(--text-ui);
    line-height: 1.5;
  }
  .seen__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-6);
  }
  .seen__controls :global(.seen__tabs) {
    min-width: 0;
    max-width: 100%;
  }

  /* Two sides, same width, top-aligned so heights read honestly. */
  .seen__pair {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-8);
    align-items: start;
  }
  .seen__pair[hidden] {
    display: none;
  }
  .seen__pair--mobile {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
  }
  .seen__side {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .seen__who {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
    margin-bottom: var(--space-3);
  }
  .seen__name {
    min-width: 0;
    overflow: hidden;
    font-size: var(--text-md);
    font-weight: var(--weight-semibold);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .seen__count {
    margin-left: auto;
    flex: none;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
  }
  .seen__pair--mobile :global(.seen__window) {
    width: min(100%, 320px);
  }
  .seen__canvas {
    position: relative;
    display: block;
    container-type: inline-size;
    background: var(--capture-bg);
  }
  .fit-none .seen__tag {
    display: none;
  }
  @container (max-width: 899px) {
    .fit-900 .seen__tag {
      display: none;
    }
  }
  @container (max-width: 639px) {
    .fit-640 .seen__tag {
      display: none;
    }
  }
  @container (max-width: 479px) {
    .fit-480 .seen__tag {
      display: none;
    }
  }
  .seen__canvas img {
    display: block;
    width: 100%;
    height: auto;
    background: var(--capture-bg);
    transition: opacity var(--dur-base) var(--ease-out);
  }
  a.seen__canvas:hover img {
    opacity: 0.94;
  }
  .seen__canvas--crop {
    outline: 1.5px dashed transparent;
    outline-offset: -6px;
    transition: outline-color var(--dur-base) var(--ease-out);
  }
  .seen__canvas--crop:hover {
    outline-color: var(--accent);
  }

  /* Pinned section tags (same look as the store viewer). */
  .seen__region {
    position: absolute;
    left: 0;
    right: 0;
    border: 1px dashed var(--line-strong);
    border-radius: 2px;
    pointer-events: none;
    transition: border-color var(--dur-base) var(--ease-out);
  }
  .seen__canvas:hover .seen__region {
    border-color: color-mix(in srgb, var(--accent) 60%, transparent);
  }
  .seen__tag {
    position: absolute;
    left: 8px;
    top: 8px;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    max-width: calc(100% - 16px);
    height: 20px;
    padding: 0 7px;
    border-radius: var(--radius-pill);
    background: var(--btn-bg);
    color: var(--btn-fg);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    line-height: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.18);
  }
  .seen__tag--crop {
    top: 10px;
    left: 10px;
  }
  .seen__tag-n {
    color: var(--btn-fg-2);
  }
  .seen__canvas:hover .seen__tag--crop {
    background: var(--accent-btn);
    color: var(--accent-fg);
  }

  .seen__empty {
    display: grid;
    place-items: center;
    aspect-ratio: var(--empty-ratio, 4 / 3);
    min-height: 160px;
    padding: var(--space-6);
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-card);
    text-align: center;
  }
  .seen__pair--mobile .seen__empty {
    width: min(100%, 320px);
    aspect-ratio: var(--empty-ratio, 9 / 16);
  }
  .seen__empty p {
    max-width: 30ch;
    color: var(--ink-3);
    font-size: var(--text-sm);
    line-height: 1.5;
  }
  .seen__cap {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px var(--space-2);
    margin-top: var(--space-3);
    font-size: var(--text-sm);
  }
  .seen__store {
    font-weight: var(--weight-medium);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
  }
  .seen__store:hover {
    text-decoration-color: currentColor;
  }
  .seen__ctx {
    color: var(--ink-3);
  }
  .seen__pair--mobile .seen__cap {
    font-size: var(--text-xs);
  }
  .seen__pair--mobile .seen__cap :global(.store-mark),
  .seen__pair--mobile .seen__cap :global(.badge) {
    display: none;
  }

  @media (min-width: 640px) {
    .seen__pair--desktop {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-6);
    }
    .seen__pair--mobile {
      gap: var(--space-6);
    }
    .seen__pair--mobile .seen__cap :global(.store-mark) {
      display: inline-grid;
    }
  }
  @media (min-width: 1024px) {
    .seen {
      padding-block: var(--space-16);
    }
    .seen__head {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: var(--space-10);
      margin-bottom: var(--space-8);
    }
    .seen__controls {
      flex: none;
      justify-content: flex-end;
    }
    .seen__pair--desktop {
      gap: var(--space-10);
    }
    .seen__pair--mobile {
      grid-template-columns: repeat(2, minmax(0, 360px));
      justify-content: center;
      gap: var(--space-16);
    }
  }
</style>
