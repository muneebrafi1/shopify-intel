---
/**
 * Two equal columns for wide side-by-side content (plans, prices). ≥768 both sides sit next to
 * each other around a hairline axis. Below 768, with JS, a segmented switch shows one side at a
 * time (the content is too wide to squeeze into halves); without JS both sides stack.
 */
import Segmented from '~/components/ui/Segmented.astro';

interface Props {
  /** Names for the switch, [A, B]. */
  labels: [string, string];
  /** Unique name for the switch on the page. */
  name: string;
  class?: string;
}
const { labels, name, class: className } = Astro.props;
---

<div class:list={['dip', className]} data-dip={name} data-show="a">
  <div class="dip__switch">
    <Segmented
      label="Show"
      name={name}
      size="md"
      full
      items={[
        { label: labels[0], value: 'a', selected: true },
        { label: labels[1], value: 'b' },
      ]}
    />
  </div>
  <div class="dip__side dip__side--a">
    <slot name="a" />
  </div>
  <div class="dip__axis" aria-hidden="true"></div>
  <div class="dip__side dip__side--b">
    <slot name="b" />
  </div>
</div>

<script>
  document.addEventListener('segmented:change', (event) => {
    const detail = (event as CustomEvent<{ name?: string; value?: string }>).detail;
    if (!detail?.name) return;
    const dip = document.querySelector<HTMLElement>(`[data-dip="${CSS.escape(detail.name)}"]`);
    if (dip && (detail.value === 'a' || detail.value === 'b')) dip.dataset.show = detail.value;
  });
</script>

<style>
  .dip {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-8);
  }
  .dip__side {
    min-width: 0;
  }
  .dip__axis,
  .dip__switch {
    display: none;
  }
  @media (max-width: 767px) {
    :global(html.js) .dip__switch {
      display: block;
      position: sticky;
      z-index: 3;
      top: calc(var(--header-h) + 48px);
      margin-bottom: calc(var(--space-8) * -1 + var(--space-5));
      padding-block: 6px;
      background: var(--bg);
    }
    :global(html.js) .dip[data-show='a'] .dip__side--b,
    :global(html.js) .dip[data-show='b'] .dip__side--a {
      display: none;
    }
  }
  @media (min-width: 768px) {
    .dip {
      grid-template-columns: minmax(0, 1fr) 1px minmax(0, 1fr);
      gap: var(--space-8);
    }
    .dip__axis {
      display: block;
      background: var(--line);
    }
  }
  @media (min-width: 1024px) {
    .dip {
      gap: var(--space-12);
    }
  }
</style>
