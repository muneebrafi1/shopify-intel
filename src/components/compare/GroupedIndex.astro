---
/**
 * A catalogue index split into groups, like a book's table of contents: the group name sits in
 * the left margin (columns 1–3, sticky while its rows scroll), the numbered rows on the right.
 * Rows are the shared <IndexRow>, so hover previews and mobile behaviour match the rest of the
 * site. Numbering runs on across groups.
 */
import IndexList from '~/components/ui/IndexList.astro';
import IndexRow, { type IndexCell } from '~/components/ui/IndexRow.astro';
import Count from '~/components/ui/Count.astro';
import type { Device } from '~/lib/taxonomy';

export interface GroupRow {
  href: string;
  title: string;
  subtitle?: string;
  cells?: IndexCell[];
  preview?: { src: string; width: number; height: number; device?: Device } | null;
}
export interface Group {
  id?: string;
  label: string;
  /** Small mono line under the label (e.g. "Category" or a link target). */
  note?: string;
  href?: string;
  rows: GroupRow[];
}

interface Props {
  groups: Group[];
  columns: string;
  head?: string[];
  /** Accessible name for each list: receives the group label. */
  listLabel?: (label: string) => string;
  start?: number;
  class?: string;
}
const { groups, columns, head, listLabel = (l: string) => l, start = 1, class: className } = Astro.props;
let n = start - 1;
const numbered = groups.map((g) => ({ ...g, rows: g.rows.map((r) => ({ ...r, n: ++n })) }));
---

<div class:list={['gidx', className]}>
  {
    head && (
      <div class="gidx__head" aria-hidden="true">
        <span class="mlabel">Group</span>
        <div class="gidx__head-cols" style={`--index-cols:${columns}`}>
          {head.map((h, i) => (
            <span class:list={['mlabel', { 'gidx__head-end': i === head.length - 1 && i > 1 }]}>{h}</span>
          ))}
        </div>
      </div>
    )
  }
  {
    numbered.map((g) => (
      <section class="gidx__group" id={g.id} aria-label={g.label}>
        <div class="gidx__label">
          <h3 class="gidx__name">
            {g.href ? <a href={g.href}>{g.label}</a> : g.label}
            <Count value={g.rows.length} />
          </h3>
          {g.note && <p class="gidx__note">{g.note}</p>}
        </div>
        <IndexList columns={columns} label={listLabel(g.label)} class="gidx__list">
          {g.rows.map((r) => (
            <IndexRow n={r.n} href={r.href} title={r.title} subtitle={r.subtitle} cells={r.cells} preview={r.preview} />
          ))}
        </IndexList>
      </section>
    ))
  }
</div>

<style>
  .gidx__head {
    display: none;
  }
  .gidx__group {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
  }
  .gidx__group + .gidx__group {
    margin-top: var(--space-10);
  }
  .gidx__name {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-snug);
    line-height: 1.2;
  }
  .gidx__name a {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.2em;
    transition: text-decoration-color var(--dur-fast) var(--ease-out);
  }
  .gidx__name a:hover {
    text-decoration-color: var(--line-strong);
  }
  .gidx__note {
    margin-top: 4px;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  @media (min-width: 1024px) {
    .gidx__head,
    .gidx__group {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: var(--space-6);
    }
    .gidx__head {
      padding-bottom: var(--space-2);
    }
    .gidx__head > .mlabel {
      grid-column: span 3;
    }
    .gidx__head-cols {
      grid-column: 4 / -1;
      display: grid;
      grid-template-columns: var(--index-cols);
      gap: var(--space-4);
    }
    .gidx__head-end {
      justify-content: flex-end;
    }
    .gidx__group + .gidx__group {
      margin-top: var(--space-12);
    }
    .gidx__label {
      grid-column: span 3;
      align-self: start;
      position: sticky;
      top: calc(var(--header-h) + var(--space-6));
      padding-top: 14px;
      border-top: 1px solid var(--ink);
    }
    .gidx__group > :global(.gidx__list) {
      grid-column: 4 / -1;
    }
  }
</style>
