---
/**
 * The first thing under the hero: real stores, as captured. A sideways row of tiles (phone
 * screenshots on small screens, desktop on wide ones), each linking to that store's page with its
 * theme and app count. Tiles are small pre-cut crops (data/curation/home-gallery.json, uploaded by
 * scripts/home/make-tiles.py); a store whose capture changed since then falls back to its regular
 * top thumbnail. The first tiles load eagerly (they are the LCP), the rest lazily.
 */
import { thumbUrl } from '~/lib/media';

export interface GalleryTile {
  domain: string;
  name: string;
  href: string;
  theme: string;
  appCount: number;
  apps: { name: string; iconUrl: string | null }[];
  desktop: { src: string; width: number; height: number; tile: boolean };
  mobile: { src: string; width: number; height: number; tile: boolean };
}
interface Props {
  tiles: GalleryTile[];
  total: number;
}
const { tiles, total } = Astro.props;
const pick = (s: GalleryTile['desktop'], device: 'desktop' | 'mobile') =>
  s.tile
    ? s.src
    : thumbUrl(s.src, {
        cropHeight: Math.min(s.height, device === 'desktop' ? 900 : 844),
        width: device === 'desktop' ? 640 : 320,
      });
---

<section class="gal" aria-labelledby="gal-title">
  <div class="gal__head">
    <h2 id="gal-title" class="gal__title">Real stores, as their customers see them</h2>
    <a class="gal__all" href="/stores">All {total} stores <span aria-hidden="true">→</span></a>
  </div>
  <ul class="gal__row" role="list" tabindex="0" aria-label="Store gallery, scroll sideways">
    {tiles.map((t, i) => (
      <li class="gal__item">
        <a class="gal__card" href={t.href}>
          <span class="gal__shot" data-theme="light">
            <picture>
              <source media="(min-width: 640px)" srcset={pick(t.desktop, 'desktop')} />
              <img
                src={pick(t.mobile, 'mobile')}
                alt={`${t.name} home page`}
                width={t.mobile.width}
                height={t.mobile.height}
                loading={i < 3 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : undefined}
                decoding="async"
              />
            </picture>
          </span>
          <span class="gal__name">{t.name}</span>
          <span class="gal__meta">
            {t.theme} · {t.appCount} apps
          </span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .gal {
    margin-top: var(--space-8);
  }
  .gal__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-3);
    text-align: left;
  }
  .gal__title {
    font-size: var(--text-ui);
    font-weight: var(--weight-semibold);
    letter-spacing: 0;
    color: var(--ink);
  }
  .gal__all {
    flex: none;
    color: var(--ink-3);
    font-size: var(--text-sm);
  }
  .gal__all:hover {
    color: var(--ink);
  }
  /* Bleeds to the screen edge on phones so the next tile is visibly "more". */
  .gal__row {
    display: flex;
    gap: var(--space-3);
    margin-inline: calc(var(--page-gutter) * -1);
    padding: 2px var(--page-gutter) var(--space-3);
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scroll-padding-inline: var(--page-gutter);
    scrollbar-width: thin;
    overscroll-behavior-x: contain;
  }
  .gal__item {
    flex: none;
    width: 150px;
    scroll-snap-align: start;
    text-align: left;
  }
  .gal__card {
    display: block;
    color: inherit;
  }
  .gal__shot {
    display: block;
    overflow: hidden;
    border-radius: var(--radius-md, 10px);
    background: var(--capture-bg);
    box-shadow:
      inset 0 0 0 1px var(--line),
      var(--shadow-shot);
    aspect-ratio: 280 / 448;
    transition: transform var(--dur-base) var(--ease-out);
  }
  .gal__shot :global(picture),
  .gal__shot :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .gal__shot :global(img) {
    object-fit: cover;
    object-position: top;
  }
  .gal__card:hover .gal__shot {
    transform: translateY(-2px);
  }
  .gal__name {
    display: block;
    margin-top: var(--space-2);
    overflow: hidden;
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .gal__meta {
    display: block;
    overflow: hidden;
    color: var(--ink-3);
    font-size: var(--text-xs);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  @media (min-width: 640px) {
    .gal__item {
      width: 248px;
    }
    .gal__shot {
      aspect-ratio: 480 / 300;
    }
  }
  @media (min-width: 1024px) {
    .gal {
      margin-top: var(--space-10);
    }
    .gal__item {
      width: 272px;
    }
  }
</style>
