---
/**
 * The hero's product shot: the real store viewer in a <Window>, not a mock. A page-type
 * sidebar, the full-page capture with pinned section tags (shared <FullPage>), and the
 * sections list with the app behind each one.
 *
 * Without JS every page type and section row is a link into /stores/<domain> (the full viewer).
 * With JS the sidebar switches the page in place, and hovering, focusing or clicking a section
 * row lights its region and scrolls the capture to it. Below 640px the window shows the mobile
 * capture with its first tags, cropped with a bottom fade.
 */
import Window from '~/components/ui/Window.astro';
import Badge from '~/components/ui/Badge.astro';
import StoreMark from '~/components/ui/StoreMark.astro';
import AppIcon from '~/components/ui/AppIcon.astro';
import Icon from '~/components/ui/Icon.astro';
import FullPage, { type FullPageSection } from '~/components/media/FullPage.astro';
import type { Device } from '~/lib/taxonomy';

export interface WindowShot {
  src: string;
  width: number;
  height: number;
  device: Device;
  isPlaceholder: boolean;
  sections: (FullPageSection & { href: string })[];
}
export interface WindowPage {
  slug: string;
  name: string;
  /** /stores/<domain>?page=…&device=desktop */
  href: string;
  desktop: WindowShot;
}

interface Props {
  store: {
    domain: string;
    name: string;
    href: string;
    themeLabel: string;
    themeHref: string | null;
    appCount: number;
    apps: { name: string; iconUrl: string | null }[];
    /** The store's teardown, if it has one. */
    teardown: { href: string; title: string } | null;
    /** Last scan date, formatted. */
    lastSeen: string;
  };
  pages: WindowPage[];
  /** Page shown first (and the one the mobile capture comes from). */
  initial: string;
  mobile: WindowShot | null;
}
const { store, pages, initial, mobile } = Astro.props;
const first = pages.find((p) => p.slug === initial) ?? pages[0]!;
const preview = pages.some((p) => p.desktop.isPlaceholder);
const pad = (i: number) => String(i + 1).padStart(2, '0');
---

<div class="pw" data-pw>
  <div class="pw__glow" aria-hidden="true"></div>
  <Window url={store.domain} class="pw__window">
    <Fragment slot="toolbar">
      {preview && (
        <span
          class="pw__status"
          title="Drawn from each page's detected sections until the first capture run"
        >
          <Badge size="sm">Layout preview</Badge>
        </span>
      )}
      <a class="pw__open" href={first.href}>
        Open viewer
        <Icon name="arrow-right" size={14} />
      </a>
    </Fragment>

    <div class="pw__body">
      <nav class="pw__side" aria-label={`${store.name} pages`}>
        <div class="pw__store">
          <StoreMark domain={store.domain} name={store.name} size={28} />
          <span class="pw__store-text">
            <span class="pw__store-name">{store.name}</span>
            <span class="pw__store-domain mono">{store.domain}</span>
          </span>
        </div>
        <p class="pw__label eyebrow">Pages</p>
        <ul class="pw__pages">
          {pages.map((p) => (
            <li>
              <a
                class="pw__page"
                href={p.href}
                data-pw-page={p.slug}
                aria-current={p.slug === first.slug ? 'true' : undefined}
              >
                <span>{p.name}</span>
                <span class="pw__page-n num">{p.desktop.sections.length}</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="pw__label eyebrow">Theme</p>
        {store.themeHref ? (
          <a class="pw__fact pw__fact--link" href={store.themeHref}>
            {store.themeLabel}
          </a>
        ) : (
          <p class="pw__fact">{store.themeLabel}</p>
        )}
        <p class="pw__label eyebrow">Apps</p>
        <p class="pw__fact">{store.appCount} detected</p>
        <span class="pw__apps" aria-hidden="true">
          {store.apps.slice(0, 5).map((a) => (
            <AppIcon src={a.iconUrl} name={a.name} size={22} />
          ))}
        </span>
        <div class="pw__foot">
          {store.teardown && (
            <a class="pw__teardown" href={store.teardown.href}>
              <span class="eyebrow">Teardown</span>
              <span class="pw__teardown-title">{store.teardown.title}</span>
            </a>
          )}
          <p class="pw__seen mono">Scanned {store.lastSeen}</p>
        </div>
      </nav>

      <div class="pw__canvas">
        {pages.map((p) => (
          <div class="pw__pane" data-pw-pane={p.slug} hidden={p.slug !== first.slug}>
            <FullPage
              src={p.desktop.src}
              width={p.desktop.width}
              height={p.desktop.height}
              device="desktop"
              alt={`${store.name} ${p.name.toLowerCase()} page, desktop, with every section tagged`}
              sections={p.desktop.sections}
              rail={false}
              bare
              eager={p.slug === first.slug}
            />
          </div>
        ))}
      </div>

      <div class="pw__list">
        {pages.map((p) => (
          <div class="pw__sections" data-pw-list={p.slug} hidden={p.slug !== first.slug}>
            <p class="pw__list-head">
              <span class="eyebrow">Sections</span>
              <span class="pw__list-meta mono">{p.name} · desktop</span>
            </p>
            <ol class="pw__rows">
              {p.desktop.sections.map((s, i) => (
                <li>
                  <a class="pw__row" href={s.href} data-pw-target={String(s.id)}>
                    <span class="pw__row-n num">{pad(i)}</span>
                    <span class="pw__row-name">{s.name}</span>
                    {s.app && (
                      <span class="pw__row-app" title={`Rendered by ${s.app.name}`}>
                        <AppIcon src={s.app.iconUrl} name={s.app.name} size={16} />
                        <span class="pw__row-app-name">{s.app.name}</span>
                      </span>
                    )}
                  </a>
                </li>
              ))}
            </ol>
          </div>
        ))}
      </div>

      {mobile && (
        <div class="pw__phone">
          <FullPage
            src={mobile.src}
            width={mobile.width}
            height={mobile.height}
            device="mobile"
            alt={`${store.name} ${first.name.toLowerCase()} page on a phone, with its sections tagged`}
            sections={mobile.sections}
            rail={false}
            bare
          />
        </div>
      )}
    </div>
  </Window>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-pw]').forEach((root) => {
    const reduce = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
    const canvas = root.querySelector<HTMLElement>('.pw__canvas');

    // Page types switch in place (the links still work as a fallback for new tabs).
    const pageLinks = root.querySelectorAll<HTMLAnchorElement>('[data-pw-page]');
    const open = root.querySelector<HTMLAnchorElement>('.pw__open');
    pageLinks.forEach((link) => {
      link.addEventListener('click', (event) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
        event.preventDefault();
        const slug = link.dataset.pwPage!;
        pageLinks.forEach((l) =>
          l === link ? l.setAttribute('aria-current', 'true') : l.removeAttribute('aria-current'),
        );
        root.querySelectorAll<HTMLElement>('[data-pw-pane]').forEach((el) => {
          el.hidden = el.dataset.pwPane !== slug;
        });
        root.querySelectorAll<HTMLElement>('[data-pw-list]').forEach((el) => {
          el.hidden = el.dataset.pwList !== slug;
        });
        if (open) open.href = link.href;
        canvas?.scrollTo({ top: 0 });
      });
    });

    // Section rows ⇄ regions on the capture.
    const regionFor = (id: string) =>
      root.querySelector<HTMLElement>(`.pw__canvas [data-region="${CSS.escape(id)}"]`);
    const rowFor = (id: string) =>
      root.querySelector<HTMLElement>(`[data-pw-target="${CSS.escape(id)}"]`);
    const light = (id: string, on: boolean) => {
      regionFor(id)?.classList.toggle('is-hover', on);
      rowFor(id)?.classList.toggle('is-hover', on);
    };
    root.querySelectorAll<HTMLAnchorElement>('[data-pw-target]').forEach((row) => {
      const id = row.dataset.pwTarget!;
      row.addEventListener('mouseenter', () => light(id, true));
      row.addEventListener('mouseleave', () => light(id, false));
      row.addEventListener('focus', () => light(id, true));
      row.addEventListener('blur', () => light(id, false));
      row.addEventListener('click', (event) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
        const region = regionFor(id);
        if (!region || !canvas) return;
        event.preventDefault();
        const top =
          region.getBoundingClientRect().top -
          canvas.getBoundingClientRect().top +
          canvas.scrollTop -
          24;
        canvas.scrollTo({ top: Math.max(0, top), behavior: reduce() ? 'auto' : 'smooth' });
        root
          .querySelectorAll('[data-pw-target]')
          .forEach((r) => r.toggleAttribute('aria-current', r === row));
      });
    });
    root.querySelectorAll<HTMLElement>('.pw__canvas [data-region]').forEach((region) => {
      const id = region.dataset.region!;
      region.addEventListener('mouseenter', () => rowFor(id)?.classList.add('is-hover'));
      region.addEventListener('mouseleave', () => rowFor(id)?.classList.remove('is-hover'));
    });
  });
</script>

<style>
  .pw {
    position: relative;
    max-width: 1120px;
    margin-inline: auto;
  }
  /* Dark mode only: a faint vermilion bloom under the window (direction.md "Depth"). */
  .pw__glow {
    position: absolute;
    inset: 12% -6% -8%;
    z-index: -1;
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--accent-wash), transparent);
    opacity: 0;
    pointer-events: none;
  }
  :global(:root[data-theme='dark']) .pw__glow {
    opacity: 0.8;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .pw__glow {
      opacity: 0.8;
    }
  }

  .pw__status {
    display: none;
    cursor: help;
  }
  .pw__open {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    height: 24px;
    padding: 0 var(--space-2);
    border-radius: var(--radius-sm);
    color: var(--ink-2);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    white-space: nowrap;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .pw__open:hover {
    background: var(--surface-2);
    color: var(--ink);
  }
  .pw__open :global(svg) {
    transition: transform var(--dur-base) var(--ease-out);
  }
  .pw__open:hover :global(svg) {
    transform: translateX(2px);
  }

  /* ---- Body: phone first ---- */
  .pw__body {
    position: relative;
  }
  .pw__side,
  .pw__list,
  .pw__canvas {
    display: none;
  }
  .pw__phone {
    height: 440px;
    padding: var(--space-5) var(--space-6) 0;
    overflow: hidden;
    mask-image: linear-gradient(to bottom, #000 calc(100% - 120px), transparent);
  }
  .pw__phone :global(.fp__canvas) {
    max-width: 300px;
  }

  @media (min-width: 640px) {
    .pw__phone {
      display: none;
    }
    .pw__canvas {
      display: block;
      height: 520px;
      padding: var(--space-6) var(--space-6) 0;
      overflow: hidden;
      mask-image: linear-gradient(to bottom, #000 calc(100% - 96px), transparent);
    }
    .pw__canvas :global(.fp__canvas) {
      max-width: 560px;
    }
  }

  @media (min-width: 1024px) {
    .pw__status {
      display: inline-flex;
      margin-right: var(--space-2);
    }
    .pw__body {
      display: grid;
      grid-template-columns: 216px minmax(0, 1fr) 260px;
      height: 620px;
    }
    .pw__canvas {
      height: auto;
      padding: var(--space-5) var(--space-8) 0;
      mask-image: linear-gradient(to bottom, #000 calc(100% - 64px), transparent);
    }
    .pw__canvas :global(.fp__canvas) {
      max-width: 480px;
    }
    .pw__side,
    .pw__list {
      display: block;
      min-height: 0;
      background: var(--surface);
    }
    .pw__side {
      display: flex;
      flex-direction: column;
      padding: var(--space-4) var(--space-3);
      border-right: 1px solid var(--line);
    }
    .pw__list {
      border-left: 1px solid var(--line);
      overflow: hidden;
    }
  }

  /* ---- Sidebar ---- */
  .pw__store {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 var(--space-2) var(--space-4);
    margin-bottom: var(--space-3);
    border-bottom: 1px solid var(--line);
  }
  .pw__store-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .pw__store-name {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    line-height: 1.3;
  }
  .pw__store-domain {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--ink-3);
    font-size: var(--text-2xs);
  }
  .pw__label {
    padding: var(--space-3) var(--space-2) var(--space-1-5);
    font-size: var(--text-2xs);
  }
  .pw__pages {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .pw__page {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 32px;
    padding: 0 var(--space-2);
    border-radius: var(--radius-control);
    color: var(--ink-2);
    font-size: var(--text-sm);
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .pw__page:hover {
    background: var(--surface-2);
    color: var(--ink);
  }
  .pw__page[aria-current='true'] {
    background: var(--surface-2);
    color: var(--ink);
    font-weight: var(--weight-medium);
  }
  .pw__page-n {
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
  }
  .pw__fact {
    display: block;
    padding: 0 var(--space-2);
    color: var(--ink);
    font-size: var(--text-sm);
  }
  .pw__fact--link:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-color: var(--line-strong);
  }
  .pw__apps {
    display: flex;
    gap: 4px;
    padding: var(--space-2) var(--space-2) 0;
  }

  .pw__foot {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: auto;
    padding: var(--space-4) var(--space-2) 0;
    border-top: 1px solid var(--line);
  }
  .pw__teardown {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 0 calc(var(--space-2) * -1);
    padding: var(--space-2);
    border-radius: var(--radius-control);
    transition: background-color var(--dur-fast) var(--ease-out);
  }
  .pw__teardown:hover {
    background: var(--surface-2);
  }
  .pw__teardown .eyebrow {
    font-size: var(--text-2xs);
  }
  .pw__teardown-title {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    line-height: 1.35;
  }
  .pw__seen {
    color: var(--ink-3);
    font-size: var(--text-2xs);
  }

  /* ---- Capture ---- */
  .pw__canvas {
    position: relative;
    min-width: 0;
    scrollbar-width: none;
  }
  .pw__canvas::-webkit-scrollbar {
    display: none;
  }
  .pw__pane {
    padding-bottom: var(--space-8);
  }

  /* ---- Sections list ---- */
  .pw__list-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-4) var(--space-2);
  }
  .pw__list-head .eyebrow {
    font-size: var(--text-2xs);
  }
  .pw__list-meta {
    color: var(--ink-3);
    font-size: var(--text-2xs);
  }
  .pw__rows {
    display: flex;
    flex-direction: column;
    gap: 1px;
    padding: 0 var(--space-2);
  }
  .pw__row {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 34px;
    padding: 4px var(--space-2);
    border-radius: var(--radius-control);
    color: var(--ink-2);
    font-size: var(--text-sm);
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .pw__row:hover,
  .pw__row.is-hover,
  .pw__row[aria-current] {
    background: var(--surface-2);
    color: var(--ink);
  }
  .pw__row[aria-current]::before {
    content: '';
    position: absolute;
    left: 0;
    top: 9px;
    bottom: 9px;
    width: 2px;
    border-radius: 2px;
    background: var(--accent);
  }
  .pw__row-n {
    flex: none;
    width: 18px;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
  }
  .pw__row.is-hover .pw__row-n,
  .pw__row[aria-current] .pw__row-n {
    color: var(--accent-text);
  }
  .pw__row-name {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .pw__row-app {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 5px;
    max-width: 96px;
    color: var(--ink-3);
    font-size: var(--text-xs);
  }
  .pw__row-app-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
