---
/**
 * Section types as a book's table of contents: group headings, type names with dotted leaders
 * and counts. On pointer devices, hovering or focusing an entry swaps the crop shown beside the
 * list (no JS: the first entry's crop shows).
 */
import SectionCrop from '~/components/media/SectionCrop.astro';
import MonoLabel from '~/components/ui/MonoLabel.astro';
import type { SectionTypeInfo } from '~/server/api/v1/types';
import { pageTypeName } from '~/lib/taxonomy';

interface Props {
  groups: Array<{ slug: string; name: string; count: number }>;
  items: SectionTypeInfo[];
  /** Type shown in the preview before any hover. */
  featured?: string;
}
const { groups, items, featured = 'hero' } = Astro.props;

const byGroup = groups
  .map((g) => ({ ...g, items: items.filter((t) => t.group.slug === g.slug) }))
  .filter((g) => g.items.length > 0);
const withPreview = items.filter((t) => t.preview);
const first = withPreview.find((t) => t.slug === featured) ?? withPreview[0];
---

<div class="toc cols-12">
  <div class="toc__list span-8">
    {
      byGroup.map((g, gi) => (
        <section class="toc__group" aria-labelledby={`toc-${g.slug}`}>
          <h3 id={`toc-${g.slug}`} class="toc__group-title">
            <span class="toc__group-n">{String(gi + 1).padStart(2, '0')}</span>
            {g.name}
          </h3>
          <ul>
            {g.items.map((t) => (
              <li>
                <a href={t.href} class="toc__item" data-toc-type={t.preview ? t.slug : undefined}>
                  <span class="toc__name">{t.name}</span>
                  <span class="toc__leader" aria-hidden="true" />
                  <span class="toc__count num">{t.count.toLocaleString('en-US')}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>

  {
    first && (
      <figure class="toc__preview start-9" aria-hidden="true">
        {withPreview.map((t) => {
          const p = t.preview!;
          return (
            <div class="toc__plate" data-toc-plate={t.slug} hidden={t.slug !== first.slug}>
              <SectionCrop src={p.crop.src} width={p.crop.width} height={p.crop.height} device={p.device} alt="" />
              <figcaption class="toc__caption">
                <span class="toc__caption-name">{t.name}</span>
                <MonoLabel bullet={false}>
                  {p.store.display_name} · {pageTypeName(p.page_type)} · {p.device}
                  {p.is_placeholder ? ' · preview' : ''}
                </MonoLabel>
              </figcaption>
            </div>
          );
        })}
      </figure>
    )
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>('.toc').forEach((toc) => {
    const plates = toc.querySelectorAll<HTMLElement>('[data-toc-plate]');
    let current = '';
    const show = (slug: string) => {
      if (!slug || slug === current) return;
      current = slug;
      plates.forEach((p) => (p.hidden = p.dataset.tocPlate !== slug));
      toc.querySelectorAll('[data-toc-type]').forEach((a) => a.classList.toggle('is-current', (a as HTMLElement).dataset.tocType === slug));
    };
    const handler = (event: Event) => {
      const link = (event.target as HTMLElement).closest<HTMLElement>('[data-toc-type]');
      if (link) show(link.dataset.tocType!);
    };
    toc.addEventListener('pointerover', handler);
    toc.addEventListener('focusin', handler);
    const initial = toc.querySelector<HTMLElement>('[data-toc-plate]:not([hidden])');
    if (initial) show(initial.dataset.tocPlate!);
  });
</script>

<style>
  .toc__list {
    columns: 2;
    column-gap: var(--space-6);
  }
  .toc__group {
    break-inside: avoid;
    padding-bottom: var(--space-6);
  }
  .toc__group-title {
    display: flex;
    gap: var(--space-2);
    align-items: baseline;
    padding-bottom: var(--space-2);
    margin-bottom: var(--space-1);
    border-bottom: 1px solid var(--ink);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    font-weight: 450;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .toc__group-n {
    color: var(--ink-3);
  }
  .toc__item {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    padding: 7px 0;
    font-size: var(--text-md);
    line-height: 1.3;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .toc__name {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .toc__leader {
    flex: 1;
    min-width: var(--space-3);
    border-bottom: 1px dotted var(--line-strong);
    transform: translateY(-0.3em);
  }
  .toc__count {
    flex: none;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-3);
  }
  .toc__item:hover .toc__name,
  .toc__item.is-current .toc__name {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
  .toc__item.is-current .toc__count {
    color: var(--accent-text);
  }

  .toc__preview {
    display: none;
  }
  .toc__caption {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: var(--space-3);
  }
  .toc__caption-name {
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
  }

  @media (max-width: 479px) {
    .toc__list {
      column-gap: var(--space-4);
    }
    .toc__item {
      font-size: var(--text-sm);
    }
    .toc__leader {
      display: none;
    }
    .toc__count {
      margin-left: auto;
    }
  }
  @media (min-width: 1024px) {
    .toc__list {
      columns: 3;
      column-gap: var(--space-8);
    }
    .toc__preview {
      display: block;
      position: sticky;
      top: calc(var(--header-h) + var(--space-6));
      align-self: start;
    }
  }
</style>
