---
/**
 * Home hero (Attio + Stripe), the one centred block on the site: announcement pill for the
 * newest teardown → two-tone display headline → lead → Browse stores + Search ⌘K → live counter.
 *
 * "Search" is a link to /search (works without JS); with JS the header script hands it to the
 * command palette (`data-palette-open`), and the shortcut hint follows the platform.
 */
import AnnouncementPill from '~/components/ui/AnnouncementPill.astro';
import Button from '~/components/ui/Button.astro';
import Counter from '~/components/ui/Counter.astro';
import Kbd from '~/components/ui/Kbd.astro';

interface Props {
  announcement: { href: string; text: string } | null;
  lead: string;
  counter: { value: number | string; label: string }[];
  asOf: string;
}
const { announcement, lead, counter, asOf } = Astro.props;
---

<section class="hero" aria-labelledby="home-title">
  <div class="hero__inner">
    {announcement && (
      <AnnouncementPill href={announcement.href} class="hero__pill">
        {announcement.text}
      </AnnouncementPill>
    )}
    <h1 id="home-title" class="hero__title display-xl">
      Shopify themes and apps, <span class="tone-muted">on the stores that run them.</span>
    </h1>
    <p class="hero__lead lead">{lead}</p>
    <div class="hero__actions">
      <Button variant="primary" size="lg" href="/stores" arrow>
        Browse stores
      </Button>
      <Button
        variant="secondary"
        size="lg"
        href="/search"
        icon="magnifying-glass"
        class="hero__search"
        data-palette-open
      >
        Search
        <span class="hero__kbd" data-kbd-hint aria-hidden="true">
          <Kbd>⌘</Kbd>
          <Kbd>K</Kbd>
        </span>
      </Button>
    </div>
    <Counter items={counter} asOf={asOf} asOfLabel="scanned" class="hero__counter" />
  </div>
</section>

<style>
  .hero {
    padding-top: var(--space-16);
    text-align: center;
  }
  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .hero :global(.hero__pill) {
    max-width: min(100%, 420px);
    margin-bottom: var(--space-6);
  }
  .hero__title {
    max-width: 15ch;
  }
  /* Two-tone: from 768px the muted continuation gets its own line. */
  @media (min-width: 768px) {
    .hero__title {
      max-width: none;
    }
    .hero__title .tone-muted {
      display: block;
    }
  }
  .hero__lead {
    max-width: 34rem;
    margin-top: var(--space-5);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }
  .hero__kbd {
    display: none;
    gap: 3px;
    margin-left: var(--space-1);
  }
  .hero :global(.hero__counter) {
    justify-content: center;
    margin-top: var(--space-8);
  }
  @media (hover: hover) and (pointer: fine) {
    .hero__kbd {
      display: inline-flex;
    }
  }
  @media (max-width: 639px) {
    .hero {
      padding-top: var(--space-10);
    }
    .hero__actions {
      width: 100%;
    }
    .hero__actions > :global(.btn) {
      flex: 1 1 0;
      min-width: 0;
    }
    /* The date goes to its own line instead of wrapping behind a separator. */
    .hero :global(.counter__item:last-child) {
      flex-basis: 100%;
    }
    .hero :global(.counter__item:last-child .counter__sep) {
      display: none;
    }
  }
  @media (min-width: 1024px) {
    .hero {
      padding-top: var(--space-24);
    }
  }
</style>
