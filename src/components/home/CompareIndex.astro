---
/**
 * Two short indexes side by side: popular head-to-head comparisons (two marks + "A vs B") and
 * the most-asked alternatives ("Klaviyo — 14 alternatives").
 */
import AppIcon from '~/components/ui/AppIcon.astro';
import MonoLabel from '~/components/ui/MonoLabel.astro';
import { formatCount } from '~/lib/format';

export interface ComparePair {
  href: string;
  a: { name: string; icon: string | null };
  b: { name: string; icon: string | null };
  kind: 'app' | 'theme';
  note: string;
}
export interface AltEntry {
  href: string;
  name: string;
  icon: string | null;
  kind: 'app' | 'theme';
  alternatives: number;
  stores: number;
}
interface Props {
  pairs: ComparePair[];
  alternatives: AltEntry[];
  comparisonsTotal: number;
}
const { pairs, alternatives, comparisonsTotal } = Astro.props;
---

<div class="cmpi cols-12">
  <section class="cmpi__col span-7" aria-labelledby="cmpi-compare">
    <div class="cmpi__head">
      <MonoLabel as="h3" id="cmpi-compare" tone="ink">
        Side by side
      </MonoLabel>
      <span class="cmpi__count">{formatCount(comparisonsTotal)} pairs</span>
    </div>
    <ol class="cmpi__list">
      {pairs.map((p) => (
        <li>
          <a href={p.href} class="cmpi__pair">
            <span class="cmpi__marks" aria-hidden="true">
              <AppIcon src={p.a.icon} name={p.a.name} size={28} />
              <AppIcon src={p.b.icon} name={p.b.name} size={28} />
            </span>
            <span class="cmpi__names">
              {p.a.name} <span class="cmpi__vs">vs</span> {p.b.name}
            </span>
            <span class="cmpi__note">{p.note}</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="cmpi__col start-9" aria-labelledby="cmpi-alts">
    <div class="cmpi__head">
      <MonoLabel as="h3" id="cmpi-alts" tone="ink">
        Alternatives to
      </MonoLabel>
      <a href="/alternatives" class="cmpi__all">
        All alternatives <span aria-hidden="true">→</span>
      </a>
    </div>
    <ol class="cmpi__list">
      {alternatives.map((a) => (
        <li>
          <a href={a.href} class="cmpi__alt">
            <span class="cmpi__alt-name">{a.name}</span>
            <span class="cmpi__alt-n num">
              {a.alternatives} {a.alternatives === 1 ? 'alternative' : 'alternatives'}
            </span>
          </a>
        </li>
      ))}
    </ol>
  </section>
</div>

<style>
  .cmpi {
    row-gap: var(--space-10);
  }
  .cmpi__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--ink);
  }
  .cmpi__all {
    color: var(--ink-2);
    font-size: var(--text-sm);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
    white-space: nowrap;
  }
  .cmpi__count {
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .cmpi__all:hover {
    color: var(--ink);
    text-decoration-color: currentColor;
  }
  .cmpi__pair {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-areas:
      'marks names'
      'marks note';
    column-gap: var(--space-4);
    align-items: center;
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--line);
  }
  .cmpi__marks {
    grid-area: marks;
    display: flex;
  }
  .cmpi__marks :global(.app-icon + .app-icon) {
    margin-left: -8px;
    box-shadow: 0 0 0 2px var(--bg);
  }
  .cmpi__names {
    grid-area: names;
    min-width: 0;
    font-size: var(--text-lg);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-snug);
    line-height: 1.3;
  }
  .cmpi__vs {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    color: var(--ink-3);
    padding-inline: 2px;
  }
  .cmpi__note {
    grid-area: note;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .cmpi__pair:hover .cmpi__names,
  .cmpi__alt:hover .cmpi__alt-name {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
  .cmpi__alt {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--line);
  }
  .cmpi__alt-name {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: var(--text-lg);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-snug);
  }
  .cmpi__alt-n {
    flex: none;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-md);
    color: var(--ink-2);
  }
  @media (min-width: 768px) {
    .cmpi__pair {
      grid-template-columns: auto minmax(0, 1fr) auto;
      grid-template-areas: 'marks names note';
    }
  }
</style>
