---
/**
 * "How it works" (the Dovetail pattern) in a dark band inside the light page: four steps on the
 * left drive a visual on the right; the active step expands. All four visuals are built from one
 * real store page (see HowVisual).
 *
 * ≥1024: an accordion of buttons (aria-expanded) with the visual beside it; Arrow keys move
 * between steps. Without JS the first visual shows and every step's text stays readable.
 * <1024: a plain stacked list, each step with its own visual (no interaction needed).
 */
import HowVisual, { type HowData } from './HowVisual.astro';

interface Props {
  data: HowData;
  counts: { sections: number; types: number; stores: number };
}
const { data, counts } = Astro.props;

const steps = [
  {
    key: 'capture',
    title: 'Capture',
    body: `We load each curated store’s home, collection and product pages at desktop and phone width and keep the whole page, top to footer.`,
    link: { href: '/stores', label: `Browse ${counts.stores} stores` },
  },
  {
    key: 'slice',
    title: 'Slice into sections',
    body: `Every page is cut into its sections, from the announcement bar to the footer: ${counts.sections.toLocaleString('en-US')} so far, in ${counts.types} types.`,
    link: { href: '/sections', label: 'Open the sections library' },
  },
  {
    key: 'tag',
    title: 'Tag theme and apps',
    body: 'Each section is labelled with its type, the theme the store runs and the app that renders it, so you can see where an app actually shows up.',
    link: { href: '/apps', label: 'See apps by usage' },
  },
  {
    key: 'compare',
    title: 'Compare',
    body: 'Line stores up by theme and shared apps, then put two apps or two themes side by side with dated facts.',
    link: { href: '/compare', label: 'Browse comparisons' },
  },
] as const;
const shown = steps.filter((s) => s.key !== 'compare' || data.pair);
const pad = (i: number) => String(i + 1).padStart(2, '0');
---

<section class="how" data-theme="dark" aria-labelledby="how-title" data-how>
  <div class="how__head">
    <p class="eyebrow">How it works</p>
    <h2 id="how-title" class="how__title display-md">
      From a live storefront to tagged sections.{' '}
      <span class="tone-muted">Four steps, on every curated page.</span>
    </h2>
  </div>

  <!-- ≥1024: steps drive one visual -->
  <div class="how__grid">
    <div class="how__steps">
      {shown.map((s, i) => (
        <div class:list={['how__step', { 'is-active': i === 0 }]} data-how-step={i}>
          <h3 class="how__h">
            <button
              type="button"
              class="how__btn"
              id={`how-b-${i}`}
              aria-expanded={i === 0 ? 'true' : 'false'}
              aria-controls={`how-d-${i} how-v-${i}`}
            >
              <span class="how__n num">{pad(i)}</span>
              {s.title}
            </button>
          </h3>
          <div class="how__desc" id={`how-d-${i}`}>
            <p>{s.body}</p>
            <a class="how__link" href={s.link.href}>
              {s.link.label} <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      ))}
    </div>
    <div class="how__visuals">
      {shown.map((s, i) => (
        <div
          class:list={['how__panel', { 'is-active': i === 0 }]}
          id={`how-v-${i}`}
          role="region"
          aria-labelledby={`how-b-${i}`}
        >
          <HowVisual step={s.key} data={data} />
        </div>
      ))}
    </div>
  </div>

  <!-- <1024: each step stacked with its visual -->
  <ol class="how__stack">
    {shown.map((s, i) => (
      <li class="how__item">
        <h3 class="how__item-title">
          <span class="how__n num">{pad(i)}</span>
          {s.title}
        </h3>
        <p class="how__item-body">{s.body}</p>
        <HowVisual step={s.key} data={data} />
        <a class="how__link" href={s.link.href}>
          {s.link.label} <span aria-hidden="true">→</span>
        </a>
      </li>
    ))}
  </ol>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-how]').forEach((root) => {
    const steps = [...root.querySelectorAll<HTMLElement>('[data-how-step]')];
    const panels = [...root.querySelectorAll<HTMLElement>('.how__panel')];
    const buttons = steps.map((s) => s.querySelector<HTMLButtonElement>('.how__btn')!);
    const select = (index: number) => {
      steps.forEach((s, i) => s.classList.toggle('is-active', i === index));
      panels.forEach((p, i) => p.classList.toggle('is-active', i === index));
      buttons.forEach((b, i) => b.setAttribute('aria-expanded', String(i === index)));
    };
    buttons.forEach((button, i) => {
      button.addEventListener('click', () => select(i));
      button.addEventListener('keydown', (event) => {
        const delta = event.key === 'ArrowDown' ? 1 : event.key === 'ArrowUp' ? -1 : 0;
        if (!delta) return;
        event.preventDefault();
        const next = (i + delta + buttons.length) % buttons.length;
        buttons[next]!.focus();
        select(next);
      });
    });
  });
</script>

<style>
  .how {
    margin-inline: calc(var(--page-gutter) * -1);
    padding: var(--space-16) var(--page-gutter);
    background: var(--bg-subtle);
    color: var(--ink);
  }
  @media (min-width: 640px) {
    .how {
      margin-inline: 0;
      padding: var(--space-16) var(--space-10);
      border-radius: var(--radius-band);
      box-shadow: inset 0 0 0 1px var(--line);
    }
  }
  @media (min-width: 1024px) {
    .how {
      padding: var(--space-20) var(--space-16);
    }
  }
  .how__head {
    max-width: 720px;
    margin-bottom: var(--space-10);
  }
  .how__head .eyebrow {
    margin-bottom: var(--space-3);
  }
  @media (min-width: 1024px) {
    .how__head {
      margin-bottom: var(--space-12);
    }
  }

  .how__n {
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 450;
  }
  .how__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 32px;
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }
  .how__link span {
    transition: transform var(--dur-base) var(--ease-out);
  }
  .how__link:hover span {
    transform: translateX(2px);
  }

  /* ---- <1024: stacked ---- */
  .how__grid {
    display: none;
  }
  .how__stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }
  .how__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .how__item-title {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    font-size: var(--text-h3);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.015em;
  }
  .how__item-body {
    margin-bottom: var(--space-2);
    color: var(--ink-2);
    font-size: var(--text-body);
    line-height: 1.6;
  }

  /* ---- ≥1024: steps + one visual ---- */
  @media (min-width: 1024px) {
    .how__stack {
      display: none;
    }
    .how__grid {
      display: grid;
      grid-template-columns: minmax(0, 360px) minmax(0, 1fr);
      gap: var(--space-16);
      align-items: start;
    }
  }
  .how__steps {
    display: flex;
    flex-direction: column;
    box-shadow: inset 1px 0 0 var(--line);
  }
  .how__step {
    position: relative;
    padding: var(--space-4) 0 var(--space-4) var(--space-6);
  }
  .how__step::before {
    content: '';
    position: absolute;
    left: 0;
    top: var(--space-4);
    bottom: var(--space-4);
    width: 2px;
    border-radius: 2px;
    background: var(--ink);
    opacity: 0;
    transform: scaleY(0.4);
    transition:
      opacity var(--dur-base) var(--ease-out),
      transform var(--dur-slow) var(--ease-out);
  }
  .how__step.is-active::before {
    opacity: 1;
    transform: none;
  }
  .how__btn {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    width: 100%;
    min-height: 32px;
    color: var(--ink-3);
    font-size: var(--text-h3);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.015em;
    text-align: left;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .how__btn:hover,
  .is-active .how__btn {
    color: var(--ink);
  }
  .how__btn:focus-visible {
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }
  .how__desc {
    padding: var(--space-2) 0 0 calc(var(--space-3) + 2ch);
  }
  .how__desc p {
    color: var(--ink-2);
    font-size: var(--text-body);
    line-height: 1.6;
  }
  .how__desc .how__link {
    margin-top: var(--space-2);
  }
  /* With JS, only the active step is expanded. Without it every step stays readable. */
  :global(html.js) .how__step:not(.is-active) .how__desc {
    display: none;
  }

  .how__visuals {
    display: grid;
    min-width: 0;
  }
  .how__panel {
    grid-area: 1 / 1;
    min-width: 0;
    transition:
      opacity var(--dur-slow) var(--ease-out),
      transform var(--dur-slow) var(--ease-out),
      visibility 0s linear var(--dur-slow);
  }
  .how__panel:not(.is-active) {
    visibility: hidden;
    opacity: 0;
    transform: translateY(6px);
  }
  .how__panel.is-active {
    transition-delay: 0s;
  }
</style>
