---
/**
 * "Latest captures": a static mosaic of curated store pages, desktop and phone columns side by
 * side in a --bg-subtle well, cropped at the edges so it reads as "there is more". No motion.
 * Every tile links to that store's viewer at the page type and device shown; the domain shows on
 * hover/focus and is always in the link's accessible name.
 *
 * Tiles are top-of-page thumbnails in fixed-ratio boxes (nothing shifts while they load).
 * Captures keep light tokens in both themes; in dark they get a --line-strong ring.
 */
import { thumbUrl } from '~/lib/media';
import { pageTypeName, type Device } from '~/lib/taxonomy';

export interface WallTile {
  domain: string;
  name: string;
  href: string;
  pageType: string;
  device: Device;
  src: string;
  width: number;
  height: number;
  isPlaceholder: boolean;
}

interface Props {
  desktop: WallTile[];
  mobile: WallTile[];
}
const { desktop, mobile } = Astro.props;

/** The first screen of each page: a 1440×900 or 390×844 viewport. */
const VIEWPORT: Record<Device, number> = { desktop: 900, mobile: 844 };

// Columns left to right; desktop and phone alternate so any slice (a phone sees the middle)
// mixes both. `offset` staggers the columns vertically (px at 1440).
const LAYOUT: Array<{ device: Device; offset: number }> = [
  { device: 'desktop', offset: -60 },
  { device: 'mobile', offset: -150 },
  { device: 'desktop', offset: -10 },
  { device: 'mobile', offset: -90 },
  { device: 'desktop', offset: -110 },
  { device: 'mobile', offset: -30 },
  { device: 'desktop', offset: -70 },
];
const PER_COLUMN = 4;

const pools: Record<Device, WallTile[]> = { desktop, mobile };
const columnsOf = (device: Device) => LAYOUT.filter((c) => c.device === device).length;
const columns = LAYOUT.map((col, ci) => {
  const pool = pools[col.device];
  const n = columnsOf(col.device);
  const index = LAYOUT.slice(0, ci).filter((c) => c.device === col.device).length;
  // Deal round-robin so neighbouring tiles come from different stores; mobile starts further in,
  // so a phone and the desktop beside it are rarely the same store.
  const shift = col.device === 'mobile' ? Math.floor(pool.length / 2) : 0;
  const tiles = pool.length
    ? Array.from({ length: PER_COLUMN }, (_, row) => pool[(row * n + index + shift) % pool.length]!)
    : [];
  return {
    ...col,
    tiles: tiles.map((t) => {
      const cropH = Math.min(t.height, VIEWPORT[t.device]);
      return {
        ...t,
        cropH,
        thumb: thumbUrl(t.src, { cropHeight: cropH, width: t.device === 'desktop' ? 640 : 320 }),
        page: pageTypeName(t.pageType),
      };
    }),
  };
}).filter((c) => c.tiles.length > 0);
---

<div class="wall" data-wall>
  <div class="wall__cols">
    {columns.map((col) => (
      <ul
        class:list={['wall__col', `wall__col--${col.device}`]}
        style={`--offset:${col.offset}px`}
        role="list"
      >
        {col.tiles.map((t) => (
          <li>
            <a
              href={t.href}
              class:list={['wall__tile', `wall__tile--${t.device}`]}
              aria-label={`${t.name}, ${t.page.toLowerCase()} page, ${t.device}${t.isPlaceholder ? ' (layout preview)' : ''}`}
              data-theme="light"
            >
              <img
                src={t.thumb}
                alt=""
                width={t.width}
                height={t.cropH}
                loading="lazy"
                decoding="async"
              />
              <span class="wall__pill" aria-hidden="true">
                {t.domain}
              </span>
            </a>
          </li>
        ))}
      </ul>
    ))}
  </div>
</div>

<style>
  .wall {
    --d: 168px; /* desktop column width */
    --m: 78px; /* phone column width */
    --g: 10px;
    --h: 380px; /* visible height */
    --o: 0.55; /* share of the column offset used at this width */
    position: relative;
    height: var(--h);
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--bg-subtle);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  @media (min-width: 640px) {
    .wall {
      --d: 220px;
      --m: 102px;
      --g: 14px;
      --h: 460px;
      --o: 0.8;
    }
  }
  @media (min-width: 1024px) {
    .wall {
      --d: 260px;
      --m: 120px;
      --g: 16px;
      --h: 560px;
      --o: 1;
      border-radius: var(--radius-band);
    }
  }
  /* Soft edges: the mosaic fades into the well, so cropped tiles read as "more beyond". */
  .wall__cols {
    display: flex;
    justify-content: center;
    gap: var(--g);
    height: 100%;
    padding-top: var(--space-6);
    mask-image:
      linear-gradient(to bottom, transparent, #000 40px, #000 calc(100% - 120px), transparent),
      linear-gradient(to right, transparent, #000 48px, #000 calc(100% - 48px), transparent);
    mask-composite: intersect;
  }
  .wall__col {
    display: flex;
    flex: none;
    flex-direction: column;
    gap: var(--g);
    width: var(--d);
    margin-top: calc(var(--offset) * var(--o));
  }
  .wall__col--mobile {
    width: var(--m);
  }

  .wall__tile {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--capture-bg);
    box-shadow: var(--shadow-shot);
    aspect-ratio: 1440 / 900;
    transition:
      box-shadow var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }
  :global([data-theme='dark']) .wall {
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }
  .wall__tile--mobile {
    border-radius: 10px;
    aspect-ratio: 390 / 844;
  }
  .wall__tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .wall__tile:hover {
    box-shadow:
      0 0 0 1.5px var(--accent),
      var(--shadow-md);
    transform: translateY(-2px);
  }
  .wall__tile:focus-visible {
    outline-offset: 3px;
  }

  /* Domain pill (the section-tag language), shown on hover and keyboard focus. */
  .wall__pill {
    position: absolute;
    left: 6px;
    bottom: 6px;
    max-width: calc(100% - 12px);
    height: 20px;
    padding: 0 8px;
    display: inline-flex;
    align-items: center;
    border-radius: var(--radius-pill);
    background: var(--btn-bg);
    color: var(--btn-fg);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    opacity: 0;
    transform: translateY(2px);
    transition:
      opacity var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
    pointer-events: none;
  }
  .wall__tile:hover .wall__pill,
  .wall__tile:focus-visible .wall__pill {
    opacity: 1;
    transform: none;
  }
</style>
