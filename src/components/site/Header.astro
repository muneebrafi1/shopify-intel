---
/**
 * Global header (direction.md → Header). 64px (56 on mobile), sticky; transparent at the top,
 * --header-bg + blur + hairline once the page has scrolled ([data-scrolled]).
 *
 * ≥1024: logo · nav (Stores … Compare) · search trigger (input look ≥1200, icon below) · theme
 *        toggle · Sign in (ghost) · Get Pro (primary).
 * <1024: logo · search · menu button → full-height sheet (native <dialog>: focus trap, Esc,
 *        scroll lock) with nav + live counts, secondary links, theme switch and the Pro CTA.
 */
import { PRIMARY_NAV } from '~/config/site';
import Logo from './Logo.astro';
import Icon from '~/components/ui/Icon.astro';
import Kbd from '~/components/ui/Kbd.astro';
import Button from '~/components/ui/Button.astro';
import ThemeToggle from '~/components/ui/ThemeToggle.astro';
import ThemeSwitch from '~/components/ui/ThemeSwitch.astro';

interface Props {
  /** Minimal chrome: logo + theme toggle only (focused flows such as sign-in). */
  minimal?: boolean;
  /** Live counts shown in the mobile menu, keyed by nav href ("/stores"). */
  counts?: Record<string, number>;
  /** Align with gallery pages (1440 content) instead of 1200. */
  wide?: boolean;
}
const { minimal = false, counts = {}, wide = false } = Astro.props;
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);

const SECONDARY_NAV = [
  { href: '/alternatives', label: 'Alternatives' },
  { href: '/apps/categories', label: 'App categories' },
  { href: '/developers', label: 'Developers' },
  { href: '/methodology', label: 'Methodology' },
  { href: '/about', label: 'About' },
  { href: '/pro', label: 'Pricing' },
];
---

<header class="header" data-header>
  <div class:list={['header__inner', wide ? 'container--wide' : 'container']}>
    <a href="/" class="header__logo" aria-label="Home">
      <Logo />
    </a>

    {!minimal && (
      <nav class="header__nav" aria-label="Main">
        {PRIMARY_NAV.map((item) => (
          <a
            href={item.href}
            class="header__link"
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))}
      </nav>
    )}

    <div class="header__actions">
      {!minimal && (
        <a href="/search" class="search-trigger" data-palette-open aria-label="Search">
          <Icon name="magnifying-glass" size={16} />
          <span class="search-trigger__label" aria-hidden="true">
            Search
          </span>
          <span class="search-trigger__kbd" data-kbd-hint aria-hidden="true">
            <Kbd>⌘</Kbd>
            <Kbd>K</Kbd>
          </span>
        </a>
      )}
      <ThemeToggle class="header__desktop" />
      {!minimal && (
        <>
          <Button href="/sign-in" variant="ghost" class="header__desktop" data-auth-link>
            Sign in
          </Button>
          <Button href="/pro" variant="primary" class="header__desktop header__pro">
            Get Pro
          </Button>
          <button
            type="button"
            class="header__menu-btn"
            aria-label="Open menu"
            aria-haspopup="dialog"
            data-menu-open
          >
            <Icon name="list" size={20} />
          </button>
        </>
      )}
    </div>
  </div>

  {!minimal && (
    <dialog class="menu" aria-label="Menu" data-menu>
      <div class="menu__top container">
        <a href="/" aria-label="Home">
          <Logo />
        </a>
        <button type="button" class="header__menu-btn" aria-label="Close menu" data-menu-close>
          <Icon name="x" size={20} />
        </button>
      </div>
      <div class="menu__scroll">
        <nav class="menu__body container" aria-label="Main">
          <ul class="menu__primary">
            {PRIMARY_NAV.map((item) => (
              <li>
                <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                  <span>{item.label}</span>
                  {typeof counts[item.href] === 'number' && (
                    <span class="menu__count num">
                      {counts[item.href]!.toLocaleString('en-US')}
                    </span>
                  )}
                  <Icon name="caret-right" size={14} class="menu__caret" />
                </a>
              </li>
            ))}
          </ul>
          <ul class="menu__secondary">
            {SECONDARY_NAV.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))}
          </ul>
          <div class="menu__theme">
            <span class="eyebrow">Appearance</span>
            <ThemeSwitch labels />
          </div>
        </nav>
      </div>
      <div class="menu__cta container">
        <Button href="/sign-in" variant="secondary" size="lg" full data-auth-link>
          Sign in
        </Button>
        <Button href="/pro" variant="primary" size="lg" full>
          Get Pro
        </Button>
      </div>
    </dialog>
  )}
</header>

<script>
  // Public pages are cached for everyone, so "signed in" is read from the readable vt_in flag
  // cookie (no credential in it) and the header link is swapped here.
  if (/(?:^|;\s*)vt_in=1(?:;|$)/.test(document.cookie)) {
    document.querySelectorAll<HTMLAnchorElement>('a[data-auth-link]').forEach((a) => {
      a.href = '/account';
      const label = a.querySelector('.btn__label') ?? a;
      label.textContent = 'Account';
    });
  }

  // Search trigger: if the command palette is mounted it handles the event; otherwise we fall
  // through to the /search page (works without JS too).
  document.querySelectorAll<HTMLAnchorElement>('[data-palette-open]').forEach((el) => {
    el.addEventListener('click', (event) => {
      const handled = !document.dispatchEvent(
        new CustomEvent('palette:open', { cancelable: true }),
      );
      if (handled) event.preventDefault();
    });
  });

  // Show the right shortcut for the platform.
  if (!/Mac|iPhone|iPad/.test(navigator.platform)) {
    document.querySelectorAll('[data-kbd-hint] kbd:first-child').forEach((k) => {
      k.textContent = 'Ctrl';
    });
  }

  // Scrolled state: hairline + blur once the page moves.
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    let ticking = false;
    const update = () => {
      ticking = false;
      header.toggleAttribute('data-scrolled', window.scrollY > 4);
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    update();
  }

  // Mobile sheet. showModal() makes the page inert (focus stays inside) and Esc closes it.
  const menu = document.querySelector<HTMLDialogElement>('[data-menu]');
  const opener = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  opener?.addEventListener('click', () => {
    menu?.showModal();
    opener.setAttribute('aria-expanded', 'true');
  });
  menu?.addEventListener('close', () => {
    opener?.setAttribute('aria-expanded', 'false');
    opener?.focus();
  });
  menu?.querySelector('[data-menu-close]')?.addEventListener('click', () => menu.close());
  menu?.addEventListener('click', (event) => {
    if (event.target === menu) menu.close();
  });
  // The sheet only exists below 1024px; close it if the window grows past that.
  matchMedia('(min-width: 1024px)').addEventListener('change', (event) => {
    if (event.matches && menu?.open) menu.close();
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: transparent;
    box-shadow: 0 1px 0 transparent;
    transition:
      background-color var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out);
  }
  .header[data-scrolled] {
    background: var(--header-bg);
    box-shadow: 0 1px 0 var(--line);
  }
  @supports (backdrop-filter: blur(1px)) {
    .header[data-scrolled] {
      backdrop-filter: saturate(1.5) blur(12px);
    }
  }
  /* Without backdrop blur the 80% background would let text show through. */
  @supports not (backdrop-filter: blur(1px)) {
    .header[data-scrolled] {
      background: var(--bg);
    }
  }
  .header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    height: var(--header-h);
  }
  .header__logo {
    flex: none;
    display: inline-flex;
    padding: 4px;
    margin: -4px;
    border-radius: var(--radius-control);
  }

  /* Nav */
  .header__nav {
    display: none;
    align-items: center;
    gap: 2px;
  }
  .header__link {
    display: inline-flex;
    align-items: center;
    height: 32px;
    padding: 0 11px;
    border-radius: var(--radius-pill);
    font-size: var(--text-ui);
    font-weight: var(--weight-medium);
    color: var(--ink-2);
    white-space: nowrap;
    transition:
      color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }
  .header__link:hover {
    color: var(--ink);
    background: var(--surface-2);
  }
  .header__link[aria-current='page'] {
    color: var(--ink);
  }

  /* Right side */
  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin-left: auto;
  }
  .header__actions :global(.header__desktop) {
    display: none;
  }
  .search-trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    width: 40px;
    height: 40px;
    border-radius: var(--radius-control);
    color: var(--ink-2);
    font-size: var(--text-ui);
    transition:
      background-color var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .search-trigger:hover {
    background: var(--surface-2);
    color: var(--ink);
  }
  .search-trigger__label,
  .search-trigger__kbd {
    display: none;
  }
  .header__menu-btn {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    margin-right: -8px;
    border-radius: var(--radius-control);
    color: var(--ink);
    transition: background-color var(--dur-fast) var(--ease-out);
  }
  .header__menu-btn:hover {
    background: var(--surface-2);
  }

  @media (min-width: 1024px) {
    .header__nav {
      display: flex;
    }
    .header__actions {
      gap: var(--space-2);
    }
    .header__actions :global(.header__desktop) {
      display: inline-flex;
    }
    .header__actions :global(.header__pro) {
      margin-left: 2px;
    }
    .header__menu-btn {
      display: none;
    }
    .search-trigger {
      width: 36px;
      height: 36px;
    }
  }
  @media (min-width: 1200px) {
    .header__inner {
      gap: var(--space-8);
    }
    .search-trigger {
      justify-content: flex-start;
      width: 200px;
      margin-right: var(--space-1);
      padding: 0 6px 0 10px;
      background: var(--surface-2);
      box-shadow: inset 0 0 0 1px var(--line);
      color: var(--ink-3);
    }
    .search-trigger:hover {
      background: var(--surface-3);
      color: var(--ink-2);
    }
    .search-trigger__label {
      display: inline;
      flex: 1;
    }
    .search-trigger__kbd {
      display: inline-flex;
      gap: 2px;
    }
  }

  /* Mobile menu sheet */
  .menu {
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--bg);
    color: var(--ink);
    flex-direction: column;
  }
  .menu[open] {
    display: flex;
    animation: menu-in var(--dur-slow) var(--ease-out);
  }
  .menu::backdrop {
    background: transparent;
  }
  :global(html:has(dialog.menu[open])) {
    overflow: hidden;
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }
  .menu__top {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: space-between;
    height: var(--header-h);
    border-bottom: 1px solid var(--line);
  }
  .menu__scroll {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .menu__body {
    padding-block: var(--space-2) var(--space-8);
  }
  .menu__primary a {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 56px;
    border-bottom: 1px solid var(--line);
    font-size: 1.1875rem;
    font-weight: var(--weight-medium);
    letter-spacing: -0.015em;
  }
  .menu__primary a span:first-child {
    flex: 1;
  }
  .menu__primary a[aria-current='page'] {
    color: var(--ink);
  }
  .menu__primary a[aria-current='page'] span:first-child::after {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-left: 10px;
    border-radius: 50%;
    background: var(--accent);
    vertical-align: middle;
  }
  .menu__count {
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 450;
  }
  .menu :global(.menu__caret) {
    color: var(--ink-4);
  }
  .menu__secondary {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 var(--space-4);
    margin-top: var(--space-5);
  }
  .menu__secondary a {
    display: flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--text-body);
    color: var(--ink-2);
  }
  .menu__theme {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-5);
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
  }
  .menu__cta {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
    flex: none;
    padding-block: var(--space-4) calc(var(--space-4) + env(safe-area-inset-bottom));
    border-top: 1px solid var(--line);
    background: var(--bg);
  }
</style>
