---
import { SITE_NAME } from '~/config/site';
import Logo from './Logo.astro';
import Wordmark from './Wordmark.astro';

interface Props {
  /** Data freshness line, e.g. "930 stores scanned · data as of 17 Nov 2026". */
  dataNote?: string;
}
const { dataNote } = Astro.props;

const COLUMNS = [
  {
    title: 'Browse',
    links: [
      { href: '/stores', label: 'Top stores' },
      { href: '/themes', label: 'Themes' },
      { href: '/apps', label: 'Apps' },
      { href: '/sections', label: 'Sections library' },
      { href: '/teardowns', label: 'Teardowns' },
    ],
  },
  {
    title: 'Decide',
    links: [
      { href: '/compare', label: 'Compare apps & themes' },
      { href: '/alternatives', label: 'Alternatives' },
      { href: '/apps/categories', label: 'App categories' },
      { href: '/search', label: 'Search' },
    ],
  },
  {
    title: 'Product',
    links: [
      { href: '/pro', label: 'Pro' },
      { href: '/developers', label: 'API & MCP' },
      { href: '/methodology', label: 'Methodology' },
      { href: '/about', label: 'About' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { href: '/privacy', label: 'Privacy' },
      { href: '/terms', label: 'Terms' },
      { href: '/affiliate-disclosure', label: 'Affiliate disclosure' },
      { href: '/opt-out', label: 'Remove your store' },
    ],
  },
];
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <a href="/" aria-label="Home"><Logo /></a>
      <p class="footer__pitch">
        Real Shopify stores, page by page. See every theme and app on live storefronts before you
        buy or install.
      </p>
      {dataNote && <p class="footer__data num">{dataNote}</p>}
    </div>
    {
      COLUMNS.map((col) => (
        <nav class="footer__col" aria-label={col.title}>
          <h2 class="footer__title mlabel mlabel--bullet">{col.title}</h2>
          <ul>
            {col.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
  <div class="container footer__mark">
    <Wordmark />
  </div>
  <div class="container footer__legal">
    <p>© {year} {SITE_NAME}</p>
    <p>
      Independent. Not affiliated with or endorsed by Shopify Inc. Some links are affiliate links;
      they never influence what we detect or how we rank. <a href="/affiliate-disclosure"
        >How we make money</a
      >
    </p>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--space-24);
    border-top: 1px solid var(--line);
    background: var(--bg);
    color: var(--ink-2);
    font-size: var(--text-sm);
  }
  .footer__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-8) var(--space-6);
    padding-block: var(--space-12) var(--space-10);
  }
  .footer__brand {
    grid-column: 1 / -1;
    max-width: 320px;
  }
  .footer__pitch {
    margin-top: var(--space-4);
    color: var(--ink-3);
    line-height: var(--leading-normal);
  }
  .footer__data {
    margin-top: var(--space-3);
    color: var(--ink-3);
    font-size: var(--text-xs);
  }
  .footer__title {
    margin-bottom: var(--space-4);
  }
  .footer__col li + li {
    margin-top: var(--space-2);
  }
  .footer__col a {
    color: var(--ink-3);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .footer__col a:hover {
    color: var(--ink);
  }
  .footer__mark {
    padding-top: var(--space-6);
  }
  .footer__legal {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-block: var(--space-5) var(--space-8);
    border-top: 1px solid var(--line);
    margin-top: var(--space-4);
    color: var(--ink-3);
    font-size: var(--text-xs);
  }
  .footer__legal a {
    color: var(--ink-2);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
  }
  @media (min-width: 768px) {
    .footer__grid {
      grid-template-columns: 2fr repeat(4, minmax(0, 1fr));
    }
    .footer__brand {
      grid-column: auto;
    }
    .footer__legal {
      flex-direction: row;
      justify-content: space-between;
      gap: var(--space-8);
    }
    .footer__legal p:last-child {
      max-width: 640px;
      text-align: right;
    }
  }
</style>
