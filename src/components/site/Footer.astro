---
/**
 * Global footer (direction.md → Footer): --bg-subtle with a top hairline. Logo, one-line
 * description and the System/Light/Dark switch; five link columns with mono heads; a bottom
 * row with the legal entity, the data date and the Shopify disclaimer.
 */
import { LEGAL_ENTITY } from '~/config/site';
import { PRO_ENABLED } from '~/config/flags';
import Logo from './Logo.astro';
import ThemeSwitch from '~/components/ui/ThemeSwitch.astro';

interface Props {
  /** Data freshness line, e.g. "930 stores scanned · data as of 17 Nov 2026". */
  dataNote?: string;
  /** Align with gallery pages (1440 content) instead of 1200. */
  wide?: boolean;
}
const { dataNote, wide = false } = Astro.props;

const COLUMNS = [
  {
    title: 'Explore',
    links: [
      { href: '/stores', label: 'Stores' },
      { href: '/themes', label: 'Themes' },
      { href: '/apps', label: 'Apps' },
      { href: '/sections', label: 'Sections' },
      { href: '/teardowns', label: 'Teardowns' },
      { href: '/search', label: 'Search' },
    ],
  },
  {
    title: 'Compare',
    links: [
      { href: '/compare', label: 'Compare' },
      { href: '/alternatives', label: 'Alternatives' },
      { href: '/apps/categories', label: 'App categories' },
    ],
  },
  {
    title: 'Product',
    links: [
      ...(PRO_ENABLED ? [{ href: '/pro', label: 'Pro' }] : []),
      { href: '/developers', label: 'Developers' },
      { href: '/methodology', label: 'Methodology' },
    ],
  },
  {
    title: 'Company',
    links: [
      { href: '/about', label: 'About' },
      { href: '/affiliate-disclosure', label: 'Affiliate disclosure' },
      { href: '/opt-out', label: 'Remove a store' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { href: '/privacy', label: 'Privacy' },
      { href: '/terms', label: 'Terms' },
    ],
  },
];
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class:list={['footer__grid', wide ? 'container--wide' : 'container']}>
    <div class="footer__brand">
      <a href="/" aria-label="Home" class="footer__logo">
        <Logo />
      </a>
      <p class="footer__pitch">
        Shopify themes, apps and sections, shown on the live stores that use them.
      </p>
      <ThemeSwitch class="footer__theme" />
    </div>
    {COLUMNS.map((col) => (
      <nav class="footer__col" aria-label={col.title}>
        <h2 class="footer__title">{col.title}</h2>
        <ul>
          {col.links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    ))}
  </div>
  <div class:list={['footer__legal', wide ? 'container--wide' : 'container']}>
    <p>
      © {year} {LEGAL_ENTITY}
    </p>
    {dataNote && <p class="footer__data num">{dataNote}</p>}
    <p class="footer__disclaimer">Not affiliated with Shopify Inc.</p>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--space-16);
    border-top: 1px solid var(--line);
    background: var(--bg-subtle);
    color: var(--ink-2);
    font-size: var(--text-sm);
  }
  @media (min-width: 1024px) {
    .footer {
      margin-top: var(--space-24);
    }
  }
  .footer__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-8) var(--space-6);
    padding-block: var(--space-12) var(--space-10);
  }
  .footer__brand {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    max-width: 320px;
  }
  .footer__logo {
    display: inline-flex;
    padding: 4px;
    margin: -4px;
    border-radius: var(--radius-control);
  }
  .footer__pitch {
    color: var(--ink-3);
    line-height: var(--leading-normal);
  }
  .footer__brand :global(.footer__theme) {
    margin-top: var(--space-1);
  }
  .footer__title {
    margin-bottom: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 450;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .footer__col li + li {
    margin-top: var(--space-1);
  }
  .footer__col a {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    color: var(--ink-2);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .footer__col a:hover {
    color: var(--ink);
  }
  .footer__legal {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-block: var(--space-5) var(--space-8);
    border-top: 1px solid var(--line);
    color: var(--ink-3);
    font-size: var(--text-xs);
  }
  /* The hairline spans the content width, not the gutters. */
  .footer__legal {
    border-top: 0;
    background: linear-gradient(var(--line), var(--line)) top / calc(100% - 2 * var(--page-gutter))
      1px no-repeat;
  }
  @media (min-width: 768px) {
    .footer__grid {
      grid-template-columns: minmax(0, 1.6fr) repeat(5, minmax(0, 1fr));
    }
    .footer__brand {
      grid-column: auto;
      padding-right: var(--space-6);
    }
    .footer__legal {
      flex-direction: row;
      align-items: center;
      gap: var(--space-6);
    }
    .footer__disclaimer {
      margin-left: auto;
    }
  }
  @media (min-width: 768px) and (max-width: 1023px) {
    .footer__grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
    .footer__brand {
      grid-column: 1 / -1;
    }
  }
</style>
