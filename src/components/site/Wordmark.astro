---
/**
 * SITE_NAME set across the full width (inline SVG text fitted with textLength, so any brand
 * name fills the line without JavaScript). Not used by the v2 footer; kept for marketing pages
 * that want a closing wordmark. Sans, like everything else in v2.
 */
import { SITE_NAME } from '~/config/site';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const W = 1000;
// Instrument Sans at 600 averages ~0.56em per glyph; textLength corrects the remainder.
const size = Math.min(380, W / (SITE_NAME.length * 0.56));
const hasDescender = /[gjpqy]/.test(SITE_NAME);
const H = Math.round(size * (hasDescender ? 0.98 : 0.78));
const baseline = Math.round(size * 0.75);
---

<div class:list={['wordmark', className]} aria-hidden="true">
  <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid meet" role="presentation">
    <text
      x="0"
      y={baseline}
      textLength={W}
      lengthAdjust="spacingAndGlyphs"
      font-size={size}
      font-weight="600"
      font-family="Instrument Sans Variable, Instrument Sans, system-ui, sans-serif"
      fill="currentColor"
    >
      {SITE_NAME}
    </text>
  </svg>
</div>

<style>
  .wordmark {
    color: var(--ink);
    line-height: 0;
  }
  .wordmark svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .wordmark text {
    letter-spacing: -0.04em;
  }
</style>
