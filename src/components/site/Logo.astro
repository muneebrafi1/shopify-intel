---
import { SITE_NAME } from '~/config/site';

interface Props {
  /** Show the wordmark next to the mark. */
  wordmark?: boolean;
  size?: 'sm' | 'md';
  class?: string;
}
const { wordmark = true, size = 'md', class: className } = Astro.props;
---

<span class:list={['logo', `logo--${size}`, className]}>
  <!-- The mark: a page sliced into sections. Brand-agnostic, so it survives a rename. -->
  <svg class="logo__mark" viewBox="0 0 20 20" aria-hidden="true">
    <rect x="1" y="1" width="18" height="18" rx="5" fill="var(--ink)"></rect>
    <rect x="4.5" y="4.5" width="11" height="2.5" rx="1" fill="var(--accent)"></rect>
    <rect x="4.5" y="8.5" width="11" height="4" rx="1" fill="var(--bg)" opacity="0.92"></rect>
    <rect x="4.5" y="14" width="7" height="1.5" rx="0.75" fill="var(--bg)" opacity="0.5"></rect>
  </svg>
  {wordmark && <span class="logo__word">{SITE_NAME}</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--ink);
  }
  .logo__mark {
    width: 22px;
    height: 22px;
  }
  .logo--sm .logo__mark {
    width: 18px;
    height: 18px;
  }
  .logo__word {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .logo--sm .logo__word {
    font-size: var(--text-base);
  }
</style>
