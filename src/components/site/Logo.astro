---
/**
 * Logo: the vermilion mark (a store page: hero block + two lines) and SITE_NAME.
 * Brand-agnostic on purpose, so it survives the rename. Never type the brand; use SITE_NAME.
 */
import { SITE_NAME } from '~/config/site';

interface Props {
  /** Show the wordmark next to the mark. */
  wordmark?: boolean;
  size?: 'sm' | 'md';
  class?: string;
}
const { wordmark = true, size = 'md', class: className } = Astro.props;
---

<span class:list={['logo', `logo--${size}`, className]}>
  <svg class="logo__mark" viewBox="0 0 20 20" aria-hidden="true">
    <rect width="20" height="20" rx="5.5" fill="var(--accent)"></rect>
    <rect x="4.5" y="4.5" width="11" height="5.5" rx="1.5" fill="#fff"></rect>
    <rect x="4.5" y="11.6" width="11" height="1.7" rx="0.85" fill="#fff" opacity="0.72"></rect>
    <rect x="4.5" y="14.5" width="6.5" height="1.7" rx="0.85" fill="#fff" opacity="0.5"></rect>
  </svg>
  {wordmark && <span class="logo__word">{SITE_NAME}</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--ink);
  }
  .logo__mark {
    width: 22px;
    height: 22px;
    flex: none;
  }
  .logo--sm .logo__mark {
    width: 18px;
    height: 18px;
  }
  .logo__word {
    font-size: 1rem;
    font-weight: var(--weight-semibold);
    letter-spacing: -0.025em;
    line-height: 1;
  }
  .logo--sm .logo__word {
    font-size: var(--text-ui);
  }
</style>
