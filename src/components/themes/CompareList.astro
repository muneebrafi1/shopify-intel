---
/**
 * Side-by-side comparisons for a theme, as a hairline list of row links: "<other> vs <this>",
 * why the pair is listed, and how many scanned stores ran both when we know it. Two columns from
 * 768px.
 */
import Icon from '~/components/ui/Icon.astro';
import type { ComparisonLink } from '~/server/api/v1/types';

interface Props {
  slug: string;
  items: ComparisonLink[];
  class?: string;
}
const { slug, items, class: className } = Astro.props;
const REASONS: Record<string, string> = {
  'usage-top': 'Both widely used',
  'same-vendor': 'Same vendor',
  'similar-price': 'Similar price',
  'shared-apps': 'Shared apps',
};
---

<ul class:list={['cmp', className]}>
  {items.map((c) => {
    const other = c.a.slug === slug ? c.b : c.a;
    const self = c.a.slug === slug ? c.a : c.b;
    const why = REASONS[c.reason] ?? c.reason.replace(/-/g, ' ');
    return (
      <li class="cmp__item">
        <a href={c.href} class="cmp__link">
          <span class="cmp__names">
            <span class="cmp__other">{other.name}</span>
            <span class="cmp__vs">vs {self.name}</span>
          </span>
          <span class="cmp__why">
            {why}
            {typeof c.shared_stores === 'number' && c.shared_stores > 0 && (
              <>
                {' · '}
                <span class="num">{c.shared_stores}</span> shared{' '}
                {c.shared_stores === 1 ? 'store' : 'stores'}
              </>
            )}
          </span>
          <Icon name="arrow-right" size={16} class="cmp__arrow" />
        </a>
      </li>
    );
  })}
</ul>

<style>
  .cmp {
    display: grid;
    gap: 1px;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--line);
    box-shadow: 0 0 0 1px var(--line);
  }
  @media (min-width: 768px) {
    .cmp {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    /* An odd last item spans both columns so the grid has no empty cell. */
    .cmp__item:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }
  .cmp__item {
    display: flex;
    background: var(--bg);
  }
  .cmp__link {
    display: grid;
    flex: 1;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 2px var(--space-4);
    min-height: 64px;
    padding: var(--space-3) var(--space-4);
    transition: background-color var(--dur-fast) var(--ease-out);
  }
  .cmp__link:hover {
    background: var(--surface-2);
  }
  .cmp__names {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0 var(--space-2);
    min-width: 0;
  }
  .cmp__other {
    color: var(--ink);
    font-size: var(--text-body);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.01em;
  }
  .cmp__vs {
    color: var(--ink-3);
    font-size: var(--text-sm);
  }
  .cmp__why {
    grid-column: 1;
    color: var(--ink-3);
    font-size: var(--text-xs);
  }
  .cmp__link :global(.cmp__arrow) {
    grid-column: 2;
    grid-row: 1 / span 2;
    color: var(--ink-3);
    transition:
      color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }
  .cmp__link:hover :global(.cmp__arrow) {
    color: var(--ink);
    transform: translateX(2px);
  }
</style>
