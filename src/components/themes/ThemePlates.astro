---
/**
 * The plates: a theme on the real stores that run it, page by page, on a dark stage (the theme
 * page's one dark moment). Page-type tabs and a device toggle are links (URL state, no JS
 * needed); with JS they swap panels in place and keep the URL in sync.
 *
 * One store: a single large plate with crop marks and a contact-sheet caption beside it.
 * Several stores: a grid of Shot tiles, each with its caption and frame number.
 */
import Tabs from '~/components/ui/Tabs.astro';
import Segmented from '~/components/ui/Segmented.astro';
import MonoLabel from '~/components/ui/MonoLabel.astro';
import Count from '~/components/ui/Count.astro';
import Shot from '~/components/media/Shot.astro';
import { thumbCropHeight, thumbUrl } from '~/lib/media';
import { CORE_PAGE_TYPES, DEVICES, PAGE_TYPES, type Device, type PageType } from '~/lib/taxonomy';
import { formatCount } from '~/lib/format';
import type { CuratedStoreShots, ScreenshotThumb } from '~/server/api/v1/types';
import { detailHref, type PlateState } from './params';

interface Props {
  slug: string;
  name: string;
  curated: CuratedStoreShots[];
  state: PlateState;
  /** Page types that have at least one capture, in display order. */
  pages: PageType[];
  /** Detected app counts by store domain (for the captions), when known. */
  appCounts?: Map<string, number>;
  /** Extra params to keep on tab links (stores-list paging). */
  keep?: { cursor?: string | null; p?: number };
}
const { slug, name, curated, state, pages, appCounts, keep = {} } = Astro.props;

const pageName = (p: PageType) => PAGE_TYPES.find((x) => x.slug === p)?.name ?? p;
const deviceName = (d: Device) => DEVICES.find((x) => x.slug === d)?.name ?? d;
const href = (page: PageType, device: Device) =>
  detailHref(slug, { page, device }, { ...keep, hash: 'plates' });
const storePageHref = (storeHref: string, page: PageType, device: Device) => {
  const q = new URLSearchParams({ page, device });
  return `${storeHref}?${q.toString()}`;
};

const tabs = pages.map((p) => ({
  label: pageName(p),
  href: href(p, state.device),
  selected: p === state.page,
}));
const devices = DEVICES.map((d) => ({
  label: d.name,
  value: d.slug,
  icon: d.slug === 'desktop' ? ('desktop' as const) : ('device-mobile' as const),
  href: href(state.page, d.slug),
  selected: d.slug === state.device,
}));

interface Frame {
  store: CuratedStoreShots['store'];
  version: string | null;
  shot: ScreenshotThumb;
}
const panels = (pages.length ? pages : CORE_PAGE_TYPES).flatMap((page) =>
  DEVICES.map(({ slug: device }) => {
    const frames: Frame[] = curated.flatMap((c) => {
      const shot = c.pages.find((p) => p.page_type === page)?.[device];
      return shot ? [{ store: c.store, version: c.version, shot }] : [];
    });
    return { page, device, frames, current: page === state.page && device === state.device };
  }),
);

const facts = (f: Frame) => {
  const apps = appCounts?.get(f.store.domain);
  return [
    `${name}${f.version ? ` ${f.version}` : ''}`,
    typeof apps === 'number' ? `${apps} ${apps === 1 ? 'app' : 'apps'}` : null,
  ]
    .filter(Boolean)
    .join(' · ');
};
const frameNo = (i: number, n: number) =>
  `${String(i + 1).padStart(2, '0')}/${String(n).padStart(2, '0')}`;
const anyPlaceholder = curated.some((c) =>
  c.pages.some((p) => p.desktop?.is_placeholder || p.mobile?.is_placeholder),
);
const storeCount = curated.length;
---

<section
  class="plates"
  id="plates"
  aria-labelledby="plates-title"
  data-plates
  data-slug={slug}
  data-page={state.page}
  data-device={state.device}
>
  <div class="container">
    <div class="plates__head">
      <div class="plates__intro">
        <MonoLabel
          as="p"
          tone="ink"
        >{`Plates · ${pages.length} ${pages.length === 1 ? 'page' : 'pages'} × 2 devices`}</MonoLabel>
        <h2 id="plates-title" class="plates__title">
          {name} on real stores
          <Count value={storeCount} label={storeCount === 1 ? 'store' : 'stores'} />
        </h2>
      </div>
      <p class="plates__desc">
        {storeCount === 0
          ? `No store running ${name} has been captured yet. The stores below are detected; captures follow.`
          : storeCount === 1
            ? `The same theme, page by page: home, collection, product and cart on one curated store, on desktop and mobile.`
            : `The same theme on ${formatCount(storeCount)} curated stores, page by page, on desktop and mobile.`}
      </p>
    </div>

    {storeCount > 0 && (
      <div class="plates__bar">
        <Tabs items={tabs} label="Page type" class="plates__tabs" />
        <Segmented items={devices} label="Device" size="sm" class="plates__device" />
      </div>
    )}

    {storeCount === 0 ? (
      <div class="plates__empty">
        <p>Not captured yet</p>
        <a href="#stores">See the stores using {name}</a>
      </div>
    ) : (
      panels.map((panel) => (
        <div
          class="plates__panel"
          data-plate-panel
          data-page={panel.page}
          data-device={panel.device}
          hidden={!panel.current}
          role="region"
          aria-label={`${pageName(panel.page)} page, ${deviceName(panel.device)}`}
        >
          {panel.frames.length === 0 ? (
            <p class="plates__none">
              No {pageName(panel.page).toLowerCase()} page on {panel.device} yet.
            </p>
          ) : panel.frames.length === 1 ? (
            (() => {
              const f = panel.frames[0]!;
              const img = f.shot.image;
              const cropH = thumbCropHeight(img.width, img.height, panel.device);
              const link = storePageHref(f.store.href, panel.page, panel.device);
              return (
                <div class:list={['solo', `solo--${panel.device}`]}>
                  <div class="solo__stage">
                    <a href={link} class:list={['plate', `plate--${panel.device}`, 'marks']}>
                      <img
                        src={thumbUrl(img.src, {
                          cropHeight: cropH,
                          width: panel.device === 'desktop' ? 1440 : 780,
                        })}
                        alt={`${f.store.display_name} ${pageName(panel.page).toLowerCase()} page on ${name}, ${panel.device}${img.is_placeholder ? ' (layout preview)' : ''}`}
                        width={img.width}
                        height={cropH}
                        loading={panel.current ? 'eager' : 'lazy'}
                        decoding="async"
                        fetchpriority={panel.current ? 'high' : undefined}
                      />
                    </a>
                  </div>
                  <div class="solo__caption">
                    <p class="solo__frame mlabel">
                      Frame {frameNo(0, 1)} · {pageName(panel.page)} · {deviceName(panel.device)}
                    </p>
                    <h3 class="solo__store">
                      <a href={f.store.href}>{f.store.display_name}</a>
                    </h3>
                    {f.store.name && <p class="solo__domain">{f.store.domain}</p>}
                    <p class="solo__facts mlabel mlabel--bullet">{facts(f)}</p>
                    <p class="solo__facts mlabel mlabel--bullet">
                      {img.width} × {formatCount(img.height)} px
                    </p>
                    {img.is_placeholder && (
                      <p class="solo__honest">Layout preview — capture pending.</p>
                    )}
                    <a class="solo__open" href={link}>
                      Open the full {pageName(panel.page).toLowerCase()} page
                      <span aria-hidden="true">→</span>
                    </a>
                  </div>
                </div>
              );
            })()
          ) : (
            <div
              class:list={[
                'grid',
                panel.device === 'desktop' ? 'grid--shots' : 'grid--mobile-shots',
                'plates__grid',
              ]}
            >
              {panel.frames.map((f, i) => (
                <figure class="frame">
                  <Shot
                    src={f.shot.image.src}
                    width={f.shot.image.width}
                    height={f.shot.image.height}
                    device={panel.device}
                    alt={`${f.store.display_name} ${pageName(panel.page).toLowerCase()} page on ${name}, ${panel.device}${f.shot.is_placeholder ? ' (layout preview)' : ''}`}
                    href={storePageHref(f.store.href, panel.page, panel.device)}
                    eager={panel.current && i < 3}
                  />
                  <figcaption class="frame__caption">
                    <span class="frame__store">{f.store.display_name}</span>
                    <span class="frame__no mlabel">{frameNo(i, panel.frames.length)}</span>
                    <span class="frame__facts mlabel">{facts(f)}</span>
                  </figcaption>
                </figure>
              ))}
            </div>
          )}
        </div>
      ))
    )}

    {anyPlaceholder && (
      <p class="plates__note">
        <span class="mlabel mlabel--bullet">Capture plan</span>
        These plates are drawn from each page’s detected sections until the first capture run. Theme
        and section detection is real.
      </p>
    )}
  </div>
</section>

<script>
  // Swap plates in place (no reload) and keep ?page=&device= in the URL. Links still work
  // without JS, and modified clicks (new tab) are left alone.
  document.querySelectorAll<HTMLElement>('[data-plates]').forEach((root) => {
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-plate-panel]'));
    const tabs = Array.from(root.querySelectorAll<HTMLAnchorElement>('.plates__tabs a'));
    const devices = Array.from(root.querySelectorAll<HTMLAnchorElement>('.plates__device a'));
    if (!panels.length) return;
    let page = root.dataset.page ?? 'home';
    let device = root.dataset.device ?? 'desktop';

    const read = (a: HTMLAnchorElement) => {
      const u = new URL(a.href);
      return {
        page: u.searchParams.get('page') ?? 'home',
        device: u.searchParams.get('device') ?? 'desktop',
      };
    };
    const withState = (a: HTMLAnchorElement, next: { page: string; device: string }) => {
      const u = new URL(a.href);
      if (next.page === 'home') u.searchParams.delete('page');
      else u.searchParams.set('page', next.page);
      if (next.device === 'desktop') u.searchParams.delete('device');
      else u.searchParams.set('device', next.device);
      a.href = u.pathname + u.search + u.hash;
    };
    const apply = () => {
      panels.forEach((p) => (p.hidden = !(p.dataset.page === page && p.dataset.device === device)));
      tabs.forEach((a) => {
        const s = read(a);
        if (s.page === page) a.setAttribute('aria-current', 'page');
        else a.removeAttribute('aria-current');
        withState(a, { page: s.page, device });
      });
      devices.forEach((a) => {
        const s = read(a);
        if (s.device === device) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
        withState(a, { page, device: s.device });
      });
      root.dataset.page = page;
      root.dataset.device = device;
      const url = new URL(window.location.href);
      if (page === 'home') url.searchParams.delete('page');
      else url.searchParams.set('page', page);
      if (device === 'desktop') url.searchParams.delete('device');
      else url.searchParams.set('device', device);
      history.replaceState(history.state, '', url.pathname + url.search + url.hash);
    };

    root.addEventListener('click', (event) => {
      const a = (event.target as HTMLElement).closest('a');
      if (!a || !(tabs.includes(a) || devices.includes(a))) return;
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0)
        return;
      event.preventDefault();
      ({ page, device } = read(a));
      apply();
    });
  });
</script>

<style>
  /* The dark stage: tokens are re-scoped so shared components (Tabs, Segmented, Shot,
     MonoLabel, Count) render on near-black without per-component overrides. */
  .plates {
    --bg: var(--inverse);
    --surface: var(--line-inverse);
    /* v2 tokens used by shared components inside this band (compat until the redesign) */
    --surface-2: var(--inverse-2);
    --surface-3: var(--line-inverse);
    --raised: var(--line-inverse);
    --tile: var(--inverse-2);
    --tile-hover: color-mix(in srgb, var(--inverse-2) 70%, var(--line-inverse));
    --fill: var(--inverse-2);
    --fill-hover: var(--line-inverse);
    --line: var(--line-inverse);
    --line-strong: color-mix(in srgb, var(--line-inverse) 70%, var(--ink-inverse-2));
    --ink: var(--ink-inverse);
    --ink-2: var(--ink-inverse-2);
    --ink-3: color-mix(in srgb, var(--ink-inverse-2) 78%, var(--inverse));
    --ink-4: color-mix(in srgb, var(--ink-inverse-2) 45%, var(--inverse));
    --focus-ring: 0 0 0 2px var(--inverse), 0 0 0 4px var(--accent);
    background: var(--inverse);
    color: var(--ink);
    padding-block: var(--space-12) var(--space-10);
  }
  @media (min-width: 1024px) {
    .plates {
      padding-block: var(--space-16) var(--space-12);
    }
  }
  .plates__head {
    display: grid;
    gap: var(--space-4);
    align-items: end;
  }
  @media (min-width: 1024px) {
    .plates__head {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: var(--space-6);
    }
    .plates__intro {
      grid-column: span 8;
    }
    .plates__desc {
      grid-column: 9 / -1;
    }
  }
  .plates__title {
    margin-top: var(--space-3);
    font-family: var(--font-serif);
    font-size: clamp(2rem, 1.4rem + 2.2vw, 3.25rem);
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 1.02;
  }
  .plates__desc {
    color: var(--ink-2);
    font-size: var(--text-base);
    max-width: 420px;
  }
  .plates__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-3) var(--space-6);
    margin-top: var(--space-8);
    border-bottom: 1px solid var(--line);
  }
  .plates__bar :global(.plates__tabs) {
    flex: 1 1 auto;
    min-width: 0;
    border-bottom: 0;
  }
  .plates__bar :global(.plates__device) {
    margin-bottom: 7px;
  }
  .plates__panel {
    margin-top: var(--space-8);
  }
  @media (min-width: 1024px) {
    .plates__panel {
      margin-top: var(--space-12);
    }
  }

  /* One store: the plate is the hero. */
  .solo {
    display: grid;
    gap: var(--space-6);
  }
  @media (min-width: 1024px) {
    .solo {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: start;
    }
    .solo__stage {
      grid-column: 1 / span 9;
    }
    .solo__caption {
      grid-column: 10 / -1;
      position: sticky;
      top: calc(var(--header-h) + var(--space-6));
    }
  }
  .solo__stage {
    display: flex;
    justify-content: center;
    padding: 12px;
  }
  .solo--mobile .solo__stage {
    padding-block: 12px;
  }
  .plate {
    --mark: var(--ink-4);
    display: block;
    width: 100%;
    background: var(--surface);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--ink-inverse) 14%, transparent);
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .plate img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .plate:hover {
    transform: translateY(-3px);
  }
  .plate--desktop {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-xs);
  }
  .plate--desktop img {
    border-radius: inherit;
  }
  .plate--mobile {
    width: min(100%, 340px);
    aspect-ratio: 390 / 820;
    border-radius: 18px;
  }
  .plate--mobile img {
    border-radius: inherit;
  }
  @media (max-width: 639px) {
    .plate--mobile {
      width: min(78%, 300px);
    }
  }

  .solo__caption {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid var(--ink);
  }
  .solo__frame {
    color: var(--ink-3);
  }
  .solo__store {
    margin-top: var(--space-2);
    font-size: var(--text-2xl);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .solo__store a:hover {
    text-decoration: underline;
    text-underline-offset: 0.15em;
    text-decoration-thickness: 1px;
  }
  .solo__domain {
    margin-top: -4px;
    color: var(--ink-3);
    font-size: var(--text-sm);
  }
  .solo__facts {
    color: var(--ink-2);
  }
  .solo__facts:first-of-type {
    margin-top: var(--space-2);
  }
  .solo__honest {
    color: var(--ink-3);
    font-size: var(--text-xs);
  }
  .solo__open {
    display: inline-flex;
    gap: 6px;
    margin-top: var(--space-3);
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.25em;
  }
  .solo__open:hover {
    text-decoration-color: currentColor;
  }

  /* Several stores: contact sheet. */
  .frame {
    min-width: 0;
  }
  .frame__caption {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2px var(--space-3);
    margin-top: var(--space-3);
  }
  .frame__store {
    font-weight: var(--weight-medium);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .frame__facts {
    grid-column: 1 / -1;
  }

  .plates__none,
  .plates__empty {
    padding: var(--space-12) 0;
    color: var(--ink-3);
  }
  .plates__empty {
    margin-top: var(--space-8);
    border-top: 1px solid var(--line);
  }
  .plates__empty a {
    display: inline-block;
    margin-top: var(--space-2);
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .plates__note {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
    margin-top: var(--space-10);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
    color: var(--ink-3);
    font-size: var(--text-xs);
  }
</style>
