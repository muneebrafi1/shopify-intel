---
/**
 * Spec sheet rows: mono label with a square bullet on the left, value on the right, hairline
 * between rows. An optional mono note under a value carries its source and date.
 */
export interface SpecRow {
  label: string;
  value: string;
  href?: string;
  mono?: boolean;
  muted?: boolean;
  /** Small mono line under the value (source · date, or an explanation). */
  note?: string;
}
interface Props {
  rows: SpecRow[];
  class?: string;
}
const { rows, class: className } = Astro.props;
---

<dl class:list={['specs', className]}>
  {rows.map((r) => (
    <div class="specs__row">
      <dt class="mlabel mlabel--bullet">{r.label}</dt>
      <dd>
        <span
          class:list={[
            'specs__value',
            { 'specs__value--mono': r.mono, 'specs__value--muted': r.muted },
          ]}
        >
          {r.href ? <a href={r.href}>{r.value}</a> : r.value}
        </span>
        {r.note && <span class="specs__note">{r.note}</span>}
      </dd>
    </div>
  ))}
</dl>

<style>
  .specs {
    border-top: 1px solid var(--ink);
  }
  .specs__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
  }
  .specs__row dt {
    flex: none;
  }
  .specs__row dd {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    min-width: 0;
    text-align: right;
  }
  .specs__value {
    color: var(--ink);
    font-size: var(--text-base);
    overflow-wrap: anywhere;
  }
  .specs__value--mono {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: -0.01em;
  }
  .specs__value--muted {
    color: var(--ink-3);
  }
  .specs__value a {
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
    transition: text-decoration-color var(--dur-fast) var(--ease-out);
  }
  .specs__value a:hover {
    text-decoration-color: currentColor;
  }
  .specs__note {
    margin-top: 2px;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.02em;
  }
</style>
