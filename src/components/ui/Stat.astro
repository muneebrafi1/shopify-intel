---
/**
 * A number with its label. Every number on the site shows where it came from: pass `source`
 * (and `asOf`) and it is rendered as a quiet footnote line.
 */
interface Props {
  value: string | number;
  label: string;
  source?: string;
  asOf?: string;
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}
const { value, label, source, asOf, size = 'md', class: className } = Astro.props;
const display = typeof value === 'number' ? value.toLocaleString('en-US') : value;
---

<div class:list={['stat', `stat--${size}`, className]}>
  <dt class="stat__label">{label}</dt>
  <dd class="stat__value num">{display}</dd>
  {
    (source || asOf) && (
      <dd class="stat__source">
        {source}
        {source && asOf && ' · '}
        {asOf}
      </dd>
    )
  }
</div>

<style>
  .stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .stat__label {
    order: 2;
    color: var(--ink-3);
    font-size: var(--text-sm);
  }
  .stat__value {
    order: 1;
    color: var(--ink);
    font-size: var(--text-2xl);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-snug);
    line-height: 1.15;
  }
  .stat--sm .stat__value {
    font-size: var(--text-lg);
  }
  .stat--lg .stat__value {
    font-size: var(--text-4xl);
    letter-spacing: var(--tracking-tight);
  }
  .stat__source {
    order: 3;
    color: var(--ink-3);
    font-size: var(--text-2xs);
    margin-top: 2px;
  }
</style>
