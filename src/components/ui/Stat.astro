---
/**
 * A number with its label and source. Every number on the site shows where it came from: pass
 * `source` (and `asOf`) and it is rendered as a quiet footnote line. Use inside <StatList> (a
 * <dl>), or pass `as="div"` standalone.
 *
 *   <Stat value={930} label="Stores scanned" source="Our scan" asOf="17 Nov 2026" />
 *   <Stat display value="41.2%" label="Run Klaviyo" source="383 of 930 stores" />
 *
 * size sm/md/lg; `display` = big marketing numerals (sans 600, tight) with a mono label.
 */
interface Props {
  value: string | number;
  label: string;
  source?: string;
  asOf?: string;
  size?: 'sm' | 'md' | 'lg';
  /** Big numerals for page-level stat strips (home, Pro, About). */
  display?: boolean;
  class?: string;
}
const {
  value,
  label,
  source,
  asOf,
  size = 'md',
  display: big = false,
  class: className,
} = Astro.props;
const shown = typeof value === 'number' ? value.toLocaleString('en-US') : value;
---

<div class:list={['stat', `stat--${size}`, { 'stat--display': big }, className]}>
  <dt class="stat__label">{label}</dt>
  <dd class="stat__value num">{shown}</dd>
  {(source || asOf) && (
    <dd class="stat__source">
      {source}
      {source && asOf && ' · '}
      {asOf}
    </dd>
  )}
</div>

<style>
  .stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .stat__label {
    order: 2;
    color: var(--ink-3);
    font-size: var(--text-sm);
  }
  .stat__value {
    order: 1;
    color: var(--ink);
    font-size: var(--text-2xl);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.025em;
    line-height: 1.15;
  }
  .stat--sm .stat__value {
    font-size: var(--text-lg);
    letter-spacing: -0.015em;
  }
  .stat--lg .stat__value {
    font-size: var(--text-4xl);
    letter-spacing: -0.035em;
    line-height: 1.05;
  }
  .stat--display .stat__value {
    font-size: clamp(2.25rem, 1.8rem + 1.6vw, 3rem);
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .stat--display.stat--sm .stat__value {
    font-size: var(--text-3xl);
  }
  .stat--display .stat__label {
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .stat__source {
    order: 3;
    margin-top: 2px;
    color: var(--ink-3);
    font-size: var(--text-xs);
  }
  .stat--display .stat__source {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.02em;
  }
</style>
