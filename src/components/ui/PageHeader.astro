---
/**
 * Top of an index, detail or marketing page: eyebrow, title, description, count, actions.
 *
 *   <PageHeader eyebrow="Index" title="Themes" count={20}
 *     description="Every theme we track, shown on the stores that run it.">
 *     <Breadcrumbs slot="top" items={…} />
 *     <Button slot="actions" …>Compare</Button>
 *   </PageHeader>
 *
 * size: md → display-md (index + detail pages), lg → display-lg (marketing: Pro, About).
 * align: start (default) or center (only the home hero and the pricing header are centred).
 * `titleMuted` renders a two-tone title: "<title> <muted continuation>".
 * Slots: top (breadcrumbs), meta (under the description), actions (right ≥1024), default (below).
 * v1 props kept: `lede` (= description), `serif` (ignored: no serif in v2).
 */
interface Props {
  title: string;
  /** Muted continuation for a two-tone title. */
  titleMuted?: string;
  description?: string;
  /** v1 name for `description`. */
  lede?: string;
  /** Mono eyebrow above the title, e.g. "Index" or "Theme · Maestrooo". */
  eyebrow?: string;
  /** Total shown after the title in mono, e.g. 930. */
  count?: number | string;
  size?: 'md' | 'lg';
  align?: 'start' | 'center';
  /** @deprecated v1 serif title; ignored. */
  serif?: boolean;
  class?: string;
}
const {
  title,
  titleMuted,
  description,
  lede,
  eyebrow,
  count,
  size = 'md',
  align = 'start',
  class: className,
} = Astro.props;
const desc = description ?? lede;
const shownCount = typeof count === 'number' ? count.toLocaleString('en-US') : count;
---

<header class:list={['ph', `ph--${size}`, `ph--${align}`, className]}>
  <slot name="top" />
  <div class="ph__row">
    <div class="ph__text">
      {eyebrow && <p class="ph__eyebrow eyebrow">{eyebrow}</p>}
      <h1 class:list={['ph__title', size === 'lg' ? 'display-lg' : 'display-md']}>
        {title}
        {titleMuted && (
          <>
            {' '}
            <span class="tone-muted">{titleMuted}</span>
          </>
        )}
        {shownCount !== undefined && (
          <>
            {' '}
            <span class="ph__count num">{shownCount}</span>
          </>
        )}
      </h1>
      <slot name="meta" />
    </div>
    {Astro.slots.has('actions') && (
      <div class="ph__actions">
        <slot name="actions" />
      </div>
    )}
  </div>
  <slot />
</header>

<style>
  .ph {
    padding-block: var(--space-8) var(--space-6);
  }
  .ph--lg {
    padding-block: var(--space-12) var(--space-8);
  }
  @media (min-width: 1024px) {
    .ph {
      padding-block: var(--space-12) var(--space-8);
    }
    .ph--lg {
      padding-block: var(--space-20) var(--space-12);
    }
  }
  .ph :global(nav[aria-label='Breadcrumb']) {
    margin-bottom: var(--space-5);
  }
  .ph__row {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  @media (min-width: 1024px) {
    .ph__row {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: var(--space-10);
    }
  }
  .ph__text {
    min-width: 0;
    max-width: 760px;
  }
  .ph__eyebrow {
    margin-bottom: var(--space-3);
  }
  .ph__count {
    display: inline-block;
    margin-left: 0.35em;
    font-family: var(--font-mono);
    font-size: max(0.4em, 13px);
    font-weight: 450;
    letter-spacing: 0;
    color: var(--ink-3);
    vertical-align: 0.4em;
  }
  .ph__desc {
    margin-top: var(--space-3);
    max-width: 600px;
  }
  .ph--lg .ph__desc {
    margin-top: var(--space-4);
  }
  .ph__actions {
    display: flex;
    flex: none;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .ph--center {
    text-align: center;
  }
  .ph--center .ph__row {
    align-items: center;
    flex-direction: column;
  }
  .ph--center .ph__text {
    margin-inline: auto;
  }
  .ph--center .ph__desc {
    margin-inline: auto;
  }
  .ph--center .ph__eyebrow {
    justify-content: center;
  }
  .ph--center .ph__actions {
    justify-content: center;
  }
</style>
