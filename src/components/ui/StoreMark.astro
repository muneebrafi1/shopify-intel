---
/**
 * A store's avatar until we capture real favicons: a rounded square in the store's own tone
 * (the same palette as its captures) with its initial. 32px by default. Decorative; the name is
 * always shown beside it.
 */
import { toneFor } from '~/lib/tone';

interface Props {
  domain: string;
  /** Used for the initial (falls back to the domain). */
  name?: string | null;
  size?: number;
  class?: string;
}
const { domain, name, size = 32, class: className } = Astro.props;
const t = toneFor(domain);
const initial = (name || domain)
  .replace(/^www\./, '')
  .trim()
  .charAt(0)
  .toUpperCase();
const radius = Math.max(4, Math.round(size * 0.25));
---

<span
  class:list={['store-mark', className]}
  style={`--s:${size}px;--r:${radius}px;--mark-bg:${t.mark};--mark-fg:${t.markInk}`}
  aria-hidden="true"
>
  {initial}
</span>

<style>
  .store-mark {
    position: relative;
    display: inline-grid;
    place-items: center;
    flex: none;
    width: var(--s);
    height: var(--s);
    border-radius: var(--r);
    background: var(--mark-bg);
    color: var(--mark-fg);
    font-size: calc(var(--s) * 0.44);
    font-weight: var(--weight-semibold);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .store-mark::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px var(--shot-ring);
  }
</style>
