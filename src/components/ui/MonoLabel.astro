---
/**
 * Mono eyebrow label: `DETECTED 17 NOV 2026` (same look as the `.eyebrow` class).
 * v1 drew a square bullet; `bullet` is accepted and ignored in v2. tone: muted | ink
 * ('accent' is accepted and renders like muted: accent text is reserved for state).
 */
interface Props {
  bullet?: boolean;
  tone?: 'muted' | 'ink' | 'accent';
  as?: 'span' | 'p' | 'h2' | 'h3' | 'dt' | 'div';
  class?: string;
  id?: string;
}
const { bullet = true, tone = 'muted', as: Tag = 'span', class: className, id } = Astro.props;
---

<Tag
  id={id}
  class:list={[
    'mlabel',
    {
      'mlabel--bullet': bullet,
      'mlabel--ink': tone === 'ink',
      'mlabel--accent': tone === 'accent',
    },
    className,
  ]}
>
  <slot />
</Tag>
