---
/** Mono spec label: `■ DETECTED 17 NOV 2026`. The square bullet is on by default. */
interface Props {
  bullet?: boolean;
  tone?: 'muted' | 'ink' | 'accent';
  as?: 'span' | 'p' | 'h2' | 'h3' | 'dt' | 'div';
  class?: string;
  id?: string;
}
const { bullet = true, tone = 'muted', as: Tag = 'span', class: className, id } = Astro.props;
---

<Tag
  id={id}
  class:list={[
    'mlabel',
    { 'mlabel--bullet': bullet, 'mlabel--ink': tone === 'ink', 'mlabel--accent': tone === 'accent' },
    className,
  ]}><slot /></Tag
>
