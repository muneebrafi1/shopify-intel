---
/** A row of <Stat> items with hairline dividers. Wraps to two columns on small screens. */
interface Props {
  class?: string;
  columns?: number;
}
const { class: className, columns = 4 } = Astro.props;
---

<dl class:list={['stat-list', className]} style={`--cols:${columns}`}>
  <slot />
</dl>

<style>
  .stat-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5) var(--space-6);
  }
  @media (min-width: 768px) {
    .stat-list {
      grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    }
    .stat-list > :global(* + *) {
      border-left: 1px solid var(--line);
      padding-left: var(--space-6);
    }
  }
</style>
