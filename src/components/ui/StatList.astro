---
/**
 * A row of <Stat> items with hairline dividers; two columns on small screens.
 * `boxed` puts the row in a card with hairline cells (Stripe-style metrics strip).
 */
interface Props {
  class?: string;
  columns?: number;
  boxed?: boolean;
}
const { class: className, columns = 4, boxed = false } = Astro.props;
---

<dl
  class:list={['stat-list', { 'stat-list--boxed': boxed }, className]}
  style={`--cols:${columns}`}
>
  <slot />
</dl>

<style>
  .stat-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6) var(--space-6);
  }
  @media (min-width: 768px) {
    .stat-list {
      grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    }
    .stat-list:not(.stat-list--boxed) > :global(* + *) {
      border-left: 1px solid var(--line);
      padding-left: var(--space-6);
    }
  }
  .stat-list--boxed {
    gap: 1px;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--line);
    box-shadow: 0 0 0 1px var(--line);
  }
  .stat-list--boxed > :global(*) {
    padding: var(--space-5);
    background: var(--surface);
  }
  @media (min-width: 1024px) {
    .stat-list--boxed > :global(*) {
      padding: var(--space-6);
    }
  }
</style>
