---
import type { HTMLAttributes } from 'astro/types';

type Props = Omit<HTMLAttributes<'input'>, 'type'> & { label: string; hint?: string; type?: 'checkbox' | 'radio' };
const { label, hint, type = 'checkbox', class: className, ...rest } = Astro.props;
---

<label class:list={['check', className]}>
  <input type={type} {...rest} />
  <span class="check__text">
    <span class="check__label">{label}</span>
    {hint && <span class="check__hint">{hint}</span>}
  </span>
</label>

<style>
  .check {
    display: flex;
    gap: var(--space-2);
    align-items: flex-start;
    cursor: pointer;
    font-size: var(--text-base);
  }
  .check input {
    flex: none;
    width: 16px;
    height: 16px;
    margin-top: 2px;
    accent-color: var(--ink);
  }
  .check__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .check__hint {
    color: var(--ink-3);
    font-size: var(--text-xs);
  }
</style>
