---
/**
 * v1 name for <BrowseBar>. Same props, same markup; kept so pages that import FilterBar keep
 * working. New code should import BrowseBar (it adds `search`, `pills` and `sticky`).
 */
import BrowseBar from './BrowseBar.astro';
export type { FilterOption, FilterGroup, SortOption, BrowseSearch } from './BrowseBar.astro';

type Props = import('astro/types').ComponentProps<typeof BrowseBar>;
const props = Astro.props;
---

<BrowseBar {...props} />
