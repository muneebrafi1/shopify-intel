---
/**
 * 3-way theme preference: System / Light / Dark (footer, mobile menu sheet, settings).
 * A radiogroup; the selected look comes from <html data-theme-pref> (set before paint), and
 * client/theme.ts sets aria-checked, handles clicks and arrow keys (delegated).
 */
import Icon from './Icon.astro';
import type { IconName } from './icons';

interface Props {
  /** Show text labels next to the icons. */
  labels?: boolean;
  size?: 'sm' | 'md';
  class?: string;
}
const { labels = false, size = 'sm', class: className } = Astro.props;
const OPTIONS: { value: 'system' | 'light' | 'dark'; label: string; icon: IconName }[] = [
  { value: 'system', label: 'System', icon: 'monitor' },
  { value: 'light', label: 'Light', icon: 'sun' },
  { value: 'dark', label: 'Dark', icon: 'moon' },
];
---

<div
  class:list={['tswitch', `tswitch--${size}`, { 'tswitch--labels': labels }, className]}
  role="radiogroup"
  aria-label="Theme"
  data-theme-switch
>
  {OPTIONS.map((o) => (
    <button
      type="button"
      role="radio"
      class="tswitch__item"
      aria-checked={o.value === 'system' ? 'true' : 'false'}
      tabindex={o.value === 'system' ? 0 : -1}
      data-theme-set={o.value}
      title={labels ? undefined : o.label}
    >
      <Icon name={o.icon} size={size === 'sm' ? 14 : 16} />
      <span class:list={[{ 'visually-hidden': !labels }]}>{o.label}</span>
    </button>
  ))}
</div>

<style>
  .tswitch {
    --h: 30px;
    display: inline-flex;
    gap: 2px;
    height: var(--h);
    padding: 3px;
    border-radius: var(--radius-pill);
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .tswitch--md {
    --h: 36px;
  }
  .tswitch__item {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    height: 100%;
    aspect-ratio: 1;
    border-radius: var(--radius-pill);
    color: var(--ink-3);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    transition:
      color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out);
  }
  .tswitch--labels .tswitch__item {
    aspect-ratio: auto;
    padding: 0 12px;
    flex: 1;
  }
  .tswitch--md .tswitch__item {
    font-size: var(--text-sm);
  }
  .tswitch__item:hover {
    color: var(--ink);
  }
  .tswitch__item:focus-visible {
    outline-offset: 0;
  }
  /* Selected look from the stored preference on <html> (correct before any JS). */
  :global(html[data-theme-pref='system']) .tswitch__item[data-theme-set='system'],
  :global(html[data-theme-pref='light']) .tswitch__item[data-theme-set='light'],
  :global(html[data-theme-pref='dark']) .tswitch__item[data-theme-set='dark'],
  :global(html:not([data-theme-pref])) .tswitch__item[data-theme-set='system'] {
    background: var(--raised);
    color: var(--ink);
    box-shadow:
      0 0 0 1px var(--line),
      var(--shadow-xs);
  }
  @media (pointer: coarse) {
    .tswitch__item::before {
      content: '';
      position: absolute;
      inset: -7px -2px;
    }
  }
</style>
