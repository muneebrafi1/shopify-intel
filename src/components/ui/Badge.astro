---
import Icon from './Icon.astro';
import type { IconName } from './icons';

type Tone = 'neutral' | 'outline' | 'accent' | 'positive' | 'caution' | 'inverse';
interface Props {
  tone?: Tone;
  icon?: IconName;
  title?: string;
  class?: string;
}
const { tone = 'neutral', icon, title, class: className } = Astro.props;
---

<span class:list={['badge', `badge--${tone}`, className]} title={title}>
  {icon && <Icon name={icon} size={12} />}
  <slot />
</span>

<style>
  .badge {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 4px;
    height: 20px;
    padding: 0 7px;
    border-radius: var(--radius-pill);
    font-size: var(--text-2xs);
    font-weight: var(--weight-medium);
    line-height: 1;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }
  .badge--neutral {
    background: var(--fill);
    color: var(--ink-2);
  }
  .badge--outline {
    box-shadow: inset 0 0 0 1px var(--line-strong);
    color: var(--ink-2);
  }
  .badge--accent {
    background: var(--accent-soft);
    color: var(--accent-text);
  }
  .badge--positive {
    background: var(--positive-soft);
    color: var(--positive);
  }
  .badge--caution {
    background: var(--caution-soft);
    color: var(--caution);
  }
  .badge--inverse {
    background: var(--inverse);
    color: var(--ink-inverse);
  }
</style>
