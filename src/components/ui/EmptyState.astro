---
/**
 * Nothing to show: say what is missing, why, and offer one way out. A dashed card, left-aligned
 * by default (direction.md). Never an icon in a circle.
 *
 *   <EmptyState title="No themes match these filters"
 *     body="Try fewer filters, or browse every theme.">
 *     <Button href="/themes">Clear filters</Button>
 *   </EmptyState>
 */
import Icon from './Icon.astro';
import type { IconName } from './icons';

interface Props {
  title: string;
  body?: string;
  /** Optional 20px line icon above the title (no circle). */
  icon?: IconName;
  align?: 'start' | 'center';
  size?: 'sm' | 'md';
  /** Heading level for the title. */
  level?: 2 | 3;
  class?: string;
}
const {
  title,
  body,
  icon,
  align = 'start',
  size = 'md',
  level = 2,
  class: className,
} = Astro.props;
const H = `h${level}` as 'h2' | 'h3';
---

<div class:list={['empty', `empty--${align}`, `empty--${size}`, className]}>
  {icon && <Icon name={icon} size={20} class="empty__icon" />}
  <H class="empty__title">{title}</H>
  {body && <p class="empty__body">{body}</p>}
  {Astro.slots.has('default') && (
    <div class="empty__actions">
      <slot />
    </div>
  )}
</div>

<style>
  .empty {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    padding: var(--space-8) var(--space-6);
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-card);
    background: var(--bg-subtle);
  }
  @media (min-width: 1024px) {
    .empty--md {
      padding: var(--space-10) var(--space-8);
    }
  }
  .empty--sm {
    padding: var(--space-5);
  }
  .empty--center {
    align-items: center;
    text-align: center;
  }
  .empty :global(.empty__icon) {
    margin-bottom: var(--space-1);
    color: var(--ink-3);
  }
  .empty__title {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.015em;
    line-height: 1.3;
  }
  .empty--sm .empty__title {
    font-size: var(--text-body);
  }
  .empty__body {
    max-width: 480px;
    color: var(--ink-3);
    font-size: var(--text-ui);
    line-height: var(--leading-normal);
  }
  .empty__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }
</style>
