---
/** Keyboard key: <Kbd>⌘</Kbd><Kbd>K</Kbd>. Mono 11px on --surface with a --line-strong border. */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<kbd class:list={['kbd', className]}>
  <slot />
</kbd>

<style>
  .kbd {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 20px;
    height: 20px;
    padding: 0 5px;
    border-radius: var(--radius-xs);
    background: var(--surface);
    box-shadow:
      inset 0 0 0 1px var(--line-strong),
      0 1px 0 var(--line-strong);
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    font-weight: 450;
    line-height: 1;
  }
</style>
