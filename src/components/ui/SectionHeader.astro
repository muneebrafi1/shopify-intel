---
/**
 * Heading for a block within a page: optional mono label, title with superscript count,
 * description, and a "view all" link. Sits on a hairline (catalogue style).
 */
import Count from './Count.astro';
import MonoLabel from './MonoLabel.astro';

interface Props {
  title: string;
  description?: string;
  /** Mono label above the title, e.g. "02 — Themes". */
  label?: string;
  href?: string;
  linkLabel?: string;
  count?: number;
  level?: 2 | 3;
  /** Draw the top hairline. */
  rule?: boolean;
  id?: string;
  class?: string;
}
const {
  title,
  description,
  label,
  href,
  linkLabel = 'View all',
  count,
  level = 2,
  rule = false,
  id,
  class: className,
} = Astro.props;
const H = `h${level}` as 'h2' | 'h3';
---

<div class:list={['sh', { 'sh--rule': rule }, className]}>
  <div class="sh__text">
    {label && <MonoLabel as="p" class="sh__label">{label}</MonoLabel>}
    <H class="sh__title" id={id}>
      {title}{typeof count === 'number' && <Count value={count} />}
    </H>
    {description && <p class="sh__desc">{description}</p>}
  </div>
  {
    (href || Astro.slots.has('default')) && (
      <div class="sh__actions">
        <slot />
        {href && (
          <a class="sh__link" href={href}>
            {linkLabel}
            <span aria-hidden="true">→</span>
          </a>
        )}
      </div>
    )
  }
</div>

<style>
  .sh {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }
  .sh--rule {
    padding-top: var(--space-4);
    border-top: 1px solid var(--ink);
  }
  .sh__text {
    min-width: 0;
  }
  .sh__label {
    margin-bottom: var(--space-3);
  }
  .sh__title {
    font-size: clamp(1.375rem, 1.1rem + 0.9vw, 1.875rem);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.025em;
    line-height: 1.1;
  }
  h3.sh__title {
    font-size: var(--text-lg);
    letter-spacing: var(--tracking-snug);
  }
  .sh__desc {
    margin-top: var(--space-2);
    color: var(--ink-3);
    font-size: var(--text-base);
    max-width: 560px;
  }
  .sh__actions {
    display: flex;
    flex: none;
    align-items: center;
    gap: var(--space-3);
  }
  .sh__link {
    display: inline-flex;
    gap: 6px;
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    white-space: nowrap;
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.25em;
    transition: text-decoration-color var(--dur-fast) var(--ease-out);
  }
  .sh__link:hover {
    text-decoration-color: currentColor;
  }
  .sh__link span {
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .sh__link:hover span {
    transform: translateX(2px);
  }
</style>
