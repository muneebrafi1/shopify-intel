---
/**
 * One row inside <IndexList>: rank · title (+ subtitle) · cells. On small screens only the rank,
 * title and cells marked `mobile` are shown.
 * `numbering`: 'specimen' prints "N°001" (v1; stores/themes e2e still assert it) — new pages
 * should pass 'rank' ("1") or 'none'.
 */
import { thumbCropHeight, thumbUrl } from '~/lib/media';
import type { Device } from '~/lib/taxonomy';

export interface IndexCell {
  value: string;
  mono?: boolean;
  /** Editorial parenthetical in the serif, e.g. "(13 stores)". */
  serif?: boolean;
  muted?: boolean;
  /** Keep this cell visible on small screens (shown at the end of the row). */
  mobile?: boolean;
  href?: string;
}

interface Props {
  n: number;
  href: string;
  title: string;
  subtitle?: string;
  cells?: IndexCell[];
  preview?: { src: string; width: number; height: number; device?: Device } | null;
  numbering?: 'specimen' | 'rank' | 'none';
  class?: string;
}
const {
  n,
  href,
  title,
  subtitle,
  cells = [],
  preview,
  numbering = 'specimen',
  class: className,
} = Astro.props;
const device = preview?.device ?? 'desktop';
const previewSrc = preview
  ? thumbUrl(preview.src, {
      cropHeight: thumbCropHeight(preview.width, preview.height, device),
      width: 600,
    })
  : undefined;
const num =
  numbering === 'specimen'
    ? `N°${String(n).padStart(3, '0')}`
    : numbering === 'rank'
      ? String(n)
      : '';
---

<li
  class:list={['irow', className]}
  data-preview={previewSrc}
  data-preview-device={preview ? device : undefined}
>
  <a href={href} class="irow__link">
    <span class="irow__n">{num}</span>
    <span class="irow__title">
      <span class="irow__name">{title}</span>
      {subtitle && <span class="irow__sub">{subtitle}</span>}
    </span>
    {cells.map((c, i) => (
      <span
        class:list={[
          'irow__cell',
          {
            'irow__cell--mono': c.mono,
            'irow__cell--serif': c.serif,
            'irow__cell--muted': c.muted,
            'irow__cell--mobile': c.mobile,
            'irow__cell--end': i === cells.length - 1,
          },
        ]}
      >
        {c.value}
      </span>
    ))}
  </a>
</li>

<style>
  .irow {
    border-bottom: 1px solid var(--line);
  }
  .irow__link {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--space-3);
    padding: 12px var(--space-2);
    margin-inline: calc(var(--space-2) * -1);
    border-radius: var(--radius-control);
    transition: background-color var(--dur-fast) var(--ease-out);
  }
  .irow__link:hover {
    background: var(--surface-2);
  }
  .irow__n {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }
  .irow__title {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .irow__name {
    font-size: var(--text-body);
    font-weight: var(--weight-medium);
    letter-spacing: -0.01em;
    line-height: 1.3;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .irow__sub {
    color: var(--ink-3);
    font-size: var(--text-sm);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .irow__cell {
    display: none;
    min-width: 0;
    color: var(--ink-2);
    font-size: var(--text-ui);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .irow__cell--mobile {
    display: block;
    text-align: right;
  }
  .irow__cell--mono {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
  }
  .irow__cell--serif {
    color: var(--ink-3);
  }
  .irow__cell--muted {
    color: var(--ink-3);
  }
  @media (min-width: 900px) {
    .irow__link {
      grid-template-columns: var(--index-cols);
      gap: var(--space-4);
      align-items: center;
      min-height: 52px;
      padding-block: 8px;
    }
    .irow__cell {
      display: block;
      text-align: left;
    }
    .irow__cell--end {
      text-align: right;
    }
    .irow__sub {
      display: none;
    }
  }
</style>
