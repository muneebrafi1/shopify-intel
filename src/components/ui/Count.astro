---
/**
 * Count after a title or label ("Themes 20"): a quiet mono number, sized relative to its
 * parent. (v1 drew it as a superscript; kept as <sup> for markup compatibility.)
 */
interface Props {
  value: number | string;
  label?: string;
  class?: string;
}
const { value, label, class: className } = Astro.props;
const text = typeof value === 'number' ? value.toLocaleString('en-US') : value;
---

<sup class:list={['count-sup', className]} aria-label={label ? `${text} ${label}` : undefined}>
  {text}
</sup>
