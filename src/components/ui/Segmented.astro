---
import Icon from './Icon.astro';
import type { IconName } from './icons';

export interface SegmentedItem {
  label: string;
  value: string;
  href?: string;
  icon?: IconName;
  selected?: boolean;
  /** Visually hide the label (icon-only segment); label is still announced. */
  iconOnly?: boolean;
  count?: number;
}
interface Props {
  items: SegmentedItem[];
  label: string;
  size?: 'sm' | 'md';
  /** Name used by client scripts to listen for changes (button mode). */
  name?: string;
  class?: string;
}
const { items, label, size = 'md', name, class: className } = Astro.props;
---

<div class:list={['seg', `seg--${size}`, className]} role="group" aria-label={label} data-segmented={name}>
  {
    items.map((item) => {
      const inner = (
        <>
          {item.icon && <Icon name={item.icon} size={size === 'sm' ? 14 : 16} />}
          <span class:list={[{ 'visually-hidden': item.iconOnly }]}>{item.label}</span>
          {typeof item.count === 'number' && <span class="seg__count num">{item.count}</span>}
        </>
      );
      return item.href ? (
        <a
          href={item.href}
          class="seg__item"
          aria-current={item.selected ? 'true' : undefined}
          data-value={item.value}
          rel="nofollow"
        >
          {inner}
        </a>
      ) : (
        <button type="button" class="seg__item" aria-pressed={item.selected ? 'true' : 'false'} data-value={item.value}>
          {inner}
        </button>
      );
    })
  }
</div>

<style>
  .seg {
    display: inline-flex;
    flex: none;
    padding: 2px;
    gap: 2px;
    border-radius: var(--radius-pill);
    background: var(--fill);
  }
  .seg__item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    height: 30px;
    padding: 0 12px;
    border-radius: var(--radius-pill);
    color: var(--ink-3);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    white-space: nowrap;
    transition:
      color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }
  .seg--sm .seg__item {
    height: 26px;
    padding: 0 10px;
    font-size: var(--text-xs);
  }
  .seg__item:hover {
    color: var(--ink);
  }
  .seg__item:focus-visible {
    border-radius: var(--radius-pill);
  }
  .seg__item[aria-current='true'],
  .seg__item[aria-pressed='true'] {
    background: var(--surface);
    color: var(--ink);
    box-shadow: 0 0 0 1px rgb(25 24 22 / 0.06), 0 1px 2px rgb(25 24 22 / 0.08);
  }
  .seg__count {
    color: var(--ink-3);
    font-weight: var(--weight-regular);
  }
</style>
