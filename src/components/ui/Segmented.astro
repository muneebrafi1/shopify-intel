---
/**
 * Pill-track switch for small 2–3-way choices: Desktop/Mobile, Monthly/Yearly, Grid/List.
 * A --surface thumb slides to the selected item (client/indicator.ts); without JS the selected
 * item draws its own thumb.
 *
 *   Links (URL state; preferred):   items[].href + selected → aria-current="true"
 *   Buttons (client state):         no href → aria-pressed; a click selects the item and fires
 *                                   `segmented:change` on the group ({ detail: { name, value } }).
 *
 *   <Segmented label="Device" size="sm" items={[
 *     { label: 'Desktop', value: 'desktop', icon: 'desktop', href: '?device=desktop', selected: true },
 *     { label: 'Mobile', value: 'mobile', icon: 'device-mobile', href: '?device=mobile' },
 *   ]} />
 */
import Icon from './Icon.astro';
import type { IconName } from './icons';

export interface SegmentedItem {
  label: string;
  value: string;
  href?: string;
  icon?: IconName;
  selected?: boolean;
  /** Visually hide the label (icon-only segment); label is still announced. */
  iconOnly?: boolean;
  count?: number;
}
interface Props {
  items: SegmentedItem[];
  label: string;
  size?: 'sm' | 'md';
  /** Stretch to the container width with equal segments. */
  full?: boolean;
  /** Name used by client scripts to listen for changes (button mode). */
  name?: string;
  class?: string;
}
const { items, label, size = 'md', full = false, name, class: className } = Astro.props;
---

<div
  class:list={['seg', `seg--${size}`, { 'seg--full': full }, className]}
  role="group"
  aria-label={label}
  data-segmented={name}
  data-indicator
>
  {items.map((item) => {
    const inner = (
      <>
        {item.icon && <Icon name={item.icon} size={size === 'sm' ? 14 : 16} />}
        <span class:list={[{ 'visually-hidden': item.iconOnly }]}>{item.label}</span>
        {typeof item.count === 'number' && <span class="seg__count num">{item.count}</span>}
      </>
    );
    return item.href ? (
      <a
        href={item.href}
        class:list={['seg__item', { 'seg__item--icon': item.iconOnly }]}
        aria-current={item.selected ? 'true' : undefined}
        data-value={item.value}
        rel="nofollow"
        title={item.iconOnly ? item.label : undefined}
      >
        {inner}
      </a>
    ) : (
      <button
        type="button"
        class:list={['seg__item', { 'seg__item--icon': item.iconOnly }]}
        aria-pressed={item.selected ? 'true' : 'false'}
        data-value={item.value}
        title={item.iconOnly ? item.label : undefined}
      >
        {inner}
      </button>
    );
  })}
</div>

<script>
  import '~/components/ui/client/indicator';

  // Button mode: select on click and announce the change. Link mode is plain navigation (pages
  // may intercept it and flip aria-current themselves; the indicator follows either way).
  document.addEventListener('click', (event) => {
    const item = (event.target as Element | null)?.closest<HTMLButtonElement>(
      '.seg button.seg__item',
    );
    const group = item?.closest<HTMLElement>('.seg');
    if (!item || !group || item.getAttribute('aria-pressed') === 'true') return;
    group.querySelectorAll('button.seg__item').forEach((b) => {
      b.setAttribute('aria-pressed', String(b === item));
    });
    group.dispatchEvent(
      new CustomEvent('segmented:change', {
        bubbles: true,
        detail: { name: group.dataset.segmented, value: item.dataset.value },
      }),
    );
  });
</script>

<style>
  .seg {
    --seg-h: 36px;
    position: relative;
    isolation: isolate;
    display: inline-flex;
    flex: none;
    height: var(--seg-h);
    padding: 3px;
    gap: 2px;
    border-radius: var(--radius-pill);
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .seg--sm {
    --seg-h: 30px;
  }
  .seg--full {
    display: flex;
    width: 100%;
  }
  .seg--full .seg__item {
    flex: 1;
  }
  .seg__item {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    height: 100%;
    padding: 0 12px;
    border-radius: var(--radius-pill);
    color: var(--ink-3);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    white-space: nowrap;
    transition:
      color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }
  .seg--sm .seg__item {
    padding: 0 10px;
    font-size: var(--text-xs);
  }
  .seg__item--icon {
    aspect-ratio: 1;
    padding: 0;
  }
  .seg--sm .seg__item--icon {
    padding: 0;
  }
  .seg__item:hover {
    color: var(--ink);
  }
  .seg__item:focus-visible {
    outline-offset: 0;
  }
  .seg__item[aria-current='true'],
  .seg__item[aria-pressed='true'] {
    color: var(--ink);
  }
  .seg__count {
    color: var(--ink-3);
    font-weight: var(--weight-regular);
  }

  /* Thumb: drawn by the selected item until the sliding indicator is measured. */
  .seg:not([data-indicator-ready]) .seg__item:is([aria-current='true'], [aria-pressed='true']),
  .seg[data-indicator-ready]::before {
    background: var(--raised);
    box-shadow:
      0 0 0 1px var(--line),
      var(--shadow-xs),
      var(--highlight);
  }
  .seg[data-indicator-ready]::before {
    content: '';
    position: absolute;
    z-index: -1;
    top: 3px;
    bottom: 3px;
    left: 0;
    width: var(--ind-w, 0);
    border-radius: var(--radius-pill);
    opacity: var(--ind-o, 0);
    transform: translateX(var(--ind-x, 0));
  }
  .seg.is-sliding::before {
    transition:
      transform var(--dur-base) var(--ease-out),
      width var(--dur-base) var(--ease-out);
  }
</style>
