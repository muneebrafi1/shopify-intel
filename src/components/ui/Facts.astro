---
/**
 * Key/value rows (the spec list): label --ink-3 13px left, value 14px --ink right, hairlines.
 * Use bare inside a column, or wrapped by <FactsCard> for the detail-page side panel.
 *
 *   <Facts items={[{ label: 'Vendor', value: 'Maestrooo', href: '/themes?vendor=maestrooo' },
 *                  { label: 'Latest version', value: '10.2.0', mono: true }]} />
 *
 * Default slot: extra rows (<div class="facts__row"><dt>…</dt><dd>…</dd></div>).
 */
export interface Fact {
  label: string;
  value: string;
  href?: string;
  /** Mono value: versions, dates, IDs, domains. */
  mono?: boolean;
  title?: string;
}
interface Props {
  items: Fact[];
  /** Draw a hairline above the first row (default true when not inside a FactsCard). */
  ruled?: boolean;
  class?: string;
}
const { items, ruled = true, class: className } = Astro.props;
---

<dl class:list={['facts', { 'facts--ruled': ruled }, className]}>
  {items.map((f) => (
    <div class="facts__row">
      <dt>{f.label}</dt>
      <dd class:list={[{ facts__mono: f.mono }]} title={f.title}>
        {f.href ? <a href={f.href}>{f.value}</a> : f.value}
      </dd>
    </div>
  ))}
  <slot />
</dl>

<style>
  .facts {
    font-size: var(--text-ui);
  }
  .facts :global(.facts__row) {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 40px;
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--line);
  }
  .facts :global(.facts__row:last-child) {
    border-bottom: 0;
  }
  .facts--ruled :global(.facts__row:first-child) {
    border-top: 1px solid var(--line);
  }
  .facts--ruled :global(.facts__row:last-child) {
    border-bottom: 1px solid var(--line);
  }
  .facts :global(dt) {
    flex: none;
    color: var(--ink-3);
    font-size: var(--text-sm);
  }
  .facts :global(dd) {
    min-width: 0;
    color: var(--ink);
    text-align: right;
    overflow-wrap: anywhere;
  }
  .facts__mono {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: -0.01em;
  }
  .facts :global(dd a) {
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
    transition: text-decoration-color var(--dur-fast) var(--ease-out);
  }
  .facts :global(dd a:hover) {
    text-decoration-color: currentColor;
  }
</style>
