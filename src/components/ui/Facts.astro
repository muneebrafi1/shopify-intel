---
/** Label/value rows for detail-page sidebars ("Vendor — Maestrooo"). */
export interface Fact {
  label: string;
  value: string;
  href?: string;
  mono?: boolean;
  title?: string;
}
interface Props {
  items: Fact[];
  class?: string;
}
const { items, class: className } = Astro.props;
---

<dl class:list={['facts', className]}>
  {
    items.map((f) => (
      <div class="facts__row">
        <dt>{f.label}</dt>
        <dd class:list={[{ mono: f.mono }]} title={f.title}>
          {f.href ? <a href={f.href}>{f.value}</a> : f.value}
        </dd>
      </div>
    ))
  }
  <slot />
</dl>

<style>
  .facts {
    font-size: var(--text-sm);
  }
  .facts__row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--line);
  }
  .facts__row:first-child {
    border-top: 1px solid var(--line);
  }
  dt {
    color: var(--ink-3);
    flex: none;
  }
  dd {
    color: var(--ink);
    text-align: right;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  dd a {
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
  }
  dd a:hover {
    text-decoration-color: currentColor;
  }
</style>
