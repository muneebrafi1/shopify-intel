---
/**
 * A short spec sheet for page headers: mono label left, value right, hairlines between rows,
 * and the source line underneath. Every number on these pages carries its source and date.
 */
import SourceNote from '~/components/ui/SourceNote.astro';

export interface SpecItem {
  label: string;
  value: string;
  href?: string;
}
interface Props {
  items: SpecItem[];
  source?: { label: string; asOf: string };
  class?: string;
}
const { items, source, class: className } = Astro.props;
---

<div class:list={['spec', className]}>
  <dl class="spec__rows">
    {
      items.map((i) => (
        <div class="spec__row">
          <dt class="mlabel mlabel--bullet">{i.label}</dt>
          <dd class="num">{i.href ? <a href={i.href}>{i.value}</a> : i.value}</dd>
        </div>
      ))
    }
  </dl>
  {source && <SourceNote source={source.label} asOf={source.asOf} class="spec__source" />}
</div>

<style>
  .spec__rows {
    border-top: 1px solid var(--ink);
  }
  .spec__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding: 8px 0;
    border-bottom: 1px solid var(--line);
  }
  .spec__row dt {
    flex: none;
  }
  .spec__row dd {
    min-width: 0;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
    text-align: right;
  }
  .spec__row a {
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
  }
  .spec :global(.spec__source) {
    margin-top: var(--space-3);
  }
</style>
