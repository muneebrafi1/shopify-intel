---
/**
 * A short spec sheet for page headers: mono label left, value right, hairlines between rows,
 * and the source line underneath. Every number on these pages carries its source and date.
 */
import SourceNote from '~/components/ui/SourceNote.astro';

export interface SpecItem {
  label: string;
  value: string;
  href?: string;
}
interface Props {
  items: SpecItem[];
  source?: { label: string; asOf: string };
  /** One horizontal strip (index page headers) instead of stacked rows. */
  inline?: boolean;
  class?: string;
}
const { items, source, inline = false, class: className } = Astro.props;
---

<div class:list={['spec', { 'spec--inline': inline }, className]}>
  <dl class="spec__rows">
    {items.map((i) => (
      <div class="spec__row">
        <dt class="mlabel mlabel--bullet">{i.label}</dt>
        <dd class="num">{i.href ? <a href={i.href}>{i.value}</a> : i.value}</dd>
      </div>
    ))}
  </dl>
  {source && <SourceNote source={source.label} asOf={source.asOf} class="spec__source" />}
</div>

<style>
  .spec__rows {
    border-top: 1px solid var(--ink);
  }
  .spec__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding: 8px 0;
    border-bottom: 1px solid var(--line);
  }
  .spec__row dt {
    flex: none;
  }
  .spec__row dd {
    min-width: 0;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
    text-align: right;
  }
  .spec__row a {
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
  }
  .spec :global(.spec__source) {
    margin-top: var(--space-3);
  }

  /* Inline strip: cells side by side with hairline dividers, source at the end. */
  .spec--inline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-8);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding-block: var(--space-3);
  }
  .spec--inline .spec__rows {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2) var(--space-6);
    border: 0;
  }
  .spec--inline .spec__row {
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    gap: 4px;
    padding: 0;
    border: 0;
  }
  .spec--inline .spec__row dd {
    text-align: left;
  }
  .spec--inline :global(.spec__source) {
    margin-top: 0;
  }
  @media (min-width: 900px) {
    .spec--inline {
      flex-wrap: nowrap;
      justify-content: space-between;
    }
    .spec--inline .spec__rows {
      display: flex;
      gap: 0;
    }
    .spec--inline .spec__row {
      flex-direction: row;
      align-items: baseline;
      gap: var(--space-3);
      padding-right: var(--space-6);
      margin-right: var(--space-6);
      border-right: 1px solid var(--line);
    }
    .spec--inline .spec__row:last-child {
      border-right: 0;
      margin-right: 0;
      padding-right: 0;
    }
    .spec--inline :global(.spec__source) {
      max-width: 360px;
    }
  }
</style>
