---
/**
 * The section in the context of its page: the full-page capture (pinned tags, this section
 * outlined in accent and scrolled into view) in a window that scrolls on its own, beside the
 * page's sections in order. Hovering or focusing a row outlines that section on the page; each
 * row links to that section's own page.
 */
import FullPage, { type FullPageSection } from '~/components/media/FullPage.astro';
import AppIcon from '~/components/ui/AppIcon.astro';
import Badge from '~/components/ui/Badge.astro';
import Icon from '~/components/ui/Icon.astro';
import Window from '~/components/ui/Window.astro';
import type { ScreenshotDetail } from '~/server/api/v1/types';
import { pageLabel } from './library';

interface Props {
  shot: ScreenshotDetail;
  currentId: number;
  storeLabel: string;
  fullPageHref: string;
  class?: string;
}
const { shot, currentId, storeLabel, fullPageHref, class: className } = Astro.props;
const ordered = [...shot.sections].sort((a, b) => a.order_index - b.order_index);
const sections: FullPageSection[] = ordered.map((s) => ({
  id: s.id,
  type: s.type.slug,
  name: s.type.name,
  y: s.rect.y,
  height: s.rect.h,
  x: s.rect.x,
  w: s.rect.w,
  app: s.app ? { name: s.app.short_name, slug: s.app.slug, iconUrl: s.app.icon_url } : null,
  href: s.href,
}));
const page = pageLabel(shot.page_type.slug);
const pad = (n: number) => String(n).padStart(2, '0');
// The current section's outline, rendered on the server (no JS needed to see it).
const id = Number(currentId);
const currentCss = `[data-ctx="${id}"] .fp__region[data-region="${id}"]::before{border:1.5px solid var(--accent);background:var(--accent-wash)}[data-ctx="${id}"] .fp__region[data-region="${id}"] .fp__tag{opacity:1;transform:none;background:var(--accent-btn);color:var(--accent-fg)}[data-ctx="${id}"] .fp__region[data-region="${id}"] :is(.fp__tag-n,.fp__tag-app){color:var(--accent-fg)}`;
---

<style is:inline set:html={currentCss}></style>
<div class:list={['ctx', `ctx--${shot.device}`, className]} data-ctx={id}>
  <Window url={shot.store.domain} class="ctx__window">
    <a slot="toolbar" href={fullPageHref} class="ctx__open">
      Full page
      <Icon name="arrow-up-right" size={12} />
    </a>
    <div class="ctx__scroll" data-ctx-scroll tabindex="0" aria-label={`${page} of ${storeLabel}`}>
      <FullPage
        src={shot.image.src}
        width={shot.width}
        height={shot.height}
        device={shot.device}
        alt={`${storeLabel}, ${page.toLowerCase()} on ${shot.device}, with this section outlined${shot.is_placeholder ? ' (layout preview, not a screenshot)' : ''}`}
        sections={sections}
        rail={false}
        bare
        class="ctx__fp"
      />
    </div>
  </Window>

  <div class="ctx__side">
    <p class="ctx__head">
      <span>
        {page}, {shot.device}
      </span>
      <span class="num">{ordered.length} sections</span>
    </p>
    <ol class="ctx__list">
      {ordered.map((x, i) => {
        const current = x.id === id;
        return (
          <li>
            <a
              href={x.href}
              class:list={['ctx__row', { 'is-current': current }]}
              aria-current={current ? 'page' : undefined}
              data-ctx-target={String(x.id)}
            >
              <span class="ctx__n num">{pad(i + 1)}</span>
              <span class="ctx__name">{x.type.name}</span>
              {current && (
                <Badge tone="accent" size="sm" class="ctx__here">
                  This section
                </Badge>
              )}
              {x.app && (
                <span class="ctx__app" title={`Rendered by ${x.app.name}`}>
                  <AppIcon src={x.app.icon_url} name={x.app.short_name} size={16} />
                  <span class="ctx__app-name">{x.app.short_name}</span>
                </span>
              )}
            </a>
          </li>
        );
      })}
    </ol>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-ctx]').forEach((root) => {
    const scroller = root.querySelector<HTMLElement>('[data-ctx-scroll]');
    if (!scroller) return;
    const region = (id: string) =>
      root.querySelector<HTMLElement>(`.fp__region[data-region="${CSS.escape(id)}"]`);
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const bring = (el: HTMLElement, smooth: boolean) => {
      const box = scroller.getBoundingClientRect();
      const r = el.getBoundingClientRect();
      const top = scroller.scrollTop + r.top - box.top - Math.min(96, box.height * 0.2);
      scroller.scrollTo({
        top: Math.max(0, top),
        behavior: smooth && !reduced ? 'smooth' : 'auto',
      });
    };
    // Start with this section in view (once the capture has a size).
    const current = region(root.dataset.ctx ?? '');
    if (current) {
      const img = scroller.querySelector('img');
      const go = () => bring(current, false);
      if (img && !img.complete) img.addEventListener('load', go, { once: true });
      go();
    }
    // Hover or focus a row: outline that section and bring it into view.
    let timer = 0;
    const setHover = (id: string | null) => {
      root
        .querySelectorAll<HTMLElement>('.fp__region')
        .forEach((el) => el.classList.toggle('is-hover', el.dataset.region === id));
      window.clearTimeout(timer);
      if (!id) return;
      const el = region(id);
      if (el) timer = window.setTimeout(() => bring(el, true), 120);
    };
    root.querySelectorAll<HTMLElement>('[data-ctx-target]').forEach((row) => {
      const id = row.dataset.ctxTarget!;
      row.addEventListener('mouseenter', () => setHover(id));
      row.addEventListener('focus', () => setHover(id));
      row.addEventListener('mouseleave', () => setHover(null));
      row.addEventListener('blur', () => setHover(null));
    });
  });
</script>

<style>
  .ctx {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
  }
  @media (min-width: 1024px) {
    .ctx {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: var(--space-8);
      align-items: start;
    }
  }
  .ctx__open {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--ink-2);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    white-space: nowrap;
  }
  .ctx__open:hover {
    color: var(--ink);
  }
  .ctx__scroll {
    height: 440px;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: var(--space-4);
    scrollbar-width: thin;
    scrollbar-color: var(--line-strong) transparent;
  }
  .ctx__scroll:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
  @media (min-width: 1024px) {
    .ctx__scroll {
      height: 620px;
      padding: var(--space-6);
    }
  }
  /* A smaller map than the store viewer: more of the page in view at once. */
  .ctx :global(.ctx__fp .fp__canvas) {
    max-width: 640px;
  }
  .ctx--mobile :global(.ctx__fp .fp__canvas) {
    max-width: 320px;
  }
  .ctx :global(.ctx__fp .fp__region) {
    scroll-margin-top: 24px;
  }

  .ctx__head {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    padding: 0 var(--space-3) var(--space-2);
    color: var(--ink-3);
    font-size: var(--text-sm);
  }
  .ctx__list {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .ctx__row {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 44px;
    padding: 6px var(--space-3);
    border-radius: var(--radius-control);
    color: var(--ink-2);
    font-size: var(--text-ui);
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .ctx__row:hover,
  .ctx__row:focus-visible {
    background: var(--surface-2);
    color: var(--ink);
  }
  .ctx__row.is-current {
    background: var(--surface-2);
    color: var(--ink);
    font-weight: var(--weight-medium);
  }
  .ctx__row.is-current::before {
    content: '';
    position: absolute;
    left: 0;
    top: 10px;
    bottom: 10px;
    width: 2px;
    border-radius: 2px;
    background: var(--accent);
  }
  .ctx__n {
    flex: none;
    width: 20px;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  .ctx__row.is-current .ctx__n {
    color: var(--accent-text);
  }
  .ctx__name {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .ctx__row :global(.ctx__here) {
    flex: none;
  }
  .ctx__app {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
    margin-left: auto;
    color: var(--ink-3);
    font-size: var(--text-xs);
    font-weight: var(--weight-regular);
  }
  .ctx__app-name {
    max-width: 96px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  @media (min-width: 1024px) {
    .ctx__side {
      position: sticky;
      top: calc(var(--header-h) + var(--space-6));
    }
  }
</style>
