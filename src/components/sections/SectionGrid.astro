---
/**
 * The library results: section cards on an aligned grid (or a table in list view), then a cursor
 * "Load more". Without JavaScript the link opens the next page (?cursor=…&p=2); with it, the next
 * page's items are fetched and appended in place, and the grid becomes the sequence the
 * lightbox steps through. Mobile-only results use a portrait well and more columns.
 */
import AppIcon from '~/components/ui/AppIcon.astro';
import Button from '~/components/ui/Button.astro';
import EmptyState from '~/components/ui/EmptyState.astro';
import Icon from '~/components/ui/Icon.astro';
import type { Device } from '~/lib/taxonomy';
import type { SectionCard } from '~/server/api/v1/types';
import CropCard from './CropCard.astro';
import { fmt, pageLabel } from './library';

interface Props {
  items: SectionCard[];
  total: number;
  /** Pinned tag on each card: section type (library) or page type (type page). */
  tag?: 'type' | 'page';
  /** 1-based page number of this slice (from ?p=). */
  page: number;
  pageSize: number;
  nextHref: string | null;
  firstHref: string;
  clearHref: string;
  /** Device filter, when set (mobile-only results get portrait wells). */
  device?: Device | undefined;
  /** Eager-load the first row. */
  eager?: number;
  view?: 'grid' | 'index';
}
const {
  items,
  total,
  tag = 'type',
  page,
  pageSize,
  nextHref,
  firstHref,
  clearHref,
  device,
  eager = 4,
  view = 'grid',
} = Astro.props;
const from = (page - 1) * pageSize + 1;
const to = from + items.length - 1;
const portrait = device === 'mobile';
---

{items.length === 0 ? (
  <EmptyState
    title="No sections match these filters"
    body="Nothing in the library fits this combination yet. Try another page type or device, or clear the theme, app and store filters."
    icon="funnel-simple"
    class="sgrid__empty"
  >
    <Button href={clearHref} size="sm" variant="secondary">
      Clear filters
    </Button>
  </EmptyState>
) : (
  <div class="sgrid" data-sgrid data-total={total}>
    {view === 'index' ? (
      <div class="table-wrap sgrid__table">
        <table class="table table--sticky">
          <caption class="visually-hidden">Sections</caption>
          <thead>
            <tr>
              <th scope="col">Section</th>
              {tag === 'type' && (
                <th scope="col" class="sgrid__col-type">
                  Type
                </th>
              )}
              <th scope="col" class="sgrid__col-page">
                Page
              </th>
              <th scope="col" class="sgrid__col-theme">
                Theme
              </th>
              <th scope="col" class="sgrid__col-app">
                App
              </th>
            </tr>
          </thead>
          <tbody data-sgrid-list>
            {items.map((s, i) => (
              <tr class="srow">
                <td>
                  <span class="srow__main">
                    <span class:list={['srow__thumb', `srow__thumb--${s.device}`]}>
                      <img
                        src={s.crop.src}
                        alt=""
                        width={s.crop.width}
                        height={s.crop.height}
                        loading={page === 1 && i < 8 ? 'eager' : 'lazy'}
                        decoding="async"
                      />
                    </span>
                    <span class="srow__text">
                      <a href={s.href} class="srow__link" data-ccard-link>
                        {s.store.display_name}
                        <span class="visually-hidden">
                          {' '}
                          — {s.type.name}, {pageLabel(s.page_type).toLowerCase()}, {s.device}
                        </span>
                      </a>
                      <span class="srow__sub">
                        {s.device === 'mobile' ? (
                          <Icon name="device-mobile" size={12} />
                        ) : (
                          <Icon name="desktop" size={12} />
                        )}
                        <span class="mono">{s.store.domain}</span>
                      </span>
                    </span>
                  </span>
                </td>
                {tag === 'type' && <td class="sgrid__col-type">{s.type.name}</td>}
                <td class="sgrid__col-page srow__muted">{pageLabel(s.page_type)}</td>
                <td class="sgrid__col-theme">{s.theme?.name ?? 'Custom theme'}</td>
                <td class="sgrid__col-app">
                  {s.app ? (
                    <span class="srow__app">
                      <AppIcon src={s.app.icon_url} name={s.app.short_name} size={18} />
                      {s.app.short_name}
                    </span>
                  ) : (
                    <span class="srow__muted">Theme</span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : (
      <div
        class:list={['sgrid__cards', { 'sgrid__cards--portrait': portrait }]}
        data-sgrid-cards
        data-sgrid-list
      >
        {items.map((s, i) => (
          <CropCard
            section={s}
            tag={tag}
            ratio={portrait ? '4 / 5' : undefined}
            eager={page === 1 && i < eager}
          />
        ))}
      </div>
    )}

    <div class="sgrid__foot" data-sgrid-foot>
      <p class="sgrid__status" aria-live="polite" data-sgrid-status data-from={from}>
        {page > 1 ? 'Sections' : 'Showing'}{' '}
        <span class="num" data-sgrid-range>
          {page > 1 ? `${fmt(from)}–${fmt(to)}` : fmt(to)}
        </span>{' '}
        of <span class="num">{fmt(total)}</span>
      </p>
      <div class="sgrid__actions">
        {page > 1 && (
          <a class="sgrid__first" href={firstHref} data-sgrid-first>
            <Icon name="arrow-left" size={14} />
            First page
          </a>
        )}
        {nextHref && (
          <a class="sgrid__more" href={nextHref} rel="next nofollow" data-sgrid-more>
            <span data-sgrid-more-label>Load more</span>
            <span class="sgrid__more-n num" aria-hidden="true">
              +{fmt(Math.min(pageSize, total - to))}
            </span>
          </a>
        )}
      </div>
    </div>
  </div>
)}

<script>
  // Progressive "Load more": fetch the next page and append its items in place.
  const parser = new DOMParser();
  const LIST = '[data-sgrid-list]';
  async function loadMore(link: HTMLAnchorElement): Promise<boolean> {
    const root = link.closest<HTMLElement>('[data-sgrid]');
    const list = root?.querySelector<HTMLElement>(LIST);
    if (!root || !list || link.dataset.busy) return false;
    link.dataset.busy = '1';
    link.setAttribute('aria-busy', 'true');
    const label = link.querySelector('[data-sgrid-more-label]');
    if (label) label.textContent = 'Loading…';
    try {
      const res = await fetch(link.href, { headers: { Accept: 'text/html' } });
      if (!res.ok) throw new Error(String(res.status));
      const doc = parser.parseFromString(await res.text(), 'text/html');
      const incoming = doc.querySelector(LIST);
      if (!incoming) throw new Error('no items');
      const before = list.children.length;
      for (const item of Array.from(incoming.children)) list.appendChild(item);
      const after = list.children.length;
      const status = root.querySelector<HTMLElement>('[data-sgrid-status]');
      const range = status?.querySelector('[data-sgrid-range]');
      const from = Number(status?.dataset.from ?? 1);
      const fmt = (n: number) => n.toLocaleString('en-US');
      if (range)
        range.textContent = from > 1 ? `${fmt(from)}–${fmt(from + after - 1)}` : fmt(after);
      const next = doc.querySelector<HTMLAnchorElement>('[data-sgrid-more]');
      if (next) {
        link.href = next.getAttribute('href') ?? link.href;
        const n = link.querySelector('.sgrid__more-n');
        const nn = next.querySelector('.sgrid__more-n');
        if (n && nn) n.textContent = nn.textContent;
      } else {
        link.remove();
      }
      // Keep keyboard users where the new content starts.
      if (before < after) {
        list.children[before]
          ?.querySelector<HTMLElement>('[data-ccard-link]')
          ?.focus({ preventScroll: true });
      }
      document.dispatchEvent(new CustomEvent('sgrid:append'));
      return true;
    } catch {
      // Fall back to a normal navigation.
      window.location.href = link.href;
      return false;
    } finally {
      delete link.dataset.busy;
      link.removeAttribute('aria-busy');
      if (label) label.textContent = 'Load more';
    }
  }

  document.addEventListener('click', (event) => {
    const link = (event.target as HTMLElement).closest<HTMLAnchorElement>('[data-sgrid-more]');
    if (!link || event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
    event.preventDefault();
    void loadMore(link);
  });
  // The lightbox asks for more when stepping past the last item.
  document.addEventListener('sgrid:more', (event) => {
    const link = document.querySelector<HTMLAnchorElement>('[data-sgrid-more]');
    const done = (event as CustomEvent<{ done: (ok: boolean) => void }>).detail.done;
    if (!link) return done(false);
    void loadMore(link).then(done);
  });
</script>

<style>
  /* Aligned grid: every card has the same 4:3 well, so desktop strips and mobile slices line
     up. 1 → 2 → 3 → 4 columns; mobile-only results: 2 → 3 → 4 → 6 portrait wells. */
  .sgrid__cards {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
  }
  .sgrid__cards--portrait {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
  }
  @media (min-width: 560px) {
    .sgrid__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 768px) {
    .sgrid__cards--portrait {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-4);
    }
  }
  @media (min-width: 1024px) {
    .sgrid__cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-5);
    }
    .sgrid__cards--portrait {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  @media (min-width: 1280px) {
    .sgrid__cards {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .sgrid__cards--portrait {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }
  /* Portrait cards are narrow: drop the domain, keep the store and the app icon. */
  .sgrid__cards--portrait :global(.ccard__body) {
    padding: 10px var(--space-3) var(--space-3);
  }
  .sgrid__cards--portrait :global(.ccard__domain),
  .sgrid__cards--portrait :global(.ccard__domain + span),
  .sgrid__cards--portrait :global(.ccard__app-name) {
    display: none;
  }
  /* Every card is mobile here: the tag names the type (or page) only. */
  .sgrid__cards--portrait :global(.ccard__dev) {
    display: none;
  }
  .sgrid__cards--portrait :global(.ccard__app) {
    padding: 0 3px;
  }

  /* List view */
  .sgrid__table :global(.table) {
    min-width: 0;
  }
  .srow__main {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-width: 0;
  }
  .srow__thumb {
    flex: none;
    display: grid;
    place-items: center;
    width: 72px;
    height: 48px;
    overflow: hidden;
    border-radius: 6px;
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .srow__thumb img {
    max-width: 62px;
    max-height: 40px;
    width: auto;
    height: auto;
    border-radius: 2px;
    background: var(--capture-bg);
    box-shadow: var(--shadow-xs);
  }
  .srow__thumb--mobile img {
    max-width: 30px;
  }
  .srow__text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .srow__link {
    color: var(--ink);
    font-weight: var(--weight-medium);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .srow__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .srow {
    position: relative;
  }
  .srow__sub {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--ink-3);
    font-size: var(--text-xs);
  }
  .srow__muted {
    color: var(--ink-3);
  }
  .srow__app {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
  }
  .sgrid__table td {
    white-space: nowrap;
  }
  @media (max-width: 767px) {
    .sgrid__col-page,
    .sgrid__col-theme,
    .sgrid__col-type {
      display: none;
    }
  }
  @media (max-width: 479px) {
    .sgrid__col-app {
      display: none;
    }
  }

  /* Footer: status + Load more */
  .sgrid__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-6);
    margin-top: var(--space-8);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }
  .sgrid__status {
    color: var(--ink-3);
    font-size: var(--text-sm);
  }
  .sgrid__status .num {
    color: var(--ink);
    font-weight: var(--weight-medium);
  }
  .sgrid__actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .sgrid__first {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 40px;
    color: var(--ink-2);
    font-size: var(--text-sm);
  }
  .sgrid__first:hover {
    color: var(--ink);
  }
  .sgrid__more {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    height: 40px;
    padding: 0 6px 0 16px;
    border-radius: var(--radius-control);
    background: var(--surface);
    box-shadow:
      inset 0 0 0 1px var(--line-strong),
      var(--shadow-xs);
    color: var(--ink);
    font-size: var(--text-ui);
    font-weight: var(--weight-medium);
    transition: background-color var(--dur-fast) var(--ease-out);
  }
  .sgrid__more:hover {
    background: var(--surface-2);
  }
  .sgrid__more:active {
    transform: scale(0.98);
  }
  .sgrid__more[aria-busy='true'] {
    opacity: 0.7;
    cursor: progress;
  }
  .sgrid__more-n {
    display: inline-grid;
    place-items: center;
    height: 26px;
    padding: 0 8px;
    border-radius: 6px;
    background: var(--surface-2);
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  @media (max-width: 479px) {
    .sgrid__foot {
      flex-direction: column-reverse;
      align-items: stretch;
    }
    .sgrid__actions {
      justify-content: space-between;
    }
    .sgrid__more {
      flex: 1;
    }
    .sgrid__status {
      text-align: center;
    }
  }
</style>
