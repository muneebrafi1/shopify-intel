---
/** One teardown in the editorial list next to the lead: number, serif title, dek, facts. */
import type { TeardownListItem } from '~/server/api/v1/types';
import { formatDate } from '~/lib/format';

interface Props {
  item: TeardownListItem;
  n: number;
}
const { item, n } = Astro.props;
---

<article class="tdrow">
  <p class="tdrow__kicker mono num">
    <span>N°{String(n).padStart(2, '0')}</span>
    {item.is_sample && <span class="tdrow__sample">Sample</span>}
    {item.published_at && <span>{formatDate(item.published_at)}</span>}
  </p>
  <h3 class="tdrow__title display">
    <a href={item.href}>{item.title}</a>
  </h3>
  {item.dek && <p class="tdrow__dek">{item.dek}</p>}
  <p class="tdrow__facts mono">
    {item.store.domain}
    {item.theme && ` · ${item.theme.name}`} · {item.note_count}
    {item.note_count === 1 ? ' note' : ' notes'}
  </p>
</article>

<style>
  .tdrow {
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--line);
  }
  .tdrow__kicker {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    color: var(--ink-3);
    font-size: var(--text-2xs);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .tdrow__sample {
    color: var(--accent-text);
  }
  .tdrow__title {
    margin-top: var(--space-2);
    font-size: clamp(1.375rem, 1.2rem + 0.6vw, 1.75rem);
    line-height: 1.12;
    text-wrap: balance;
  }
  .tdrow__title a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.14em;
  }
  .tdrow__dek {
    margin-top: var(--space-2);
    color: var(--ink-2);
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .tdrow__facts {
    margin-top: var(--space-3);
    color: var(--ink-3);
    font-size: var(--text-2xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
</style>
