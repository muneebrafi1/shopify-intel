---
/**
 * A teardown's notes on the store's captures (the Twenty pattern: real product crops with
 * labels pinned on them). One capture at a time (?plate=<page>-<device>, kept from v1 for
 * shared links): the notes for it as a numbered legend beside the capture in a product window,
 * each note tied to its section. Note numbers are the section numbers of the <FullPage> rail
 * on the store page (sections sorted top to bottom), so "02 Header" means the same section in
 * both places. Annotated sections stay outlined in accent with their tag.
 */
import Tabs from '~/components/ui/Tabs.astro';
import Window from '~/components/ui/Window.astro';
import AppIcon from '~/components/ui/AppIcon.astro';
import Icon from '~/components/ui/Icon.astro';
import FullPage, { type FullPageSection } from '~/components/media/FullPage.astro';
import type { ScreenshotDetail, StoreDetail, TeardownNote } from '~/server/api/v1/types';
import { inline } from './markdown';

interface Props {
  notes: TeardownNote[];
  store: StoreDetail;
  basePath: string;
  plate: string | null;
}
const { notes, store, basePath, plate } = Astro.props;

// All screenshots of the store by id.
const shots = new Map<number, ScreenshotDetail>();
for (const p of store.pages) {
  for (const d of ['desktop', 'mobile'] as const) {
    const s = p.screenshots[d];
    if (s) shots.set(s.id, s);
  }
}

// FullPage numbering: sections sorted top to bottom (stable on the order we pass in).
const toSections = (shot: ScreenshotDetail): FullPageSection[] =>
  [...shot.sections]
    .sort((a, b) => a.order_index - b.order_index)
    .map((s) => ({
      id: s.id,
      type: s.type.slug,
      name: s.type.name,
      y: s.rect.y,
      height: s.rect.h,
      x: s.rect.x,
      w: s.rect.w,
      app: s.app ? { name: s.app.short_name, slug: s.app.slug, iconUrl: s.app.icon_url } : null,
      href: s.href,
    }));
const railNumbers = (sections: FullPageSection[]) => {
  const ordered = [...sections].sort((a, b) => a.y - b.y);
  return new Map(ordered.map((s, i) => [String(s.id), i + 1]));
};

interface Plate {
  key: string;
  label: string;
  shot: ScreenshotDetail;
  notes: TeardownNote[];
}
const plates: Plate[] = [];
for (const note of [...notes].sort((a, b) => a.n - b.n)) {
  const shot = note.screenshot_id ? shots.get(note.screenshot_id) : undefined;
  if (!shot) continue;
  const key = `${note.page_type}-${note.device}`;
  let entry = plates.find((x) => x.key === key);
  if (!entry) {
    entry = {
      key,
      label: `${shot.page_type.name} · ${note.device === 'desktop' ? 'Desktop' : 'Mobile'}`,
      shot,
      notes: [],
    };
    plates.push(entry);
  }
  entry.notes.push(note);
}
const current = plates.find((x) => x.key === plate) ?? plates[0];
const sections = current ? toSections(current.shot) : [];
const numbers = railNumbers(sections);
const pad = (n: number) => String(n).padStart(2, '0');
const hrefFor = (key: string, hash = '') => `?plate=${encodeURIComponent(key)}${hash || '#notes'}`;

// Notes on this plate, in section order; their sections stay outlined and tagged on the capture.
const legend = (current?.notes ?? [])
  .map((note) => ({
    note,
    num: note.section ? (numbers.get(String(note.section.id)) ?? null) : null,
  }))
  .sort((a, b) => (a.num ?? 99) - (b.num ?? 99));
const annotatedIds = legend
  .map((l) => l.note.section?.id)
  .filter((id): id is number => typeof id === 'number');
const css = annotatedIds
  .map(
    (id) =>
      `.tdplates.tdplates [data-region="${id}"]::before{border:1.5px solid var(--accent)}` +
      `.tdplates.tdplates [data-region="${id}"] .fp__tag{opacity:1;transform:none;background:var(--accent-btn);color:var(--accent-fg)}` +
      `.tdplates.tdplates [data-region="${id}"] .fp__tag :is(.fp__tag-n,.fp__tag-app){color:var(--accent-fg)}`,
  )
  .join('');
const PATHS: Record<string, string> = {
  collection: '/collections/…',
  product: '/products/…',
  cart: '/cart',
};
const storePlateHref = current
  ? `${basePath}${current.shot.page_type.slug === 'home' ? '' : `?page=${current.shot.page_type.slug}`}${
      current.shot.device === 'mobile'
        ? `${current.shot.page_type.slug === 'home' ? '?' : '&'}device=mobile`
        : ''
    }#plates`
  : basePath;
---

{current && (
  <div class="tdplates" data-tdplates>
    {css && <Fragment set:html={`<style>${css}</style>`} />}
    {plates.length > 1 && (
      <Tabs
        label="Captures with notes"
        class="tdplates__tabs"
        items={plates.map((x) => ({
          label: x.label,
          href: hrefFor(x.key),
          selected: x.key === current.key,
          count: x.notes.length,
        }))}
      />
    )}

    <div class="tdplates__grid">
      <div class="tdplates__legend">
        <p class="tdplates__head">
          {current.label}
          <span class="num">
            {legend.length} {legend.length === 1 ? 'note' : 'notes'}
          </span>
        </p>
        <ol class="tdnotes">
          {legend.map(({ note, num }) => (
            <li class="tdnote">
              {note.section && num ? (
                <a
                  class="tdnote__num num"
                  href={`#section-${note.section.id}`}
                  data-note-target={String(note.section.id)}
                  aria-label={`Section ${pad(num)} on the capture`}
                >
                  {pad(num)}
                </a>
              ) : (
                <span class="tdnote__num tdnote__num--none num" aria-hidden="true">
                  —
                </span>
              )}
              <div class="tdnote__text">
                <p class="tdnote__where">
                  {note.section_type.name}
                  {!note.section && <span class="tdnote__missing">Not on the current capture</span>}
                  {note.section?.app && (
                    <span class="tdnote__app">
                      <AppIcon
                        src={note.section.app.icon_url}
                        name={note.section.app.short_name}
                        size={14}
                      />
                      {note.section.app.short_name}
                    </span>
                  )}
                </p>
                <h3 class="tdnote__title">{note.title}</h3>
                <p class="tdnote__body" set:html={inline(note.body)} />
              </div>
            </li>
          ))}
        </ol>
        {plates.length > 1 && (
          <ul class="tdplates__others">
            {plates
              .filter((x) => x.key !== current.key)
              .map((x) => (
                <li>
                  <a href={hrefFor(x.key)}>
                    <span class="num">{x.notes.length}</span>{' '}
                    {x.notes.length === 1 ? 'note' : 'notes'} on {x.label}
                    <Icon name="arrow-right" size={12} />
                  </a>
                </li>
              ))}
          </ul>
        )}
      </div>

      <Window
        url={`${current.shot.store.domain}${PATHS[current.shot.page_type.slug] ?? ''}`}
        class:list={['tdplates__window', `tdplates__window--${current.shot.device}`]}
      >
        <FullPage
          src={current.shot.image.src}
          width={current.shot.width}
          height={current.shot.height}
          device={current.shot.device}
          alt={`${current.shot.store.display_name}, ${current.label.toLowerCase()} capture${current.shot.is_placeholder ? ' (layout preview, not a screenshot)' : ''}`}
          sections={sections}
          rail={false}
          bare
          class="tdplates__viewer"
        />
      </Window>
    </div>
  </div>
)}

<script>
  // Hovering a note lights up its section on the capture (FullPage's own hover state).
  document.querySelectorAll<HTMLElement>('[data-tdplates]').forEach((root) => {
    root.querySelectorAll<HTMLElement>('[data-note-target]').forEach((el) => {
      const region = root.querySelector<HTMLElement>(`[data-region="${el.dataset.noteTarget}"]`);
      if (!region) return;
      const on = () => region.classList.add('is-hover');
      const off = () => region.classList.remove('is-hover');
      el.addEventListener('mouseenter', on);
      el.addEventListener('mouseleave', off);
      el.addEventListener('focus', on);
      el.addEventListener('blur', off);
    });
  });
</script>

<style>
  .tdplates :global(.tdplates__tabs) {
    margin-bottom: var(--space-6);
  }
  .tdplates__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
  }
  @media (min-width: 1024px) {
    .tdplates__grid {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      gap: var(--space-10);
      align-items: start;
    }
    .tdplates__legend {
      position: sticky;
      top: calc(var(--header-h) + var(--space-6));
      max-height: calc(100dvh - var(--header-h) - var(--space-12));
      overflow-y: auto;
      scrollbar-width: thin;
    }
  }
  .tdplates__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    font-size: var(--text-ui);
    font-weight: var(--weight-semibold);
  }
  .tdplates__head .num {
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 400;
  }
  .tdnote {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr);
    gap: var(--space-3);
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--line);
  }
  /* The number reads like the pinned tag on the capture. */
  .tdnote__num {
    display: inline-grid;
    place-items: center;
    align-self: start;
    width: 32px;
    height: 22px;
    margin-top: 1px;
    border-radius: var(--radius-pill);
    background: var(--accent-btn);
    color: var(--accent-fg);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    transition: background-color var(--dur-fast) var(--ease-out);
  }
  .tdnote__num--none {
    background: var(--surface-2);
    color: var(--ink-3);
  }
  .tdnote__missing {
    font-size: var(--text-xs);
  }
  a.tdnote__num:hover {
    background: var(--accent-btn-hover);
  }
  .tdnote__where {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 10px;
    color: var(--ink-3);
    font-size: var(--text-xs);
    line-height: 22px;
  }
  .tdnote__app {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--ink-2);
  }
  .tdnote__title {
    margin-top: var(--space-1);
    color: var(--ink);
    font-size: var(--text-body);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.01em;
    line-height: 1.35;
  }
  .tdnote__body {
    margin-top: var(--space-1-5);
    color: var(--ink-2);
    font-size: var(--text-sm);
    line-height: 1.6;
  }
  .tdnote__body :global(a) {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
  }
  .tdplates__hint {
    margin-top: var(--space-4);
    color: var(--ink-3);
    font-size: var(--text-xs);
    line-height: 1.5;
  }
  .tdplates__hint a,
  .tdplates__others a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--ink-2);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
  }
  .tdplates__hint a:hover,
  .tdplates__others a:hover {
    color: var(--ink);
    text-decoration-color: currentColor;
  }
  .tdplates__others {
    display: grid;
    gap: var(--space-1);
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--line);
    font-size: var(--text-sm);
  }
  .tdplates__others a {
    min-height: 32px;
  }
  .tdplates :global(.tdplates__viewer .fp__stage) {
    padding: var(--space-3);
  }
  .tdplates :global(.tdplates__window--mobile .fp__stage) {
    padding: var(--space-5) var(--space-4);
  }
  @media (min-width: 1024px) {
    .tdplates :global(.tdplates__viewer .fp__stage) {
      padding: var(--space-6);
    }
    .tdplates :global(.tdplates__window--mobile .fp__stage) {
      padding: var(--space-8) var(--space-6);
    }
  }
</style>
