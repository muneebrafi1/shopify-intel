---
/**
 * The admin sections with their counts. Rendered in the desktop sidebar and in the mobile menu
 * sheet. Pending removals show as an accent badge (they need someone); other counts are quiet.
 */
import Icon from '~/components/ui/Icon.astro';
import {
  SECTION_HREFS,
  SECTION_ICONS,
  SECTION_LABELS,
  type AdminSection,
  type NavCounts,
} from './nav';

interface Props {
  current: AdminSection;
  counts: NavCounts;
  /** Distinguishes the two instances (sidebar / mobile menu) for ids and sizes. */
  variant: 'side' | 'menu';
}
const { current, counts, variant } = Astro.props;

interface Item {
  key: AdminSection;
  count?: number;
  /** Shown as an accent badge, with a label for assistive tech. */
  attention?: string;
  countLabel?: string;
}
const groups: Array<{ label: string | null; items: Item[] }> = [
  {
    label: null,
    items: [
      { key: 'overview' },
      {
        key: 'removals',
        count: counts.removals,
        attention: counts.removals > 0 ? `${counts.removals} pending` : undefined,
      },
    ],
  },
  {
    label: 'Library',
    items: [
      { key: 'stores', count: counts.stores, countLabel: 'stores' },
      { key: 'themes', count: counts.themes, countLabel: 'themes' },
      { key: 'apps', count: counts.apps, countLabel: 'apps' },
    ],
  },
  {
    label: 'Content',
    items: [
      { key: 'affiliates', count: counts.links, countLabel: 'links' },
      { key: 'teardowns', count: counts.teardowns, countLabel: 'teardowns' },
    ],
  },
  {
    label: 'Pipeline',
    items: [{ key: 'scans', count: counts.jobs, countLabel: 'open jobs' }],
  },
];
const fmt = (n: number) => (n >= 10_000 ? `${Math.round(n / 1000)}k` : n.toLocaleString('en-US'));
---

<div class:list={['anav', `anav--${variant}`]}>
  {groups.map((group, gi) => (
    <div class="anav__group">
      {group.label && (
        <p class="anav__label" id={`anav-${variant}-${gi}`}>
          {group.label}
        </p>
      )}
      <ul aria-labelledby={group.label ? `anav-${variant}-${gi}` : undefined}>
        {group.items.map((item) => (
          <li>
            <a
              href={SECTION_HREFS[item.key]}
              class="anav__link"
              aria-current={item.key === current ? 'page' : undefined}
            >
              <Icon name={SECTION_ICONS[item.key]} size={16} />
              <span class="anav__text">{SECTION_LABELS[item.key]}</span>
              {item.attention ? (
                <span class="anav__badge num" aria-label={item.attention}>
                  {fmt(item.count ?? 0)}
                </span>
              ) : typeof item.count === 'number' && item.count > 0 ? (
                <span class="anav__count num" aria-label={`${item.count} ${item.countLabel ?? ''}`}>
                  {fmt(item.count)}
                </span>
              ) : null}
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))}
</div>

<style>
  .anav {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .anav ul {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .anav__label {
    padding: 0 var(--space-2) var(--space-1);
    color: var(--ink-3);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
  }
  .anav__link {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 32px;
    padding: 0 var(--space-2);
    border-radius: var(--radius-sm);
    color: var(--ink-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .anav__link :global(.icon) {
    color: var(--ink-3);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .anav__link:hover {
    background: var(--surface-2);
    color: var(--ink);
  }
  .anav__link[aria-current='page'] {
    background: var(--surface);
    color: var(--ink);
    box-shadow:
      0 0 0 1px var(--line),
      var(--shadow-xs),
      var(--highlight);
  }
  .anav__link[aria-current='page'] :global(.icon) {
    color: var(--ink);
  }
  .anav__text {
    flex: 1;
    min-width: 0;
  }
  .anav__count {
    color: var(--ink-3);
    font-size: var(--text-xs);
  }
  .anav__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 20px;
    height: 18px;
    padding: 0 6px;
    border-radius: var(--radius-pill);
    background: var(--accent-soft);
    color: var(--accent-text);
    font-size: var(--text-2xs);
    font-weight: var(--weight-semibold);
  }
  .anav--menu .anav__link {
    height: 44px;
    font-size: var(--text-ui);
  }
</style>
