---
/**
 * Metric cards: one card with hairline cells (Stripe-style), each a label, the number in tabular
 * figures and one quiet note. Cells with `href` are links (hover fills, an arrow appears).
 * 2 columns on phones, 3 on tablets, up to 6 wide. Every strip carries its source line.
 */
import Icon from '~/components/ui/Icon.astro';

interface Metric {
  label: string;
  value: number | string;
  note?: string;
  href?: string;
}
interface Props {
  items: Metric[];
  /** Source line under the strip (every number shows where it came from). */
  source?: string;
}
const { items, source } = Astro.props;
const fmt = (v: number | string) => (typeof v === 'number' ? v.toLocaleString('en-US') : v);
---

<div class="metrics-wrap">
  <dl class="metrics" style={`--n:${items.length}`}>
    {items.map((m) => {
      const Cell = m.href ? 'a' : 'div';
      return (
        <div class="metric">
          <dt class="metric__label">{m.label}</dt>
          <dd class="metric__value num">
            <Cell
              href={m.href}
              class="metric__link"
              aria-label={m.href ? `${m.label}: ${fmt(m.value)}` : undefined}
            >
              {fmt(m.value)}
              {m.href && <Icon name="arrow-up-right" size={14} class="metric__arrow" />}
            </Cell>
          </dd>
          {m.note && <dd class="metric__note">{m.note}</dd>}
        </div>
      );
    })}
  </dl>
  {source && <p class="metrics__source">{source}</p>}
</div>

<style>
  .metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--line);
    box-shadow: var(--shadow-card);
  }
  @media (min-width: 768px) {
    .metrics {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 1280px) {
    .metrics {
      grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    }
  }
  .metric {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: 0;
    padding: var(--space-4);
    background: var(--surface);
    transition: background-color var(--dur-fast) var(--ease-out);
  }
  .metric:has(.metric__link[href]):hover {
    background: var(--bg-subtle);
  }
  .metric__label {
    order: 1;
    color: var(--ink-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }
  .metric__value {
    order: 2;
    color: var(--ink);
    font-size: 1.75rem;
    font-weight: var(--weight-semibold);
    letter-spacing: -0.03em;
    line-height: 1.15;
  }
  .metric__link {
    display: inline-flex;
    align-items: flex-start;
    gap: 4px;
  }
  /* The number is the link; the whole cell is its hit area. */
  a.metric__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  a.metric__link:focus-visible {
    outline: none;
  }
  a.metric__link:focus-visible::after {
    border-radius: var(--radius-sm);
    box-shadow: inset 0 0 0 2px var(--accent);
  }
  .metric__link :global(.metric__arrow) {
    margin-top: 4px;
    color: var(--ink-3);
    opacity: 0;
    transform: translate(-2px, 2px);
    transition:
      opacity var(--dur-fast) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }
  .metric:hover :global(.metric__arrow) {
    opacity: 1;
    transform: none;
  }
  .metric__note {
    order: 3;
    color: var(--ink-3);
    font-size: var(--text-xs);
    line-height: 1.4;
  }
  .metrics__source {
    margin-top: var(--space-2);
    color: var(--ink-3);
    font-size: var(--text-xs);
  }
  @media (max-width: 639px) {
    .metric {
      padding: var(--space-3) var(--space-4);
    }
    .metric__value {
      font-size: 1.5rem;
    }
  }
</style>
