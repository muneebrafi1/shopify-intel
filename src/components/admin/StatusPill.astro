---
/**
 * Status as a badge: the shared Badge (small, with a status dot) in a semantic tone.
 * pending/queued = caution, approved/done/active/published = positive, running = accent,
 * rejected/failed/opted out/blocked = critical, everything else neutral.
 * `variant="dot"`: dot and text without a fill, for long tables where a pill per row is noise.
 */
import Badge from '~/components/ui/Badge.astro';

interface Props {
  status: string;
  /** Override the visible text (defaults to the status, humanised). */
  label?: string;
  variant?: 'pill' | 'dot';
  size?: 'sm' | 'md';
  title?: string;
  class?: string;
}
const { status, label, variant = 'pill', size = 'sm', title, class: className } = Astro.props;
type Tone = 'caution' | 'positive' | 'critical' | 'accent' | 'neutral';
const TONES: Record<string, Tone> = {
  pending: 'caution',
  queued: 'caution',
  approved: 'positive',
  done: 'positive',
  active: 'positive',
  published: 'positive',
  captured: 'positive',
  running: 'accent',
  rejected: 'critical',
  failed: 'critical',
  opted_out: 'critical',
  blocked: 'critical',
};
const tone = TONES[status] ?? 'neutral';
const text = label ?? status.replace(/[_-]+/g, ' ').replace(/^./, (c) => c.toUpperCase());
---

{variant === 'dot' ? (
  <span class:list={['sdot', `sdot--${tone}`, className]} title={title}>
    <span class="sdot__mark" aria-hidden="true" />
    {text}
  </span>
) : (
  <Badge tone={tone} size={size} dot class={className} title={title}>
    {text}
  </Badge>
)}

<style>
  .sdot {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--ink-2);
    white-space: nowrap;
  }
  .sdot__mark {
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ink-4);
  }
  .sdot--caution .sdot__mark {
    background: var(--caution);
  }
  .sdot--positive .sdot__mark {
    background: var(--positive);
  }
  .sdot--critical .sdot__mark {
    background: var(--critical);
  }
  .sdot--accent .sdot__mark {
    background: var(--accent);
  }
  .sdot--critical {
    color: var(--critical);
  }
</style>
