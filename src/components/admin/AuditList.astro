---
/** Recent admin activity: what changed, by whom, when (reads `admin_audit`). A quiet timeline. */
import type { AuditRow } from '~/server/admin/queries';
import { AUDIT_LABELS } from '~/server/admin/audit';
import { fullTime, shortDate, timeAgo } from '~/server/admin/format';

interface Props {
  rows: AuditRow[];
  /** Hide the target column (e.g. on a store page, where every row is that store). */
  hideTarget?: boolean;
  empty?: string;
}
const { rows, hideTarget = false, empty = 'No admin activity yet.' } = Astro.props;
const now = new Date();

const FIELD_LABELS: Record<string, string> = {
  is_curated: 'curated',
  category_slug: 'category',
  category_id: 'category',
  price_label: 'price',
  program_id: 'program',
};
const show = (v: unknown) => (v === null || v === undefined || v === '' ? '—' : String(v));
const plural = (n: number, one: string) =>
  `${n.toLocaleString('en-US')} ${n === 1 ? one : `${one}s`}`;

function parse(row: AuditRow): Record<string, unknown> | null {
  if (!row.detail_json) return null;
  try {
    return JSON.parse(row.detail_json) as Record<string, unknown>;
  } catch {
    return null;
  }
}

function summary(row: AuditRow, detail: Record<string, unknown> | null): string {
  if (!detail) return '';
  if (row.action === 'removal.purge') {
    const n = Number(detail.purged ?? 0);
    const cutoff = typeof detail.cutoff === 'string' ? shortDate(detail.cutoff) : null;
    return `${plural(n, 'record')}${cutoff ? ` closed before ${cutoff}` : ''}`;
  }
  const parts: string[] = [];
  for (const [key, value] of Object.entries(detail)) {
    const label = FIELD_LABELS[key] ?? key.replace(/_/g, ' ');
    if (Array.isArray(value) && value.length === 2)
      parts.push(`${label} ${show(value[0])} → ${show(value[1])}`);
    else if (['kind', 'scope', 'objects', 'note', 'reference'].includes(key) && value !== null) {
      parts.push(`${label} ${show(value)}`);
    }
  }
  return parts.slice(0, 3).join(' · ');
}

function target(row: AuditRow): { text: string; href?: string } | null {
  const id = row.target_id;
  if (row.action === 'removal.purge') return { text: 'Removals', href: '/admin/removals' };
  if (!id) return null;
  switch (row.target_type) {
    case 'store':
      return { text: id, href: `/admin/stores/${encodeURIComponent(id)}` };
    case 'removal':
      return { text: `Request #${id}`, href: `/admin/removals/${encodeURIComponent(id)}` };
    case 'theme':
      return { text: id, href: `/admin/themes?q=${encodeURIComponent(id)}` };
    case 'app':
      return { text: id, href: `/admin/apps?q=${encodeURIComponent(id)}` };
    case 'teardown':
      return { text: id, href: '/admin/teardowns' };
    case 'affiliate_link':
      return { text: `Link #${id}`, href: `/admin/affiliates?edit=${encodeURIComponent(id)}#edit` };
    case 'affiliate_program':
      return { text: `Program #${id}`, href: '/admin/affiliates' };
    case 'client':
      // Salted IP hash for sign-in attempts: not useful to show.
      return null;
    default:
      return { text: id };
  }
}

type Kind = 'warn' | 'remove' | 'block' | 'default';
function kind(row: AuditRow, detail: Record<string, unknown> | null): Kind {
  if (row.action.endsWith('_failed')) return 'warn';
  if (detail?.capture_blocked === true) return 'block';
  if (row.action.startsWith('removal.')) return 'remove';
  return 'default';
}
---

{rows.length === 0 ? (
  <p class="audit-empty">{empty}</p>
) : (
  <ol class="audit">
    {rows.map((row) => {
      const detail = parse(row);
      const t = hideTarget ? null : target(row);
      const s = summary(row, detail);
      const k = kind(row, detail);
      return (
        <li class:list={['audit__row', `audit__row--${k}`]}>
          <span class="audit__dot" aria-hidden="true" />
          <div class="audit__body">
            <p class="audit__what">
              <span class="audit__action">{AUDIT_LABELS[row.action] ?? row.action}</span>
              {t &&
                (t.href ? (
                  <a href={t.href}>{t.text}</a>
                ) : (
                  <span class="audit__target">{t.text}</span>
                ))}
            </p>
            <p class="audit__meta">
              {row.actor}
              {s && <> · {s}</>}
              {k === 'block' && <span class="audit__flag"> · captures blocked</span>}
            </p>
          </div>
          <time class="audit__time" datetime={row.created_at} title={fullTime(row.created_at)}>
            {timeAgo(row.created_at, now)}
          </time>
        </li>
      );
    })}
  </ol>
)}

<style>
  .audit {
    position: relative;
    padding: var(--space-2) 0;
  }
  .audit__row {
    position: relative;
    display: grid;
    grid-template-columns: 7px minmax(0, 1fr) auto;
    gap: var(--space-3);
    align-items: start;
    padding: var(--space-2) var(--space-4);
  }
  /* The timeline rail between dots. */
  .audit__row:not(:last-child)::before {
    content: '';
    position: absolute;
    left: calc(var(--space-4) + 3px);
    top: calc(var(--space-2) + 15px);
    bottom: calc(var(--space-2) * -1 + 7px);
    width: 1px;
    background: var(--line);
  }
  .audit__dot {
    width: 7px;
    height: 7px;
    margin-top: 6px;
    border-radius: 50%;
    background: var(--surface);
    box-shadow: inset 0 0 0 1.5px var(--ink-4);
  }
  .audit__row--remove .audit__dot {
    box-shadow: inset 0 0 0 1.5px var(--ink-2);
  }
  .audit__row--block .audit__dot {
    background: var(--critical);
    box-shadow: none;
  }
  .audit__row--warn .audit__dot {
    background: var(--critical);
    box-shadow: none;
  }
  .audit__what {
    display: flex;
    flex-wrap: wrap;
    gap: 0 6px;
    font-size: var(--text-sm);
    line-height: 1.45;
  }
  .audit__action {
    color: var(--ink);
    font-weight: var(--weight-medium);
  }
  .audit__what a,
  .audit__target {
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }
  .audit__what a {
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
  }
  .audit__what a:hover {
    color: var(--ink);
    text-decoration-color: currentColor;
  }
  .audit__meta {
    margin-top: 1px;
    color: var(--ink-3);
    font-size: var(--text-xs);
    overflow-wrap: anywhere;
  }
  .audit__flag {
    color: var(--critical);
  }
  .audit__row--warn .audit__action {
    color: var(--critical);
  }
  .audit__time {
    padding-top: 1px;
    color: var(--ink-3);
    font-size: var(--text-xs);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .audit-empty {
    padding: var(--space-5) var(--space-4);
    color: var(--ink-3);
    font-size: var(--text-sm);
  }
</style>
