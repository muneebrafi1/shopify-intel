---
/**
 * The page header inside the admin content: the page's one <h1>, an optional count, a one-line
 * description and a meta row (status badges, links). The breadcrumb and the page actions live in
 * the layout's top bar (AdminLayout `trail` prop and `actions` slot).
 *
 *   <AdminHeader title="Stores" count={930} description="…" />
 *   <AdminHeader title={store.name}><StoreMark slot="mark" … /><p slot="meta">…</p></AdminHeader>
 */
interface Props {
  title: string;
  description?: string;
  count?: number;
  /** What the count counts, for assistive tech ("930 stores"). */
  countLabel?: string;
}
const { title, description, count, countLabel } = Astro.props;
const hasMark = Astro.slots.has('mark');
---

<header class:list={['ahead', { 'ahead--mark': hasMark }]}>
  {hasMark && (
    <div class="ahead__mark">
      <slot name="mark" />
    </div>
  )}
  <div class="ahead__text">
    <div class="ahead__titlerow">
      <h1 class="ahead__title">{title}</h1>
      {typeof count === 'number' && (
        <span class="ahead__count num" aria-label={`${count} ${countLabel ?? ''}`.trim()}>
          {count.toLocaleString('en-US')}
        </span>
      )}
    </div>
    {description && <p class="ahead__desc">{description}</p>}
    <slot name="meta" />
  </div>
</header>

<style>
  .ahead {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }
  .ahead__mark {
    flex: none;
    padding-top: 2px;
  }
  .ahead__text {
    min-width: 0;
    max-width: 760px;
  }
  .ahead__titlerow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-3);
  }
  .ahead__title {
    min-width: 0;
    color: var(--ink);
    font-size: var(--text-2xl);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.025em;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }
  .ahead__count {
    display: inline-flex;
    align-items: center;
    height: 22px;
    padding: 0 8px;
    border-radius: var(--radius-pill);
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--line);
    color: var(--ink-2);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
  }
  .ahead__desc {
    margin-top: var(--space-1-5);
    color: var(--ink-3);
    font-size: var(--text-ui);
    line-height: var(--leading-normal);
  }
  @media (max-width: 639px) {
    .ahead {
      margin-bottom: var(--space-5);
    }
    .ahead__title {
      font-size: 1.375rem;
    }
  }
</style>
