---
/**
 * Left rail on the apps index (desktop only): the categories as a book's table of contents —
 * number, name, count — each a filter link that keeps the other filters. Mobile uses the
 * FilterBar sheet instead.
 */
interface RailItem {
  label: string;
  href: string;
  count: number;
  selected?: boolean;
}
interface Props {
  all: RailItem;
  items: RailItem[];
  class?: string;
}
const { all, items, class: className } = Astro.props;
---

<nav class:list={['rail', className]} aria-label="App categories">
  <p class="mlabel mlabel--bullet mlabel--ink rail__label">Contents</p>
  <ol class="rail__list">
    <li>
      <a href={all.href} rel="nofollow" aria-current={all.selected ? 'true' : undefined}>
        <span class="rail__n">00</span>
        <span class="rail__name">{all.label}</span>
        <span class="rail__count num">{all.count}</span>
      </a>
    </li>
    {
      items.map((item, i) => (
        <li>
          <a href={item.href} rel="nofollow" aria-current={item.selected ? 'true' : undefined}>
            <span class="rail__n">{String(i + 1).padStart(2, '0')}</span>
            <span class="rail__name">{item.label}</span>
            <span class="rail__count num">{item.count}</span>
          </a>
        </li>
      ))
    }
  </ol>
  <a class="rail__more" href="/apps/categories">
    Categories by reach <span aria-hidden="true">→</span>
  </a>
</nav>

<style>
  .rail {
    border-top: 1px solid var(--ink);
    padding-bottom: var(--space-4);
  }
  /* Sticky only when the whole rail fits in the viewport. */
  @media (min-height: 980px) {
    .rail {
      position: sticky;
      top: calc(var(--header-h) + var(--space-6));
    }
  }
  .rail__label {
    display: flex;
    height: 57px;
    border-bottom: 1px solid var(--line);
  }
  .rail__list a {
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--space-2);
    padding: 7px 8px 7px 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink-2);
    font-size: var(--text-sm);
    transition:
      color var(--dur-fast) var(--ease-out),
      padding var(--dur-base) var(--ease-out);
  }
  .rail__list a:hover {
    color: var(--ink);
    padding-left: 4px;
  }
  .rail__list a[aria-current='true'] {
    color: var(--ink);
    font-weight: var(--weight-medium);
    box-shadow: inset 2px 0 0 var(--accent);
    padding-left: 10px;
  }
  .rail__n {
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
  }
  .rail__name {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .rail__count {
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
  }
  .rail__more {
    display: inline-flex;
    gap: 6px;
    margin-top: var(--space-4);
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.25em;
  }
  .rail__more:hover {
    text-decoration-color: currentColor;
  }
</style>
