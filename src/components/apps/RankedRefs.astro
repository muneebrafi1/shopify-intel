---
/**
 * A short ranked list of related apps or themes with a count and share: co-installed apps
 * ("41% of Judge.me stores also run Klaviyo") and themes most used by an app's stores.
 * Apps show their icon; themes show their name in the serif, like everywhere else.
 */
import AppIcon from '~/components/ui/AppIcon.astro';

export interface RankedRef {
  href: string;
  name: string;
  sub?: string | null;
  iconUrl?: string | null;
  stores: number;
  share: number;
}
interface Props {
  items: RankedRef[];
  kind: 'app' | 'theme';
  /** Screen-reader description of the share, e.g. "of Judge.me stores". */
  shareOf: string;
  class?: string;
}
const { items, kind, shareOf, class: className } = Astro.props;
---

<ol class:list={['ranked', `ranked--${kind}`, className]}>
  {items.map((item, i) => (
    <li>
      <a href={item.href} class="ranked__row">
        <span class="ranked__n">{String(i + 1).padStart(2, '0')}</span>
        {kind === 'app' && <AppIcon src={item.iconUrl} name={item.name} size={28} />}
        <span class="ranked__main">
          <span class="ranked__name">{item.name}</span>
          {item.sub && <span class="ranked__sub">{item.sub}</span>}
        </span>
        <span class="ranked__nums">
          <span class="ranked__stores num">{item.stores.toLocaleString('en-US')}</span>
          <span class="ranked__share num">
            {(item.share * 100).toFixed(item.share * 100 >= 10 ? 0 : 1)}%
            <span class="visually-hidden"> {shareOf}</span>
          </span>
        </span>
      </a>
    </li>
  ))}
</ol>

<style>
  .ranked {
    border-top: 1px solid var(--ink);
  }
  .ranked__row {
    position: relative;
    display: grid;
    grid-template-columns: 26px auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    min-height: 52px;
    padding: 8px 0;
    border-bottom: 1px solid var(--line);
    transition: background-color var(--dur-fast) var(--ease-out);
  }
  .ranked--theme .ranked__row {
    grid-template-columns: 26px minmax(0, 1fr) auto;
  }
  .ranked__row:hover {
    background: color-mix(in srgb, var(--fill) 70%, transparent);
  }
  .ranked__n {
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
  }
  .ranked__main {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .ranked__name {
    color: var(--ink);
    font-weight: var(--weight-medium);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ranked--theme .ranked__name {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }
  .ranked__sub {
    color: var(--ink-3);
    font-size: var(--text-xs);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ranked__nums {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
  }
  .ranked__stores {
    color: var(--ink);
    font-weight: var(--weight-medium);
  }
  .ranked__share {
    min-width: 3.2em;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    text-align: right;
  }
</style>
