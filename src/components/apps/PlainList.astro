---
/**
 * Compact, typographic list of apps that have no plate to show (grid view of the apps index):
 * N°, icon, name, stores. Flows into columns on wide screens like an index at the back of a book.
 */
import AppIcon from '~/components/ui/AppIcon.astro';
import MonoLabel from '~/components/ui/MonoLabel.astro';
import type { AppListItem } from '~/server/api/v1/types';
import { specimen } from './helpers';

interface Props {
  title: string;
  note: string;
  apps: AppListItem[];
  /** Per-app short reason, e.g. "Renders as Reviews". */
  reason?: (app: AppListItem) => string | null;
  class?: string;
}
const { title, note, apps, reason, class: className } = Astro.props;
---

{
  apps.length > 0 && (
    <section class:list={['plain', className]}>
      <div class="plain__head">
        <MonoLabel as="h2" tone="ink">
          {title} · {apps.length}
        </MonoLabel>
        <p class="plain__note">{note}</p>
      </div>
      <ol class="plain__list">
        {apps.map((app) => {
          const why = reason?.(app);
          return (
            <li>
              <a href={app.href}>
                <span class="plain__n">{specimen(app.usage.rank ?? 0)}</span>
                <AppIcon src={app.icon_url} name={app.short_name} size={22} />
                <span class="plain__name">
                  {app.short_name}
                  {why && <span class="plain__why">{why}</span>}
                </span>
                <span class="plain__stores num">{app.usage.stores.toLocaleString('en-US')}</span>
              </a>
            </li>
          );
        })}
      </ol>
    </section>
  )
}

<style>
  .plain__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-6);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--ink);
  }
  .plain__note {
    color: var(--ink-3);
    font-size: var(--text-sm);
  }
  .plain__list {
    columns: 1;
    column-gap: var(--space-8);
  }
  @media (min-width: 640px) {
    .plain__list {
      columns: 2;
    }
  }
  @media (min-width: 1024px) {
    .plain__list {
      columns: 3;
    }
  }
  .plain__list li {
    break-inside: avoid;
    border-bottom: 1px solid var(--line);
  }
  .plain__list a {
    display: grid;
    grid-template-columns: 44px 22px minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    min-height: 44px;
    padding: 6px 0;
    font-size: var(--text-sm);
    transition: background-color var(--dur-fast) var(--ease-out);
  }
  .plain__list a:hover {
    background: color-mix(in srgb, var(--fill) 70%, transparent);
  }
  .plain__n {
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
  }
  .plain__name {
    display: flex;
    flex-direction: column;
    min-width: 0;
    color: var(--ink);
    font-weight: var(--weight-medium);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .plain__why {
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    font-weight: var(--weight-regular);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .plain__stores {
    color: var(--ink-2);
    font-size: var(--text-xs);
  }
</style>
