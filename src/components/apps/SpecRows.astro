---
/**
 * Spec sheet rows: mono label left, value right in sans (FREITAG / In Common With data sheets).
 * Missing facts stay in the sheet and say so, so a thin profile reads as "not yet checked"
 * rather than as a broken page.
 */
export interface SpecRow {
  label: string;
  value?: string | null;
  href?: string;
  /** Quiet second line under the value (source, detail). */
  sub?: string | null;
  /** Shown instead of the value when it is missing. */
  missing?: string;
  mono?: boolean;
  title?: string;
}
interface Props {
  rows: SpecRow[];
  columns?: 1 | 2;
  class?: string;
}
const { rows, columns = 2, class: className } = Astro.props;
---

<dl class:list={['specs', `specs--${columns}`, className]}>
  {rows.map((r) => {
    const has = r.value !== null && r.value !== undefined && r.value !== '';
    return (
      <div class:list={['specs__row', { 'specs__row--missing': !has }]}>
        <dt class="specs__label">{r.label}</dt>
        <dd class="specs__value" title={r.title}>
          {has ? (
            r.href ? (
              <a href={r.href} class:list={[{ mono: r.mono }]}>
                {r.value}
              </a>
            ) : (
              <span class:list={[{ mono: r.mono }]}>{r.value}</span>
            )
          ) : (
            <span class="specs__missing">{r.missing ?? 'Not listed'}</span>
          )}
          {has && r.sub && <span class="specs__sub">{r.sub}</span>}
        </dd>
      </div>
    );
  })}
</dl>

<style>
  .specs {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    column-gap: var(--space-10);
  }
  @media (min-width: 768px) {
    .specs--2 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .specs__row {
    display: grid;
    grid-template-columns: minmax(118px, 40%) minmax(0, 1fr);
    align-items: baseline;
    gap: var(--space-4);
    padding: 11px 0;
    border-bottom: 1px solid var(--line);
  }
  .specs__label {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .specs__label::before {
    content: '';
    flex: none;
    width: 5px;
    height: 5px;
    background: currentColor;
    transform: translateY(-1px);
  }
  .specs__value {
    display: flex;
    flex-direction: column;
    min-width: 0;
    color: var(--ink);
    font-size: var(--text-md);
    overflow-wrap: anywhere;
  }
  .specs__value a {
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
    transition: text-decoration-color var(--dur-fast) var(--ease-out);
  }
  .specs__value a:hover {
    text-decoration-color: currentColor;
  }
  .specs__value .mono {
    font-size: var(--text-sm);
  }
  .specs__sub {
    margin-top: 2px;
    color: var(--ink-3);
    font-size: var(--text-xs);
  }
  .specs__missing {
    color: var(--ink-3);
  }
</style>
