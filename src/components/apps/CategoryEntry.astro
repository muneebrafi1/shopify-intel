---
/**
 * One entry of the app categories catalogue: N°, the category name set large, where its apps
 * show up on the page (mono labels), app count, reach (serif numeral + mono fraction) and the
 * three most used apps. The whole entry links to the category page.
 */
import AppIcon from '~/components/ui/AppIcon.astro';
import type { AppCategory } from '~/server/api/v1/types';
import { sharePct, specimen } from './helpers';

interface Props {
  n: number;
  category: AppCategory;
  denominator: number;
}
const { n, category: c, denominator } = Astro.props;
const surfaces = c.surfaces.map((s) => s.name);
---

<li class="centry">
  <a href={c.href} class="centry__link">
    <span class="centry__n">{specimen(n, 2)}</span>
    <span class="centry__main">
      <span class="centry__name">{c.name}</span>
      <span class="centry__where">
        {
          surfaces.length > 0 ? (
            surfaces.map((s) => <span class="mlabel mlabel--bullet">{s}</span>)
          ) : (
            <span class="mlabel centry__none">No storefront section</span>
          )
        }
      </span>
    </span>
    <span class="centry__apps">
      <span class="centry__apps-n num">{c.app_count}</span>
      <span class="centry__unit">{c.app_count === 1 ? 'app' : 'apps'}</span>
    </span>
    <span class="centry__reach">
      <span class="centry__pct num">{sharePct(c.share)}</span>
      <span class="centry__frac num">
        {c.store_count.toLocaleString('en-US')} of {denominator.toLocaleString('en-US')} stores
      </span>
    </span>
    <span class="centry__top" aria-label={`Most used: ${c.top_apps.map((a) => a.short_name).join(', ')}`}>
      {
        c.top_apps.slice(0, 3).map((a) => (
          <span class="centry__app" title={a.short_name}>
            <AppIcon src={a.icon_url} name={a.short_name} size={28} />
          </span>
        ))
      }
      <span class="centry__top-names">{c.top_apps.slice(0, 3).map((a) => a.short_name).join(', ')}</span>
    </span>
  </a>
</li>

<style>
  .centry {
    border-bottom: 1px solid var(--line);
  }
  .centry__link {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr) auto;
    grid-template-areas:
      'n main main'
      'n reach apps'
      'n top top';
    align-items: baseline;
    gap: var(--space-3) var(--space-4);
    padding: var(--space-5) 0 var(--space-6);
    transition:
      background-color var(--dur-fast) var(--ease-out),
      padding var(--dur-base) var(--ease-out);
  }
  .centry__link:hover {
    background: color-mix(in srgb, var(--fill) 60%, transparent);
  }
  .centry__n {
    grid-area: n;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.02em;
    padding-top: 0.6em;
  }
  .centry__main {
    grid-area: main;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-width: 0;
  }
  .centry__name {
    font-size: clamp(1.75rem, 1.2rem + 2.2vw, 3.25rem);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.035em;
    line-height: 1;
  }
  .centry__where {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
  }
  .centry__where .mlabel {
    color: var(--ink-2);
  }
  .centry__where .centry__none {
    color: var(--ink-3);
  }
  .centry__apps {
    grid-area: apps;
    display: flex;
    align-items: baseline;
    gap: 6px;
    justify-self: end;
  }
  .centry__apps-n {
    font-size: var(--text-xl);
    font-weight: var(--weight-medium);
  }
  .centry__unit {
    color: var(--ink-3);
    font-size: var(--text-sm);
  }
  .centry__reach {
    grid-area: reach;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px var(--space-3);
  }
  .centry__pct {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 1.4rem + 1.2vw, 2.5rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .centry__frac {
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .centry__top {
    grid-area: top;
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
  }
  .centry__top-names {
    margin-left: var(--space-2);
    color: var(--ink-3);
    font-size: var(--text-sm);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (min-width: 1024px) {
    .centry__link {
      grid-template-columns: 64px minmax(0, 5fr) minmax(0, 1fr) minmax(0, 2.4fr) minmax(0, 2.6fr);
      grid-template-areas: 'n main apps reach top';
      align-items: center;
      gap: var(--space-6);
      padding: var(--space-6) 0;
    }
    .centry__link:hover {
      padding-left: var(--space-3);
    }
    .centry__n {
      padding-top: 0;
      align-self: start;
      margin-top: 0.9em;
    }
    .centry__apps {
      justify-self: start;
      flex-direction: column;
      gap: 0;
    }
    .centry__reach {
      flex-direction: column;
      align-items: flex-start;
    }
    .centry__top {
      flex-wrap: wrap;
      justify-content: flex-end;
    }
    .centry__top-names {
      flex-basis: 100%;
      margin-left: 0;
      text-align: right;
      font-size: var(--text-xs);
    }
  }
</style>
