---
/**
 * An app's plans as cards, as listed on the Shopify App Store: name, price and period, trial,
 * then what the plan includes. No plan is highlighted (we don't sell them). Cards share one
 * row (up to 4) ≥1024, two per row on tablets and stack on phones.
 */
import Badge from '~/components/ui/Badge.astro';
import Card from '~/components/ui/Card.astro';
import Icon from '~/components/ui/Icon.astro';
import type { AppPlan } from '~/server/api/v1/types';

interface Props {
  plans: AppPlan[];
  class?: string;
}
const { plans, class: className } = Astro.props;
const MAX_FEATURES = 6;
const period = (p: AppPlan) => {
  if (p.price_cents === 0) return 'forever';
  if (!p.period) return 'one-time or usage based';
  return `per ${p.period}`;
};
const priceText = (p: AppPlan) => (p.price_cents === 0 ? 'Free' : p.price_label);
// Listing text occasionally carries stray markup ("<div"); show only the words.
const clean = (features: string[]) =>
  features.map((f) => f.replace(/<[^>]*>?/g, '').trim()).filter(Boolean);
const list = plans.map((p) => ({ ...p, features: clean(p.features) }));
---

<ul
  class:list={['plans', className]}
  style={`--plans:${Math.min(plans.length, 3)};--plans-md:${Math.min(plans.length, 2)}`}
  aria-label="Plans"
>
  {list.map((p) => (
    <li class="plans__item">
      <Card as="article" padding="md" class="plan">
        <div class="plan__top">
          <h3 class="plan__name">{p.name}</h3>
          {p.trial_days ? (
            <Badge size="sm">{p.trial_days}-day trial</Badge>
          ) : (
            p.price_cents === 0 && (
              <Badge size="sm" tone="positive">
                Free plan
              </Badge>
            )
          )}
        </div>
        <p class="plan__price">
          <span class="plan__amount num">{priceText(p)}</span>
          <span class="plan__period">{period(p)}</span>
        </p>
        {p.features.length > 0 ? (
          <ul class="plan__features">
            {p.features.slice(0, MAX_FEATURES).map((f) => (
              <li>
                <Icon name="check-bold" size={14} class="plan__check" />
                <span>{f}</span>
              </li>
            ))}
          </ul>
        ) : (
          <p class="plan__none">No features listed for this plan.</p>
        )}
        {p.features.length > MAX_FEATURES && (
          <details class="plan__more">
            <summary>
              {p.features.length - MAX_FEATURES} more
              <Icon name="caret-down" size={12} />
            </summary>
            <ul class="plan__features">
              {p.features.slice(MAX_FEATURES).map((f) => (
                <li>
                  <Icon name="check-bold" size={14} class="plan__check" />
                  <span>{f}</span>
                </li>
              ))}
            </ul>
          </details>
        )}
      </Card>
    </li>
  ))}
</ul>

<style>
  .plans {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
  }
  @media (min-width: 640px) {
    .plans {
      grid-template-columns: repeat(var(--plans-md), minmax(0, 1fr));
      gap: var(--space-4);
    }
  }
  @media (min-width: 1200px) {
    .plans {
      grid-template-columns: repeat(var(--plans), minmax(0, 1fr));
    }
  }
  .plans__item {
    display: flex;
    min-width: 0;
  }
  .plans__item > :global(.plan) {
    flex: 1;
  }
  .plan__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }
  .plan__name {
    min-width: 0;
    color: var(--ink-2);
    font-size: var(--text-ui);
    font-weight: var(--weight-semibold);
  }
  .plan__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px var(--space-2);
    margin-top: var(--space-2);
  }
  .plan__amount {
    color: var(--ink);
    font-size: var(--text-h2);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.025em;
    line-height: 1.15;
  }
  .plan__period {
    color: var(--ink-3);
    font-size: var(--text-sm);
  }
  .plan__features {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }
  .plan__more .plan__features {
    margin-top: var(--space-2);
    padding-top: 0;
    border-top: 0;
  }
  .plan__features li {
    display: grid;
    grid-template-columns: 14px minmax(0, 1fr);
    gap: var(--space-2);
    color: var(--ink-2);
    font-size: var(--text-sm);
    line-height: 1.45;
  }
  .plan__features :global(.plan__check) {
    margin-top: 3px;
    color: var(--ink);
  }
  .plan__none {
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
    color: var(--ink-3);
    font-size: var(--text-sm);
  }
  .plan__more {
    margin-top: var(--space-3);
  }
  .plan__more summary {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-height: 32px;
    color: var(--ink-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    cursor: pointer;
    list-style: none;
  }
  .plan__more summary::-webkit-details-marker {
    display: none;
  }
  .plan__more summary:hover {
    color: var(--ink);
  }
  .plan__more[open] summary :global(svg) {
    transform: rotate(180deg);
  }
</style>
