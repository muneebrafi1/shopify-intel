---
/**
 * A board in a grid: a card whose media well is a mosaic of its first three captures (one big,
 * two stacked), then the name and a meta line. Example boards say so with a badge.
 */
import Badge from '~/components/ui/Badge.astro';
import Card from '~/components/ui/Card.astro';

interface Thumb {
  src: string;
  width: number;
  height: number;
}
interface Props {
  href: string;
  name: string;
  count: number;
  thumbs: Thumb[];
  description?: string;
  example?: boolean;
  class?: string;
}
const { href, name, count, thumbs, description, example = false, class: className } = Astro.props;
const [a, b, c] = thumbs;
/** Very wide crops (headers, bars) are shown whole instead of cropped to fill the cell. */
const fit = (t: Thumb) => (t.width / t.height > 3 ? 'board__img--wide' : undefined);
---

<Card interactive padding="none" as="article" class:list={['board', className]}>
  <div slot="media" class="board__well">
    <span class="board__main">
      {a && (
        <img
          class={fit(a)}
          src={a.src}
          width={a.width}
          height={a.height}
          alt=""
          loading="lazy"
          decoding="async"
        />
      )}
    </span>
    <span class="board__side">
      <span>
        {b && (
          <img
            class={fit(b)}
            src={b.src}
            width={b.width}
            height={b.height}
            alt=""
            loading="lazy"
            decoding="async"
          />
        )}
      </span>
      <span>
        {c && (
          <img
            class={fit(c)}
            src={c.src}
            width={c.width}
            height={c.height}
            alt=""
            loading="lazy"
            decoding="async"
          />
        )}
      </span>
    </span>
  </div>
  <div class="board__body">
    <div class="board__row">
      <h3 class="board__name">
        <a class="stretched-link" href={href}>
          {name}
          {example && <span class="visually-hidden"> (example board)</span>}
        </a>
      </h3>
      {example && (
        <Badge tone="outline" size="sm">
          Example
        </Badge>
      )}
    </div>
    {description && <p class="board__desc">{description}</p>}
    <p class="board__meta num">
      {count}
      {count === 1 ? ' item' : ' items'}
    </p>
  </div>
</Card>

<style>
  .board__well {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: 6px;
    aspect-ratio: 16 / 10;
    padding: 10px;
  }
  .board__main,
  .board__side > span {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 0;
    overflow: hidden;
    border-radius: 6px;
    background: var(--surface-3);
  }
  .board__side {
    display: grid;
    grid-template-rows: 1fr 1fr;
    gap: 6px;
    min-height: 0;
  }
  .board__well img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    background: var(--capture-bg);
  }
  .board__well img.board__img--wide {
    width: calc(100% - 12px);
    height: auto;
    max-height: 100%;
    object-fit: contain;
    box-shadow: var(--shadow-shot);
  }
  .board__body {
    padding: var(--space-4);
  }
  .board__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .board__name {
    min-width: 0;
    font-size: var(--text-ui);
    font-weight: var(--weight-semibold);
  }
  .board__name a {
    color: var(--ink);
  }
  .board__name a:focus-visible {
    outline: none;
  }
  :global(.board:has(.stretched-link:focus-visible)) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .board__desc {
    margin-top: var(--space-1);
    color: var(--ink-2);
    font-size: var(--text-sm);
    line-height: 1.45;
  }
  .board__meta {
    margin-top: var(--space-2);
    color: var(--ink-3);
    font-size: var(--text-xs);
  }
</style>
