---
/**
 * A board in a list: a mosaic of its first three items in one warm well, then the name and a
 * mono meta line. Example boards say so in the meta line.
 */
interface Thumb {
  src: string;
  width: number;
  height: number;
}
interface Props {
  href: string;
  name: string;
  count: number;
  thumbs: Thumb[];
  example?: boolean;
  class?: string;
}
const { href, name, count, thumbs, example = false, class: className } = Astro.props;
const [a, b, c] = thumbs;
---

<article class:list={['board', className]}>
  <a class="board__well" href={href} aria-label={`${name}${example ? ' (example board)' : ''}`}>
    <span class="board__main">
      {a && (
        <img src={a.src} width={a.width} height={a.height} alt="" loading="lazy" decoding="async" />
      )}
    </span>
    <span class="board__side">
      <span>
        {b && (
          <img
            src={b.src}
            width={b.width}
            height={b.height}
            alt=""
            loading="lazy"
            decoding="async"
          />
        )}
      </span>
      <span>
        {c && (
          <img
            src={c.src}
            width={c.width}
            height={c.height}
            alt=""
            loading="lazy"
            decoding="async"
          />
        )}
      </span>
    </span>
  </a>
  <div class="board__caption">
    <h3 class="board__name">
      <a href={href}>{name}</a>
    </h3>
    <p class="board__meta">
      {example && <span class="board__example">Example</span>}
      <span class="num">
        {count} {count === 1 ? 'item' : 'items'}
      </span>
    </p>
  </div>
</article>

<style>
  .board {
    min-width: 0;
  }
  .board__well {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: 6px;
    aspect-ratio: 4 / 3;
    padding: 6px;
    border-radius: var(--radius-lg);
    background: var(--tile);
    transition: background-color var(--dur-base) var(--ease-out);
  }
  .board__well:hover {
    background: var(--tile-hover);
  }
  .board__well:focus-visible {
    border-radius: var(--radius-lg);
  }
  .board__main,
  .board__side > span {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 0;
    overflow: hidden;
    border-radius: 9px;
    background: color-mix(in srgb, var(--surface) 55%, var(--tile));
  }
  .board__side {
    display: grid;
    grid-template-rows: 1fr 1fr;
    gap: 6px;
    min-height: 0;
  }
  .board__well img {
    max-width: 86%;
    max-height: 86%;
    width: auto;
    height: auto;
    border-radius: 3px;
    box-shadow: var(--shadow-shot);
  }
  .board__caption {
    margin-top: var(--space-3);
  }
  .board__name {
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
  }
  .board__meta {
    display: flex;
    gap: var(--space-2);
    margin-top: 2px;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .board__example {
    color: var(--accent-text);
  }
</style>
