---
/** Confirmation after a removal request: the reference, what was asked, and what's next. */
import Button from '~/components/ui/Button.astro';
import MonoLabel from '~/components/ui/MonoLabel.astro';
import { CONTACT } from '~/config/site';
import { REMOVAL_SLA } from './content';
import { scopeLabel } from './removal';

interface Props {
  reference: string;
  domain: string | null;
  scope: string;
}
const { reference, domain, scope } = Astro.props;
---

<section class="receipt" aria-labelledby="receipt-title" data-receipt>
  <MonoLabel as="p" tone="accent" class="receipt__flag">
    Request received
  </MonoLabel>
  <h1 class="receipt__title display" id="receipt-title" tabindex="-1">
    We have your request.
  </h1>
  <p class="receipt__lede">
    We aim to handle it {REMOVAL_SLA}, and we’ll write to the email you gave. Keep the reference in
    case you need to follow up.
  </p>

  <dl class="receipt__spec marks">
    <div class="receipt__row receipt__row--ref">
      <dt>Reference</dt>
      <dd class="receipt__ref" data-reference>
        {reference}
      </dd>
    </div>
    {domain && (
      <div class="receipt__row">
        <dt>Store</dt>
        <dd>{domain}</dd>
      </div>
    )}
    <div class="receipt__row">
      <dt>Request</dt>
      <dd>{scopeLabel(scope)}</dd>
    </div>
    <div class="receipt__row">
      <dt>Status</dt>
      <dd>Waiting for review</dd>
    </div>
  </dl>

  <div class="receipt__actions">
    <Button href="/" variant="primary">
      Back to the library
    </Button>
    <Button href="/opt-out" variant="ghost">
      Send another request
    </Button>
  </div>
  <p class="receipt__help">
    Something to add? Reply to our email, or write to{' '}
    <a href={`mailto:${CONTACT.removals}?subject=${encodeURIComponent(reference)}`}>
      {CONTACT.removals}
    </a>{' '}
    with your reference.
  </p>
</section>

<style>
  .receipt :global(.receipt__flag) {
    display: flex;
    margin-bottom: var(--space-5);
  }
  .receipt__title {
    font-size: var(--text-5xl);
  }
  .receipt__title:focus {
    outline: none;
  }
  .receipt__lede {
    max-width: 560px;
    margin-top: var(--space-4);
    color: var(--ink-2);
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
  }
  .receipt__spec {
    max-width: 560px;
    margin-top: var(--space-10);
    padding: var(--space-2) var(--space-5);
  }
  .receipt__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--line);
    font-size: var(--text-sm);
  }
  .receipt__row:last-child {
    border-bottom: 0;
  }
  .receipt__row dt {
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .receipt__row dd {
    min-width: 0;
    color: var(--ink);
    text-align: right;
    overflow-wrap: anywhere;
  }
  .receipt__ref {
    font-family: var(--font-mono);
    font-size: var(--text-xl);
    letter-spacing: 0.02em;
  }
  .receipt__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-8);
  }
  .receipt__help {
    max-width: 560px;
    margin-top: var(--space-5);
    color: var(--ink-3);
    font-size: var(--text-sm);
  }
  .receipt__help a {
    color: var(--ink-2);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
  }
  @media (max-width: 639px) {
    .receipt__title {
      font-size: var(--text-4xl);
    }
    .receipt__lede {
      font-size: var(--text-md);
    }
  }
</style>
