---
/** Confirmation after a removal request: the reference, what was asked, and what's next. */
import Badge from '~/components/ui/Badge.astro';
import Button from '~/components/ui/Button.astro';
import Icon from '~/components/ui/Icon.astro';
import { CONTACT } from '~/config/site';
import { REMOVAL_SLA } from './content';
import { scopeLabel } from './removal';

interface Props {
  reference: string;
  domain: string | null;
  scope: string;
}
const { reference, domain, scope } = Astro.props;
---

<section class="receipt" aria-labelledby="receipt-title" data-receipt>
  <p class="receipt__flag">
    <Icon name="check-circle-fill" size={20} class="receipt__icon" />
    <span>Request received</span>
  </p>
  <h1 class="display-md receipt__title" id="receipt-title" tabindex="-1">
    We have your request.
  </h1>
  <p class="lead receipt__lede">
    We aim to handle it {REMOVAL_SLA}, and we’ll write to the email you gave. Keep the reference in
    case you need to follow up.
  </p>

  <div class="receipt__card">
    <div class="receipt__ref-row">
      <p class="receipt__ref-label">Reference</p>
      <p class="receipt__ref num" data-reference>
        {reference}
      </p>
    </div>
    <dl class="receipt__rows">
      {domain && (
        <div class="receipt__row">
          <dt>Store</dt>
          <dd class="mono">{domain}</dd>
        </div>
      )}
      <div class="receipt__row">
        <dt>Request</dt>
        <dd>{scopeLabel(scope)}</dd>
      </div>
      <div class="receipt__row">
        <dt>Status</dt>
        <dd>
          <Badge tone="caution" dot size="sm">
            Waiting for review
          </Badge>
        </dd>
      </div>
    </dl>
  </div>

  <div class="receipt__actions">
    <Button href="/" variant="primary">
      Back to the library
    </Button>
    <Button href="/opt-out" variant="secondary">
      Send another request
    </Button>
  </div>
  <p class="receipt__help">
    Something to add? Reply to our email, or write to{' '}
    <a href={`mailto:${CONTACT.removals}?subject=${encodeURIComponent(reference)}`}>
      {CONTACT.removals}
    </a>{' '}
    with your reference.
  </p>
</section>

<style>
  .receipt__flag {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
    color: var(--positive);
    font-size: var(--text-ui);
    font-weight: var(--weight-semibold);
  }
  .receipt__title:focus {
    outline: none;
  }
  .receipt__lede {
    max-width: 560px;
    margin-top: var(--space-3);
  }
  .receipt__card {
    max-width: 560px;
    margin-top: var(--space-8);
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }
  .receipt__ref-row {
    padding: var(--space-5);
    border-bottom: 1px dashed var(--line-strong);
    background: var(--surface-2);
  }
  .receipt__ref-label {
    color: var(--ink-3);
    font-size: var(--text-sm);
  }
  .receipt__ref {
    margin-top: var(--space-1);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: var(--text-h2);
    letter-spacing: 0.02em;
    overflow-wrap: anywhere;
  }
  .receipt__rows {
    padding: var(--space-1) var(--space-5);
  }
  .receipt__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 48px;
    border-bottom: 1px solid var(--line);
    font-size: var(--text-ui);
  }
  .receipt__row:last-child {
    border-bottom: 0;
  }
  .receipt__row dt {
    color: var(--ink-3);
  }
  .receipt__row dd {
    min-width: 0;
    color: var(--ink);
    text-align: right;
    overflow-wrap: anywhere;
  }
  .receipt__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-8);
  }
  .receipt__help {
    max-width: 560px;
    margin-top: var(--space-5);
    color: var(--ink-3);
    font-size: var(--text-sm);
  }
  .receipt__help a {
    color: var(--ink-2);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
    overflow-wrap: anywhere;
  }
</style>
