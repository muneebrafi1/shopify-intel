---
/** A short note for the right-hand aside of reading pages: a quiet card with a title. */
interface Props {
  title: string;
  class?: string;
}
const { title, class: className } = Astro.props;
---

<section class:list={['aside-note', className]}>
  <h2 class="aside-note__title">{title}</h2>
  <div class="aside-note__body">
    <slot />
  </div>
</section>

<style>
  .aside-note {
    padding: var(--space-4) var(--space-5) var(--space-5);
    border-radius: var(--radius-card);
    background: var(--surface);
    box-shadow:
      inset 0 0 0 1px var(--line),
      var(--shadow-xs),
      var(--highlight);
  }
  .aside-note + .aside-note {
    margin-top: var(--space-3);
  }
  .aside-note__title {
    color: var(--ink);
    font-size: var(--text-ui);
    font-weight: var(--weight-semibold);
  }
  .aside-note__body {
    margin-top: var(--space-1);
    color: var(--ink-2);
    font-size: var(--text-sm);
    line-height: 1.5;
  }
  .aside-note__body :global(p + p),
  .aside-note__body :global(p + .btn),
  .aside-note__body :global(p + a) {
    margin-top: var(--space-3);
  }
  .aside-note__body :global(a:not(.btn)) {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
    overflow-wrap: anywhere;
  }
  .aside-note__body :global(a:not(.btn):hover) {
    text-decoration-color: currentColor;
  }
</style>
