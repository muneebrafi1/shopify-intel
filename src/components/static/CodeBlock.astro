---
/**
 * Mono code block with a copy button. `variant="line"` is a compact one-line command (curl
 * examples under endpoint rows); `block` is a multi-line sample (JSON responses).
 */
import Icon from '~/components/ui/Icon.astro';

interface Props {
  code: string;
  /** Small mono caption above the block, e.g. "Response" or "bash". */
  label?: string;
  variant?: 'block' | 'line';
  /** Show a "$" prompt before a one-line command (not copied). */
  prompt?: boolean;
  class?: string;
}
const { code, label, variant = 'block', prompt = false, class: className } = Astro.props;
---

<div class:list={['code', `code--${variant}`, className]} data-code>
  {label && <p class="code__label">{label}</p>}
  <div class="code__body">
    <pre
      class="code__pre"
      tabindex="0"
    ><code>{prompt && <span class="code__prompt" aria-hidden="true">$ </span>}<span data-code-text>{code}</span></code></pre>
    <button type="button" class="code__copy" data-copy aria-label="Copy to clipboard" title="Copy">
      <Icon name="copy" size={15} class="code__icon code__icon--copy" />
      <Icon name="check" size={15} class="code__icon code__icon--done" />
    </button>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-code]').forEach((block) => {
    const button = block.querySelector<HTMLButtonElement>('[data-copy]');
    const text = block.querySelector<HTMLElement>('[data-code-text]')?.textContent ?? '';
    if (!button) return;
    if (!navigator.clipboard) {
      button.hidden = true;
      return;
    }
    let timer: number | undefined;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(text);
        button.dataset.copied = 'true';
        button.setAttribute('aria-label', 'Copied');
        window.clearTimeout(timer);
        timer = window.setTimeout(() => {
          delete button.dataset.copied;
          button.setAttribute('aria-label', 'Copy to clipboard');
        }, 1600);
      } catch {
        // Clipboard blocked (permissions); the text is still selectable.
      }
    });
  });
</script>

<style>
  /* A hairline card in both themes: label bar on top (block), mono body, copy button. */
  .code {
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-well);
    background: var(--surface);
    box-shadow: var(--shadow-xs);
  }
  .code__label {
    display: flex;
    align-items: center;
    height: 34px;
    padding: 0 var(--space-4);
    border-bottom: 1px solid var(--line);
    background: var(--surface-2);
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  .code__body {
    position: relative;
    display: flex;
    align-items: flex-start;
  }
  .code__pre {
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    margin: 0;
    padding: var(--space-4) var(--space-2) var(--space-4) var(--space-4);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.65;
    tab-size: 2;
    scrollbar-width: thin;
  }
  .code__pre:focus-visible {
    outline-offset: -2px;
  }
  .code__pre code {
    font: inherit;
    white-space: pre;
  }
  .code__prompt {
    color: var(--ink-3);
    user-select: none;
  }
  /* One-line command under an endpoint row: a quiet well, no card chrome. */
  .code--line {
    border-radius: var(--radius-control);
    background: var(--surface-2);
    box-shadow: none;
  }
  .code--line .code__body {
    align-items: center;
  }
  .code--line .code__pre {
    padding-block: var(--space-2);
    padding-left: var(--space-3);
    font-size: var(--text-xs);
    line-height: 1.6;
  }
  .code__copy {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    margin: 8px 8px 0 0;
    border-radius: var(--radius-control);
    color: var(--ink-3);
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .code__copy:hover {
    background: var(--surface-3);
    color: var(--ink);
  }
  .code--line .code__copy {
    width: 28px;
    height: 28px;
    margin: 0 4px 0 0;
  }
  @media (pointer: coarse) {
    .code__copy,
    .code--line .code__copy {
      width: 40px;
      height: 40px;
      margin-top: 0;
    }
  }
  .code__copy :global(.code__icon--done) {
    display: none;
  }
  .code__copy[data-copied] :global(.code__icon--copy) {
    display: none;
  }
  .code__copy[data-copied] :global(.code__icon--done) {
    display: inline-flex;
    color: var(--positive);
  }
</style>
