---
/**
 * Long-form document layout for Methodology, Affiliate disclosure, Privacy and Terms.
 *
 * Desktop: a sticky "On this page" rail on the left (numbered, scroll-spied), the ~680px reading
 * column centred, and an optional aside on the right. Mobile: a collapsible contents card under
 * the title, the other trust documents at the end.
 */
import MonoLabel from '~/components/ui/MonoLabel.astro';
import { formatDate } from '~/lib/format';
import { TRUST_DOCS, type TocItem } from './content';

interface Props {
  title: string;
  eyebrow?: string;
  lede?: string;
  /** YYYY-MM-DD shown as "Last updated". */
  updated?: string;
  /** Show the "Draft" marker next to the date. */
  draft?: boolean;
  toc: TocItem[];
  /** Number the h2 headings and TOC entries. */
  numbered?: boolean;
  /** href of this document, so the related-docs list can mark it. */
  current: string;
}

const { title, eyebrow, lede, updated, draft = false, toc, numbered = true, current } = Astro.props;
const related = TRUST_DOCS.filter((d) => d.href !== current);
const hasAside = Astro.slots.has('aside');
---

<div class:list={['doc container', { 'doc--numbered': numbered, 'doc--has-aside': hasAside }]}>
  <aside class="doc__rail" aria-label="On this page">
    <div class="doc__rail-inner">
      <p class="doc__rail-title">On this page</p>
      <ol class="doc__toc" data-toc>
        {toc.map((item) => (
          <li>
            <a href={`#${item.id}`} data-toc-link={item.id}>
              {item.label}
            </a>
          </li>
        ))}
      </ol>
      <p class="doc__rail-title doc__rail-title--related">Related</p>
      <ul class="doc__related">
        {related.map((d) => (
          <li>
            <a href={d.href}>{d.label}</a>
          </li>
        ))}
      </ul>
    </div>
  </aside>

  <article class="doc__main">
    <header class="doc__head">
      {eyebrow && (
        <MonoLabel as="p" class="doc__eyebrow">
          {eyebrow}
        </MonoLabel>
      )}
      <h1 class="doc__title display">{title}</h1>
      {(updated || draft) && (
        <MonoLabel as="p" class="doc__meta">
          {draft && <span class="doc__draft">Draft</span>}
          {draft && updated && <span aria-hidden="true">·</span>}
          {updated && (
            <span>
              Last updated <time datetime={updated}>{formatDate(updated)}</time>
            </span>
          )}
        </MonoLabel>
      )}
      {lede && <p class="doc__lede">{lede}</p>}
      <slot name="head" />
    </header>

    <details class="doc__contents">
      <summary>On this page</summary>
      <ol class="doc__toc doc__toc--mobile">
        {toc.map((item) => (
          <li>
            <a href={`#${item.id}`}>{item.label}</a>
          </li>
        ))}
      </ol>
    </details>

    {Astro.slots.has('summary') && (
      <section class="doc__summary" aria-labelledby="doc-summary-title">
        <MonoLabel as="h2" tone="ink" class="doc__summary-title" id="doc-summary-title">
          In short
        </MonoLabel>
        <slot name="summary" />
      </section>
    )}

    <div class="prose doc__body">
      <slot />
    </div>

    <nav class="doc__more" aria-label="Related documents">
      <p class="doc__more-title">Related</p>
      <ul>
        {related.map((d) => (
          <li>
            <a href={d.href}>
              {d.label}
              <span aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </article>

  {hasAside && (
    <div class="doc__aside">
      <div class="doc__aside-inner">
        <slot name="aside" />
      </div>
    </div>
  )}
</div>

<script>
  // Scroll-spy: mark the TOC entry for the section being read (the last heading that has
  // crossed the top third of the viewport). A rAF-throttled scroll handler stays correct after
  // jumps (anchor links, Home/End) where intersection events can be missed.
  const links = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]').forEach((a) => {
    links.set(a.dataset.tocLink ?? '', a);
  });
  const headings = [...links.keys()]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => !!el);

  let current = '';
  let queued = false;
  const update = () => {
    queued = false;
    const line = window.innerHeight * 0.33;
    let id = '';
    for (const h of headings) {
      if (h.getBoundingClientRect().top <= line) id = h.id;
      else break;
    }
    // At the very bottom, the last section is the one being read even if its heading is low.
    if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) {
      id = headings[headings.length - 1]?.id ?? id;
    }
    if (id === current) return;
    current = id;
    links.forEach((a, key) => {
      if (key === id) a.setAttribute('aria-current', 'true');
      else a.removeAttribute('aria-current');
    });
  };
  if (headings.length) {
    window.addEventListener(
      'scroll',
      () => {
        if (!queued) {
          queued = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    update();
  }
</script>

<style>
  .doc {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding-top: var(--space-8);
  }

  /* ---------- Rail (desktop only) ---------- */
  .doc__rail {
    display: none;
  }
  .doc__rail-inner {
    position: sticky;
    top: calc(var(--header-h) + var(--space-8));
    max-height: calc(100dvh - var(--header-h) - var(--space-12));
    overflow-y: auto;
    padding-bottom: var(--space-6);
  }
  .doc__rail-title {
    margin-bottom: var(--space-3);
    color: var(--ink-3);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
  }
  .doc__rail-title--related {
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--line);
  }
  .doc__toc {
    counter-reset: toc;
    border-left: 1px solid var(--line);
  }
  .doc__toc li {
    counter-increment: toc;
  }
  .doc__toc a {
    position: relative;
    display: flex;
    gap: var(--space-2);
    padding: 5px 0 5px var(--space-4);
    color: var(--ink-3);
    font-size: var(--text-sm);
    line-height: 1.35;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .doc--numbered .doc__toc a::before {
    content: counter(toc, decimal-leading-zero);
    flex: none;
    min-width: 1.6em;
    padding-top: 1px;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.02em;
  }
  .doc__toc a:hover {
    color: var(--ink);
  }
  .doc__toc a[aria-current='true'] {
    color: var(--ink);
  }
  .doc__toc a[aria-current='true']::after {
    content: '';
    position: absolute;
    left: -1px;
    top: 4px;
    bottom: 4px;
    width: 2px;
    border-radius: 2px;
    background: var(--accent);
  }
  .doc__related li + li {
    margin-top: var(--space-1);
  }
  .doc__related a {
    display: block;
    padding: 3px 0;
    color: var(--ink-3);
    font-size: var(--text-sm);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .doc__related a:hover {
    color: var(--ink);
  }

  /* ---------- Main column ---------- */
  .doc__main {
    min-width: 0;
    max-width: var(--reading-max);
  }
  .doc__head {
    padding-bottom: var(--space-8);
  }
  .doc__head :global(.doc__eyebrow) {
    display: flex;
    margin-bottom: var(--space-5);
  }
  .doc__title {
    font-size: var(--text-5xl);
  }
  .doc__head :global(.doc__meta) {
    display: flex;
    flex-wrap: wrap;
    margin-top: var(--space-5);
  }
  .doc__draft {
    color: var(--caution);
  }
  .doc__lede {
    margin-top: var(--space-5);
    color: var(--ink-2);
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
  }

  .doc__contents {
    margin-bottom: var(--space-8);
    border-radius: var(--radius-md);
    background: var(--fill);
  }
  .doc__contents > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 44px;
    padding: 0 var(--space-4);
    cursor: pointer;
    list-style: none;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }
  .doc__contents > summary::-webkit-details-marker {
    display: none;
  }
  .doc__contents > summary::after {
    content: '+';
    color: var(--ink-3);
    font-size: var(--text-lg);
    line-height: 1;
  }
  .doc__contents[open] > summary::after {
    content: '−';
  }
  .doc__toc--mobile {
    margin: 0 var(--space-4) var(--space-4);
  }
  .doc__toc--mobile a {
    padding-block: 7px;
    color: var(--ink-2);
  }

  .doc__summary {
    margin-bottom: var(--space-4);
    padding: var(--space-5) 0 var(--space-6);
    border-top: 1px solid var(--ink);
    color: var(--ink-2);
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
  }
  .doc__summary :global(.doc__summary-title) {
    display: flex;
    margin-bottom: var(--space-3);
  }
  .doc__summary :global(ul) {
    list-style: disc;
    padding-left: 1.2em;
  }
  .doc__summary :global(li + li) {
    margin-top: var(--space-1-5);
  }
  .doc__summary :global(li::marker) {
    color: var(--ink-4);
  }
  .doc__summary :global(strong) {
    color: var(--ink);
    font-weight: var(--weight-semibold);
  }

  /* Numbered section headings. */
  .doc--numbered .doc__body {
    counter-reset: sec;
  }
  .doc--numbered .doc__body > :global(h2) {
    counter-increment: sec;
  }
  .doc--numbered .doc__body > :global(h2) {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
  }
  .doc--numbered .doc__body > :global(h2)::before {
    content: counter(sec, decimal-leading-zero);
    flex: none;
    width: 2.2em;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-regular);
    letter-spacing: 0.02em;
  }
  .doc__body > :global(h2) {
    padding-top: var(--space-8);
    border-top: 1px solid var(--line);
  }
  .doc__body > :global(h2:first-child) {
    margin-top: var(--space-10);
  }
  .doc__body :global(h2 + p),
  .doc__body :global(h3 + p) {
    margin-top: var(--space-3);
  }

  .doc__more {
    margin-top: var(--space-16);
    padding-top: var(--space-6);
    border-top: 1px solid var(--line);
  }
  .doc__more-title {
    margin-bottom: var(--space-3);
    color: var(--ink-3);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
  }
  .doc__more ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .doc__more a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 36px;
    padding: 0 var(--space-4);
    border-radius: var(--radius-pill);
    background: var(--fill);
    color: var(--ink-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .doc__more a:hover {
    background: var(--fill-hover);
    color: var(--ink);
  }
  .doc__more span {
    color: var(--ink-3);
  }

  .doc__aside {
    min-width: 0;
    margin-top: var(--space-10);
  }

  @media (max-width: 639px) {
    .doc__title {
      font-size: var(--text-4xl);
    }
    .doc__lede {
      font-size: var(--text-md);
    }
  }

  @media (min-width: 1024px) {
    .doc {
      grid-template-columns: 200px minmax(0, 1fr);
      column-gap: var(--space-12);
      padding-top: var(--space-12);
    }
    .doc__rail {
      display: block;
      grid-row: 1 / span 2;
    }
    .doc__contents,
    .doc__more {
      display: none;
    }
    .doc__aside {
      grid-column: 2;
    }
  }

  @media (min-width: 1280px) {
    .doc {
      grid-template-columns: minmax(200px, 1fr) minmax(0, var(--reading-max)) minmax(200px, 1fr);
      column-gap: var(--space-16);
    }
    .doc__rail {
      grid-row: auto;
    }
    .doc__rail-inner {
      max-width: 240px;
    }
    .doc__aside {
      grid-column: 3;
      margin-top: 0;
    }
    .doc__aside-inner {
      position: sticky;
      top: calc(var(--header-h) + var(--space-8));
      max-width: 280px;
    }
  }
</style>
