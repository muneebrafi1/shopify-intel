---
/**
 * Reading layout for Methodology, Affiliate disclosure, Privacy, Terms (direction.md "Reading
 * pages"): a 680px column with a display-lg title, a dek and a byline/date row; a sticky,
 * scroll-spied "On this page" rail at ≥1200; an optional aside on the right at ≥1024. Below
 * 1200 the contents fold into a disclosure card under the title.
 */
import Badge from '~/components/ui/Badge.astro';
import Icon from '~/components/ui/Icon.astro';
import { formatDate } from '~/lib/format';
import { TRUST_DOCS, type TocItem } from './content';

interface Props {
  title: string;
  eyebrow?: string;
  lede?: string;
  /** YYYY-MM-DD shown as "Updated". */
  updated?: string;
  /** Who wrote it, shown before the date (e.g. "Editorial team"). */
  byline?: string;
  /** Pre-launch draft: a "Draft" badge and a not-legal-advice note under the title. */
  draft?: boolean;
  toc: TocItem[];
  /** @deprecated v1 numbered headings; ignored in v2. */
  numbered?: boolean;
  /** href of this document, so the related-docs list can leave it out. */
  current: string;
}

const { title, eyebrow, lede, updated, byline, draft = false, toc, current } = Astro.props;
const related = TRUST_DOCS.filter((d) => d.href !== current);
const hasAside = Astro.slots.has('aside');
---

<div class:list={['doc container', { 'doc--has-aside': hasAside }]}>
  <nav class="doc__rail" aria-label="On this page">
    <div class="doc__rail-inner">
      <p class="doc__rail-title">On this page</p>
      <ol class="doc__toc" data-toc>
        {toc.map((item) => (
          <li>
            <a href={`#${item.id}`} data-toc-link={item.id}>
              {item.label}
            </a>
          </li>
        ))}
      </ol>
    </div>
  </nav>

  <article class="doc__main">
    <header class="doc__head">
      {eyebrow && <p class="eyebrow doc__eyebrow">{eyebrow}</p>}
      <h1 class="display-lg doc__title">{title}</h1>
      {lede && <p class="lead doc__lede">{lede}</p>}
      {(updated || byline || draft) && (
        <p class="doc__meta">
          {draft && (
            <Badge tone="caution" size="sm">
              Draft
            </Badge>
          )}
          {byline && <span class="doc__byline">{byline}</span>}
          {byline && updated && (
            <span class="doc__sep" aria-hidden="true">
              ·
            </span>
          )}
          {updated && (
            <span>
              Updated <time datetime={updated}>{formatDate(updated)}</time>
            </span>
          )}
        </p>
      )}
      {draft && (
        <p class="doc__draft">
          <Icon name="info" size={16} />
          <span>
            A pre-launch draft, not legal advice. It will be reviewed before launch, and the date
            above changes when it does.
          </span>
        </p>
      )}
      <slot name="head" />
    </header>

    <details class="doc__contents">
      <summary>
        <span>On this page</span>
        <span class="doc__contents-count num">{toc.length}</span>
      </summary>
      <ol class="doc__contents-list">
        {toc.map((item) => (
          <li>
            <a href={`#${item.id}`}>{item.label}</a>
          </li>
        ))}
      </ol>
    </details>

    {Astro.slots.has('summary') && (
      <section class="doc__summary" aria-labelledby="doc-summary-title">
        <h2 class="doc__summary-title" id="doc-summary-title">
          In short
        </h2>
        <slot name="summary" />
      </section>
    )}

    <div class="prose doc__body">
      <slot />
    </div>

    <nav class="doc__more" aria-label="Related documents">
      <h2 class="doc__more-title">Related</h2>
      <ul>
        {related.map((d) => (
          <li>
            <a href={d.href}>
              <span>{d.label}</span>
              <Icon name="arrow-right" size={14} class="doc__more-arrow" />
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </article>

  {hasAside && (
    <aside class="doc__aside" aria-label="More">
      <div class="doc__aside-inner">
        <slot name="aside" />
      </div>
    </aside>
  )}
</div>

<script>
  // Scroll-spy: mark the contents entry for the section being read (the last heading that has
  // crossed the top third of the viewport). rAF-throttled scroll handler, correct after jumps.
  const links = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]').forEach((a) => {
    links.set(a.dataset.tocLink ?? '', a);
  });
  const headings = [...links.keys()]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => !!el);

  let current = '';
  let queued = false;
  const update = () => {
    queued = false;
    const line = window.innerHeight * 0.33;
    let id = '';
    for (const h of headings) {
      if (h.getBoundingClientRect().top <= line) id = h.id;
      else break;
    }
    if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) {
      id = headings[headings.length - 1]?.id ?? id;
    }
    if (id === current) return;
    current = id;
    links.forEach((a, key) => {
      if (key === id) a.setAttribute('aria-current', 'true');
      else a.removeAttribute('aria-current');
    });
  };
  if (headings.length) {
    window.addEventListener(
      'scroll',
      () => {
        if (!queued) {
          queued = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    update();
  }
</script>

<style>
  .doc {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding-block: var(--space-10) var(--section-y);
  }

  /* ---------- Rail (≥1200 only) ---------- */
  .doc__rail {
    display: none;
  }
  .doc__rail-inner {
    position: sticky;
    top: calc(var(--header-h) + var(--space-8));
    max-height: calc(100dvh - var(--header-h) - var(--space-12));
    overflow-y: auto;
    padding-bottom: var(--space-6);
  }
  .doc__rail-title {
    margin-bottom: var(--space-3);
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }
  .doc__toc {
    border-left: 1px solid var(--line);
  }
  .doc__toc a {
    position: relative;
    display: block;
    padding: 5px 0 5px var(--space-4);
    color: var(--ink-3);
    font-size: var(--text-sm);
    line-height: 1.4;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .doc__toc a:hover,
  .doc__toc a[aria-current='true'] {
    color: var(--ink);
  }
  .doc__toc a[aria-current='true']::before {
    content: '';
    position: absolute;
    left: -1px;
    top: 5px;
    bottom: 5px;
    width: 2px;
    border-radius: 2px;
    background: var(--accent);
  }

  /* ---------- Reading column ---------- */
  .doc__main {
    min-width: 0;
    max-width: var(--reading-max);
  }
  .doc__head {
    padding-bottom: var(--space-8);
  }
  .doc__eyebrow {
    margin-bottom: var(--space-4);
  }
  .doc__lede {
    margin-top: var(--space-4);
  }
  .doc__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-5);
    color: var(--ink-3);
    font-size: var(--text-sm);
  }
  .doc__byline {
    color: var(--ink-2);
    font-weight: var(--weight-medium);
  }
  .doc__sep {
    color: var(--ink-4);
  }
  .doc__draft {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    margin-top: var(--space-5);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-control);
    background: var(--caution-soft);
    color: var(--ink-2);
    font-size: var(--text-sm);
    line-height: 1.5;
  }
  .doc__draft :global(.icon) {
    margin-top: 2px;
    color: var(--caution);
  }

  .doc__contents {
    margin-bottom: var(--space-8);
    border-radius: var(--radius-card);
    background: var(--surface);
    box-shadow:
      inset 0 0 0 1px var(--line),
      var(--shadow-xs),
      var(--highlight);
  }
  .doc__contents > summary {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 48px;
    padding: 0 var(--space-4);
    cursor: pointer;
    list-style: none;
    color: var(--ink);
    font-size: var(--text-ui);
    font-weight: var(--weight-medium);
  }
  .doc__contents > summary::-webkit-details-marker {
    display: none;
  }
  .doc__contents > summary::after {
    content: '';
    width: 7px;
    height: 7px;
    margin-left: auto;
    margin-right: 4px;
    border-right: 1.5px solid var(--ink-3);
    border-bottom: 1.5px solid var(--ink-3);
    transform: translateY(-2px) rotate(45deg);
    transition: transform var(--dur-base) var(--ease-out);
  }
  .doc__contents[open] > summary::after {
    transform: translateY(2px) rotate(-135deg);
  }
  .doc__contents-count {
    color: var(--ink-3);
    font-weight: var(--weight-regular);
  }
  .doc__contents-list {
    padding: 0 var(--space-4) var(--space-3);
    border-top: 1px solid var(--line);
  }
  .doc__contents-list a {
    display: flex;
    align-items: center;
    min-height: 40px;
    color: var(--ink-2);
    font-size: var(--text-ui);
  }
  .doc__contents-list li + li {
    border-top: 1px solid var(--line);
  }

  .doc__summary {
    margin-bottom: var(--space-4);
    padding: var(--space-5) var(--space-6);
    border-radius: var(--radius-card);
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--line);
    color: var(--ink-2);
    font-size: var(--text-body);
    line-height: var(--leading-relaxed);
  }
  .doc__summary-title {
    margin-bottom: var(--space-2);
    color: var(--ink);
    font-size: var(--text-h4);
    font-weight: var(--weight-strong);
  }
  .doc__summary :global(ul) {
    display: grid;
    gap: var(--space-1-5);
  }
  .doc__summary :global(li) {
    position: relative;
    padding-left: var(--space-5);
  }
  .doc__summary :global(li)::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.72em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ink-4);
  }
  .doc__summary :global(strong) {
    color: var(--ink);
    font-weight: var(--weight-semibold);
  }
  .doc__summary :global(code) {
    font-family: var(--font-mono);
    font-size: 0.86em;
    color: var(--ink);
  }

  .doc__body > :global(h2) {
    scroll-margin-top: calc(var(--header-h) + var(--space-6));
  }
  .doc__body > :global(h2:first-child) {
    margin-top: var(--space-10);
  }
  .doc__body :global(h3) {
    scroll-margin-top: calc(var(--header-h) + var(--space-6));
  }

  .doc__more {
    margin-top: var(--space-16);
    padding-top: var(--space-6);
    border-top: 1px solid var(--line);
  }
  .doc__more-title {
    margin-bottom: var(--space-3);
    color: var(--ink);
    font-size: var(--text-ui);
    font-weight: var(--weight-semibold);
  }
  .doc__more ul {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2);
  }
  .doc__more a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 44px;
    padding: 0 var(--space-4);
    border-radius: var(--radius-control);
    background: var(--surface);
    box-shadow:
      inset 0 0 0 1px var(--line),
      var(--shadow-xs);
    color: var(--ink);
    font-size: var(--text-ui);
    font-weight: var(--weight-medium);
    transition:
      box-shadow var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }
  .doc__more a:hover {
    box-shadow:
      inset 0 0 0 1px var(--line-strong),
      var(--shadow-sm);
  }
  .doc__more a :global(.doc__more-arrow) {
    color: var(--ink-3);
    transition: transform var(--dur-base) var(--ease-out);
  }
  .doc__more a:hover :global(.doc__more-arrow) {
    transform: translateX(2px);
    color: var(--ink);
  }

  .doc__aside {
    min-width: 0;
    margin-top: var(--space-10);
  }

  @media (min-width: 640px) {
    .doc__more ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Aside on the right from 1024; the rail joins at 1200. */
  @media (min-width: 1024px) {
    .doc {
      padding-top: var(--space-16);
    }
    .doc--has-aside {
      grid-template-columns: minmax(0, var(--reading-max)) minmax(0, 1fr);
      column-gap: var(--space-12);
    }
    .doc__aside {
      margin-top: 0;
    }
    .doc__aside-inner {
      position: sticky;
      top: calc(var(--header-h) + var(--space-8));
      max-width: 260px;
    }
  }
  @media (min-width: 1200px) {
    .doc {
      grid-template-columns: 200px minmax(0, var(--reading-max));
      column-gap: var(--space-12);
    }
    .doc--has-aside {
      grid-template-columns: 200px minmax(0, var(--reading-max)) minmax(0, 1fr);
    }
    .doc__rail {
      display: block;
    }
    .doc__contents {
      display: none;
    }
  }
</style>
