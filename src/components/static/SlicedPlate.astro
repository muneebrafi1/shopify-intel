---
/**
 * Methodology figure: one full page drawn with the placeholder renderer, its sections outlined
 * and numbered, and a legend with each section's position. It explains slicing; it is a
 * drawing, not a capture, and the caption says so.
 */
import { renderPlaceholderSvg, type PlaceholderSection } from '~/server/media/placeholder-svg';
import { sectionTypeName } from '~/lib/taxonomy';

const WIDTH = 1440;
const LAYOUT: [string, number][] = [
  ['announcement-bar', 40],
  ['header', 84],
  ['hero', 680],
  ['featured-collection', 640],
  ['image-with-text', 600],
  ['testimonials', 380],
  ['newsletter', 340],
  ['footer', 440],
];

let y = 0;
const sections: PlaceholderSection[] = LAYOUT.map(([type, height]) => {
  const s = { type, y, height };
  y += height;
  return s;
});
const height = y;
const svg = renderPlaceholderSvg(
  { seed: 'methodology-example', label: 'Example store', device: 'desktop', pageType: 'home', width: WIDTH, height, sections },
  { outputWidth: 480 },
);
const src = `data:image/svg+xml;charset=utf-8,${encodeURIComponent(svg)}`;
const pct = (n: number) => `${((n / height) * 100).toFixed(3)}%`;
const pad = (n: number) => String(n).padStart(2, '0');
---

<figure class="plate">
  <div class="plate__grid">
    <div class="plate__stage marks">
      <div class="plate__page">
        <img src={src} width={480} height={Math.round((height / WIDTH) * 480)} alt="" loading="lazy" decoding="async" />
        {
          sections.map((s, i) => (
            <span class="plate__slice" style={`top:${pct(s.y)};height:${pct(s.height)}`} aria-hidden="true">
              {s.height >= 300 && <span class="plate__tag">{pad(i + 1)}</span>}
            </span>
          ))
        }
      </div>
    </div>
    <ol class="plate__legend">
      {
        sections.map((s, i) => (
          <li>
            <span class="plate__n">{pad(i + 1)}</span>
            <span class="plate__name">{sectionTypeName(s.type)}</span>
            <span class="plate__px">
              {s.y}–{s.y + s.height}
            </span>
          </li>
        ))
      }
    </ol>
  </div>
  <figcaption class="plate__caption">
    <span>Home page, desktop, sliced into {sections.length} sections.</span>
    <span class="plate__mono">Diagram · drawn layout, not a capture · positions in CSS px at 1440 wide</span>
  </figcaption>
</figure>

<style>
  .plate {
    margin-block: var(--space-8);
  }
  .plate__grid {
    display: grid;
    grid-template-columns: minmax(0, 150px) minmax(0, 1fr);
    gap: var(--space-6);
    align-items: start;
  }
  .plate__stage {
    padding: var(--space-3);
    border-radius: var(--radius-md);
    background: var(--tile);
  }
  .plate__page {
    position: relative;
    box-shadow: var(--shadow-shot);
  }
  .plate__page img {
    width: 100%;
    height: auto;
  }
  .plate__slice {
    position: absolute;
    left: 0;
    right: 0;
    border-top: 1px dashed color-mix(in srgb, var(--accent) 70%, transparent);
  }
  .plate__slice:first-of-type {
    border-top: 0;
  }
  .plate__tag {
    position: absolute;
    top: 4px;
    left: 4px;
    padding: 1px 4px;
    border-radius: 3px;
    background: var(--inverse);
    color: var(--ink-inverse);
    font-family: var(--font-mono);
    font-size: 9px;
    line-height: 1.3;
  }
  .plate__legend {
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
  }
  .plate__legend li {
    margin: 0;
    display: grid;
    grid-template-columns: 2.2em minmax(0, 1fr) auto;
    gap: var(--space-3);
    align-items: baseline;
    padding: 7px 0;
    border-bottom: 1px solid var(--line);
  }
  .plate__legend li:first-child {
    border-top: 1px solid var(--ink);
  }
  .plate__n,
  .plate__px {
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    font-variant-numeric: tabular-nums;
  }
  .plate__name {
    color: var(--ink);
  }
  .plate__caption {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: var(--space-4);
    color: var(--ink-2);
    font-size: var(--text-sm);
  }
  .plate__mono {
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  @media (min-width: 640px) {
    .plate__grid {
      grid-template-columns: minmax(0, 220px) minmax(0, 1fr);
      gap: var(--space-10);
    }
    .plate__stage {
      padding: var(--space-4);
    }
  }
</style>
