---
/**
 * Methodology figure: one full page drawn with the placeholder renderer, each section outlined
 * with a pinned type tag, and a legend with positions. It explains slicing; it is a
 * drawing, not a capture, and the caption says so.
 */
import { renderPlaceholderSvg, type PlaceholderSection } from '~/server/media/placeholder-svg';
import { sectionTypeName } from '~/lib/taxonomy';

const WIDTH = 1440;
const LAYOUT: [string, number][] = [
  ['announcement-bar', 40],
  ['header', 84],
  ['hero', 680],
  ['featured-collection', 640],
  ['image-with-text', 600],
  ['testimonials', 380],
  ['newsletter', 340],
  ['footer', 440],
];

let y = 0;
const sections: PlaceholderSection[] = LAYOUT.map(([type, height]) => {
  const s = { type, y, height };
  y += height;
  return s;
});
const height = y;
const svg = renderPlaceholderSvg(
  {
    seed: 'methodology-example',
    label: 'Example store',
    device: 'desktop',
    pageType: 'home',
    width: WIDTH,
    height,
    sections,
  },
  { outputWidth: 480 },
);
const src = `data:image/svg+xml;charset=utf-8,${encodeURIComponent(svg)}`;
const pct = (n: number) => `${((n / height) * 100).toFixed(3)}%`;
---

<figure class="plate">
  <div class="plate__grid">
    <div class="plate__stage" data-theme="light">
      <div class="plate__page">
        <img
          src={src}
          width={480}
          height={Math.round((height / WIDTH) * 480)}
          alt=""
          loading="lazy"
          decoding="async"
        />
        {sections.map((s) => (
          <span
            class="plate__slice"
            style={`top:${pct(s.y)};height:${pct(s.height)}`}
            aria-hidden="true"
          >
            {s.height >= 300 && <span class="plate__tag">{sectionTypeName(s.type)}</span>}
          </span>
        ))}
      </div>
    </div>
    <div class="plate__side">
      <p class="plate__side-title">
        {sections.length} sections <span class="plate__side-meta">· home page, desktop</span>
      </p>
      <ol class="plate__legend">
        {sections.map((s) => (
          <li>
            <span class="plate__name">{sectionTypeName(s.type)}</span>
            <span class="plate__px num">
              {s.y}–{s.y + s.height}px
            </span>
          </li>
        ))}
      </ol>
    </div>
  </div>
  <figcaption class="plate__caption">
    A drawn layout, not a capture. Positions are CSS pixels on a page 1,440px wide.
  </figcaption>
</figure>

<style>
  .plate {
    margin-block: var(--space-8);
  }
  .plate__grid {
    display: grid;
    grid-template-columns: minmax(0, 150px) minmax(0, 1fr);
    gap: var(--space-5);
    align-items: start;
    padding: var(--space-4);
    border-radius: var(--radius-card);
    background: var(--surface);
    box-shadow:
      inset 0 0 0 1px var(--line),
      var(--shadow-xs),
      var(--highlight);
  }
  .plate__stage {
    padding: var(--space-3);
    border-radius: var(--radius-well);
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .plate__page {
    position: relative;
    overflow: hidden;
    border-radius: 3px;
    background: var(--capture-bg);
    box-shadow: var(--shadow-shot);
  }
  .plate__page img {
    display: block;
    width: 100%;
    height: auto;
  }
  .plate__slice {
    position: absolute;
    left: 0;
    right: 0;
    border-top: 1px dashed var(--line-strong);
  }
  .plate__slice:first-of-type {
    border-top: 0;
  }
  .plate__tag {
    position: absolute;
    top: 4px;
    left: 4px;
    max-width: calc(100% - 8px);
    overflow: hidden;
    padding: 1px 5px;
    border-radius: var(--radius-pill);
    background: var(--btn-bg);
    color: var(--btn-fg);
    font-family: var(--font-mono);
    font-size: 9px;
    line-height: 1.4;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .plate__side {
    min-width: 0;
  }
  .plate__side-title {
    color: var(--ink);
    font-size: var(--text-ui);
    font-weight: var(--weight-semibold);
  }
  .plate__side-meta {
    color: var(--ink-3);
    font-weight: var(--weight-regular);
  }
  .plate__legend {
    margin-top: var(--space-2);
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
  }
  .plate__legend li {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    margin: 0;
    padding: 7px 0;
    border-bottom: 1px solid var(--line);
  }
  .plate__legend li:last-child {
    border-bottom: 0;
  }
  .plate__name {
    min-width: 0;
    color: var(--ink);
  }
  .plate__px {
    flex: none;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  .plate__caption {
    margin-top: var(--space-3);
    color: var(--ink-3);
    font-size: var(--text-sm);
  }
  @media (max-width: 639px) {
    .plate__legend li {
      flex-direction: column;
      gap: 0;
      padding: 6px 0;
    }
  }
  @media (min-width: 640px) {
    .plate__grid {
      grid-template-columns: minmax(0, 220px) minmax(0, 1fr);
      gap: var(--space-8);
      padding: var(--space-5);
    }
    .plate__stage {
      padding: var(--space-4);
    }
  }
</style>
