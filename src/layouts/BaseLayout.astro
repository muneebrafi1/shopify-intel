---
/**
 * The one HTML shell for every public page: head/SEO, theme, header, main, footer.
 * Pages pass a plain title (no brand); the brand is appended from SITE_NAME.
 *
 * Theme: a tiny inline script in <head> resolves localStorage['theme'] ('light' | 'dark' |
 * 'system', default system → prefers-color-scheme) and sets <html data-theme data-theme-pref
 * class="js"> before first paint, so there is no flash. Without JS the CSS media query applies.
 * `client/theme.ts` keeps it in sync afterwards (controls, system changes, other tabs).
 */
import '~/styles/base.css';
import fontUrl from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';
import { SITE_NAME, SITE_TAGLINE, SHOW_CAPTURE_PREVIEW_NOTICE } from '~/config/site';
import PreviewNotice from '~/components/site/PreviewNotice.astro';
import { api } from '~/server/api';
import { formatDate } from '~/lib/format';
import Header from '~/components/site/Header.astro';
import Footer from '~/components/site/Footer.astro';
import CommandPalette from '~/components/site/CommandPalette.astro';

interface Props {
  /** Page title without the brand. Omit on the home page. */
  title?: string;
  description?: string;
  /** Canonical path (defaults to the current path, without query string). */
  canonical?: string;
  noindex?: boolean;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  /** One or more schema.org objects, serialised as JSON-LD. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Hide the global header/footer (admin, focused flows). */
  chrome?: 'full' | 'minimal' | 'none';
  bodyClass?: string;
  /** Live nav counts (see Header). Filled from the API meta by `getChromeData`. */
  navCounts?: Record<string, number>;
  /** Footer data line (source + as-of). */
  dataNote?: string;
  /** Gallery pages (stores, themes, sections): align header/footer with the 1440 container. */
  wide?: boolean;
}

const {
  title,
  description = `${SITE_TAGLINE}. See how every Shopify theme and app looks on live stores — home, collection, product and cart, on desktop and mobile.`,
  canonical,
  noindex = false,
  ogImage,
  ogImageAlt,
  ogType = 'website',
  jsonLd,
  chrome = 'full',
  bodyClass,
  wide = false,
} = Astro.props;

// Live chrome data (nav superscript counts, footer data line) from the same API the pages use.
// Cached per isolate by the API layer; failures (e.g. prerender without D1) degrade silently.
let navCounts = Astro.props.navCounts;
let dataNote = Astro.props.dataNote;
if (chrome === 'full' && (!navCounts || !dataNote)) {
  try {
    const { data: meta } = await api.getMeta({});
    const c = meta.counts;
    navCounts ??= {
      '/stores': c.stores_scanned,
      '/themes': c.themes,
      '/apps': c.apps,
      '/sections': c.sections,
      '/teardowns': c.teardowns,
    };
    dataNote ??= `${c.stores_scanned.toLocaleString('en-US')} stores scanned · ${c.stores_curated} curated · data as of ${formatDate(meta.data_as_of)}`;
  } catch {
    /* chrome renders without live numbers */
  }
}

const fullTitle = title ? `${title} · ${SITE_NAME}` : `${SITE_NAME} — ${SITE_TAGLINE}`;
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, Astro.site ?? Astro.url).href;
const ldItems = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const resolvedOgImage = ogImage ?? (noindex ? undefined : '/og-default.png');
const ogImageHref = resolvedOgImage
  ? new URL(resolvedOgImage, Astro.site ?? Astro.url).href
  : undefined;
const ogAltText =
  ogImageAlt ?? (title ? `${title} · ${SITE_NAME}` : `${SITE_NAME} — ${SITE_TAGLINE}`);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>
      // Theme before first paint (see the comment at the top of BaseLayout.astro).
      (function () {
        var d = document.documentElement;
        var pref = 'system';
        try {
          var stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark' || stored === 'system') pref = stored;
        } catch (e) {}
        var dark =
          pref === 'dark' ||
          (pref === 'system' &&
            !!window.matchMedia &&
            window.matchMedia('(prefers-color-scheme: dark)').matches);
        d.setAttribute('data-theme', dark ? 'dark' : 'light');
        d.setAttribute('data-theme-pref', pref);
        d.className += ' js';
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', dark ? '#0a0a0b' : '#ffffff');
        // If the motion module never runs, stop hiding .reveal content.
        setTimeout(function () {
          if (!d.getAttribute('data-motion')) d.className += ' reveal-off';
        }, 3000);
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title ?? SITE_NAME} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    {ogImageHref && <meta property="og:image" content={ogImageHref} />}
    {ogImageHref && <meta property="og:image:alt" content={ogAltText} />}
    <meta name="twitter:card" content={ogImageHref ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title ?? SITE_NAME} />
    <meta name="twitter:description" content={description} />
    {ogImageHref && <meta name="twitter:image" content={ogImageHref} />}
    {ldItems.map((item) => (
      <script
        type="application/ld+json"
        set:html={JSON.stringify({ '@context': 'https://schema.org', ...item })}
      />
    ))}
    <script is:inline>
      // Remote images (app icons from the App Store CDN) can fail; drop them so the monogram
      // underneath shows instead of a broken-image glyph.
      document.addEventListener(
        'error',
        (event) => {
          const el = event.target;
          if (el instanceof HTMLImageElement && el.closest('.app-icon')) el.remove();
        },
        true,
      );
    </script>
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    {SHOW_CAPTURE_PREVIEW_NOTICE && chrome === 'full' && <PreviewNotice />}
    {chrome !== 'none' && <Header minimal={chrome === 'minimal'} counts={navCounts} wide={wide} />}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {chrome === 'full' && <Footer dataNote={dataNote} wide={wide} />}
    <slot name="end" />
    <CommandPalette />
  </body>
</html>

<script>
  import '~/components/ui/client/theme';
  import '~/components/ui/client/motion';
</script>

<style>
  main {
    display: block;
    min-height: 60vh;
  }
  main:focus {
    outline: none;
  }
</style>
