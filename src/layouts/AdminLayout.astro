---
/**
 * The protected admin's app shell (Linear-like): a 232px sidebar with the sections and their
 * counts, a sticky top bar with the breadcrumb and the page's actions, and the content area.
 * Below 1024px the sidebar becomes a top bar with a menu sheet (a native <details>, so it works
 * without JS), and the breadcrumb + actions row sits above the page title.
 *
 * Same tokens, type and theme mechanics as the public site (see BaseLayout): the theme is
 * resolved before first paint and client/theme.ts keeps the toggle and switch in sync.
 * Always noindex; the middleware also sends X-Robots-Tag and Cache-Control: no-store.
 *
 *   <AdminLayout title="Stores" section="stores" trail={[{ label: 'Stores' }]}>
 *     <Fragment slot="actions"><Button …>Add link</Button></Fragment>
 *     …
 *   </AdminLayout>
 */
import '~/styles/base.css';
import fontUrl from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';
import { SITE_NAME } from '~/config/site';
import Logo from '~/components/site/Logo.astro';
import Icon from '~/components/ui/Icon.astro';
import ThemeToggle from '~/components/ui/ThemeToggle.astro';
import ThemeSwitch from '~/components/ui/ThemeSwitch.astro';
import AdminNav from '~/components/admin/AdminNav.astro';
import {
  SECTION_ICONS,
  SECTION_LABELS,
  type AdminSection,
  type NavCounts,
} from '~/components/admin/nav';
import { adminDb } from '~/server/admin/env';
import { fullTime } from '~/server/admin/format';

export interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  /** Page title (without "Admin" or the brand). */
  title: string;
  section?: AdminSection;
  /** Breadcrumb after the section root, e.g. [{ label: 'Stores', href }, { label: domain }]. */
  trail?: Crumb[];
  /** Bare shell for the sign-in page (no navigation). */
  bare?: boolean;
}
const { title, section = 'overview', trail, bare = false } = Astro.props;
const session = Astro.locals.admin;

// Sidebar counts in one query (the D1 per-request budget is 50).
const EMPTY: NavCounts = {
  removals: 0,
  jobs: 0,
  stores: 0,
  themes: 0,
  apps: 0,
  links: 0,
  teardowns: 0,
};
let counts = EMPTY;
if (!bare && session) {
  counts =
    (await adminDb().first<NavCounts>(
      `SELECT (SELECT COUNT(*) FROM removal_requests WHERE status = 'pending') AS removals,
        (SELECT COUNT(*) FROM scan_jobs WHERE status IN ('queued', 'running')) AS jobs,
        (SELECT COUNT(*) FROM stores) AS stores,
        (SELECT COUNT(*) FROM themes) AS themes,
        (SELECT COUNT(*) FROM apps) AS apps,
        (SELECT COUNT(*) FROM affiliate_links) AS links,
        (SELECT COUNT(*) FROM teardowns) AS teardowns`,
    )) ?? EMPTY;
}

const crumbs: Crumb[] = trail?.length ? trail : [{ label: SECTION_LABELS[section] }];
const until = session ? fullTime(new Date(session.expiresAt * 1000).toISOString()) : '';
const method = session?.method === 'access' ? 'Cloudflare Access' : 'Break-glass sign-in';
const initial =
  (session?.actor ?? 'A')
    .replace(/[^a-z0-9]/gi, '')
    .charAt(0)
    .toUpperCase() || 'A';
const hasActions = Astro.slots.has('actions');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>
      // Theme before first paint (same as BaseLayout; see the comment at the top of that file).
      (function () {
        var d = document.documentElement;
        var pref = 'system';
        try {
          var stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark' || stored === 'system') pref = stored;
        } catch (e) {}
        var dark =
          pref === 'dark' ||
          (pref === 'system' &&
            !!window.matchMedia &&
            window.matchMedia('(prefers-color-scheme: dark)').matches);
        d.setAttribute('data-theme', dark ? 'dark' : 'light');
        d.setAttribute('data-theme-pref', pref);
        d.className += ' js';
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', dark ? '#0a0a0b' : '#ffffff');
      })();
    </script>
    <title>{`${title} · Admin · ${SITE_NAME}`}</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="same-origin" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // App icons come from the App Store CDN and can fail: drop them so the monogram shows.
      document.addEventListener(
        'error',
        (event) => {
          const el = event.target;
          if (el instanceof HTMLImageElement && el.closest('.app-icon')) el.remove();
        },
        true,
      );
    </script>
  </head>
  <body class:list={['admin', { 'admin--bare': bare }]}>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    {bare ? (
      <main id="main" tabindex="-1" class="admin-bare">
        <slot />
      </main>
    ) : (
      <div class="ashell">
        <aside class="aside" aria-label="Admin">
          <div class="aside__inner">
            <div class="aside__brand">
              <a href="/admin" class="abrand" aria-label="Admin overview">
                <Logo size="sm" />
              </a>
              <span class="abrand__tag">Admin</span>
            </div>
            <nav class="aside__nav" aria-label="Admin sections">
              <AdminNav current={section} counts={counts} variant="side" />
            </nav>
            <div class="aside__foot">
              <a href="/" class="aside__site">
                <Icon name="arrow-up-right" size={16} />
                <span>View public site</span>
              </a>
              {session && (
                <div class="auser">
                  <span class="auser__avatar" aria-hidden="true">
                    {initial}
                  </span>
                  <span class="auser__text">
                    <span class="auser__name" title={session.actor}>
                      {session.actor}
                    </span>
                    <span class="auser__note" title={`Session ends ${until}`}>
                      {method}
                    </span>
                  </span>
                  <ThemeToggle class="auser__theme" />
                </div>
              )}
              {session && (
                <form method="post" action="/admin/logout" class="aside__signout">
                  <button type="submit" class="asignout">
                    <Icon name="sign-out" size={16} />
                    <span>Sign out</span>
                  </button>
                </form>
              )}
            </div>
          </div>
        </aside>

        <header class="mbar">
          <details class="amenu" data-admin-menu>
            <summary class="amenu__btn" aria-label="Open admin menu">
              <Icon name="list" size={20} />
              {counts.removals > 0 && <span class="amenu__dot" aria-hidden="true" />}
            </summary>
            <div class="amenu__sheet">
              <div class="amenu__head">
                <a href="/admin" class="abrand" aria-label="Admin overview">
                  <Logo size="sm" />
                </a>
                <span class="abrand__tag">Admin</span>
                <button type="button" class="amenu__close" aria-label="Close menu" data-menu-close>
                  <Icon name="x" size={18} />
                </button>
              </div>
              <nav aria-label="Admin sections" class="amenu__nav">
                <AdminNav current={section} counts={counts} variant="menu" />
              </nav>
              <div class="amenu__foot">
                <div class="amenu__row">
                  <ThemeSwitch labels size="sm" />
                </div>
                <a href="/" class="aside__site">
                  <Icon name="arrow-up-right" size={16} />
                  <span>View public site</span>
                </a>
                {session && (
                  <div class="auser">
                    <span class="auser__avatar" aria-hidden="true">
                      {initial}
                    </span>
                    <span class="auser__text">
                      <span class="auser__name">{session.actor}</span>
                      <span class="auser__note">{method}</span>
                    </span>
                  </div>
                )}
                {session && (
                  <form method="post" action="/admin/logout">
                    <button type="submit" class="asignout asignout--menu">
                      <Icon name="sign-out" size={16} />
                      <span>Sign out</span>
                    </button>
                  </form>
                )}
              </div>
            </div>
          </details>
          <a href="/admin" class="abrand" aria-label="Admin overview">
            <Logo size="sm" wordmark={false} />
          </a>
          <span class="mbar__section">
            <Icon name={SECTION_ICONS[section]} size={16} />
            {SECTION_LABELS[section]}
          </span>
          <ThemeToggle class="mbar__theme" />
        </header>

        <div class="acol">
          <div
            class:list={[
              'atop',
              {
                'atop--root': crumbs.length === 1,
                'atop--bare': crumbs.length === 1 && !hasActions,
              },
            ]}
          >
            <nav class="atop__crumbs" aria-label="Breadcrumb">
              <ol>
                <li class="atop__section">
                  <Icon name={SECTION_ICONS[section]} size={16} />
                </li>
                {crumbs.map((c, i) => (
                  <li>
                    {c.href && i < crumbs.length - 1 ? (
                      <a href={c.href}>{c.label}</a>
                    ) : (
                      <span aria-current={i === crumbs.length - 1 ? 'page' : undefined}>
                        {c.label}
                      </span>
                    )}
                  </li>
                ))}
              </ol>
            </nav>
            {hasActions && (
              <div class="atop__actions">
                <slot name="actions" />
              </div>
            )}
          </div>
          <main id="main" tabindex="-1" class="amain">
            <slot />
          </main>
        </div>
      </div>
    )}

    <script>
      import '~/components/ui/client/theme';

      // Progressive enhancements only; every form works without JS.
      document.addEventListener('submit', (event) => {
        const form = event.target as HTMLFormElement;
        const message = form.dataset.confirm;
        if (message && !window.confirm(message)) event.preventDefault();
      });
      document.addEventListener('change', (event) => {
        const el = event.target as HTMLElement;
        if (el instanceof HTMLSelectElement && el.dataset.autosubmit !== undefined)
          el.form?.requestSubmit();
      });
      // Mobile menu sheet: Escape and the close button close it; focus returns to the button.
      const menu = document.querySelector<HTMLDetailsElement>('[data-admin-menu]');
      if (menu) {
        const close = () => {
          menu.open = false;
          menu.querySelector('summary')?.focus();
        };
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && menu.open) close();
        });
        menu.querySelector('[data-menu-close]')?.addEventListener('click', close);
        menu.addEventListener('toggle', () => {
          if (menu.open) menu.querySelector<HTMLElement>('.amenu__nav a')?.focus();
        });
      }
      // Sticky top bar: hairline + blur once the content has scrolled under it.
      const top = document.querySelector<HTMLElement>('.atop');
      if (top) {
        const onScroll = () => top.toggleAttribute('data-scrolled', window.scrollY > 4);
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });
      }
    </script>
  </body>
</html>

<style is:global>
  /* ======================================================================================
     Shell
     ====================================================================================== */
  body.admin {
    --aside-w: 232px;
    --admin-top-h: 52px;
    --admin-pad: var(--page-gutter);
    background: var(--bg);
  }
  .ashell {
    min-height: 100dvh;
  }
  .abrand {
    display: inline-flex;
    align-items: center;
    min-width: 0;
    border-radius: var(--radius-sm);
  }
  .abrand__tag {
    display: inline-flex;
    align-items: center;
    height: 18px;
    padding: 0 6px;
    border-radius: var(--radius-pill);
    box-shadow: inset 0 0 0 1px var(--line-strong);
    color: var(--ink-3);
    font-size: var(--text-2xs);
    font-weight: var(--weight-medium);
    line-height: 1;
  }

  /* ---------- Desktop sidebar ---------- */
  .aside {
    display: none;
  }
  .aside__site {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 32px;
    padding: 0 var(--space-2);
    border-radius: var(--radius-sm);
    color: var(--ink-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .aside__site .icon {
    color: var(--ink-3);
  }
  .aside__site:hover {
    background: var(--surface-2);
    color: var(--ink);
  }
  .auser {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    padding: var(--space-2);
  }
  .auser__avatar {
    display: grid;
    place-items: center;
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-pill);
    background: var(--surface-3);
    color: var(--ink);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
  }
  .auser__text {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
    line-height: 1.3;
  }
  .auser__name {
    overflow: hidden;
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .auser__note {
    overflow: hidden;
    color: var(--ink-3);
    font-size: var(--text-xs);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .auser .theme-toggle {
    width: 32px;
    height: 32px;
  }
  .asignout {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    height: 32px;
    padding: 0 var(--space-2);
    border-radius: var(--radius-sm);
    color: var(--ink-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    text-align: left;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .asignout .icon {
    color: var(--ink-3);
  }
  .asignout:hover {
    background: var(--surface-2);
    color: var(--ink);
  }

  /* ---------- Mobile top bar + menu sheet ---------- */
  .mbar {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    display: flex;
    align-items: center;
    gap: var(--space-2);
    height: 56px;
    padding: 0 var(--space-2) 0 var(--space-2);
    border-bottom: 1px solid var(--line);
    /* Solid (no backdrop-filter): a filter would trap the fixed menu sheet inside the bar. */
    background: var(--bg);
  }
  .mbar__section {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1-5);
    min-width: 0;
    margin-left: var(--space-1);
    padding-left: var(--space-3);
    border-left: 1px solid var(--line);
    overflow: hidden;
    color: var(--ink);
    font-size: var(--text-ui);
    font-weight: var(--weight-medium);
    white-space: nowrap;
  }
  .mbar__section .icon {
    color: var(--ink-3);
  }
  .mbar__theme {
    margin-left: auto;
  }
  .amenu__btn {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-control);
    color: var(--ink);
    list-style: none;
    cursor: pointer;
    transition: background-color var(--dur-fast) var(--ease-out);
  }
  .amenu__btn::-webkit-details-marker {
    display: none;
  }
  .amenu__btn:hover {
    background: var(--surface-2);
  }
  .amenu__dot {
    position: absolute;
    top: 9px;
    right: 8px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 2px var(--bg);
  }
  /* The open summary doubles as the backdrop: a click outside the sheet closes it (no JS). */
  .amenu[open] > .amenu__btn::before {
    content: '';
    position: fixed;
    inset: 0;
    z-index: 1;
    background: var(--overlay);
    cursor: default;
  }
  .amenu:not([open]) .amenu__sheet {
    display: none;
  }
  .amenu__sheet {
    position: fixed;
    inset: 0 auto 0 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    width: min(320px, 86vw);
    overflow-y: auto;
    background: var(--bg-subtle);
    border-right: 1px solid var(--line);
    box-shadow: var(--shadow-lg);
    animation: amenu-in var(--dur-slow) var(--ease-out);
  }
  @keyframes amenu-in {
    from {
      transform: translateX(-16px);
      opacity: 0;
    }
  }
  html:has(.amenu[open]) {
    overflow: hidden;
  }
  .amenu__head {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    height: 56px;
    padding: 0 var(--space-2) 0 var(--space-4);
    border-bottom: 1px solid var(--line);
  }
  .amenu__close {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    margin-left: auto;
    border-radius: var(--radius-control);
    color: var(--ink-2);
  }
  html:not(.js) .amenu__close {
    display: none;
  }
  .amenu__close:hover {
    background: var(--surface-2);
    color: var(--ink);
  }
  .amenu__nav {
    padding: var(--space-3);
  }
  .amenu__foot {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-top: auto;
    padding: var(--space-3) var(--space-3) var(--space-5);
    border-top: 1px solid var(--line);
  }
  .amenu__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-1) var(--space-2) var(--space-2);
  }
  .amenu__label {
    color: var(--ink-3);
    font-size: var(--text-sm);
  }
  .amenu__foot .aside__site,
  .asignout--menu {
    height: 44px;
    font-size: var(--text-ui);
  }

  /* ---------- Top bar: breadcrumb + page actions ---------- */
  .atop {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    padding: var(--space-4) var(--admin-pad) 0;
  }
  .atop--bare {
    display: none;
  }
  /* Phones: a section root repeats the bar's section name, so only its actions show. */
  .atop--root {
    justify-content: flex-end;
  }
  .atop--root .atop__crumbs {
    display: none;
  }
  .atop__crumbs {
    min-width: 0;
  }
  .atop__crumbs ol {
    display: flex;
    align-items: center;
    gap: var(--space-1-5);
    min-width: 0;
    color: var(--ink-3);
    font-size: var(--text-sm);
  }
  .atop__crumbs li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1-5);
    min-width: 0;
  }
  .atop__crumbs li + li:not(:nth-child(2))::before {
    content: '/';
    color: var(--ink-4);
  }
  .atop__crumbs a,
  .atop__crumbs span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .atop__crumbs a {
    border-radius: var(--radius-xs);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .atop__crumbs a:hover {
    color: var(--ink);
  }
  .atop__crumbs [aria-current='page'] {
    color: var(--ink);
    font-weight: var(--weight-medium);
  }
  .atop__section {
    display: none !important;
    color: var(--ink-3);
  }
  .atop__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }
  .atop__actions form {
    display: contents;
  }

  .amain:focus {
    outline: none;
  }
  .amain {
    display: block;
    width: 100%;
    max-width: 1320px;
    margin-inline: auto;
    padding: var(--space-5) var(--admin-pad) var(--space-16);
  }

  @media (min-width: 1024px) {
    body.admin {
      --admin-pad: var(--space-8);
    }
    .ashell {
      display: grid;
      grid-template-columns: var(--aside-w) minmax(0, 1fr);
    }
    .mbar {
      display: none;
    }
    .aside {
      display: block;
      border-right: 1px solid var(--line);
      background: var(--bg-subtle);
    }
    .aside__inner {
      position: sticky;
      top: 0;
      display: flex;
      flex-direction: column;
      height: 100dvh;
      overflow-y: auto;
      padding: 0 var(--space-3) var(--space-3);
    }
    .aside__brand {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      height: var(--admin-top-h);
      padding: 0 var(--space-2);
      flex: none;
    }
    .aside__nav {
      flex: 1;
      padding-top: var(--space-2);
    }
    .aside__foot {
      display: flex;
      flex-direction: column;
      gap: 2px;
      padding-top: var(--space-3);
      border-top: 1px solid var(--line);
    }
    .atop,
    .atop--bare {
      position: sticky;
      top: 0;
      z-index: var(--z-header);
      display: flex;
      flex-wrap: nowrap;
      height: var(--admin-top-h);
      padding: 0 var(--admin-pad);
      border-bottom: 1px solid transparent;
      background: var(--bg);
      transition:
        border-color var(--dur-base) var(--ease-out),
        background-color var(--dur-base) var(--ease-out);
    }
    .atop[data-scrolled] {
      border-bottom-color: var(--line);
      background: var(--header-bg);
      backdrop-filter: saturate(1.4) blur(12px);
      -webkit-backdrop-filter: saturate(1.4) blur(12px);
    }
    .atop__section {
      display: inline-flex !important;
    }
    .atop--root {
      justify-content: space-between;
    }
    .atop--root .atop__crumbs {
      display: block;
    }
    .atop__actions {
      flex-wrap: nowrap;
    }
    .amain {
      padding: var(--space-6) var(--admin-pad) var(--space-20);
    }
  }

  /* Bare shell (sign-in): a centred card on the subtle background. */
  body.admin--bare {
    background: var(--bg-subtle);
  }
  .admin-bare {
    display: grid;
    min-height: 100dvh;
    place-items: center;
    padding: var(--space-10) var(--page-gutter);
  }
  .admin-bare:focus {
    outline: none;
  }

  /* ======================================================================================
     Building blocks shared by admin pages (a-*)
     ====================================================================================== */
  .a-stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .a-block {
