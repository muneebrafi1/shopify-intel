{
  "name": "shopify-intel",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "node scripts/lint-rules.mjs && prettier --check .",
    "test:e2e": "playwright test --trace off --pass-with-no-tests",
    "size": "node scripts/size-budget.mjs",
    "budget:queries": "node scripts/query-budget.mjs",
    "screens": "node scripts/capture-screens.mjs",
    "capture": "node scripts/capture/run.ts",
    "capture:ingest": "node scripts/capture/ingest-local.ts",
    "test": "vitest run",
    "db:build-seed": "node scripts/build-seed.ts",
    "db:reset": "node scripts/db-reset.ts",
    "setup": "npm run db:build-seed && npm run db:reset",
    "capture:reprocess": "node scripts/capture/reprocess.ts",
    "crawl": "node scripts/crawl/run.ts",
    "crawl:ingest": "node scripts/crawl/ingest.ts",
    "crawl:themes": "node scripts/crawl/theme-store.ts",
    "ops:preflight": "node scripts/ops/preflight.ts",
    "ops:smoke": "node scripts/ops/preflight.ts --smoke"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.8",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@phosphor-icons/core": "^2.1.1",
    "astro": "^7.4.12",
    "wrangler": "^4.164.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261117.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "sharp": "0.35.5",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
